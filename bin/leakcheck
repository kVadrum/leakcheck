  heroku-key                  'HRKU-AA[A-Za-z0-9_-]{58}'  # gitleaks: heroku-api-key-v2
  supabase-key                'sbp_[a-f0-9]{40}|sb_secret_[A-Za-z0-9_-]{20,}'
  azure-storage-key           'AccountKey=([A-Za-z0-9+]|\\?/){86}=='
  azure-ad-client-secret      '[A-Za-z0-9_~.]{3}[0-9]Q~[A-Za-z0-9_~.-]{31,34}'  # gitleaks: azure-ad-client-secret
  new-relic-key               'NRAK-[A-Z0-9]{27}|NRII-[A-Za-z0-9_-]{32}'  # gitleaks: new-relic-user-api-key, new-relic-insert-key
