PATTERNS=()
ALLOWLIST=()
ALLOW_SCOPE=()   # per allow rule: "" (no credential hit), a credential id, or *
ALLOW_TEXT=()    # per allow rule: as written, scope included
ALLOW_AT=()      # per allow rule: file:line, for messages
DISABLES=()      # credential id, file:line pairs
RULE_CHECK=()
SKIPS=()
USE_DEFAULTS=1
USE_CREDENTIALS=1

# POSIX ERE has no \d, \t or \x: git's regex reads `\` before an ordinary
# letter as that letter, so `SECRET-\d+` and a single-backslash
# `C:\Users\<user>` silently match nothing real, and inside brackets a
# backslash is literal, so `[\w.-]` misses every letter (all measured, git
# 2.53). Only \w \W \s \S \b \B mean something; refuse every other `\` +
# letter, and `\0`. The bracket walk follows POSIX: `]` right after `[` or
# `[^` is literal, and [:class:] / [=x=] / [.x.] nest.
check_escapes() { # regex where
  local re=$1 where=$2 n=${#1} i=0 c x in_br=0 open=0 d rest tail
  local letters='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
  while (( i < n )); do
    c=${re:i:1}
    if (( in_br )); then
      if [[ $c == '[' ]] && (( i + 1 < n )); then
        d=${re:i+1:1}
        if [[ $d == ':' || $d == '=' || $d == '.' ]]; then
          rest=${re:i+2}
          tail=${rest#*"$d]"}
          if [[ $tail == "$rest" ]]; then return 0; fi # unterminated: git rejects it
          i=$(( n - ${#tail} ))
          continue
        fi
      fi
      if [[ $c == ']' ]] && (( i > open )); then
        in_br=0
      elif [[ $c == '\' ]] && (( i + 1 < n )); then
        x=${re:i+1:1}
        if [[ $letters == *"$x"* ]]; then
          die "$where: inside [...] a backslash is literal, so '\\$x' means a backslash or a '$x', not a class; write [0-9] for a digit, [[:alnum:]_] for a word character"
        fi
      fi
      i=$(( i + 1 ))
      continue
    fi
    if [[ $c == '\' ]]; then
      x=${re:i+1:1}
      if [[ -n $x && ( $letters == *"$x"* || $x == 0 ) && $x != [bBsSwW] ]]; then
        die "$where: '\\$x' is a plain '$x' in POSIX ERE, not an escape, so this can never match what it looks like; write '\\\\' for a literal backslash, [0-9] for a digit"
      fi
      i=$(( i + 2 ))
      continue
    fi
    if [[ $c == '[' ]]; then
      in_br=1
      i=$(( i + 1 ))
      if [[ ${re:i:1} == '^' ]]; then i=$(( i + 1 )); fi
      open=$i
      continue
    fi
    i=$(( i + 1 ))
  done
}

# Read each config in order. Absence is fine — defaults still apply.
# The blanks a copy from a rendered page brings, as UTF-8 bytes, which
# [[:space:]] does not see (measured, in a UTF-8 and a C locale): no-break,
# U+1680, U+180E, U+2000 through the zero-width space, the line and
# paragraph separators, narrow no-break, medium mathematical, word joiner,
# ideographic, and the BOM.
UNICODE_BLANKS=($'\xc2\xa0' $'\xe1\x9a\x80' $'\xe1\xa0\x8e' $'\xe2\x80\xa8' $'\xe2\x80\xa9'
                $'\xe2\x80\xaf' $'\xe2\x81\x9f' $'\xe2\x81\xa0' $'\xe3\x80\x80' $'\xef\xbb\xbf')
for b in 80 81 82 83 84 85 86 87 88 89 8a 8b; do
  printf -v c "\\xe2\\x80\\x$b"
  UNICODE_BLANKS+=("$c")
done
unicode_blank_edge() { # text: does it begin or end in one of them?
  local LC_ALL=C b
  for b in "${UNICODE_BLANKS[@]}"; do
    [[ "$1" != "$b"* && "$1" != *"$b" ]] || return 0
  done
  return 1
}

# A config error repeats the text after `credential:` only when it is a rule
# id: a key typed where the id goes is what it would print (/qaa, v0.11.5).
is_cred_id() {
  local k
  for (( k = 0; k < ${#CREDENTIALS[@]}; k += 2 )); do
    if [[ "${CREDENTIALS[k]}" == "$1" ]]; then return 0; fi
  done
  return 1
}
NOT_AN_ID="names no built-in credential rule (the text after credential: is not repeated, in case it is a key; leakcheck --list-rules prints the ids)"

parse_config() { # path name-for-messages
  local file=$1 name=$2 lineno=0 line keyword rest
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    # A CRLF config would otherwise end every regex in a CR that no line
    # can match — a pattern that silently finds nothing.
    line="${line%$'\r'}"
    # Strip leading whitespace, drop blank + comment lines.
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    keyword="${line%%[[:space:]]*}"
    rest="${line#"$keyword"}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
    case "$keyword" in
      pattern|allow|skip)
        # An empty `allow` matches every hit and an empty `pattern` every
        # line: both are typos, and one of them turns a dirty repo clean.
        [[ -n "$rest" ]] || die "$name:$lineno: empty $keyword directive"
        # `allow credential:<id> <regex>` scopes a rule to one credential
        # rule's hits (`*`: every credential rule's); an unscoped rule never
        # excuses a credential hit. The scope is peeled before the checks,
        # which then judge the regex alone.
        local text=$rest scope=""
        if [[ $keyword == allow && "$rest" == credential:* ]]; then
          scope=${rest%%[[:space:]]*}
          rest=${rest#"$scope"}
          rest="${rest#"${rest%%[![:space:]]*}"}"
          scope=${scope#credential:}
          [[ -n "$scope" ]] || die "$name:$lineno: allow credential: names no rule; write allow credential:<id> <regex>, or credential:* for every credential rule"
          if [[ -z "$rest" ]]; then
            [[ "$scope" != '*' ]] || die "$name:$lineno: allow credential:* needs a regex after the rule; to turn every credential rule off, write: no-credentials"
            is_cred_id "$scope" || die "$name:$lineno: allow $NOT_AN_ID"
            die "$name:$lineno: allow credential:$scope needs a regex after the rule; to turn the rule off, write: disable credential:$scope"
          fi
        fi
        if [[ $keyword != skip && "$rest" == '(?i)' ]]; then
          die "$name:$lineno: empty $keyword directive after (?i)"
        fi
        if [[ $keyword != skip ]]; then
          check_escapes "$rest" "$name:$lineno: $keyword '$rest'"
          # Trailing blanks are part of the regex, invisible in an editor,
          # and turn `pattern MYHOST ` into a pattern that misses `MYHOST.`.
          [[ "$rest" != *[[:space:]] ]] ||
            die "$name:$lineno: $keyword '$rest' ends in whitespace, which git would match literally; delete it, or write [ ] for a space you mean"
          ! unicode_blank_edge "$rest" ||
            die "$name:$lineno: $keyword '$rest' begins or ends in an invisible Unicode space (no-break, zero-width, ideographic or a BOM), which git would match literally; delete it"
          RULE_CHECK+=("$keyword" "$name:$lineno" "$rest")
        fi
        case "$keyword" in
          pattern) PATTERNS+=("$rest") ;;
          allow)   ALLOWLIST+=("$rest"); ALLOW_SCOPE+=("$scope"); ALLOW_TEXT+=("$text"); ALLOW_AT+=("$name:$lineno") ;;
          skip)    SKIPS+=("$rest") ;;
        esac
        ;;
      disable)
        # One credential rule off, by the label its hits carry. Read as words
        # with no glob, so `credential:*` reaches the check below as written.
        local -a words=()
        read -r -a words <<< "$rest"
        [[ ${#words[@]} -gt 0 ]] || die "$name:$lineno: empty disable directive"
        local w
        for w in "${words[@]}"; do
          [[ "$w" == credential:?* ]] || die "$name:$lineno: disable takes credential rule labels (credential:<id>) and nothing else"
          [[ "$w" != 'credential:*' ]] || die "$name:$lineno: disable credential:* — write no-credentials to turn every credential rule off"
          DISABLES+=("${w#credential:}" "$name:$lineno")
        done
        ;;
      no-defaults)   USE_DEFAULTS=0 ;;
      no-credentials) USE_CREDENTIALS=0 ;;
      *)             die "$name: unknown directive: $keyword" ;;
    esac
  done < "$file"
}
for i in "${!CONFIG_FILES[@]}"; do
  parse_config "${CONFIG_FILES[$i]}" "${CONFIG_NAMES[$i]}"
done

# A credential rule's label is `credential:<id>`; every other pattern is its
# own label. CRED_RE maps a label to its ERE, so a config pattern spelled
# like a label would be read as that rule's regex: refused.
declare -A CRED_RE=() CRED_MARKER=() CRED_OFF=()
CRED_LABELS=()
for (( i = 0; i < ${#CREDENTIALS[@]}; i += 2 )); do
  CRED_RE["lcredential:${CREDENTIALS[i]}"]=${CREDENTIALS[i + 1]}
done
# A rule id that names no rule is refused, never ignored: a typo in `disable`
# would leave on a rule meant off (harmless), but one in an allow scope would
# leave hits meant excused reported with nothing saying why — and a rule
# renamed by a later version should fail loudly, not quietly change scope.
for (( i = 0; i < ${#DISABLES[@]}; i += 2 )); do
  [[ -n "${CRED_RE["lcredential:${DISABLES[i]}"]+x}" ]] ||
    die "${DISABLES[i + 1]}: disable $NOT_AN_ID"
  CRED_OFF["${DISABLES[i]}"]=1
done
for r in "${!ALLOWLIST[@]}"; do
  asc=${ALLOW_SCOPE[r]}
  [[ -z "$asc" || "$asc" == '*' || -n "${CRED_RE["lcredential:$asc"]+x}" ]] ||
    die "${ALLOW_AT[r]}: allow $NOT_AN_ID"
done
CRED_DISABLED=()
for (( i = 0; i < ${#CREDENTIALS[@]}; i += 2 )); do
  if [[ -n "${CRED_OFF["${CREDENTIALS[i]}"]+x}" ]]; then
    CRED_DISABLED+=("credential:${CREDENTIALS[i]}")
  else
    CRED_LABELS+=("credential:${CREDENTIALS[i]}")
  fi
done
for id in "${CRED_MARKERS[@]}"; do CRED_MARKER["lcredential:$id"]=1; done
for p in "${PATTERNS[@]}"; do
  [[ -z "${CRED_RE["l$p"]+x}" ]] || die "pattern '$p' is the name of a built-in credential rule; write the ERE you mean"
done
CRED_RULES=0
if [[ "$USE_DEFAULTS" -eq 1 ]]; then
  PATTERNS=("${DEFAULTS[@]}" "${PATTERNS[@]}")
fi
# After the config's patterns, so --list-patterns and the hit order only
# ever gain lines at the end.
if [[ "$USE_CREDENTIALS" -eq 1 ]]; then
  PATTERNS+=("${CRED_LABELS[@]}")
  CRED_RULES=${#CRED_LABELS[@]}
fi

# pat_args <label>: re_args for the ERE behind a pattern label, and in
# RE_LOC how to run it. A credential rule runs in the C locale: it is ASCII
# throughout, so it matches the same bytes there, and git's regex runs over
# ten times faster than under UTF-8 (18 s against 1.4 s, 59 rules over 24 MB
# of history: measured). The defaults run there too, so their [^ -~] meets
# every byte: under UTF-8 a Latin-1 ë is no character at all, and a Latin-1
# file's home path for user zoë read clean (measured). A config pattern
# keeps the caller's locale.
in_c() { LC_ALL=C "$@"; }
declare -A DEFAULT_RE=()
for p in "${DEFAULTS[@]}"; do DEFAULT_RE["l$p"]=1; done
pat_args() {
  if [[ -n "${CRED_RE["l$1"]+x}" ]]; then
    re_args "${CRED_RE["l$1"]}"; RE_LOC=(in_c)
  elif [[ -n "${DEFAULT_RE["l$1"]+x}" ]]; then
    re_args "$1"; RE_LOC=(in_c)
  else
    re_args "$1"; RE_LOC=()
  fi
}

# The labels `disable` and `allow credential:` name, so they are never
# typed from memory: each built-in rule, tab, whether this config runs it.
if [[ "$LIST_ONLY" -eq 2 ]]; then
  for (( i = 0; i < ${#CREDENTIALS[@]}; i += 2 )); do
    st=on
    if [[ "$USE_CREDENTIALS" -eq 0 || -n "${CRED_OFF["${CREDENTIALS[i]}"]+x}" ]]; then st=off; fi
    printf 'credential:%s\t%s\n' "${CREDENTIALS[i]}" "$st"
  done
  exit 0
fi
if [[ "$LIST_ONLY" -eq 1 ]]; then
  for p in "${PATTERNS[@]}"; do
    printf '%s\n' "${CRED_RE["l$p"]:-$p}"
  done
  exit 0
fi

if [[ "${#PATTERNS[@]}" -eq 0 ]]; then
  echo "leakcheck: no patterns to scan (defaults disabled and config empty)" >&2
  exit 2
fi

# Pathspecs. `skip` removes a path from the scan entirely: content, name and
# symlink target. The config file is narrower: only its CONTENT is skipped
# (its `pattern` lines would otherwise read as leaks), and only when it lives
# inside the repo — an exclude naming a path outside the repo is fatal to
# git. Its name and stored symlink target are published like any other path,
# so they are scanned: a tracked `.leakcheckrc -> /home/<user>/…` is a leak.
skip_excludes=()
for skip in "${SKIPS[@]}"; do
  skip_excludes+=(":!:$skip")
done
excludes=("${skip_excludes[@]}")
CONFIG_REL=""
case "$CONFIG_ABS" in
  "$top"/*)
    CONFIG_REL="${CONFIG_ABS#"$top"/}"
    excludes+=(":(exclude,literal)$CONFIG_REL")
    ;;
esac

TMPD="$(mktemp -d "${TMPDIR:-/tmp}/leakcheck.XXXXXX")" || die "cannot create a temp dir"
# Scan the objects a push publishes, in every git call from here on: replace
# refs and a local info/grafts file both rewrite what git shows, and a graft
# that makes HEAD a root hid a leak from --history, exit 0 (found by /cxr,
# reproduced). A graft file that does not exist turns grafts off with no
# output; GIT_GRAFT_FILE=/dev/null also does, but prints the deprecation hint
# in every repo, which run_git rightly reads as a scan error (both measured).
export GIT_NO_REPLACE_OBJECTS=1
export GIT_GRAFT_FILE="$TMPD/no-grafts"
# Pathspec magic is the script's to choose: GIT_LITERAL_PATHSPECS=1 made
# `:(literal).leakcheckrc.local` a filename matching nothing, and a committed
# .leakcheckrc.local in history then read clean, exit 0 (measured).
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
mkdir "$TMPD/subj"

# Binary detection must depend on content alone. git grep -I otherwise
# honours .gitattributes, and `*.svg binary` (a common line) would
# silently drop text files — an Inkscape SVG carrying its author's home
# path — that the published clone still contains. GIT_ATTR_SOURCE (git
# >= 2.40; older git ignores it, and the skip is still counted) points
# in-tree attributes at the empty tree; the other two lines cover the
# global and system attribute files. $GIT_DIR/info/attributes cannot be
# switched off and is counted like any other skip.
EMPTY_TREE="$(git hash-object -t tree /dev/null)" || die "cannot compute the empty tree id"
g() {
  GIT_ATTR_SOURCE="$EMPTY_TREE" GIT_ATTR_NOSYSTEM=1 \
    git -c core.attributesFile=/dev/null "$@"
}

# run_git <label> <out-file> <command...>: stdout to <out-file>. Exit 0 or
# 1 is a result; any other status, or ANY stderr, is a scan error. git grep
# reports an unreadable worktree file on stderr and still exits 1, which
# would otherwise read as "no match" (measured, git 2.53).
run_git() {
  local label=$1 out=$2 rc=0
  shift 2
  "$@" > "$out" 2> "$TMPD/err" || rc=$?
  if [[ $rc -gt 1 || -s "$TMPD/err" ]]; then
    echo "leakcheck: scan error: $label (git exited $rc)" >&2
    sed 's/^/  /' "$TMPD/err" >&2
    exit 2
  fi
  return 0
}

GREP_FLAGS=(-z --no-color --no-column --no-textconv --no-recurse-submodules)

# re_args <pattern or allow rule>: its git grep arguments, in RE_ARGS. A
# leading (?i) makes it case-insensitive — git's ERE refuses `(?i)` (exit
# 128, measured), so the prefix had no meaning before — and the text as
# written stays its label. Every site that hands a pattern or rule to git
# goes through here.
re_args() {
  if [[ "$1" == '(?i)'* ]]; then RE_ARGS=(-i -E -e "${1:4}"); else RE_ARGS=(-E -e "$1"); fi
}

# A config rule that matches the empty string matches everything: a pattern
# would flag every line, and an allow rule, which needs to match only
# somewhere in a hit's `path:line:match`, would excuse every hit. A stray
# `|` after the last alternative or an `x*` is a typo, like an empty
# directive, and one of them turns a dirty repo clean.
# A rule can also match the empty string only beside a character, which no
# empty line shows: `\b`, `\<`, `\b(docs|)\b`, `a|\b` (each excused every
# hit through v0.10.2, measured). Each edge probe puts one context (line
# edge, word character, other character) on each side of a gap, around each
# top-level alternative A of the rule: ^LAT$|^LBT$… can match no line but
# its own, and that only with the rule matching empty. No group is added,
# so a backreference keeps its number (`\b(docs|)\1\b`; a first draft
# wrapped the rule in one and skipped every rule holding a backreference,
# found by /cxr). An alternative never begins with a quantifier that the
# context would then bind: git refuses one anywhere (measured), and the
# empty-line run has already stopped on it.
split_alts() { # ERE -> its top-level alternatives, in ALTS; brackets as in check_escapes
  local re=$1 n=${#1} i=0 c d rest tail cur="" depth=0 in_br=0 open=0
  ALTS=()
  while (( i < n )); do
    c=${re:i:1}
    if (( in_br )); then
      if [[ $c == '[' ]] && (( i + 1 < n )); then
        d=${re:i+1:1}
        if [[ $d == ':' || $d == '=' || $d == '.' ]]; then
          rest=${re:i+2}
          tail=${rest#*"$d]"}
          if [[ $tail == "$rest" ]]; then cur+=${re:i}; break; fi
          cur+=${re:i:n-${#tail}-i}
          i=$(( n - ${#tail} ))
          continue
        fi
      fi
      if [[ $c == ']' ]] && (( i > open )); then in_br=0; fi
      cur+=$c; i=$(( i + 1 ))
      continue
    fi
    case "$c" in
      '\') cur+=${re:i:2}; i=$(( i + 2 )); continue ;;
      '[')
        in_br=1; cur+=$c; i=$(( i + 1 ))
        if [[ ${re:i:1} == '^' ]]; then cur+='^'; i=$(( i + 1 )); fi
        open=$i
        continue ;;
      '(') depth=$(( depth + 1 )) ;;
      ')') if (( depth > 0 )); then depth=$(( depth - 1 )); fi ;;
      '|') if (( depth == 0 )); then ALTS+=("$cur"); cur=""; i=$(( i + 1 )); continue; fi ;;
    esac
    cur+=$c; i=$(( i + 1 ))
  done
  ALTS+=("$cur")
}
printf '\n' > "$TMPD/empty-line"
printf '%s\n' a - b @ cd e, %f '=~' > "$TMPD/edge-lines"
EDGE_PROBES=('' a '' - b '' @ '' c d e , % f = '~')
for (( i = 0; i < ${#RULE_CHECK[@]}; i += 3 )); do
  re_args "${RULE_CHECK[i + 2]}"
  run_git "${RULE_CHECK[i]} '${RULE_CHECK[i + 2]}'" "$TMPD/e" \
    git -C "$TMPD" grep --no-index -l --no-color "${RE_ARGS[@]}" -- empty-line
  if [[ ! -s "$TMPD/e" ]]; then
    split_alts "${RE_ARGS[-1]}"
    edge=("${RE_ARGS[@]:0:${#RE_ARGS[@]}-2}")
    for (( k = 0; k < ${#EDGE_PROBES[@]}; k += 2 )); do
      e=""
      for a in "${ALTS[@]}"; do e+="${e:+|}^${EDGE_PROBES[k]}$a${EDGE_PROBES[k + 1]}\$"; done
      edge+=(-e "$e")
    done
    run_git "${RULE_CHECK[i]} '${RULE_CHECK[i + 2]}'" "$TMPD/e" \
      git -C "$TMPD" grep --no-index -l --no-color "${edge[@]}" -- edge-lines
  fi
  if [[ -s "$TMPD/e" ]]; then
    if [[ "${RULE_CHECK[i]}" == pattern ]]; then what="flag every line"; else what="excuse every hit"; fi
    die "${RULE_CHECK[i + 1]}: ${RULE_CHECK[i]} '${RULE_CHECK[i + 2]}' matches the empty string, so it would $what"
  fi
done

# Credential rules go to git once per pass first, all of them as one -l
# grep: most subjects hold no credential, and one process beats one per rule
# (59 of them took a scan of a small repo from 0.1 s to 1.2 s). Same engine,
# flags and subject as each rule's own run, so where this finds nothing no
# rule could. pass_patterns <label> <git grep command with "${CRED_E[@]}">
# sets PASS_PATS: every pattern, less the credential rules on a miss.
CRED_E=()
for p in "${PATTERNS[@]}"; do
  if [[ -n "${CRED_RE["l$p"]+x}" ]]; then CRED_E+=(-e "${CRED_RE["l$p"]}"); fi
done
OTHER_PATS=("${PATTERNS[@]:0:${#PATTERNS[@]}-CRED_RULES}")
pass_patterns() {
  local label=$1
  shift
  PASS_PATS=("${PATTERNS[@]}")
  if [[ "$CRED_RULES" -eq 0 ]]; then return 0; fi
  run_git "credential rules ($label)" "$TMPD/cpre" in_c "$@"
  if [[ ! -s "$TMPD/cpre" ]]; then PASS_PATS=("${OTHER_PATS[@]}"); fi
  return 0
}

# ─── what is tracked ──────────────────────────────────────────────────
# Mode decides the kind: 100644/100755 regular, 120000 symlink (its blob is
# the target string), 160000 a submodule gitlink. Unmerged paths appear once
# per stage; the first row wins. Listed with `skip` excludes only — the
# config's own entry stays, for its name and symlink target.
run_git "ls-files" "$TMPD/ls" g ls-files -s -z -- . "${skip_excludes[@]}"
mapfile -d '' -t LS_ROWS < "$TMPD/ls"
declare -A SEEN_PATH=()
declare -A MODE_OF=()
PATHS=()
LINK_PATHS=()
LINK_OIDS=()
GITLINKS=()
for row in "${LS_ROWS[@]}"; do
  meta="${row%%$'\t'*}"
  path="${row#*$'\t'}"
  mode="${meta%% *}"
  oid="${meta#* }"
  oid="${oid%% *}"
  [[ -n "${SEEN_PATH["p$path"]+x}" ]] && continue
  SEEN_PATH["p$path"]=1
  MODE_OF["p$path"]=$mode
  PATHS+=("$path")
  case "$mode" in
    120000) LINK_PATHS+=("$path"); LINK_OIDS+=("$oid") ;;
    160000) GITLINKS+=("$path") ;;
  esac
done
# The denominator counts files whose content is in scope; the config's own
# content is not, and is reported under "skipped by config".
TRACKED_COUNT=${#PATHS[@]}
if [[ -n "$CONFIG_REL" && -n "${SEEN_PATH["p$CONFIG_REL"]+x}" ]]; then
  TRACKED_COUNT=$((TRACKED_COUNT - 1))
fi

run_git "ls-files" "$TMPD/lsall" g ls-files -z -- .
mapfile -d '' -t ALL_ROWS < "$TMPD/lsall"
declare -A SEEN_ALL=()
for path in "${ALL_ROWS[@]}"; do SEEN_ALL["p$path"]=1; done
SKIPPED_COUNT=$(( ${#SEEN_ALL[@]} - TRACKED_COUNT ))
[[ $SKIPPED_COUNT -ge 0 ]] || SKIPPED_COUNT=0

# ─── binary detection ─────────────────────────────────────────────────
# A path is binary exactly when this scan's -I skips it: listed by
# `-l -e ''` (any content at all) and not by `-I -l -e ''`. Measuring with
# the scan's own flags is what makes the count follow the scan — git sniffs
# the first 8000 bytes, which is not GNU grep's rule.
declare -A BINARY=()
BINARY_PATHS=()
mark_binary() { # path source
  if [[ -z "${BINARY["p$1"]+x}" ]]; then
    BINARY["p$1"]="$2"
    BINARY_PATHS+=("$1")
  elif [[ "${BINARY["p$1"]}" != "$2" ]]; then
    BINARY["p$1"]="both"
  fi
}
# Fills BINARY_ROWS with the names the last two sniffs ($TMPD/all, $TMPD/text)
# disagree on: content present, but skipped by -I.
binary_rows() {
  local path
  local -A text=()
  BINARY_ROWS=()
  mapfile -d '' -t _rows < "$TMPD/text"
  for path in "${_rows[@]}"; do text["p$path"]=1; done
  mapfile -d '' -t _rows < "$TMPD/all"
  for path in "${_rows[@]}"; do
    [[ -n "${text["p$path"]+x}" ]] || BINARY_ROWS+=("$path")
  done
  return 0
}
binary_pass() { # source [git grep args...]
  local src=$1 path
  shift
  run_git "binary sniff ($src)" "$TMPD/all" g grep "$@" "${GREP_FLAGS[@]}" -l -e '' -- . "${excludes[@]}"
  run_git "binary sniff ($src)" "$TMPD/text" g grep "$@" "${GREP_FLAGS[@]}" -I -l -e '' -- . "${excludes[@]}"
  binary_rows
  for path in "${BINARY_ROWS[@]}"; do mark_binary "$path" "$src"; done
  return 0
}
binary_pass index --cached
binary_pass worktree

# ─── hits ─────────────────────────────────────────────────────────────
# Parallel arrays, never a delimited temp file: a path may hold a tab, a
# colon or a newline, and each of those broke one earlier shape. Hits found
# in both the index and the worktree are reported once, as "both".
H_PAT=()
H_FILE=()
H_LINE=()
H_TEXT=()
H_SRC=()
H_COMMIT=()
declare -A HIT_AT=()
add_hit() { # pattern file line text source [commit]
  # Length-prefixed fields make the key injective whatever the fields hold.
  # The commit is part of the key, so a history hit never merges into the
  # same line found in the tree today: they need different remedies.
  local c="${6-}"
  local key="h${#1}:$1${#2}:$2${#3}:$3${#c}:$c:$4" i
  if [[ -n "${HIT_AT[$key]+x}" ]]; then
    i=${HIT_AT[$key]}
    if [[ "${H_SRC[$i]}" != "$5" ]]; then H_SRC[$i]="both"; fi
    return 0
  fi
  HIT_AT[$key]=${#H_FILE[@]}
  H_PAT+=("$1"); H_FILE+=("$2"); H_LINE+=("$3"); H_TEXT+=("$4"); H_SRC+=("$5")
  H_COMMIT+=("$c")
}

# Content: git grep, one run per pattern so each hit knows its pattern.
# -z gives `path\0line\0text\n`, so the filename never has to be split off
# the match text — the reason the old per-file grep loop existed. Every
# pattern is compiled by git: an invalid ERE exits 128 here, where GNU grep
# behind `2>/dev/null || true` once made it match nothing, forever.
# --no-column is load-bearing: grep.column=true in a user's gitconfig adds a
# field and shifts the parse. A credential rule reads the config's content
# too: the exemption exists because pattern lines match themselves, which no
# credential rule's does, and a key pasted into a committed .leakcheckrc is
# published like any other.
content_pass() { # source [git grep args...]
  local src=$1 p f l t
  local -a ex
  shift
  pass_patterns "$src" g grep "$@" "${GREP_FLAGS[@]}" -l -I -E "${CRED_E[@]}" -- . "${skip_excludes[@]}"
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    ex=("${excludes[@]}")
    if [[ -n "${CRED_RE["l$p"]+x}" ]]; then ex=("${skip_excludes[@]}"); fi
    run_git "pattern '$p' ($src)" "$TMPD/hits" \
      "${RE_LOC[@]}" g grep "$@" "${GREP_FLAGS[@]}" -n -I -H --full-name "${RE_ARGS[@]}" -- . "${ex[@]}"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      add_hit "$p" "$f" "$l" "$t" "$src"
    done < "$TMPD/hits"
  done
  return 0
}
# The index is what the next commit publishes; the worktree is what
# `git commit -a` publishes, and holds the only copy of an intent-to-add
# file. Each pass alone misses a case the other catches.
content_pass index --cached
content_pass worktree

# Type changes the worktree pass cannot see: an index symlink or gitlink
# replaced by a regular file. git grep follows the INDEX mode and skips the
# path, but `git commit -a` stages the new file — and v0.2.2's per-file grep,
# which read whatever was on disk, did scan it. Each one is copied under a
# numbered name and scanned there, with the same flags and the same binary
# rule, then mapped back to its real path. The config is among them when it
# changed type: the credential rules read its content, as in the tree.
TC_PATHS=()
TC_CFG=()
for path in "${PATHS[@]}"; do
  case "${MODE_OF["p$path"]}" in
    120000|160000) ;;
    *) continue ;;
  esac
  if [[ -f "$path" && ! -L "$path" ]]; then
    if [[ "$path" == "$CONFIG_REL" ]]; then TC_CFG=(":(exclude,literal)${#TC_PATHS[@]}"); fi
    TC_PATHS+=("$path")
  fi
done
if [[ ${#TC_PATHS[@]} -gt 0 ]]; then
  mkdir "$TMPD/tc"
  for k in "${!TC_PATHS[@]}"; do
    if ! cp -- "${TC_PATHS[$k]}" "$TMPD/tc/$k" 2>"$TMPD/err"; then
      echo "leakcheck: scan error: cannot read ${TC_PATHS[$k]}" >&2
      sed 's/^/  /' "$TMPD/err" >&2
      exit 2
    fi
  done
  gni() { GIT_ATTR_NOSYSTEM=1 git -c core.attributesFile=/dev/null -C "$TMPD/tc" grep --no-index "$@"; }
  run_git "binary sniff (type changes)" "$TMPD/all" gni -z -l -e '' -- .
  run_git "binary sniff (type changes)" "$TMPD/text" gni -z -I -l -e '' -- .
  binary_rows
  for k in "${BINARY_ROWS[@]}"; do mark_binary "${TC_PATHS[$k]}" worktree; done
  pass_patterns "type changes" gni -z -l -I -E "${CRED_E[@]}" -- .
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    ex=("${TC_CFG[@]}")
    if [[ -n "${CRED_RE["l$p"]+x}" ]]; then ex=(); fi
    run_git "pattern '$p' (type changes)" "$TMPD/hits" \
      "${RE_LOC[@]}" gni -z -n -I --no-color --no-column "${RE_ARGS[@]}" -- . "${ex[@]}"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      # An indexed subscript is arithmetic: a non-numeric name would quietly
      # map to entry 0, so check the shape before the lookup.
      [[ "$f" =~ ^[0-9]+$ && -n "${TC_PATHS[$f]+x}" ]] || die "internal error: type-change pass returned $f"
      add_hit "$p" "${TC_PATHS[$f]}" "$l" "$t" worktree
    done < "$TMPD/hits"
  done
fi
BINARY_COUNT=${#BINARY_PATHS[@]}

# Names and symlink targets: content too. A clone publishes every path name
# and every stored link target, and git grep reads neither. Each subject is
# one line of a scratch file (a name holding newlines spans several lines,
# all mapped back to it), matched by the same git grep engine as content.
S_PATH=()
S_SUBJ=()
S_TEXT=()
S_SRC=()
for path in "${PATHS[@]}"; do
  S_PATH+=("$path"); S_SUBJ+=("$path"); S_TEXT+=("$path"); S_SRC+=("index")
done
for i in "${!LINK_PATHS[@]}"; do
  if ! tgt="$(git cat-file blob "${LINK_OIDS[$i]}" 2>"$TMPD/err")"; then
    echo "leakcheck: scan error: cannot read symlink ${LINK_PATHS[$i]}" >&2
    sed 's/^/  /' "$TMPD/err" >&2
    exit 2
  fi
  S_PATH+=("${LINK_PATHS[$i]}"); S_SUBJ+=("$tgt"); S_TEXT+=("-> $tgt"); S_SRC+=("index")
done
for path in "${PATHS[@]}"; do
  [[ -L "$path" ]] || continue
  tgt="$(readlink -- "$path")" || die "scan error: cannot read symlink $path"
  S_PATH+=("$path"); S_SUBJ+=("$tgt"); S_TEXT+=("-> $tgt"); S_SRC+=("worktree")
done

SUBJ_OF_LINE=()
n=0
for i in "${!S_SUBJ[@]}"; do
  nl="${S_SUBJ[$i]//[!$'\n']/}"
  for (( k = 0; k <= ${#nl}; k++ )); do
    n=$((n + 1))
    SUBJ_OF_LINE[$n]=$i
  done
done
if [[ ${#S_SUBJ[@]} -gt 0 ]]; then
  printf '%s\n' "${S_SUBJ[@]}" > "$TMPD/subj/s"
else
  : > "$TMPD/subj/s"
fi

pass_patterns "names" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- s
for p in "${PASS_PATS[@]}"; do
  pat_args "$p"
  run_git "pattern '$p' (names)" "$TMPD/shits" \
    "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- s
  while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
    i="${SUBJ_OF_LINE[$l]:-}"
    [[ -n "$i" ]] || die "internal error: names pass returned line $l"
    add_hit "$p" "${S_PATH[$i]}" 0 "${S_TEXT[$i]}" "${S_SRC[$i]}"
  done < "$TMPD/shits"
done

# ─── history (--history) ──────────────────────────────────────────────
# Every commit reachable from any ref (--all: branches, tags, remote-tracking
# refs, stash, notes), scanned for: every ADDED line of every diff, at its
# line number in that commit's version of the file; every path that ever
# appeared in a diff; and author, committer and message. Each finding is
# reported once, at its earliest commit — a line that sat unchanged through
# fifty edits is one hit, and a leak still in the tree today is reported
# twice, once here and once as it is now, because each needs its own fix.
# --history-range RANGE puts one revision range in place of --all in every
# pass below; the summary and JSON name the range, so a partial scan never
# reads as a full one.
# Load-bearing flags:
#   --full-history  a pathspec otherwise simplifies history, and an `-s ours`
#                   merge then hides its whole side branch (measured). -m
#                   happens to stop that in the content pass; the
#                   .leakcheckrc.local pass has no -m and depends on this
#   -m              lines a merge itself introduces appear in neither
#                   parent's diff; -m diffs each merge against each parent
#   --no-renames    a rename is a delete plus an add, so every `diff --git`
#                   header names one path twice — the parser relies on that
#   log.showRoot    `false` in a user's config hides the root commit's diff
#   replace refs, grafts   ignored for every git call (exported above), so
#                   the objects scanned are the objects a push publishes
HIST_COMMITS=0
HIST_BINARY=0
HIST_SKIPPED=0
HIST_REFS=0
HIST_TAGS=0
HIST_TAGGED=0
declare -A CFG_EXEMPT=()
HREVS=(--all)
if [[ -n "$HIST_RANGE" ]]; then HREVS=("$HIST_RANGE"); fi
if [[ "$HISTORY" -eq 1 ]]; then
  run_git "rev-parse" "$TMPD/shallow" g rev-parse --is-shallow-repository
  if [[ "$(<"$TMPD/shallow")" != "false" ]]; then
    [[ -n "$HIST_RANGE" ]] ||
      die "shallow clone: its history is incomplete, so --history cannot vouch for it (git fetch --unshallow; in GitHub Actions, fetch-depth: 0)"
    # A range can still be complete in a shallow clone: what goes missing is
    # the parents of the boundary commits git lists in $GIT_DIR/shallow, so
    # the walk is exact unless one of those commits is IN the range — then
    # whatever lay behind it is silently absent (measured, git 2.53).
    run_git "rev-parse" "$TMPD/shpath" g rev-parse --git-path shallow
    run_git "rev-list" "$TMPD/hrevs" g rev-list "${HREVS[@]}" --
    declare -A SHALLOW=()
    while IFS= read -r c; do SHALLOW["c$c"]=1; done < "$(<"$TMPD/shpath")"
    while IFS= read -r c; do
      [[ -z "${SHALLOW["c$c"]+x}" ]] ||
        die "shallow clone: $HIST_RANGE reaches commit $c, whose parents this clone does not have, so the range cannot be scanned in full (fetch deeper, or git fetch --unshallow)"
    done < "$TMPD/hrevs"
  fi
  run_git "rev-list" "$TMPD/hcount" g rev-list "${HREVS[@]}" --count --
  HIST_COMMITS=$(<"$TMPD/hcount")
  [[ "$HIST_COMMITS" =~ ^[0-9]+$ ]] || die "scan error: unexpected commit count: $HIST_COMMITS"
fi

if [[ "$HISTORY" -eq 1 ]]; then
  # log.diffMerges: since git 2.32 `-m` means the user's default, and
  # `combined` prints a merge as `diff --cc` with `@@@` hunks — a merge's own
  # lines then went unscanned, exit 0 (measured). Older git ignores the key,
  # and its `-m` is already `separate`. core.bigFileThreshold: `log -p`
  # prints a file above it as binary, and at `1m` a removed 1 MB source
  # map's home path went to "binary files skipped", exit 0 (measured);
  # pinned to git's default, so a larger file is still skipped and counted.
  # i18n.logOutputEncoding: UTF-16 output split the metadata pass's NUL
  # framing, and a Latin-1 message hid a home path for user zoë (measured).
  HLOG=(-c log.showRoot=true -c core.quotePath=false -c log.diffMerges=separate
        -c core.bigFileThreshold=512m -c i18n.logOutputEncoding=UTF-8
        log "${HREVS[@]}" --full-history --date-order --reverse --no-show-signature)

  # Commit metadata, ref names and tags share one subject file, each distinct
  # (field, text) once, at the first commit or ref that carries it.
  M_SHA=()
  M_FIELD=()
  M_LINE=()
  M_TEXT=()
  declare -A M_SEEN=()
  hm_add() { # commit field line text
    local key="${#2}:$2:$4"
    [[ -n "$4" && -z "${M_SEEN[$key]+x}" ]] || return 0
    M_SEEN[$key]=1
    M_SHA+=("$1"); M_FIELD+=("$2"); M_LINE+=("$3"); M_TEXT+=("$4")
    printf '%s\n' "$4" >&9
  }
  exec 9>"$TMPD/subj/hm"
fi

# The commit passes. With no commits there is nothing for them to read, but
# the ref pass after them still runs: a ref can end at a blob or a tree, and
# a repo whose only ref was a tag named deploy-MYHOST on a blob reported
# "0 refs", exit 0, through v0.10.1 (measured).
if [[ "$HISTORY" -eq 1 && "$HIST_COMMITS" -gt 0 ]]; then
  # Old versions of the config ARE scanned: a hostname that sat in
  # .leakcheckrc before .leakcheckrc.local existed is still in every commit
  # that held it, and excluding the config's history (the first draft) hid
  # exactly that. Only a line identical to one in today's TRACKED config —
  # published on purpose, and exempt in the tree for the same reason — is
  # not reported, and each such line is counted.
  declare -A CUR_CFG=()
  if [[ -n "$CONFIG_REL" && -n "${SEEN_PATH["p$CONFIG_REL"]+x}" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do CUR_CFG["l$line"]=1; done < "$CONFIG_ABS"
  fi

  # git C-quotes a path holding ", \ or a control character even with
  # core.quotePath=false: \" \\ \a \b \t \n \v \f \r and \NNN octal. Never
  # eval it: a filename is attacker-controlled input.
  c_unquote() { # quoted-body -> REPLY
    local s=$1 out="" c o
    while [[ -n "$s" ]]; do
      c=${s:0:1}
      if [[ "$c" != '\' ]]; then out+=$c; s=${s:1}; continue; fi
      c=${s:1:1}
      case "$c" in
        '"'|'\') out+=$c ;;
        a) out+=$'\a' ;;
        b) out+=$'\b' ;;
        t) out+=$'\t' ;;
        n) out+=$'\n' ;;
        v) out+=$'\v' ;;
        f) out+=$'\f' ;;
        r) out+=$'\r' ;;
        [0-7])
          o=${s:1:3}
          [[ "$o" =~ ^[0-7]{3}$ ]] || die "scan error: cannot unquote history path: $1"
          printf -v c "\\$o"
          out+=$c
          s=${s:4}
          continue ;;
        *) die "scan error: cannot unquote history path: $1" ;;
      esac
      s=${s:2}
    done
    REPLY=$out
  }

  # With --no-renames both halves of "a/P b/P" name the same P, so the
  # header splits at its exact middle — the only split that survives a path
  # holding " b/". Anything else is a header this parser does not know.
  hist_path() { # header-remainder -> REPLY
    local rest=$1 n h a b
    n=${#rest}
    (( n % 2 == 1 )) || die "scan error: unexpected diff header: diff --git $rest"
    h=$(( (n - 1) / 2 ))
    a=${rest:0:h}
    b=${rest:h+1}
    [[ "${rest:h:1}" == " " ]] || die "scan error: unexpected diff header: diff --git $rest"
    if [[ "$a" == '"a/'*'"' && "$b" == '"b/'*'"' ]]; then
      a=${a:3:${#a}-4}
      b=${b:3:${#b}-4}
      [[ "$a" == "$b" ]] || die "scan error: unexpected diff header: diff --git $rest"
      c_unquote "$b"
    elif [[ "$a" == a/* && "$b" == b/* && "${a:2}" == "${b:2}" ]]; then
      REPLY=${b:2}
    else
      die "scan error: unexpected diff header: diff --git $rest"
    fi
  }

  # Content: every added line, written to one subject file for git grep,
  # with "<file-change> <line>" in the same row of a parallel meta file.
  # Inside a hunk every line is prefixed (+, -, space, \), so a header-shaped
  # line there is content: an added "++ x" arrives as "+++ x".
  FC_SHA=()
  FC_PATH=()
  HB_FC=()
  hist_parse() {
    local LC_ALL=C line sha="" fc=-1 ln=0 in_hunk=0 h
    exec 3>"$TMPD/subj/h" 4>"$TMPD/hmeta"
    while IFS= read -r line || [[ -n "$line" ]]; do
      if (( in_hunk )); then
        case "$line" in
          '+'*)
            printf '%s\n' "${line:1}" >&3
            printf '%s %s\n' "$fc" "$ln" >&4
            ln=$((ln + 1))
            continue ;;
          ' '*) ln=$((ln + 1)); continue ;;
          '-'*|'\'*) continue ;;
          '@@ '*) ;;
          *) in_hunk=0 ;;
        esac
      fi
      case "$line" in
        $'\x01'*) sha=${line:1}; in_hunk=0 ;;
        'diff --git '*)
          hist_path "${line#diff --git }"
          fc=$((fc + 1))
          FC_SHA[fc]=$sha
          FC_PATH[fc]=$REPLY
          in_hunk=0 ;;
        'Binary files '*' differ') HB_FC+=("$fc") ;;
        '@@ '*)
          h=${line#@@ -* +}
          h=${h%% @@*}
          ln=${h%%,*}
          [[ "$ln" =~ ^[0-9]+$ ]] || die "scan error: unexpected hunk header: $line"
          in_hunk=1 ;;
        # The extended header lines git prints with these flags. Anything
        # else — a `diff --cc` and its `@@@` hunks, a `Submodule` summary —
        # is output this parser does not understand, and skipping it would
        # skip whatever it carried.
        ''|'index '*|'--- '*|'+++ '*|'new file mode '*|'deleted file mode '*|'old mode '*|'new mode '*) ;;
        *) die "scan error: unexpected line in the history diff: ${line:0:40}" ;;
      esac
    done < "$TMPD/hlog"
    exec 3>&- 4>&-
  }

  run_git "log (history)" "$TMPD/hlog" g "${HLOG[@]}" -m --no-renames -p -U0 \
    --inter-hunk-context=0 --no-color --no-ext-diff --no-textconv --submodule=short \
    --src-prefix=a/ --dst-prefix=b/ --format=%x01%H -- . "${skip_excludes[@]}"
  hist_parse
  mapfile -t HMETA < "$TMPD/hmeta"

  declare -A HIST_SEEN=()
  hist_hit() { # kind pattern file line text commit — once per (kind, pattern, file, text)
    local key="$1${#2}:$2${#3}:$3:$5"
    [[ -z "${HIST_SEEN[$key]+x}" ]] || return 0
    HIST_SEEN[$key]=1
    add_hit "$2" "$3" "$4" "$5" history "$6"
  }

  pass_patterns "history" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- h
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- h
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      m="${HMETA[l - 1]-}"
      [[ -n "$m" ]] || die "internal error: history pass returned line $l"
      fc=${m%% *}
      if [[ -n "$CONFIG_REL" && "${FC_PATH[fc]}" == "$CONFIG_REL" && -n "${CUR_CFG["l$t"]+x}" &&
            -z "${CRED_RE["l$p"]+x}" ]]; then
        CFG_EXEMPT["l$t"]=1
        continue
      fi
      hist_hit c "$p" "${FC_PATH[fc]}" "${m#* }" "$t" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done

  # Names: every path that ever appeared in a diff header, at its first commit.
  HN_FC=()
  HN_OF_LINE=()
  declare -A HN_SEEN=()
  n=0
  exec 5>"$TMPD/subj/hn"
  for fc in "${!FC_PATH[@]}"; do
    path=${FC_PATH[fc]}
    [[ -z "${HN_SEEN["p$path"]+x}" ]] || continue
    HN_SEEN["p$path"]=1
    e=${#HN_FC[@]}
    HN_FC+=("$fc")
    printf '%s\n' "$path" >&5
    nl="${path//[!$'\n']/}"
    for (( k = 0; k <= ${#nl}; k++ )); do
      n=$((n + 1))
      HN_OF_LINE[n]=$e
    done
  done
  exec 5>&-
  pass_patterns "history names" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- hn
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history names)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hn
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      e="${HN_OF_LINE[l]-}"
      [[ -n "$e" ]] || die "internal error: history names pass returned line $l"
      fc=${HN_FC[e]}
      hist_hit n "$p" "${FC_PATH[fc]}" 0 "${FC_PATH[fc]}" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done

  # Binary files in history: skipped and counted, once per path.
  declare -A HB_SEEN=()
  for fc in "${HB_FC[@]}"; do
    path=${FC_PATH[fc]}
    [[ -z "${HB_SEEN["p$path"]+x}" ]] || continue
    HB_SEEN["p$path"]=1
    HIST_BINARY=$((HIST_BINARY + 1))
    if [[ "$STRICT" -eq 1 ]]; then
      add_hit "unscanned:binary" "$path" 0 "(binary file; content not scanned)" history "${FC_SHA[fc]}"
    fi
  done

  # What `skip` kept out of the history scan, in distinct paths.
  if [[ ${#SKIPS[@]} -gt 0 ]]; then
    sp=("${SKIPS[@]}")
    run_git "log (skipped)" "$TMPD/hskip" g "${HLOG[@]}" -m --no-renames \
      --format= --name-only -z -- "${sp[@]}"
    mapfile -d '' -t HSK < "$TMPD/hskip"
    declare -A HSK_SEEN=()
    for path in "${HSK[@]}"; do HSK_SEEN["p$path"]=1; done
    HIST_SKIPPED=${#HSK_SEEN[@]}
  fi

  # Author, committer and message — published by every push. Each distinct
  # (field, text) is scanned once, at its first commit: one leaked email in
  # five hundred commits is one hit.
  run_git "log (metadata)" "$TMPD/hmlog" g "${HLOG[@]}" -z \
    --format='%H%x00%an <%ae>%x00%cn <%ce>%x00%B'
  mapfile -d '' -t HM < "$TMPD/hmlog"
  (( ${#HM[@]} % 4 == 0 )) || die "scan error: unexpected commit metadata from git log"
  for (( i = 0; i < ${#HM[@]}; i += 4 )); do
    sha=${HM[i]}
    hm_add "$sha" "(author)" 0 "${HM[i + 1]}"
    hm_add "$sha" "(committer)" 0 "${HM[i + 2]}"
    rest=${HM[i + 3]}
    k=0
    while [[ -n "$rest" ]]; do
      k=$((k + 1))
      ml=${rest%%$'\n'*}
      if [[ "$rest" == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
      hm_add "$sha" "(message)" "$k" "$ml"
    done
  done

  # A merge of a signed tag (`git pull <url> tag v1`) carries the whole tag
  # in its own header, `mergetag`, so pushing the merge publishes the tag's
  # name, tagger and message with no tag ref at all; the tagger never
  # reaches %B, and was clean through v0.10.2 (measured). Scanned as a
  # tag's fields are, at the merge commit, from the raw objects: header
  # lines, then continuation lines that each lead with one space.
  parse_mergetags() { # <cat-file --batch output, NULs as \x01>
    local LC_ALL=C hdr sha size body nl head line tag in_tag th name tagger msg ml kk
    local -a tags
    while IFS= read -r hdr; do
      [[ "$hdr" =~ ^([0-9a-f]+)\ commit\ ([0-9]+)$ ]] ||
        die "scan error: unexpected commit object from git cat-file: $hdr"
      sha=${BASH_REMATCH[1]}; size=${BASH_REMATCH[2]}
      body=""
      if (( size > 0 )); then IFS= read -r -N "$size" body || true; fi
      (( ${#body} == size )) || die "scan error: commit object $sha could not be read whole"
      IFS= read -r nl || true
      [[ -z "$nl" ]] || die "scan error: unexpected commit object framing from git cat-file"
      [[ "$body" == *$'\nmergetag '* ]] || continue
      head=${body%%$'\n\n'*}
      tags=(); in_tag=0
      while [[ -n "$head" ]]; do
        line=${head%%$'\n'*}
        if [[ "$head" == *$'\n'* ]]; then head=${head#*$'\n'}; else head=""; fi
        if [[ "$line" == 'mergetag '* ]]; then
          tags+=("${line#mergetag }"); in_tag=1
        elif (( in_tag )) && [[ "$line" == ' '* ]]; then
          tags[${#tags[@]} - 1]+=$'\n'"${line:1}"
        else
          in_tag=0
        fi
      done
      for tag in "${tags[@]}"; do
        th=${tag%%$'\n\n'*}
        msg=""
        if [[ "$tag" == *$'\n\n'* ]]; then msg=${tag#*$'\n\n'}; fi
        name=""; tagger=""
        while [[ -n "$th" ]]; do
          line=${th%%$'\n'*}
          if [[ "$th" == *$'\n'* ]]; then th=${th#*$'\n'}; else th=""; fi
          case "$line" in
            "tag "*)    name=${line#tag } ;;
            "tagger "*) tagger=${line#tagger } ;;
          esac
        done
        if [[ "$tagger" =~ ^(.*)\ [0-9]+\ [-+][0-9]{4}$ ]]; then tagger=${BASH_REMATCH[1]}; fi
        hm_add "$sha" "(tag)" 0 "$name"
        hm_add "$sha" "(tagger)" 0 "$tagger"
        kk=0
        while [[ -n "$msg" ]]; do
          kk=$((kk + 1))
          ml=${msg%%$'\n'*}
          if [[ "$msg" == *$'\n'* ]]; then msg=${msg#*$'\n'}; else msg=""; fi
          hm_add "$sha" "(tag message)" "$kk" "$ml"
        done
      done
    done < "$1"
  }
  run_git "rev-list (merges)" "$TMPD/hmerges" g rev-list "${HREVS[@]}" --merges --
  if [[ -s "$TMPD/hmerges" ]]; then
    run_git "cat-file (merges)" "$TMPD/hmt0" g cat-file --batch < "$TMPD/hmerges"
    LC_ALL=C tr '\000' '\001' < "$TMPD/hmt0" > "$TMPD/hmt"
    parse_mergetags "$TMPD/hmt"
  fi
fi

if [[ "$HISTORY" -eq 1 ]]; then
  # Ref names and annotated tags. A push of --all, --tags or --follow-tags
  # publishes them, and neither is part of any commit: a branch named
  # feature/MYHOST-fix and a tag message "built on MYHOST" were both clean
  # through v0.7.0 (measured). Every ref is scanned by name, `(ref)`; every
  # annotated tag object a ref reaches, nested ones included, by name, tagger
  # and message, `(tag)`, `(tagger)`, `(tag message)`. With --history-range,
  # only the refs and tags that point into the range — those its push
  # carries. A ref that ends at a tree or a blob, not a commit, publishes
  # content no diff shows: counted, and reported under --strict. This pass
  # runs with or without commits.
  if [[ -n "$HIST_RANGE" ]]; then
    run_git "rev-list" "$TMPD/hrange" g rev-list "${HREVS[@]}" --
    declare -A IN_RANGE=()
    while IFS= read -r c; do IN_RANGE["c$c"]=1; done < "$TMPD/hrange"
    # A tree or a blob is in no range a walk can list, but the README's
    # pre-push hook passes a pushed tag's own id as the range, and a tag on a
    # blob or a tree went out clean, `0 refs` (measured). Such a ref is in
    # the range when the range names it, its tag or its object as a tip.
    run_git "rev-parse" "$TMPD/htips" g rev-parse "${HREVS[@]}" --
    declare -A RANGE_TIP=()
    while IFS= read -r c; do
      [[ "$c" == '^'* || "$c" == -- ]] || RANGE_TIP["o$c"]=1
    done < "$TMPD/htips"
  fi
  # Ref names hold no space or control character (git check-ref-format).
  run_git "for-each-ref" "$TMPD/hrefs" g for-each-ref --format='%(objectname) %(objecttype) %(refname)'
  REF_OBJ=(); REF_TYPE=(); REF_NAME=()
  while read -r o t n; do REF_OBJ+=("$o"); REF_TYPE+=("$t"); REF_NAME+=("$n"); done < "$TMPD/hrefs"

  declare -A TAG_OBJ=() TAG_OTYPE=() TAG_NAME=() TAG_TAGGER=() TAG_MSG=()
  # parse_tags <cat-file --batch output>: each tag's headers and message.
  # Sizes are bytes. Bash cannot hold a NUL, and `read -N` drops one and
  # reads a byte further, which misframes every object after it (measured),
  # so NULs reach here as \x01: same size, nothing dropped. A read that still
  # comes up short is a scan error, never a silently shorter tag.
  parse_tags() {
    local LC_ALL=C hdr sha size body nl head line obj ot name tagger
    while IFS= read -r hdr; do
      [[ "$hdr" =~ ^([0-9a-f]+)\ tag\ ([0-9]+)$ ]] ||
        die "scan error: unexpected tag object from git cat-file: $hdr"
      sha=${BASH_REMATCH[1]}; size=${BASH_REMATCH[2]}
      body=""
      if (( size > 0 )); then IFS= read -r -N "$size" body || true; fi
      (( ${#body} == size )) || die "scan error: tag object $sha could not be read whole"
      IFS= read -r nl || true
      [[ -z "$nl" ]] || die "scan error: unexpected tag object framing from git cat-file"
      head=${body%%$'\n\n'*}
      TAG_MSG[$sha]=""
      if [[ "$body" == *$'\n\n'* ]]; then TAG_MSG[$sha]=${body#*$'\n\n'}; fi
      obj=""; ot=""; name=""; tagger=""
      while [[ -n "$head" ]]; do
        line=${head%%$'\n'*}
        if [[ "$head" == *$'\n'* ]]; then head=${head#*$'\n'}; else head=""; fi
        case "$line" in
          "object "*) obj=${line#object } ;;
          "type "*)   ot=${line#type } ;;
          "tag "*)    name=${line#tag } ;;
          "tagger "*) tagger=${line#tagger } ;;
        esac
      done
      [[ -n "$obj" && -n "$ot" ]] || die "scan error: tag object $sha names no object"
      # The ident without its timestamp, as (author) shows a commit's.
      if [[ "$tagger" =~ ^(.*)\ [0-9]+\ [-+][0-9]{4}$ ]]; then tagger=${BASH_REMATCH[1]}; fi
      TAG_OBJ[$sha]=$obj; TAG_OTYPE[$sha]=$ot; TAG_NAME[$sha]=$name; TAG_TAGGER[$sha]=$tagger
    done < "$1"
  }
  queue=()
  declare -A QUEUED=()
  for k in "${!REF_OBJ[@]}"; do
    if [[ "${REF_TYPE[k]}" == tag && -z "${QUEUED[${REF_OBJ[k]}]+x}" ]]; then
      QUEUED[${REF_OBJ[k]}]=1; queue+=("${REF_OBJ[k]}")
    fi
  done
  while [[ ${#queue[@]} -gt 0 ]]; do
    printf '%s\n' "${queue[@]}" > "$TMPD/tagq"
    run_git "cat-file (tags)" "$TMPD/tags0" g cat-file --batch < "$TMPD/tagq"
    LC_ALL=C tr '\000' '\001' < "$TMPD/tags0" > "$TMPD/tags"
    parse_tags "$TMPD/tags"
    next=()
    for t in "${queue[@]}"; do
      o=${TAG_OBJ[$t]}
      if [[ "${TAG_OTYPE[$t]}" == tag && -z "${QUEUED[$o]+x}" ]]; then QUEUED[$o]=1; next+=("$o"); fi
    done
    queue=("${next[@]}")
  done

  HIST_REFS=0
  HIST_TAGS=0
  HIST_TAGGED=0
  declare -A TAG_DONE=()
  for k in "${!REF_OBJ[@]}"; do
    # Peel through any chain of tags to the object the ref ends at.
    o=${REF_OBJ[k]}; t=${REF_TYPE[k]}; chain=()
    while [[ "$t" == tag ]]; do chain+=("$o"); t=${TAG_OTYPE[$o]}; o=${TAG_OBJ[$o]}; done
    if [[ -n "$HIST_RANGE" && "$t" == commit ]]; then
      [[ -n "${IN_RANGE["c$o"]+x}" ]] || continue
    elif [[ -n "$HIST_RANGE" ]]; then
      tip=0
      for x in "${REF_OBJ[k]}" "${chain[@]}" "$o"; do
        [[ -z "${RANGE_TIP["o$x"]+x}" ]] || tip=1
      done
      (( tip )) || continue
    fi
    HIST_REFS=$((HIST_REFS + 1))
    hm_add "${REF_OBJ[k]}" "(ref)" 0 "${REF_NAME[k]}"
    if [[ "$t" != commit ]]; then
      HIST_TAGGED=$((HIST_TAGGED + 1))
      if [[ "$STRICT" -eq 1 ]]; then
        add_hit "unscanned:tagged-$t" "(ref)" 0 "${REF_NAME[k]} (points at a $t; its content is not scanned)" history "$o"
      fi
    fi
    for tg in "${chain[@]}"; do
      [[ -z "${TAG_DONE[$tg]+x}" ]] || continue
      TAG_DONE[$tg]=1
      HIST_TAGS=$((HIST_TAGS + 1))
      hm_add "$tg" "(tag)" 0 "${TAG_NAME[$tg]}"
      hm_add "$tg" "(tagger)" 0 "${TAG_TAGGER[$tg]}"
      rest=${TAG_MSG[$tg]}
      kk=0
      while [[ -n "$rest" ]]; do
        kk=$((kk + 1))
        ml=${rest%%$'\n'*}
        if [[ "$rest" == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
        hm_add "$tg" "(tag message)" "$kk" "$ml"
      done
    done
  done
  exec 9>&-
  pass_patterns "history metadata" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- hm
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history metadata)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hm
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      i=$((l - 1))
      [[ -n "${M_SHA[i]-}" ]] || die "internal error: history metadata pass returned line $l"
      add_hit "$p" "${M_FIELD[i]}" "${M_LINE[i]}" "${M_TEXT[i]}" history "${M_SHA[i]}"
    done < "$TMPD/hhits"
  done

  # A .leakcheckrc.local committed at ANY point published its tells, even if
  # it is gone today: the same rule as for the tree, and for the same reason.
  if [[ "$HIST_COMMITS" -gt 0 ]]; then
    run_git "log (.leakcheckrc.local)" "$TMPD/hlocal" g "${HLOG[@]}" --format=%H \
      -- ':(literal).leakcheckrc.local'
    if [[ -s "$TMPD/hlocal" ]]; then
      IFS= read -r sha < "$TMPD/hlocal"
      add_hit "config:local-in-history" ".leakcheckrc.local" 0 \
        "(a .leakcheckrc.local committed in history publishes the tells it held; remove it from history)" history "$sha"
    fi
  fi
fi

# A committed .leakcheckrc.local publishes the inventory of tells it exists
# to keep out of git. Reported as a finding of its own, in every mode and
# whatever --config says: its patterns need not match their own source text
# (`pattern ^SECRET-[0-9]+$` does not), so "its lines will report it" is not
# a guarantee. Looked up past `skip`, which listed it away: `skip
# .leakcheckrc*` turned this finding into a skipped path, exit 0 (measured).
run_git "ls-files (.leakcheckrc.local)" "$TMPD/lslocal" g ls-files -z -- ':(literal).leakcheckrc.local'
if [[ -s "$TMPD/lslocal" ]]; then
  add_hit "config:local-tracked" ".leakcheckrc.local" 0 \
    "(a committed .leakcheckrc.local publishes the tells it holds; gitignore it)" "index"
fi

# Under --strict, what could not be scanned is itself a finding.
if [[ "$STRICT" -eq 1 ]]; then
  for path in "${BINARY_PATHS[@]}"; do
    add_hit "unscanned:binary" "$path" 0 "(binary file; content not scanned)" "${BINARY["p$path"]}"
  done
  for path in "${GITLINKS[@]}"; do
    add_hit "unscanned:submodule" "$path" 0 "(submodule; contents not scanned)" "index"
  done
fi

# ─── allowlist ────────────────────────────────────────────────────────
# A rule allows a hit in one of two ways, each tested by the same engine as
# the patterns:
#   whole line  it matches all of `path:line:text`, so it names this exact
#               line (`^f\.txt:1:/home/alice/x$`): matching is POSIX
#               leftmost-longest, so such a rule's first -o match is the
#               whole line, and git grep has no -x
#   per match   it matches `path:line:M` for a match M of the hit's own
#               pattern, and every such M on the line is excused by some
#               rule (`/home/USERNAME/`, `\.example\.com`) — a location
#               rule (`^fixtures/`) matches every M there
# A rule that merely matches somewhere on the line allows nothing: matching
# the whole line once let the placeholder in `allow /home/USERNAME/` hide a
# MYHOST hit, and a real /home/alice/, that shared its line (measured,
# v0.6.0) — and a minified file is one line.
# Matches come from `git grep -o`, whose match TEXTS are right but whose
# --column is right only for a line's first match (git 2.53 adds the
# previous match's end instead: measured), so nothing here uses positions.
# Rules are compiled even when there is nothing to allow, so a broken one
# fails on a clean repo too. The lowest-numbered rule that took part takes
# the credit, and every rule's count is reported: an over-broad allow must
# not look identical to a clean repo.
ALLOWED=()
ALLOW_COUNTS=()
declare -A UNSCOPED_HINT=()
for i in "${!H_FILE[@]}"; do ALLOWED[$i]=0; done
for r in "${!ALLOWLIST[@]}"; do ALLOW_COUNTS[$r]=0; done
# lines_of <string>: how many lines a record takes in a subject file (a
# path or text may hold a newline).
lines_of() { local nl=${1//[!$'\n']/}; REPLY=$(( ${#nl} + 1 )); }
# The matches are needed by the allow rules, and by every credential hit,
# which prints them masked and is judged on them by the placeholder check.
NEED_MT=0
if [[ ${#ALLOWLIST[@]} -gt 0 ]]; then NEED_MT=1; fi
for i in "${!H_FILE[@]}"; do
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then NEED_MT=1; break; fi
done
MT_HIT=(); MT_TXT=(); MT_OF=()
if [[ "$NEED_MT" -eq 1 ]]; then
  # Every match of each hit's own pattern, as text. A text the pattern finds
  # no non-empty match in as displayed (an anchored pattern on a
  # `-> target` symlink hit), or that no pattern produced (unscanned:binary
  # and the other pseudo-patterns), counts as one match: the whole text.
  declare -A IS_PAT=() BY_PAT=()
  for p in "${PATTERNS[@]}"; do IS_PAT["l$p"]=1; done
  for i in "${!H_FILE[@]}"; do
    MT_OF[$i]=""
    BY_PAT["l${H_PAT[$i]}"]+="$i "
  done
  for key in "${!BY_PAT[@]}"; do
    [[ -n "${IS_PAT[$key]+x}" ]] || continue
    p=${key#l}
    T_HIT=(); n=0
    exec 6>"$TMPD/subj/t"
    for i in ${BY_PAT[$key]}; do
      printf '%s\n' "${H_TEXT[$i]}" >&6
      lines_of "${H_TEXT[$i]}"
      for (( k = 0; k < REPLY; k++ )); do n=$((n + 1)); T_HIT[n]=$i; done
    done
    exec 6>&-
    pat_args "$p"
    run_git "pattern '$p' (matches)" "$TMPD/tmatch" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column "${RE_ARGS[@]}" -- t
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
      i=${T_HIT[l]:-}
      [[ -n "$i" ]] || die "internal error: match pass returned line $l"
      MT_OF[$i]+="${#MT_HIT[@]} "
      MT_HIT+=("$i"); MT_TXT+=("$m")
    done < "$TMPD/tmatch"
  done
  for i in "${!H_FILE[@]}"; do
    if [[ -z "${MT_OF[$i]}" ]]; then
      MT_OF[$i]="${#MT_HIT[@]} "
      MT_HIT+=("$i"); MT_TXT+=("${H_TEXT[$i]}")
    fi
  done
fi

if [[ ${#ALLOWLIST[@]} -gt 0 ]]; then
  # Subjects: a holds each hit's whole line, m one line per match; each
  # subject line maps back to its hit (or match).
  A_OF=(); A_TXT=(); A_LINES=(); M_OF=()
  na=0; nm=0
  exec 7>"$TMPD/subj/a" 8>"$TMPD/subj/m"
  for i in "${!H_FILE[@]}"; do
    rec="${H_FILE[$i]}:${H_LINE[$i]}:${H_TEXT[$i]}"
    printf '%s\n' "$rec" >&7
    lines_of "$rec"; A_LINES[$i]=$REPLY
    for (( k = 0; k < REPLY; k++ )); do
      na=$((na + 1)); A_OF[na]=$i
      A_TXT[na]=${rec%%$'\n'*}
      rec=${rec#*$'\n'}
    done
  done
  for j in "${!MT_HIT[@]}"; do
    i=${MT_HIT[j]}
    printf '%s\n' "${H_FILE[$i]}:${H_LINE[$i]}:${MT_TXT[j]}" >&8
    lines_of "${H_FILE[$i]}:${H_LINE[$i]}:${MT_TXT[j]}"
    for (( k = 0; k < REPLY; k++ )); do nm=$((nm + 1)); M_OF[nm]=$j; done
  done
  exec 7>&- 8>&-

  # A rule excuses only the hits in its scope: an unscoped rule never a
  # credential hit, a scoped one only its own rule's (`*`: any credential
  # rule's). A location rule (`^fixtures/`) written for home paths would
  # otherwise hide a real key beside them, clean and exit 0 (measured,
  # v0.10.4). Where an unscoped rule matched a credential hit it may not
  # excuse, U_WHOLE / U_EXC record it, for one line saying how to scope it.
  allow_applies() { # rule hit
    local sc=${ALLOW_SCOPE[$1]} p=${H_PAT[$2]}
    if [[ -z "${CRED_RE["l$p"]+x}" ]]; then
      [[ -z "$sc" ]]
    else
      [[ "$sc" == '*' || "credential:$sc" == "$p" ]]
    fi
  }
  WHOLE=(); EXC=(); U_WHOLE=(); U_EXC=()
  for i in "${!H_FILE[@]}"; do WHOLE[$i]=""; U_WHOLE[$i]=""; done
  for j in "${!MT_HIT[@]}"; do EXC[$j]=""; U_EXC[$j]=""; done
  for r in "${!ALLOWLIST[@]}"; do
    rule=${ALLOWLIST[$r]}
    re_args "$rule"
    # Whole line: every line of the record matched entirely.
    run_git "allow '$rule'" "$TMPD/awhole" \
      git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column "${RE_ARGS[@]}" -- a
    declare -A WCOUNT=() WSEEN=()
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      i=${A_OF[l]:-}
      [[ -n "$i" ]] || die "internal error: allow pass returned line $l"
      [[ "$t" == "${A_TXT[l]}" && -z "${WSEEN[$l]+x}" ]] || continue
      WSEEN[$l]=1
      WCOUNT[$i]=$(( ${WCOUNT[$i]:-0} + 1 ))
    done < "$TMPD/awhole"
    for i in "${!WCOUNT[@]}"; do
      [[ ${WCOUNT[$i]} -eq ${A_LINES[$i]} ]] || continue
      if allow_applies "$r" "$i"; then
        [[ -n "${WHOLE[$i]}" ]] || WHOLE[$i]=$r
      elif [[ -z "${ALLOW_SCOPE[r]}" ]]; then
        U_WHOLE[$i]=1
      fi
    done
    unset WCOUNT WSEEN
    run_git "allow '$rule'" "$TMPD/amatch" \
      git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- m
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      j=${M_OF[l]:-}
      [[ -n "$j" ]] || die "internal error: allow pass returned line $l"
      if allow_applies "$r" "${MT_HIT[j]}"; then
        [[ -n "${EXC[$j]}" ]] || EXC[$j]=$r
      elif [[ -z "${ALLOW_SCOPE[r]}" ]]; then
        U_EXC[$j]=1
      fi
    done < "$TMPD/amatch"
  done

  for i in "${!H_FILE[@]}"; do
    credit=none
    for j in ${MT_OF[$i]}; do
      if [[ -z "${EXC[$j]}" ]]; then credit=""; break; fi
      if [[ "$credit" == none || ${EXC[$j]} -lt $credit ]]; then credit=${EXC[$j]}; fi
    done
    [[ "$credit" != none ]] || credit=""
    r=${WHOLE[$i]}
    if [[ -n "$r" ]] && [[ -z "$credit" || $r -lt $credit ]]; then credit=$r; fi
    if [[ -n "$credit" ]]; then
      ALLOWED[$i]=1
      ALLOW_COUNTS[$credit]=$(( ALLOW_COUNTS[credit] + 1 ))
    elif [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then
      # Would an unscoped rule have excused it, every match or the line?
      u=1
      for j in ${MT_OF[$i]}; do
        if [[ -z "${EXC[$j]}${U_EXC[$j]}" ]]; then u=0; break; fi
      done
      if [[ "$u" -eq 1 || -n "${U_WHOLE[$i]}" ]]; then UNSCOPED_HINT[$i]=1; fi
    fi
  done
fi

# ─── credentials ──────────────────────────────────────────────────────
# A credential hit prints its matches masked, never its line: the line may
# hold a second secret no rule knows. A credential the name passes found in a
# path, a ref name or a tag name is masked wherever that name is printed — in
# every hit's path, and in a hit whose text is the name — since it would
# otherwise ride along in the location of every hit in that file.
# A hit whose every match is a stand-in (is_placeholder) is not reported, and
# is counted. Each test is something a random secret all but never does — 8
# equal characters in a row, or 8 letters or digits counting up, is under one
# in a million even for a 64-character hex key — and that docs and fixtures
# do all the time: an X-filled key, an alphabet run, AWS's documented key
# ending in EXAMPLE. A run of `A` does not count: it is base64 for zero bytes,
# and a format holding zero-filled fields has one in every real key —
# OpenSSH's unencrypted private key (measured: nine As in its first 64
# characters), and by its msgpack layout Fly.io's macaroon token.
# A private-key header is never a placeholder: the body after it is base64
# of a structured format, and the rule's key-after-the-header requirement is
# what tells a fixture from a key.
is_placeholder() { # match
  local LC_ALL=C m=$1 i c o prev=-2 same=0 up=0
  if [[ "$m" == *EXAMPLE* || "$m" == *example* ]]; then return 0; fi
  for (( i = 0; i < ${#m}; i++ )); do
    c=${m:i:1}
    printf -v o '%d' "'$c"
    if (( o == prev )) && [[ "$c" != A ]]; then same=$((same + 1)); else same=1; fi
    if (( o == prev + 1 )) && [[ "$c" == [A-Za-z0-9] && "${m:i-1:1}" == [A-Za-z0-9] ]]; then
      up=$((up + 1))
    else
      up=1
    fi
    if (( same >= 8 || up >= 8 )); then return 0; fi
    prev=$o
  done
  return 1
}
# cred_show <label> <match>: a header as found; anything else as its first
# four characters and its length.
cred_show() {
  local h
  if [[ "$2" == -----BEGIN* ]]; then
    h=${2#-----}
    REPLY="-----${h%%-----*}-----"
  elif [[ -n "${CRED_MARKER["l$1"]+x}" ]]; then
    REPLY=$2
  else
    REPLY="${2:0:4}[redacted, ${#2} chars]"
  fi
}

# A name hit: its text is the name itself — a path (line 0, text = the
# path), a ref name or a tag name; an --strict hit on a ref leads with it.
is_name_hit() { # hit
  [[ "${H_LINE[$1]}" == 0 ]] || return 1
  [[ "${H_FILE[$1]}" == "${H_TEXT[$1]}" || "${H_FILE[$1]}" == "(ref)" || "${H_FILE[$1]}" == "(tag)" ]]
}
# Every built-in rule over FILEs in $TMPD/subj, whatever this config runs:
# `disable` and `no-credentials` choose which hits to look for, never which
# keys may print. One rule per -o grep, since git resumes after a match and
# with every rule in one grep a key swallowed the start of the key after it
# (/qaa, v0.11.5); one grep with them all first says whether any is needed.
# OUT gets <id>\0<file>\0<line>\0<match>\n per match.
cred_matches_all() { # out label file...
  local out=$1 label=$2 k f l m
  shift 2
  local -a cre=()
  for (( k = 1; k < ${#CREDENTIALS[@]}; k += 2 )); do cre+=(-e "${CREDENTIALS[k]}"); done
  : > "$out"
  run_git "credential rules ($label)" "$TMPD/cmatch" \
    in_c git -C "$TMPD/subj" grep --no-index -a -l -E "${cre[@]}" -- "$@"
  [[ -s "$TMPD/cmatch" ]] || return 0
  for (( k = 0; k < ${#CREDENTIALS[@]}; k += 2 )); do
    run_git "credential rule ${CREDENTIALS[k]} ($label)" "$TMPD/cmatch" \
      in_c git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column -E -e "${CREDENTIALS[k + 1]}" -- "$@"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
      printf '%s\0%s\0%s\0%s\n' "${CREDENTIALS[k]}" "$f" "$l" "$m"
    done < "$TMPD/cmatch" >> "$out"
  done
}

# Credentials in names, from the name hits; mask_names <string> -> REPLY.
NAME_TOKS=()
declare -A NAME_TOK_SEEN=()
for i in "${!H_FILE[@]}"; do
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]] && is_name_hit "$i"; then
    for j in ${MT_OF[$i]}; do
      [[ -z "${NAME_TOK_SEEN["t${MT_TXT[j]}"]+x}" ]] || continue
      NAME_TOK_SEEN["t${MT_TXT[j]}"]=1
      NAME_TOKS+=("${MT_TXT[j]}")
    done
  fi
done
# And from every name that prints, by every built-in rule: a disabled rule's
# key printed whole in its file's path (/qaa, v0.11.5).
if [[ ${#H_FILE[@]} -gt 0 ]]; then
  NAMES=()
  for i in "${!H_FILE[@]}"; do
    NAMES+=("${H_FILE[$i]}")
    if is_name_hit "$i"; then NAMES+=("${H_TEXT[$i]}"); fi
  done
  printf '%s\n' "${NAMES[@]}" > "$TMPD/subj/names"
  cred_matches_all "$TMPD/nmatch" "names" names
  while IFS= read -r -d '' _ && IFS= read -r -d '' _ && IFS= read -r -d '' _ && IFS= read -r tok; do
    [[ -z "${NAME_TOK_SEEN["t$tok"]+x}" ]] || continue
    NAME_TOK_SEEN["t$tok"]=1
    NAME_TOKS+=("$tok")
  done < "$TMPD/nmatch"
fi
# TEXT with each run of hidden bytes shown as its first four and its length,
# a hit's mask; HIDE names an associative array keyed PREFIX<byte offset>.
render_masked() { # text hide-array prefix -> REPLY
  local LC_ALL=C t=$1 pre=$3 k run=-1
  local -n rm_hide=$2
  REPLY=""
  for (( k = 0; k <= ${#t}; k++ )); do
    if [[ $k -lt ${#t} && -n "${rm_hide[$pre$k]+x}" ]]; then
      if [[ $run -lt 0 ]]; then run=$k; fi
      continue
    fi
    if [[ $run -ge 0 ]]; then
      REPLY+="${t:run:4}[redacted, $(( k - run )) chars]"; run=-1
    fi
    if [[ $k -lt ${#t} ]]; then REPLY+=${t:k:1}; fi
  done
}
# Every occurrence of every token marks its bytes, and each run prints once:
# replacing tokens one after another let a shorter match over a longer one's
# bytes break it, and the longer one's tail printed (Codex, v0.11.6).
mask_names() {
  REPLY=$1
  [[ ${#NAME_TOKS[@]} -gt 0 ]] || return 0
  local LC_ALL=C s=$1 tok o p k
  local -A nhide=()
  for tok in "${NAME_TOKS[@]}"; do
    [[ -n "$tok" ]] || continue
    o=0
    while [[ "${s:o}" == *"$tok"* ]]; do
      p=${s:o}; p=${p%%"$tok"*}; o=$(( o + ${#p} ))
      for (( k = o; k < o + ${#tok}; k++ )); do nhide[$k]=1; done
      o=$(( o + 1 ))
    done
  done
  [[ ${#nhide[@]} -gt 0 ]] || return 0
  render_masked "$s" nhide ""
}

KEEP=()
SHOW=()
SHOW_FILE=()
ALLOWED_TOTAL=0
CRED_FOUND=0
CRED_UNSCOPED=0
CRED_PLACEHOLDERS=0
for i in "${!H_FILE[@]}"; do
  if [[ "${ALLOWED[$i]}" -eq 1 ]]; then
    ALLOWED_TOTAL=$((ALLOWED_TOTAL + 1))
    continue
  fi
  SHOW[$i]=${H_TEXT[$i]}
  mask_names "${H_FILE[$i]}"; SHOW_FILE[$i]=$REPLY
  if is_name_hit "$i"; then
    mask_names "${H_TEXT[$i]}"; SHOW[$i]=$REPLY
  fi
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then
    ph=1
    [[ -z "${CRED_MARKER["l${H_PAT[$i]}"]+x}" ]] || ph=0
    SHOW[$i]=""
    for j in ${MT_OF[$i]}; do
      is_placeholder "${MT_TXT[j]}" || ph=0
      cred_show "${H_PAT[$i]}" "${MT_TXT[j]}"
      SHOW[$i]+="${SHOW[$i]:+ }$REPLY"
    done
    if [[ "$ph" -eq 1 ]]; then
      CRED_PLACEHOLDERS=$((CRED_PLACEHOLDERS + 1))
      continue
    fi
    CRED_FOUND=$((CRED_FOUND + 1))
    if [[ -n "${UNSCOPED_HINT[$i]+x}" ]]; then CRED_UNSCOPED=$((CRED_UNSCOPED + 1)); fi
  fi
  KEEP+=("$i")
done
HIT_COUNT=${#KEEP[@]}

if [[ "$HISTORY" -eq 1 ]]; then
  HRANGE=""
  if [[ -n "$HIST_RANGE" ]]; then HRANGE=" in range $HIST_RANGE only"; fi
  HSCOPE="history scanned: $HIST_COMMITS commits$HRANGE, $HIST_BINARY binary files skipped, $HIST_SKIPPED skipped by config, ${#CFG_EXEMPT[@]} current-config lines exempt, $HIST_REFS refs, $HIST_TAGS annotated tags, $HIST_TAGGED tagged trees or blobs not scanned"
else
  HSCOPE="history not scanned"
fi
if [[ "$CRED_RULES" -gt 0 ]]; then
  CSCOPE="credentials scanned, $CRED_PLACEHOLDERS placeholders not reported"
  # A disabled rule is a scope reduction, so it is counted where the scope is
  # printed; a config that disables none prints what it always did.
  if [[ ${#CRED_DISABLED[@]} -gt 0 ]]; then
    CSCOPE+=", ${#CRED_DISABLED[@]} credential rules disabled by config"
  fi
else
  CSCOPE="credentials not scanned"
  # Every rule turned off one by one is not `no-credentials`: the config said
  # which rules, so they are still counted (Codex, v0.11.3).
  if [[ "$USE_CREDENTIALS" -eq 1 && ${#CRED_DISABLED[@]} -gt 0 ]]; then
    CSCOPE+=", ${#CRED_DISABLED[@]} credential rules disabled by config"
  fi
fi
SCOPE="index + worktree; $BINARY_COUNT binary skipped, ${#GITLINKS[@]} submodules not scanned, $SKIPPED_COUNT skipped by config, $ALLOWED_TOTAL allowed; $HSCOPE; $CSCOPE"

# An allow rule may name a credential outright — the README's way to excuse
# a stand-in — and the JSON report prints every rule: each credential in one
# that is not a placeholder is masked there, like a hit's.
ALLOW_SHOW=("${ALLOW_TEXT[@]}")
# Masked by EVERY built-in rule, whatever this config runs: `disable` and
# `no-credentials` say which hits to look for, not which keys may be printed,
# and an allow rule naming a disabled rule's key printed it raw (/qaa, v0.11.2).
# A rule is a regex, so a careful writer escapes a key's punctuation, and
# `SG\.<body>\.<body>` matches no credential rule as written: the rules also
# run over a literal form, and what they find there masks the bytes of the
# rule it came from (literal_form's map). The as-written scan stays for what
# the literal form loses — a backslash a rule's class accepts — and both
# scans mark bytes of the one text, so neither can unmask the other's key:
# v0.11.4 showed the literal form instead, and a key only the as-written
# scan found was no longer there to mask (/cxr, v0.11.4).
if [[ "$OUTPUT_MODE" == "json" && ${#ALLOWLIST[@]} -gt 0 ]]; then
  # The literal form of a rule, for the key scan only, never printed: a `\`
  # before punctuation dropped, a one-character bracket such as `[.]`
  # unwrapped, and parentheses dropped, so `SG\.(<body>)\.(<body>)` reads as
  # the key it matches (/cxr, v0.11.4). LIT_MAP[i] is the offset in the rule
  # of the literal form's i-th byte. An alternation, a quantifier or a wider
  # bracket has no literal form; the README says so.
  literal_form() {
    local LC_ALL=C s=$1 i=0 c d
    LIT=""; LIT_MAP=()
    while (( i < ${#s} )); do
      c=${s:i:1}; d=${s:i+1:1}
      if [[ "$c" == '\' && -n "$d" && "$d" != [A-Za-z0-9] ]]; then
        LIT+=$d; LIT_MAP+=("$(( i + 1 ))"); i=$(( i + 2 ))
      elif [[ "$c" == '[' && -n "$d" && "${s:i+2:1}" == ']' && "$d" != ']' && "$d" != '^' && "$d" != '\' && "$d" != '[' ]]; then
        LIT+=$d; LIT_MAP+=("$(( i + 1 ))"); i=$(( i + 3 ))
      elif [[ "$c" == '(' || "$c" == ')' ]]; then
        i=$(( i + 1 ))
      else
        LIT+=$c; LIT_MAP+=("$i"); i=$(( i + 1 ))
      fi
    done
  }
  mask_allow_rules() {
    local LC_ALL=C r f l m t o s e k n cid marker
    local -a lit=() maps=() map=()
    local -A hide=() touched=()
    for r in "${!ALLOW_TEXT[@]}"; do
      literal_form "${ALLOW_TEXT[r]}"
      lit+=("$LIT"); maps+=("${LIT_MAP[*]}")
    done
    printf '%s\n' "${ALLOW_TEXT[@]}" > "$TMPD/subj/allow-rules"
    printf '%s\n' "${lit[@]}" > "$TMPD/subj/allow-literal"
    cred_matches_all "$TMPD/rmatch" "allow rules" allow-rules allow-literal
    while IFS= read -r -d '' cid && IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
      [[ "$l" =~ ^[0-9]+$ && -n "${ALLOW_TEXT[l - 1]+x}" ]] || die "internal error: allow-rule mask returned line $l"
      # A private-key header is never a placeholder, as for a hit, and the key
      # after it runs to the end of the rule, not the 64 characters the rule
      # reads: a one-line key printed whole after its header (/qaa, v0.11.5).
      marker=0
      if [[ -n "${CRED_MARKER["lcredential:$cid"]+x}" ]]; then
        marker=1
      elif is_placeholder "$m"; then
        continue
      fi
      r=$(( l - 1 ))
      case "$f" in
        allow-rules) t=${ALLOW_TEXT[r]}; map=() ;;
        allow-literal) t=${lit[r]}; read -r -a map <<< "${maps[r]}" ;;
        *) die "internal error: allow-rule mask returned file $f" ;;
      esac
      # Every occurrence, overlapping ones included; a key the scan found and
      # this cannot place must not print, so that is a scan error.
      o=0; n=0
      while [[ "${t:o}" == *"$m"* ]]; do
        s=${t:o}; s=${s%%"$m"*}; o=$(( o + ${#s} )); e=$(( o + ${#m} - 1 ))
        if [[ "$f" == allow-literal ]]; then s=${map[o]}; e=${map[e]}; else s=$o; fi
        if [[ $marker -eq 1 ]]; then e=$(( ${#ALLOW_TEXT[r]} - 1 )); fi
        for (( k = s; k <= e; k++ )); do hide[$r:$k]=1; done
        touched[$r]=1; o=$(( o + 1 )); n=$(( n + 1 ))
      done
      (( n > 0 )) || die "internal error: allow-rule mask could not place a match in rule $l"
    done < "$TMPD/rmatch"
    # Runs from two scans that touch are one run.
    for r in "${!touched[@]}"; do
      render_masked "${ALLOW_TEXT[r]}" hide "$r:"
      ALLOW_SHOW[r]=$REPLY
    done
  }
  mask_allow_rules
fi

# ─── output ───────────────────────────────────────────────────────────
if [[ "$OUTPUT_MODE" == "json" ]]; then
  # One well-formed UTF-8 sequence, as bytes (matched under LC_ALL=C).
  UTF8_SEQ=$'([\x01-\x7f]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])'
  # JSON must be UTF-8, and neither a path nor a line has to be (a legacy
  # filename, a Latin-1 file): one such byte made the whole envelope
  # unparseable. Well-formed input passes through on one regex test; in
  # anything else each stray byte becomes U+FFFD.
  utf8_clean() {
    local LC_ALL=C s="$1" out=""
    if [[ "$s" =~ ^${UTF8_SEQ}*$ ]]; then
      printf '%s' "$s"
      return 0
    fi
    while [[ -n "$s" ]]; do
      if [[ "$s" =~ ^$UTF8_SEQ ]]; then
        out+="${BASH_REMATCH[0]}"
        s="${s:${#BASH_REMATCH[0]}}"
      else
        out+='�'
        s="${s:1}"
      fi
    done
    printf '%s' "$out"
  }
  # Pure-bash escaping for portability.
  json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    # Strip remaining control chars (<0x20) — rare in tracked source.
    s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037')
    utf8_clean "$s"
  }
  # version, clean, count and hits stay first and unchanged; new fields
  # only ever append.
  printf '{"version":"%s","clean":%s,"count":%d,"hits":[' \
    "$VERSION" \
    "$([[ "$HIT_COUNT" -eq 0 ]] && echo true || echo false)" \
    "$HIT_COUNT"
  first=1
  for i in "${KEEP[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '{"file":"%s","line":%s,"pattern":"%s","text":"%s","source":"%s"' \
      "$(json_escape "${SHOW_FILE[$i]}")" "${H_LINE[$i]}" "$(json_escape "${H_PAT[$i]}")" \
      "$(json_escape "${SHOW[$i]}")" "${H_SRC[$i]}"
    # Only history hits carry a commit; every other hit keeps its v0.3.0 shape.
    if [[ -n "${H_COMMIT[$i]}" ]]; then printf ',"commit":"%s"' "${H_COMMIT[$i]}"; fi
    printf '}'
  done
  printf '],"target":"index+worktree","tracked":%d,"skipped":{"binary":%d,"submodule":%d,"config":%d},"symlinks":%d,"allowed":[' \
    "$TRACKED_COUNT" "$BINARY_COUNT" "${#GITLINKS[@]}" "$SKIPPED_COUNT" "${#LINK_PATHS[@]}"
  first=1
  for r in "${!ALLOWLIST[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '{"rule":"%s","count":%d}' "$(json_escape "${ALLOW_SHOW[$r]}")" "${ALLOW_COUNTS[$r]}"
  done
  if [[ "$HISTORY" -eq 1 ]]; then
    hr=null
    if [[ -n "$HIST_RANGE" ]]; then hr="\"$(json_escape "$HIST_RANGE")\""; fi
    printf '],"history_scanned":true,"history":{"commits":%d,"binary":%d,"skipped":%d,"config_lines_exempt":%d,"range":%s,"refs":%d,"tags":%d,"tagged_unscanned":%d}' \
      "$HIST_COMMITS" "$HIST_BINARY" "$HIST_SKIPPED" "${#CFG_EXEMPT[@]}" "$hr" "$HIST_REFS" "$HIST_TAGS" "$HIST_TAGGED"
  else
    printf '],"history_scanned":false'
  fi
  if [[ "$CRED_RULES" -gt 0 || ( "$USE_CREDENTIALS" -eq 1 && ${#CRED_DISABLED[@]} -gt 0 ) ]]; then
    if [[ "$CRED_RULES" -gt 0 ]]; then printf ',"credentials_scanned":true'; else printf ',"credentials_scanned":false'; fi
    printf ',"credentials":{"rules":%d,"placeholders":%d' "$CRED_RULES" "$CRED_PLACEHOLDERS"
    if [[ ${#CRED_DISABLED[@]} -gt 0 ]]; then
      printf ',"disabled":['
      for k in "${!CRED_DISABLED[@]}"; do
        [[ "$k" -eq 0 ]] || printf ','
        printf '"%s"' "${CRED_DISABLED[$k]}"
      done
      printf ']'
    fi
    printf '}}\n'
  else
    printf ',"credentials_scanned":false}\n'
  fi
else
  # One hit, one line. A field holding a newline — only a path name or a
  # symlink target can — is C-quoted the way git quotes such paths; every
  # other field prints byte-for-byte, so the common case is unchanged.
  line_safe() {
    local s="$1"
    case "$s" in
      *$'\n'*)
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/\\r}"
        s="${s//$'\t'/\\t}"
        printf '"%s"' "$s"
        ;;
      *) printf '%s' "$s" ;;
    esac
  }
  if [[ "$HIT_COUNT" -eq 0 ]]; then
    echo "leakcheck: clean — 0 matches across $TRACKED_COUNT tracked files ($SCOPE)"
  else
    for i in "${KEEP[@]}"; do
      # A history hit leads with its commit: <sha>:path:line: [pattern] text.
      if [[ -n "${H_COMMIT[$i]}" ]]; then printf '%s:' "${H_COMMIT[$i]}"; fi
      printf '%s:%s: [%s] %s\n' "$(line_safe "${SHOW_FILE[$i]}")" "${H_LINE[$i]}" \
        "${H_PAT[$i]}" "$(line_safe "${SHOW[$i]}")"
    done
    echo "leakcheck: $HIT_COUNT match(es)" >&2
    echo "leakcheck: scanned $TRACKED_COUNT tracked files ($SCOPE)" >&2
    if [[ "$CRED_FOUND" -gt 0 ]]; then
      echo "leakcheck: $CRED_FOUND credential(s) among these: revoke and reissue any that has left this machine; deleting one from the files or the history does not revoke it" >&2
    fi
    if [[ "$CRED_UNSCOPED" -gt 0 ]]; then
      echo "leakcheck: $CRED_UNSCOPED of them matched an allow rule that names no credential rule, which never excuses a credential; to excuse one, write allow credential:<id> <regex>" >&2
    fi
  fi
fi

if [[ "$HIT_COUNT" -gt 0 ]]; then
  EXIT_HITS=1
  exit 1
fi
exit 0
