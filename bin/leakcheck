#!/usr/bin/env bash
# leakcheck — scan a repo's tracked files for workspace-internal references
# (host paths, internal names) and credentials before the repo goes public.
#
# Scans the whole repo from its top level, wherever it is run: the index
# (what the next commit publishes) AND the worktree copy of every tracked
# file, plus every tracked path name and symlink target. Reads default
# patterns + the optional .leakcheckrc and .leakcheckrc.local at the repo
# top level (keep the .local one gitignored); --config replaces both.
# Built-in credential rules find keys and tokens in formats their issuers
# fixed (cloud, AI and git-host keys, webhooks, private key headers); a
# credential hit is labelled credential:<id> and printed masked.
#
# Usage:
#   leakcheck                    # scan with defaults + .leakcheckrc(.local)
#   leakcheck --strict           # also report every file whose content was
#                                # not scanned (binary, submodule) as a match
#   leakcheck --history          # also scan every commit reachable from any
#                                # ref: added lines, path names, author,
#                                # committer and message; every ref name and
#                                # annotated tag (needs full history)
#   leakcheck --history-range RANGE
#                                # --history over the commits in one git
#                                # revision range only (origin/main..HEAD)
#   leakcheck --json             # machine-readable output
#   leakcheck --list-patterns    # print the effective pattern set
#   leakcheck --list-rules       # print each credential rule's label, on/off
#   leakcheck -c, --config FILE  # config path, relative to the cwd (after --root)
#   leakcheck -C, --root DIR     # run as if started in DIR
#   leakcheck -V, --version
#   leakcheck -h, --help
#
# Config file (.leakcheckrc) is line-oriented:
#   pattern <regex>          # add an ERE to the scan set; a leading (?i)
#                            # makes it (or an allow rule) ignore case
#   allow   <regex>          # allowlist hits: an ERE matching all of
#                            # path:line:text, or path:line:<match> for
#                            # every match of the hit's own pattern there;
#                            # never excuses a credential hit
#   allow credential:<id> <regex>
#                            # the same, for that credential rule's hits
#                            # only (credential:* for every credential rule)
#   skip    <glob>           # skip paths matching glob (git pathspec, top-relative)
#   disable credential:<id>  # turn one built-in credential rule off (counted)
#   no-defaults              # disable the built-in home-path patterns
#   no-credentials           # disable the built-in credential rules
#
# Blank lines and lines starting with '#' are ignored. Name and symlink hits
# report line 0.
#
# Git history and commit metadata are scanned only with --history or
# --history-range. Never scanned: submodule contents, encoded or compressed
# content. Binary files are skipped and counted.
#
# Exit codes (treat ANY non-zero as "do not publish"):
#   0  clean
#   1  one or more matches
#   2  usage, config or scan error

# SPDX-FileCopyrightText: 2026 KeMeK Network
# SPDX-License-Identifier: MIT
# Credential rules derived from gitleaks: notice after the CREDENTIALS table.

# Older bash dies at its first empty-array expansion under `set -u` with exit
# 1, "matches found", having printed nothing (measured on bash 3.2, macOS's
# /bin/bash). Refuse it before anything else runs.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "leakcheck: needs bash 4.4 or newer (this is bash ${BASH_VERSION:-unknown})" >&2
  exit 2
fi

set -eEuo pipefail
# An unexpected failure must never surface as exit 1, which means "matches
# found" — map every abort onto the error code.
trap 'echo "leakcheck: internal error at line $LINENO; nothing was reported" >&2; exit 2' ERR
# The ERR trap does not see a `set -u` abort (an unbound variable): bash exits
# 1 without running it (measured, bash 5.3). So the one deliberate exit 1 sets
# EXIT_HITS first, and every other exit 1 is mapped onto 2 here.
EXIT_HITS=""
TMPD=""
on_exit() {
  local rc=$?
  if [[ -n "$TMPD" ]]; then rm -rf -- "$TMPD"; fi
  if [[ $rc -eq 1 && -z "$EXIT_HITS" ]]; then
    echo "leakcheck: internal error (aborted); nothing was reported" >&2
    rc=2
  fi
  exit "$rc"
}
trap on_exit EXIT

VERSION="0.11.7"

OUTPUT_MODE="text"
STRICT=0
HISTORY=0
HIST_RANGE=""
LIST_ONLY=0
CONFIG_FILE=""
ROOT=""

die() { echo "leakcheck: $*" >&2; exit 2; }

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//; s/^#$//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)            OUTPUT_MODE="json"; shift ;;
    --strict)          STRICT=1; shift ;;
    --history)         HISTORY=1; shift ;;
    --history-range)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      # One range, never last-wins: a second value silently replacing the
      # first changes what was scanned without saying so.
      [[ -z "$HIST_RANGE" ]] || die "--history-range given twice; pass one revision range"
      HIST_RANGE="$2"; HISTORY=1; shift 2 ;;
    --list-patterns)   LIST_ONLY=1; shift ;;
    --list-rules)      LIST_ONLY=2; shift ;;
    -c|--config|-C|--root)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      case "$1" in
        -c|--config) CONFIG_FILE="$2" ;;
        *)           ROOT="$2" ;;
      esac
      shift 2 ;;
    -V|--version)      echo "leakcheck $VERSION"; exit 0 ;;
    -h|--help)         usage 0 ;;
    --)                shift; break ;;
    -*)                echo "leakcheck: unknown flag: $1" >&2; usage 2 >&2 ;;
    *)                 echo "leakcheck: unexpected arg: $1" >&2; usage 2 >&2 ;;
  esac
done

# The range reaches git as a revision argument, so an option-shaped value
# (`--all`, `--since=…`, `--first-parent`) would change what the walk means
# instead of naming commits.
case "$HIST_RANGE" in
  -*) die "--history-range takes a revision range, not an option: $HIST_RANGE" ;;
esac

if [[ -n "$ROOT" ]]; then
  cd -- "$ROOT" 2>/dev/null || die "cannot cd to $ROOT"
fi

# An explicit --config resolves against the cwd as it stands now: after
# --root ("run as if started in DIR", as `git -C` means it) and before the
# move to the top level below, so a relative path typed in a subdirectory
# still means what it says. A named config that is missing is an error —
# proceeding on defaults alone is a confident clean pass over a repo that
# nothing the caller asked for actually checked.
CONFIG_ABS=""
if [[ -n "$CONFIG_FILE" ]]; then
  [[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE"
  [[ -r "$CONFIG_FILE" ]] || die "config not readable: $CONFIG_FILE"
  cfg_dir="$(cd -- "$(dirname -- "$CONFIG_FILE")" && pwd -P)" \
    || die "cannot resolve config path: $CONFIG_FILE"
  CONFIG_ABS="$cfg_dir/$(basename -- "$CONFIG_FILE")"
fi

# Always scan from the top level. `git ls-files` and `git grep` are
# cwd-relative, so a run from a subdirectory used to scan that subtree,
# miss the root .leakcheckrc, and report clean with a plausible count.
top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git work tree"
[[ -n "$top" ]] || die "not inside a git work tree"
cd -- "$top" || die "cannot cd to $top"
top="$(pwd -P)"

# Config files, read in order. An explicit --config is the whole config.
# Without one: .leakcheckrc, then .leakcheckrc.local — the gitignored home
# for the tells you would rather not commit, since a committed config is an
# inventory of exactly what you are hiding. Either may be absent; one that
# exists but is not a readable regular file (a dangling symlink, a
# directory) is a config that cannot be read, not "no config".
CONFIG_FILES=()
CONFIG_NAMES=()
if [[ -n "$CONFIG_ABS" ]]; then
  CONFIG_FILES=("$CONFIG_ABS")
  CONFIG_NAMES=("$CONFIG_FILE")
else
  for name in .leakcheckrc .leakcheckrc.local; do
    if [[ -f "$top/$name" ]]; then
      [[ -r "$top/$name" ]] || die "config not readable: $top/$name"
      CONFIG_FILES+=("$top/$name")
      CONFIG_NAMES+=("$name")
    elif [[ -e "$top/$name" || -L "$top/$name" ]]; then
      die "config is not a regular file: $top/$name"
    fi
  done
  # Only the committable .leakcheckrc has its content exempt from the scan.
  # A TRACKED .leakcheckrc.local is the inventory published: its own
  # pattern lines are left to report it.
  if [[ -f "$top/.leakcheckrc" ]]; then CONFIG_ABS="$top/.leakcheckrc"; fi
fi

# Default patterns. Only the universally-bad shapes — absolute home paths
# with a username, on each major OS. Tilde-prefixed paths (`~/...`,
# `$HOME/...`) are intentionally NOT in the defaults: they're shape-only,
# not leaks — Claude Code docs and tooling reference them as generic
# locations. Per-repo `.leakcheckrc` adds workspace tells (hostnames,
# internal project names, custom tilde paths if a project considers them
# leaky).
#
# The first three are the canonical forms; the rest catch the same paths as
# serialized or spelled differently. Every default is DISJOINT from every
# other by construction: git grep reports one hit per (line, pattern), so an
# overlapping default would double-count every hit the canonical ones find.
# Each later default was measured against a corpus of private repos before
# promotion, with no false positives. A username needs an ASCII letter,
# digit or underscore somewhere, so the elided `/home/.../` and `/home/…/`
# placeholders stay clean, in every locale. NOT a default, by measurement:
# `/home/<user>` with no trailing slash — `src/home/` trees and route
# literals like "/home/feed" are false positives; the README offers it as an
# opt-in recipe.
DEFAULTS=(
  '/home/[A-Za-z0-9_][A-Za-z0-9_.-]*/'
  '/Users/[A-Za-z0-9_][A-Za-z0-9_.-]*/'
  'C:\\Users\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\'
  # JSON-escaped slashes: {"path":"\/home\/<user>\/x"}; the only default for
  # them, so its username takes the non-ASCII form too
  '\\/(home|Users)\\/([A-Za-z0-9_]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*\\/'
  # JSON-escaped backslashes, any drive, any case: "C:\\Users\\<user>\\"
  '[A-Za-z]:\\\\[Uu][Ss][Ee][Rr][Ss]\\\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\\\'
  # Single backslashes, any spelling except the canonical C:\Users\ above
  '([A-BD-Za-z]:\\[Uu][Ss][Ee][Rr][Ss]|C:\\(u[Ss][Ee][Rr][Ss]|U(S[Ee][Rr][Ss]|s(E[Rr][Ss]|e(R[Ss]|rS)))))\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\'
  # Usernames holding a non-ASCII character (zoë, José); [^ -~] is "not
  # printable ASCII", and the defaults run in the C locale (pat_args), where
  # it meets every byte of any encoding
  '/(home|Users)/([A-Za-z0-9_][A-Za-z0-9_.-]*[^ -~]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*/'
  '[A-Za-z]:(\\\\|\\)[Uu][Ss][Ee][Rr][Ss](\\\\|\\)([A-Za-z0-9_][A-Za-z0-9_.-]*[^ -~]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*(\\\\|\\)'
)

# SPDX-SnippetBegin
# SPDX-SnippetCopyrightText: 2019 Zachary Rice
# SPDX-SnippetCopyrightText: 2026 KeMeK Network
# SPDX-License-Identifier: MIT
# A row ending `# gitleaks: <id>` is derived from that rule (or rules) in
# gitleaks' default configuration (config/gitleaks.toml, v8.30.1;
# https://github.com/gitleaks/gitleaks): its prefix and shape, re-spelled as
# POSIX ERE and in places widened or narrowed. A row with no such note has
# no gitleaks counterpart. gitleaks' license notice follows the table.
# Credential rules, on by default (`no-credentials` turns them off): each
# names one format by a prefix or shape the issuer fixed, so a match is a
# credential, or a stand-in written to look like one. Formats with no such
# anchor (an AWS secret key, a password, `token = <anything>`) are not here:
# telling them from ordinary text needs a keyword, the value and its entropy,
# which one ERE per rule cannot weigh. A hit is labelled `credential:<id>`
# and printed masked; allow rules and the placeholder check see the real
# text. No `\b`: git's ERE is the system regex, and one that reads `\b` as a
# plain `b` would make a rule match nothing, silently. Every `/` a rule
# matches may be written `\/`, as JSON serializers such as PHP's escape it:
# a webhook URL or a base64 key in such JSON was missed (measured, v0.11.1).
# A rule may match inside a longer run (a key pasted into a larger blob is
# still a key).
# The first two name a header, not the secret, and print it alone. A PEM
# header counts only where a key can follow it: at the end of its line, or
# before a body (64 base64 characters, or an armor header such as
# Proc-Type:) on the same line, after nothing, spaces or an escaped newline,
# or before a closing quote, as in a key built from one string per line.
# All five headers a measurement over real repositories' histories found
# were stand-ins: a string constant holding the header alone, or a test
# fixture with a body of `xx` or `not a key`.
CRED_MARKERS=(private-key putty-private-key)
CREDENTIALS=(
  private-key                 $'-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY( BLOCK)?-----([[:space:]]*$|[[:space:]]*[A-Za-z0-9+/=\\\\]{64}|(\\\\+r)?\\\\+n(["\'`]|[A-Za-z-]+: ))'  # gitleaks: private-key
  putty-private-key           'PuTTY-User-Key-File-[0-9]+:'
  aws-access-key-id           '(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}'  # gitleaks: aws-access-token
  github-token                'gh[pousr]_[A-Za-z0-9]{36}'  # gitleaks: github-pat, github-oauth, github-app-token, github-refresh-token
  github-fine-grained-token   'github_pat_[A-Za-z0-9_]{22,}'  # gitleaks: github-fine-grained-pat
  gitlab-token                'gl(pat|ptt|rt|dt|soat|cbt|ft|imt|agent|oas)-[A-Za-z0-9_-]{20,}|GR1348941[A-Za-z0-9_-]{20}'  # gitleaks: gitlab-pat and the other gitlab-* token rules
  slack-token                 'xox[abeoprs]-[A-Za-z0-9-]{10,}|xapp-[0-9]-[A-Za-z0-9-]{10,}'  # gitleaks: slack-bot-token, slack-user-token, slack-app-token
  slack-webhook               'hooks\.slack\.com\\?/(services|workflows|triggers)\\?/([A-Za-z0-9+]|\\?/){43,}'  # gitleaks: slack-webhook-url
  discord-webhook             'discord(app)?\.com\\?/api\\?/webhooks\\?/[0-9]{17,20}\\?/[A-Za-z0-9_-]{60,}'
  teams-webhook               '\.webhook\.office\.com\\?/webhookb2\\?/([A-Za-z0-9@-]|\\?/){60,}'  # gitleaks: microsoft-teams-webhook
  stripe-key                  '[rs]k_(live|test|prod)_[A-Za-z0-9]{24,}'  # gitleaks: stripe-access-token
  webhook-signing-secret      'whsec_([A-Za-z0-9+=]|\\?/){24,}'
  google-api-key              'AIza[A-Za-z0-9_-]{35}'  # gitleaks: gcp-api-key
  google-oauth-client-secret  'GOCSPX-[A-Za-z0-9_-]{28}'
  anthropic-key               'sk-ant-[A-Za-z0-9_-]{20,}'  # gitleaks: anthropic-api-key
  openai-key                  'sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{40,}'  # gitleaks: openai-api-key
  openrouter-key              'sk-or-v1-[a-f0-9]{64}'
  deepseek-key                'sk-[a-f0-9]{32}'
  groq-key                    'gsk_[A-Za-z0-9]{52}'
  perplexity-key              'pplx-[A-Za-z0-9]{48}'  # gitleaks: perplexity-api-key
  xai-key                     'xai-[A-Za-z0-9]{80}'
  huggingface-token           'hf_[A-Za-z0-9]{34}|api_org_[A-Za-z0-9]{34}'  # gitleaks: huggingface-access-token, huggingface-organization-api-token
  npm-token                   'npm_[A-Za-z0-9]{36}'  # gitleaks: npm-access-token
  pypi-token                  'pypi-AgE(IcHlwaS5vcmc|NdGVzdC5weXBpLm9yZw)[A-Za-z0-9_-]{50,}'  # gitleaks: pypi-upload-token
  rubygems-token              'rubygems_[a-f0-9]{48}'  # gitleaks: rubygems-api-token
  clojars-token               'CLOJARS_[a-z0-9]{60}'  # gitleaks: clojars-api-token
  sendgrid-key                'SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}'  # gitleaks: sendgrid-api-token
  brevo-key                   'x(keysib|smtpsib)-[a-f0-9]{64}-[A-Za-z0-9]{16}'  # gitleaks: sendinblue-api-token
  mailchimp-key               '[0-9a-f]{32}-us[0-9]{1,2}'  # gitleaks: mailchimp-api-key
  twilio-api-key              'SK[0-9a-fA-F]{32}'  # gitleaks: twilio-api-key
  digitalocean-token          'do[opr]_v1_[a-f0-9]{64}'  # gitleaks: digitalocean-pat, digitalocean-access-token, digitalocean-refresh-token
  shopify-token               'shp(at|ca|pa|ss)_[a-fA-F0-9]{32}'  # gitleaks: shopify-access-token and the other shopify-* rules
  jwt                         'ey[A-Za-z0-9_-]{17,}\.ey[A-Za-z0-9/\\_-]{17,}\.([A-Za-z0-9/\\_-]{10,}={0,2})?'  # gitleaks: jwt
  age-secret-key              'AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}'  # gitleaks: age-secret-key
  vault-token                 'hv[sb]\.[A-Za-z0-9_-]{90,}'  # gitleaks: vault-service-token, vault-batch-token
  terraform-cloud-token       '[A-Za-z0-9]{14}\.atlasv1\.[A-Za-z0-9_=-]{60,70}'  # gitleaks: hashicorp-tf-api-token
  doppler-token               'dp\.(pt|st|sa|ct|scim|audit)\.[A-Za-z0-9]{40,44}'  # gitleaks: doppler-api-token
  linear-api-key              'lin_api_[A-Za-z0-9]{40}'  # gitleaks: linear-api-key
  postman-api-key             'PMAK-[a-fA-F0-9]{24}-[a-fA-F0-9]{34}'  # gitleaks: postman-api-token
  sentry-token                'sntrys_eyJ([A-Za-z0-9+=_]|\\?/){50,}|sntryu_[a-f0-9]{64}'  # gitleaks: sentry-org-token, sentry-user-token
  grafana-token               'glc_([A-Za-z0-9+]|\\?/){32,}={0,2}|glsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8}'  # gitleaks: grafana-cloud-api-token, grafana-service-account-token
  databricks-token            'dapi[a-f0-9]{32}(-[0-9])?'  # gitleaks: databricks-api-token
  atlassian-token             'ATATT3[A-Za-z0-9_=-]{186}'  # gitleaks: atlassian-api-token
  notion-token                'ntn_[0-9]{11}[A-Za-z0-9]{35}'  # gitleaks: notion-api-token
  1password-token             'ops_eyJ([A-Za-z0-9+]|\\?/){250,}={0,3}|A3-[A-Z0-9]{6}-([A-Z0-9]{11}|[A-Z0-9]{6}-[A-Z0-9]{5})-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}'  # gitleaks: 1password-service-account-token, 1password-secret-key
  facebook-token              'EAA[MC][A-Za-z0-9]{100,}'  # gitleaks: facebook-page-access-token
