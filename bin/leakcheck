  sourcegraph-token           'sgp_([A-Za-z0-9]{1,64}_)?[A-Fa-f0-9]{40}|s(gd|lk|gs)_[A-Fa-f0-9]{64}'
  # source: github.com/moby/swarmkit, ca/config.go (SWMTKN-1-, 50 and 25 base36; SWMTKN-2- adds a FIPS digit) and manager/encryption/encryption.go (SWMKEY-1-, a 32-byte key in unpadded base64)
  docker-swarm-token          'SWMTKN-(1|2-[01])-[0-9a-z]{50}-[0-9a-z]{25}|SWMKEY-1-([A-Za-z0-9+]|\\?/){43}'
)
# Path rules: a key file a tracked NAME gives away. A PKCS #12 bundle is
# binary, so its content is skipped and counted, and its name is the only
# tell. Run over tracked path names alone, in the tree and in history —
# never over content, a symlink target, a ref or a tag name — and never used
# to mask: what it matches is a file extension, not a secret. A hit's text
# is its path, printed as every name is. A path rule ends in `$`, the end of
# the whole name: a name holding a newline spans several lines of the names
# pass, so a match counts only on a name's last line — `looks.p12`, a
# newline and `but.txt` read as a bundle (Codex, the /qaa of v0.16.1).
PATH_CREDENTIALS=(
  # source: IANA media type application/pkcs12 ("File extension(s): .p12, .pfx"; "primarily used for the exchange of private keys"); RFC 7292
  pkcs12-file                 '\.[Pp]([Ff][Xx]|12)$'  # gitleaks: pkcs12-file
)
ALL_CREDENTIALS=("${CREDENTIALS[@]}" "${PATH_CREDENTIALS[@]}")
