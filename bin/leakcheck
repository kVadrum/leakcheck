#!/usr/bin/env bash
# leakcheck — scan a repo's tracked files for workspace-internal references
# (host paths, internal names) before the repo goes public.
#
# Scans the whole repo from its top level, wherever it is run: the index
# (what the next commit publishes) AND the worktree copy of every tracked
# file, plus every tracked path name and symlink target. Reads default
# patterns + the optional .leakcheckrc and .leakcheckrc.local at the repo
# top level (keep the .local one gitignored); --config replaces both.
#
# Usage:
#   leakcheck                    # scan with defaults + .leakcheckrc(.local)
#   leakcheck --strict           # also report every file whose content was
#                                # not scanned (binary, submodule) as a match
#   leakcheck --history          # also scan every commit reachable from any
#                                # ref: added lines, path names, author,
#                                # committer and message; every ref name and
#                                # annotated tag (needs full history)
#   leakcheck --history-range RANGE
#                                # --history over the commits in one git
#                                # revision range only (origin/main..HEAD)
#   leakcheck --json             # machine-readable output
#   leakcheck --list-patterns    # print the effective pattern set
#   leakcheck -c, --config FILE  # config path, relative to the cwd (after --root)
#   leakcheck -C, --root DIR     # run as if started in DIR
#   leakcheck -V, --version
#   leakcheck -h, --help
#
# Config file (.leakcheckrc) is line-oriented:
#   pattern <regex>          # add an ERE to the scan set; a leading (?i)
#                            # makes it (or an allow rule) ignore case
#   allow   <regex>          # allowlist hits: an ERE matching all of
#                            # path:line:text, or path:line:<match> for
#                            # every match of the hit's own pattern there
#   skip    <glob>           # skip paths matching glob (git pathspec, top-relative)
#   no-defaults              # disable the built-in default pattern set
#
# Blank lines and lines starting with '#' are ignored. Name and symlink hits
# report line 0.
#
# Git history and commit metadata are scanned only with --history or
# --history-range. Never scanned: submodule contents, encoded or compressed
# content. Binary files are skipped and counted.
#
# Exit codes (treat ANY non-zero as "do not publish"):
#   0  clean
#   1  one or more matches
#   2  usage, config or scan error

# Older bash dies at its first empty-array expansion under `set -u` with exit
# 1, "matches found", having printed nothing (measured on bash 3.2, macOS's
# /bin/bash). Refuse it before anything else runs.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "leakcheck: needs bash 4.4 or newer (this is bash ${BASH_VERSION:-unknown})" >&2
  exit 2
fi

set -eEuo pipefail
# An unexpected failure must never surface as exit 1, which means "matches
# found" — map every abort onto the error code.
trap 'echo "leakcheck: internal error at line $LINENO; nothing was reported" >&2; exit 2' ERR
# The ERR trap does not see a `set -u` abort (an unbound variable): bash exits
# 1 without running it (measured, bash 5.3). So the one deliberate exit 1 sets
# EXIT_HITS first, and every other exit 1 is mapped onto 2 here.
EXIT_HITS=""
TMPD=""
on_exit() {
  local rc=$?
  if [[ -n "$TMPD" ]]; then rm -rf -- "$TMPD"; fi
  if [[ $rc -eq 1 && -z "$EXIT_HITS" ]]; then
    echo "leakcheck: internal error (aborted); nothing was reported" >&2
    rc=2
  fi
  exit "$rc"
}
trap on_exit EXIT

VERSION="0.9.0"

OUTPUT_MODE="text"
STRICT=0
HISTORY=0
HIST_RANGE=""
LIST_ONLY=0
CONFIG_FILE=""
ROOT=""

die() { echo "leakcheck: $*" >&2; exit 2; }

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//; s/^#$//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)            OUTPUT_MODE="json"; shift ;;
    --strict)          STRICT=1; shift ;;
    --history)         HISTORY=1; shift ;;
    --history-range)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      # One range, never last-wins: a second value silently replacing the
      # first changes what was scanned without saying so.
      [[ -z "$HIST_RANGE" ]] || die "--history-range given twice; pass one revision range"
      HIST_RANGE="$2"; HISTORY=1; shift 2 ;;
    --list-patterns)   LIST_ONLY=1; shift ;;
    -c|--config|-C|--root)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      case "$1" in
        -c|--config) CONFIG_FILE="$2" ;;
        *)           ROOT="$2" ;;
      esac
      shift 2 ;;
    -V|--version)      echo "leakcheck $VERSION"; exit 0 ;;
    -h|--help)         usage 0 ;;
    --)                shift; break ;;
    -*)                echo "leakcheck: unknown flag: $1" >&2; usage 2 >&2 ;;
    *)                 echo "leakcheck: unexpected arg: $1" >&2; usage 2 >&2 ;;
  esac
done

# The range reaches git as a revision argument, so an option-shaped value
# (`--all`, `--since=…`, `--first-parent`) would change what the walk means
# instead of naming commits.
case "$HIST_RANGE" in
  -*) die "--history-range takes a revision range, not an option: $HIST_RANGE" ;;
esac

if [[ -n "$ROOT" ]]; then
  cd -- "$ROOT" 2>/dev/null || die "cannot cd to $ROOT"
fi

# An explicit --config resolves against the cwd as it stands now: after
# --root ("run as if started in DIR", as `git -C` means it) and before the
# move to the top level below, so a relative path typed in a subdirectory
# still means what it says. A named config that is missing is an error —
# proceeding on defaults alone is a confident clean pass over a repo that
# nothing the caller asked for actually checked.
CONFIG_ABS=""
if [[ -n "$CONFIG_FILE" ]]; then
  [[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE"
  [[ -r "$CONFIG_FILE" ]] || die "config not readable: $CONFIG_FILE"
  cfg_dir="$(cd -- "$(dirname -- "$CONFIG_FILE")" && pwd -P)" \
    || die "cannot resolve config path: $CONFIG_FILE"
  CONFIG_ABS="$cfg_dir/$(basename -- "$CONFIG_FILE")"
fi

# Always scan from the top level. `git ls-files` and `git grep` are
# cwd-relative, so a run from a subdirectory used to scan that subtree,
# miss the root .leakcheckrc, and report clean with a plausible count.
top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git work tree"
[[ -n "$top" ]] || die "not inside a git work tree"
cd -- "$top" || die "cannot cd to $top"
top="$(pwd -P)"

# Config files, read in order. An explicit --config is the whole config.
# Without one: .leakcheckrc, then .leakcheckrc.local — the gitignored home
# for the tells you would rather not commit, since a committed config is an
# inventory of exactly what you are hiding. Either may be absent; one that
# exists but is not a readable regular file (a dangling symlink, a
# directory) is a config that cannot be read, not "no config".
CONFIG_FILES=()
CONFIG_NAMES=()
if [[ -n "$CONFIG_ABS" ]]; then
  CONFIG_FILES=("$CONFIG_ABS")
  CONFIG_NAMES=("$CONFIG_FILE")
else
  for name in .leakcheckrc .leakcheckrc.local; do
    if [[ -f "$top/$name" ]]; then
      [[ -r "$top/$name" ]] || die "config not readable: $top/$name"
      CONFIG_FILES+=("$top/$name")
      CONFIG_NAMES+=("$name")
    elif [[ -e "$top/$name" || -L "$top/$name" ]]; then
      die "config is not a regular file: $top/$name"
    fi
  done
  # Only the committable .leakcheckrc has its content exempt from the scan.
  # A TRACKED .leakcheckrc.local is the inventory published: its own
  # pattern lines are left to report it.
  if [[ -f "$top/.leakcheckrc" ]]; then CONFIG_ABS="$top/.leakcheckrc"; fi
fi

# Default patterns. Only the universally-bad shapes — absolute home paths
# with a username, on each major OS. Tilde-prefixed paths (`~/...`,
# `$HOME/...`) are intentionally NOT in the defaults: they're shape-only,
# not leaks — Claude Code docs and tooling reference them as generic
# locations. Per-repo `.leakcheckrc` adds workspace tells (hostnames,
# internal project names, custom tilde paths if a project considers them
# leaky).
#
# The first three are the canonical forms; the rest catch the same paths as
# serialized or spelled differently. Every default is DISJOINT from every
# other by construction: git grep reports one hit per (line, pattern), so an
# overlapping default would double-count every hit the canonical ones find.
# Each later default was measured against a corpus of private repos before
# promotion, with no false positives. A username needs an ASCII letter,
# digit or underscore somewhere, so the elided `/home/.../` and `/home/…/`
# placeholders stay clean, in every locale. NOT a default, by measurement:
# `/home/<user>` with no trailing slash — `src/home/` trees and route
# literals like "/home/feed" are false positives; the README offers it as an
# opt-in recipe.
DEFAULTS=(
  '/home/[A-Za-z0-9_][A-Za-z0-9_.-]*/'
  '/Users/[A-Za-z0-9_][A-Za-z0-9_.-]*/'
  'C:\\Users\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\'
  # JSON-escaped slashes: {"path":"\/home\/<user>\/x"}; the only default for
  # them, so its username takes the non-ASCII form too
  '\\/(home|Users)\\/([A-Za-z0-9_]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*\\/'
  # JSON-escaped backslashes, any drive, any case: "C:\\Users\\<user>\\"
  '[A-Za-z]:\\\\[Uu][Ss][Ee][Rr][Ss]\\\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\\\'
  # Single backslashes, any spelling except the canonical C:\Users\ above
  '([A-BD-Za-z]:\\[Uu][Ss][Ee][Rr][Ss]|C:\\(u[Ss][Ee][Rr][Ss]|U(S[Ee][Rr][Ss]|s(E[Rr][Ss]|e(R[Ss]|rS)))))\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\'
  # Usernames holding a non-ASCII character (zoë, José); [^ -~] is "not
  # printable ASCII" in both a UTF-8 and a C locale
  '/(home|Users)/([A-Za-z0-9_][A-Za-z0-9_.-]*[^ -~]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*/'
  '[A-Za-z]:(\\\\|\\)[Uu][Ss][Ee][Rr][Ss](\\\\|\\)([A-Za-z0-9_][A-Za-z0-9_.-]*[^ -~]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*(\\\\|\\)'
)

PATTERNS=()
ALLOWLIST=()
SKIPS=()
USE_DEFAULTS=1

# POSIX ERE has no \d, \t or \x: git's regex reads `\` before an ordinary
# letter as that letter, so `SECRET-\d+` and a single-backslash
# `C:\Users\<user>` silently match nothing real, and inside brackets a
# backslash is literal, so `[\w.-]` misses every letter (all measured, git
# 2.53). Only \w \W \s \S \b \B mean something; refuse every other `\` +
# letter, and `\0`. The bracket walk follows POSIX: `]` right after `[` or
# `[^` is literal, and [:class:] / [=x=] / [.x.] nest.
check_escapes() { # regex where
  local re=$1 where=$2 n=${#1} i=0 c x in_br=0 open=0 d rest tail
  local letters='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
  while (( i < n )); do
    c=${re:i:1}
    if (( in_br )); then
      if [[ $c == '[' ]] && (( i + 1 < n )); then
        d=${re:i+1:1}
        if [[ $d == ':' || $d == '=' || $d == '.' ]]; then
          rest=${re:i+2}
          tail=${rest#*"$d]"}
          if [[ $tail == "$rest" ]]; then return 0; fi # unterminated: git rejects it
          i=$(( n - ${#tail} ))
          continue
        fi
      fi
      if [[ $c == ']' ]] && (( i > open )); then
        in_br=0
      elif [[ $c == '\' ]] && (( i + 1 < n )); then
        x=${re:i+1:1}
        if [[ $letters == *"$x"* ]]; then
          die "$where: inside [...] a backslash is literal, so '\\$x' means a backslash or a '$x', not a class; write [0-9] for a digit, [[:alnum:]_] for a word character"
        fi
      fi
      i=$(( i + 1 ))
      continue
    fi
    if [[ $c == '\' ]]; then
      x=${re:i+1:1}
      if [[ -n $x && ( $letters == *"$x"* || $x == 0 ) && $x != [bBsSwW] ]]; then
        die "$where: '\\$x' is a plain '$x' in POSIX ERE, not an escape, so this can never match what it looks like; write '\\\\' for a literal backslash, [0-9] for a digit"
      fi
      i=$(( i + 2 ))
      continue
    fi
    if [[ $c == '[' ]]; then
      in_br=1
      i=$(( i + 1 ))
      if [[ ${re:i:1} == '^' ]]; then i=$(( i + 1 )); fi
      open=$i
      continue
    fi
    i=$(( i + 1 ))
  done
}

# Read each config in order. Absence is fine — defaults still apply.
parse_config() { # path name-for-messages
  local file=$1 name=$2 lineno=0 line keyword rest
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    # A CRLF config would otherwise end every regex in a CR that no line
    # can match — a pattern that silently finds nothing.
    line="${line%$'\r'}"
    # Strip leading whitespace, drop blank + comment lines.
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    keyword="${line%%[[:space:]]*}"
    rest="${line#"$keyword"}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
    case "$keyword" in
      pattern|allow|skip)
        # An empty `allow` matches every hit and an empty `pattern` every
        # line: both are typos, and one of them turns a dirty repo clean.
        [[ -n "$rest" ]] || die "$name:$lineno: empty $keyword directive"
        if [[ $keyword != skip && "$rest" == '(?i)' ]]; then
          die "$name:$lineno: empty $keyword directive after (?i)"
        fi
        if [[ $keyword != skip ]]; then
          check_escapes "$rest" "$name:$lineno: $keyword '$rest'"
        fi
        case "$keyword" in
          pattern) PATTERNS+=("$rest") ;;
          allow)   ALLOWLIST+=("$rest") ;;
          skip)    SKIPS+=("$rest") ;;
        esac
        ;;
      no-defaults)   USE_DEFAULTS=0 ;;
      *)             die "$name: unknown directive: $keyword" ;;
    esac
  done < "$file"
}
for i in "${!CONFIG_FILES[@]}"; do
  parse_config "${CONFIG_FILES[$i]}" "${CONFIG_NAMES[$i]}"
done

if [[ "$USE_DEFAULTS" -eq 1 ]]; then
  PATTERNS=("${DEFAULTS[@]}" "${PATTERNS[@]}")
fi

if [[ "$LIST_ONLY" -eq 1 ]]; then
  for p in "${PATTERNS[@]}"; do
    printf '%s\n' "$p"
  done
  exit 0
fi

if [[ "${#PATTERNS[@]}" -eq 0 ]]; then
  echo "leakcheck: no patterns to scan (defaults disabled and config empty)" >&2
  exit 2
fi

# Pathspecs. `skip` removes a path from the scan entirely: content, name and
# symlink target. The config file is narrower: only its CONTENT is skipped
# (its `pattern` lines would otherwise read as leaks), and only when it lives
# inside the repo — an exclude naming a path outside the repo is fatal to
# git. Its name and stored symlink target are published like any other path,
# so they are scanned: a tracked `.leakcheckrc -> /home/<user>/…` is a leak.
skip_excludes=()
for skip in "${SKIPS[@]}"; do
  skip_excludes+=(":!:$skip")
done
excludes=("${skip_excludes[@]}")
CONFIG_REL=""
case "$CONFIG_ABS" in
  "$top"/*)
    CONFIG_REL="${CONFIG_ABS#"$top"/}"
    excludes+=(":(exclude,literal)$CONFIG_REL")
    ;;
esac

TMPD="$(mktemp -d "${TMPDIR:-/tmp}/leakcheck.XXXXXX")" || die "cannot create a temp dir"
# Scan the objects a push publishes, in every git call from here on: replace
# refs and a local info/grafts file both rewrite what git shows, and a graft
# that makes HEAD a root hid a leak from --history, exit 0 (found by /cxr,
# reproduced). A graft file that does not exist turns grafts off with no
# output; GIT_GRAFT_FILE=/dev/null also does, but prints the deprecation hint
# in every repo, which run_git rightly reads as a scan error (both measured).
export GIT_NO_REPLACE_OBJECTS=1
export GIT_GRAFT_FILE="$TMPD/no-grafts"
mkdir "$TMPD/subj"

# Binary detection must depend on content alone. git grep -I otherwise
# honours .gitattributes, and `*.svg binary` (a common line) would
# silently drop text files — an Inkscape SVG carrying its author's home
# path — that the published clone still contains. GIT_ATTR_SOURCE (git
# >= 2.40; older git ignores it, and the skip is still counted) points
# in-tree attributes at the empty tree; the other two lines cover the
# global and system attribute files. $GIT_DIR/info/attributes cannot be
# switched off and is counted like any other skip.
EMPTY_TREE="$(git hash-object -t tree /dev/null)" || die "cannot compute the empty tree id"
g() {
  GIT_ATTR_SOURCE="$EMPTY_TREE" GIT_ATTR_NOSYSTEM=1 \
    git -c core.attributesFile=/dev/null "$@"
}

# run_git <label> <out-file> <command...>: stdout to <out-file>. Exit 0 or
# 1 is a result; any other status, or ANY stderr, is a scan error. git grep
# reports an unreadable worktree file on stderr and still exits 1, which
# would otherwise read as "no match" (measured, git 2.53).
run_git() {
  local label=$1 out=$2 rc=0
  shift 2
  "$@" > "$out" 2> "$TMPD/err" || rc=$?
  if [[ $rc -gt 1 || -s "$TMPD/err" ]]; then
    echo "leakcheck: scan error: $label (git exited $rc)" >&2
    sed 's/^/  /' "$TMPD/err" >&2
    exit 2
  fi
  return 0
}

GREP_FLAGS=(-z --no-color --no-column --no-textconv --no-recurse-submodules)

# re_args <pattern or allow rule>: its git grep arguments, in RE_ARGS. A
# leading (?i) makes it case-insensitive — git's ERE refuses `(?i)` (exit
# 128, measured), so the prefix had no meaning before — and the text as
# written stays its label. Every site that hands a pattern or rule to git
# goes through here.
re_args() {
  if [[ "$1" == '(?i)'* ]]; then RE_ARGS=(-i -E -e "${1:4}"); else RE_ARGS=(-E -e "$1"); fi
}

# ─── what is tracked ──────────────────────────────────────────────────
# Mode decides the kind: 100644/100755 regular, 120000 symlink (its blob is
# the target string), 160000 a submodule gitlink. Unmerged paths appear once
# per stage; the first row wins. Listed with `skip` excludes only — the
# config's own entry stays, for its name and symlink target.
run_git "ls-files" "$TMPD/ls" g ls-files -s -z -- . "${skip_excludes[@]}"
mapfile -d '' -t LS_ROWS < "$TMPD/ls"
declare -A SEEN_PATH=()
declare -A MODE_OF=()
PATHS=()
LINK_PATHS=()
LINK_OIDS=()
GITLINKS=()
for row in "${LS_ROWS[@]}"; do
  meta="${row%%$'\t'*}"
  path="${row#*$'\t'}"
  mode="${meta%% *}"
  oid="${meta#* }"
  oid="${oid%% *}"
  [[ -n "${SEEN_PATH["p$path"]+x}" ]] && continue
  SEEN_PATH["p$path"]=1
  MODE_OF["p$path"]=$mode
  PATHS+=("$path")
  case "$mode" in
    120000) LINK_PATHS+=("$path"); LINK_OIDS+=("$oid") ;;
    160000) GITLINKS+=("$path") ;;
  esac
done
# The denominator counts files whose content is in scope; the config's own
# content is not, and is reported under "skipped by config".
TRACKED_COUNT=${#PATHS[@]}
if [[ -n "$CONFIG_REL" && -n "${SEEN_PATH["p$CONFIG_REL"]+x}" ]]; then
  TRACKED_COUNT=$((TRACKED_COUNT - 1))
fi

run_git "ls-files" "$TMPD/lsall" g ls-files -z -- .
mapfile -d '' -t ALL_ROWS < "$TMPD/lsall"
declare -A SEEN_ALL=()
for path in "${ALL_ROWS[@]}"; do SEEN_ALL["p$path"]=1; done
SKIPPED_COUNT=$(( ${#SEEN_ALL[@]} - TRACKED_COUNT ))
[[ $SKIPPED_COUNT -ge 0 ]] || SKIPPED_COUNT=0

# ─── binary detection ─────────────────────────────────────────────────
# A path is binary exactly when this scan's -I skips it: listed by
# `-l -e ''` (any content at all) and not by `-I -l -e ''`. Measuring with
# the scan's own flags is what makes the count follow the scan — git sniffs
# the first 8000 bytes, which is not GNU grep's rule.
declare -A BINARY=()
BINARY_PATHS=()
mark_binary() { # path source
  if [[ -z "${BINARY["p$1"]+x}" ]]; then
    BINARY["p$1"]="$2"
    BINARY_PATHS+=("$1")
  elif [[ "${BINARY["p$1"]}" != "$2" ]]; then
    BINARY["p$1"]="both"
  fi
}
# Fills BINARY_ROWS with the names the last two sniffs ($TMPD/all, $TMPD/text)
# disagree on: content present, but skipped by -I.
binary_rows() {
  local path
  local -A text=()
  BINARY_ROWS=()
  mapfile -d '' -t _rows < "$TMPD/text"
  for path in "${_rows[@]}"; do text["p$path"]=1; done
  mapfile -d '' -t _rows < "$TMPD/all"
  for path in "${_rows[@]}"; do
    [[ -n "${text["p$path"]+x}" ]] || BINARY_ROWS+=("$path")
  done
  return 0
}
binary_pass() { # source [git grep args...]
  local src=$1 path
  shift
  run_git "binary sniff ($src)" "$TMPD/all" g grep "$@" "${GREP_FLAGS[@]}" -l -e '' -- . "${excludes[@]}"
  run_git "binary sniff ($src)" "$TMPD/text" g grep "$@" "${GREP_FLAGS[@]}" -I -l -e '' -- . "${excludes[@]}"
  binary_rows
  for path in "${BINARY_ROWS[@]}"; do mark_binary "$path" "$src"; done
  return 0
}
binary_pass index --cached
binary_pass worktree

# ─── hits ─────────────────────────────────────────────────────────────
# Parallel arrays, never a delimited temp file: a path may hold a tab, a
# colon or a newline, and each of those broke one earlier shape. Hits found
# in both the index and the worktree are reported once, as "both".
H_PAT=()
H_FILE=()
H_LINE=()
H_TEXT=()
H_SRC=()
H_COMMIT=()
declare -A HIT_AT=()
add_hit() { # pattern file line text source [commit]
  # Length-prefixed fields make the key injective whatever the fields hold.
  # The commit is part of the key, so a history hit never merges into the
  # same line found in the tree today: they need different remedies.
  local c="${6-}"
  local key="h${#1}:$1${#2}:$2${#3}:$3${#c}:$c:$4" i
  if [[ -n "${HIT_AT[$key]+x}" ]]; then
    i=${HIT_AT[$key]}
    if [[ "${H_SRC[$i]}" != "$5" ]]; then H_SRC[$i]="both"; fi
    return 0
  fi
  HIT_AT[$key]=${#H_FILE[@]}
  H_PAT+=("$1"); H_FILE+=("$2"); H_LINE+=("$3"); H_TEXT+=("$4"); H_SRC+=("$5")
  H_COMMIT+=("$c")
}

# Content: git grep, one run per pattern so each hit knows its pattern.
# -z gives `path\0line\0text\n`, so the filename never has to be split off
# the match text — the reason the old per-file grep loop existed. Every
# pattern is compiled by git: an invalid ERE exits 128 here, where GNU grep
# behind `2>/dev/null || true` once made it match nothing, forever.
# --no-column is load-bearing: grep.column=true in a user's gitconfig adds a
# field and shifts the parse.
content_pass() { # source [git grep args...]
  local src=$1 p f l t
  shift
  for p in "${PATTERNS[@]}"; do
    re_args "$p"
    run_git "pattern '$p' ($src)" "$TMPD/hits" \
      g grep "$@" "${GREP_FLAGS[@]}" -n -I -H --full-name "${RE_ARGS[@]}" -- . "${excludes[@]}"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      add_hit "$p" "$f" "$l" "$t" "$src"
    done < "$TMPD/hits"
  done
  return 0
}
# The index is what the next commit publishes; the worktree is what
# `git commit -a` publishes, and holds the only copy of an intent-to-add
# file. Each pass alone misses a case the other catches.
content_pass index --cached
content_pass worktree

# Type changes the worktree pass cannot see: an index symlink or gitlink
# replaced by a regular file. git grep follows the INDEX mode and skips the
# path, but `git commit -a` stages the new file — and v0.2.2's per-file grep,
# which read whatever was on disk, did scan it. Each one is copied under a
# numbered name and scanned there, with the same flags and the same binary
# rule, then mapped back to its real path.
TC_PATHS=()
for path in "${PATHS[@]}"; do
  case "${MODE_OF["p$path"]}" in
    120000|160000) ;;
    *) continue ;;
  esac
  [[ "$path" == "$CONFIG_REL" ]] && continue
  if [[ -f "$path" && ! -L "$path" ]]; then TC_PATHS+=("$path"); fi
done
if [[ ${#TC_PATHS[@]} -gt 0 ]]; then
  mkdir "$TMPD/tc"
  for k in "${!TC_PATHS[@]}"; do
    if ! cp -- "${TC_PATHS[$k]}" "$TMPD/tc/$k" 2>"$TMPD/err"; then
      echo "leakcheck: scan error: cannot read ${TC_PATHS[$k]}" >&2
      sed 's/^/  /' "$TMPD/err" >&2
      exit 2
    fi
  done
  gni() { GIT_ATTR_NOSYSTEM=1 git -c core.attributesFile=/dev/null -C "$TMPD/tc" grep --no-index "$@"; }
  run_git "binary sniff (type changes)" "$TMPD/all" gni -z -l -e '' -- .
  run_git "binary sniff (type changes)" "$TMPD/text" gni -z -I -l -e '' -- .
  binary_rows
  for k in "${BINARY_ROWS[@]}"; do mark_binary "${TC_PATHS[$k]}" worktree; done
  for p in "${PATTERNS[@]}"; do
    re_args "$p"
    run_git "pattern '$p' (type changes)" "$TMPD/hits" \
      gni -z -n -I --no-color --no-column "${RE_ARGS[@]}" -- .
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      # An indexed subscript is arithmetic: a non-numeric name would quietly
      # map to entry 0, so check the shape before the lookup.
      [[ "$f" =~ ^[0-9]+$ && -n "${TC_PATHS[$f]+x}" ]] || die "internal error: type-change pass returned $f"
      add_hit "$p" "${TC_PATHS[$f]}" "$l" "$t" worktree
    done < "$TMPD/hits"
  done
fi
BINARY_COUNT=${#BINARY_PATHS[@]}

# Names and symlink targets: content too. A clone publishes every path name
# and every stored link target, and git grep reads neither. Each subject is
# one line of a scratch file (a name holding newlines spans several lines,
# all mapped back to it), matched by the same git grep engine as content.
S_PATH=()
S_SUBJ=()
S_TEXT=()
S_SRC=()
for path in "${PATHS[@]}"; do
  S_PATH+=("$path"); S_SUBJ+=("$path"); S_TEXT+=("$path"); S_SRC+=("index")
done
for i in "${!LINK_PATHS[@]}"; do
  if ! tgt="$(git cat-file blob "${LINK_OIDS[$i]}" 2>"$TMPD/err")"; then
    echo "leakcheck: scan error: cannot read symlink ${LINK_PATHS[$i]}" >&2
    sed 's/^/  /' "$TMPD/err" >&2
    exit 2
  fi
  S_PATH+=("${LINK_PATHS[$i]}"); S_SUBJ+=("$tgt"); S_TEXT+=("-> $tgt"); S_SRC+=("index")
done
for path in "${PATHS[@]}"; do
  [[ -L "$path" ]] || continue
  tgt="$(readlink -- "$path")" || die "scan error: cannot read symlink $path"
  S_PATH+=("$path"); S_SUBJ+=("$tgt"); S_TEXT+=("-> $tgt"); S_SRC+=("worktree")
done

SUBJ_OF_LINE=()
n=0
for i in "${!S_SUBJ[@]}"; do
  nl="${S_SUBJ[$i]//[!$'\n']/}"
  for (( k = 0; k <= ${#nl}; k++ )); do
    n=$((n + 1))
    SUBJ_OF_LINE[$n]=$i
  done
done
if [[ ${#S_SUBJ[@]} -gt 0 ]]; then
  printf '%s\n' "${S_SUBJ[@]}" > "$TMPD/subj/s"
else
  : > "$TMPD/subj/s"
fi

for p in "${PATTERNS[@]}"; do
  re_args "$p"
  run_git "pattern '$p' (names)" "$TMPD/shits" \
    git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- s
  while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
    i="${SUBJ_OF_LINE[$l]:-}"
    [[ -n "$i" ]] || die "internal error: names pass returned line $l"
    add_hit "$p" "${S_PATH[$i]}" 0 "${S_TEXT[$i]}" "${S_SRC[$i]}"
  done < "$TMPD/shits"
done

# ─── history (--history) ──────────────────────────────────────────────
# Every commit reachable from any ref (--all: branches, tags, remote-tracking
# refs, stash, notes), scanned for: every ADDED line of every diff, at its
# line number in that commit's version of the file; every path that ever
# appeared in a diff; and author, committer and message. Each finding is
# reported once, at its earliest commit — a line that sat unchanged through
# fifty edits is one hit, and a leak still in the tree today is reported
# twice, once here and once as it is now, because each needs its own fix.
# --history-range RANGE puts one revision range in place of --all in every
# pass below; the summary and JSON name the range, so a partial scan never
# reads as a full one.
# Load-bearing flags:
#   --full-history  a pathspec otherwise simplifies history, and an `-s ours`
#                   merge then hides its whole side branch (measured). -m
#                   happens to stop that in the content pass; the
#                   .leakcheckrc.local pass has no -m and depends on this
#   -m              lines a merge itself introduces appear in neither
#                   parent's diff; -m diffs each merge against each parent
#   --no-renames    a rename is a delete plus an add, so every `diff --git`
#                   header names one path twice — the parser relies on that
#   log.showRoot    `false` in a user's config hides the root commit's diff
#   replace refs, grafts   ignored for every git call (exported above), so
#                   the objects scanned are the objects a push publishes
HIST_COMMITS=0
HIST_BINARY=0
HIST_SKIPPED=0
HIST_REFS=0
HIST_TAGS=0
HIST_TAGGED=0
declare -A CFG_EXEMPT=()
HREVS=(--all)
if [[ -n "$HIST_RANGE" ]]; then HREVS=("$HIST_RANGE"); fi
if [[ "$HISTORY" -eq 1 ]]; then
  run_git "rev-parse" "$TMPD/shallow" g rev-parse --is-shallow-repository
  if [[ "$(<"$TMPD/shallow")" != "false" ]]; then
    [[ -n "$HIST_RANGE" ]] ||
      die "shallow clone: its history is incomplete, so --history cannot vouch for it (git fetch --unshallow; in GitHub Actions, fetch-depth: 0)"
    # A range can still be complete in a shallow clone: what goes missing is
    # the parents of the boundary commits git lists in $GIT_DIR/shallow, so
    # the walk is exact unless one of those commits is IN the range — then
    # whatever lay behind it is silently absent (measured, git 2.53).
    run_git "rev-parse" "$TMPD/shpath" g rev-parse --git-path shallow
    run_git "rev-list" "$TMPD/hrevs" g rev-list "${HREVS[@]}" --
    declare -A SHALLOW=()
    while IFS= read -r c; do SHALLOW["c$c"]=1; done < "$(<"$TMPD/shpath")"
    while IFS= read -r c; do
      [[ -z "${SHALLOW["c$c"]+x}" ]] ||
        die "shallow clone: $HIST_RANGE reaches commit $c, whose parents this clone does not have, so the range cannot be scanned in full (fetch deeper, or git fetch --unshallow)"
    done < "$TMPD/hrevs"
  fi
  run_git "rev-list" "$TMPD/hcount" g rev-list "${HREVS[@]}" --count --
  HIST_COMMITS=$(<"$TMPD/hcount")
  [[ "$HIST_COMMITS" =~ ^[0-9]+$ ]] || die "scan error: unexpected commit count: $HIST_COMMITS"
fi

if [[ "$HISTORY" -eq 1 && "$HIST_COMMITS" -gt 0 ]]; then
  HLOG=(-c log.showRoot=true -c core.quotePath=false
        log "${HREVS[@]}" --full-history --date-order --reverse --no-show-signature)

  # Old versions of the config ARE scanned: a hostname that sat in
  # .leakcheckrc before .leakcheckrc.local existed is still in every commit
  # that held it, and excluding the config's history (the first draft) hid
  # exactly that. Only a line identical to one in today's TRACKED config —
  # published on purpose, and exempt in the tree for the same reason — is
  # not reported, and each such line is counted.
  declare -A CUR_CFG=()
  if [[ -n "$CONFIG_REL" && -n "${SEEN_PATH["p$CONFIG_REL"]+x}" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do CUR_CFG["l$line"]=1; done < "$CONFIG_ABS"
  fi

  # git C-quotes a path holding ", \ or a control character even with
  # core.quotePath=false: \" \\ \a \b \t \n \v \f \r and \NNN octal. Never
  # eval it: a filename is attacker-controlled input.
  c_unquote() { # quoted-body -> REPLY
    local s=$1 out="" c o
    while [[ -n "$s" ]]; do
      c=${s:0:1}
      if [[ "$c" != '\' ]]; then out+=$c; s=${s:1}; continue; fi
      c=${s:1:1}
      case "$c" in
        '"'|'\') out+=$c ;;
        a) out+=$'\a' ;;
        b) out+=$'\b' ;;
        t) out+=$'\t' ;;
        n) out+=$'\n' ;;
        v) out+=$'\v' ;;
        f) out+=$'\f' ;;
        r) out+=$'\r' ;;
        [0-7])
          o=${s:1:3}
          [[ "$o" =~ ^[0-7]{3}$ ]] || die "scan error: cannot unquote history path: $1"
          printf -v c "\\$o"
          out+=$c
          s=${s:4}
          continue ;;
        *) die "scan error: cannot unquote history path: $1" ;;
      esac
      s=${s:2}
    done
    REPLY=$out
  }

  # With --no-renames both halves of "a/P b/P" name the same P, so the
  # header splits at its exact middle — the only split that survives a path
  # holding " b/". Anything else is a header this parser does not know.
  hist_path() { # header-remainder -> REPLY
    local rest=$1 n h a b
    n=${#rest}
    (( n % 2 == 1 )) || die "scan error: unexpected diff header: diff --git $rest"
    h=$(( (n - 1) / 2 ))
    a=${rest:0:h}
    b=${rest:h+1}
    [[ "${rest:h:1}" == " " ]] || die "scan error: unexpected diff header: diff --git $rest"
    if [[ "$a" == '"a/'*'"' && "$b" == '"b/'*'"' ]]; then
      a=${a:3:${#a}-4}
      b=${b:3:${#b}-4}
      [[ "$a" == "$b" ]] || die "scan error: unexpected diff header: diff --git $rest"
      c_unquote "$b"
    elif [[ "$a" == a/* && "$b" == b/* && "${a:2}" == "${b:2}" ]]; then
      REPLY=${b:2}
    else
      die "scan error: unexpected diff header: diff --git $rest"
    fi
  }

  # Content: every added line, written to one subject file for git grep,
  # with "<file-change> <line>" in the same row of a parallel meta file.
  # Inside a hunk every line is prefixed (+, -, space, \), so a header-shaped
  # line there is content: an added "++ x" arrives as "+++ x".
  FC_SHA=()
  FC_PATH=()
  HB_FC=()
  hist_parse() {
    local LC_ALL=C line sha="" fc=-1 ln=0 in_hunk=0 h
    exec 3>"$TMPD/subj/h" 4>"$TMPD/hmeta"
    while IFS= read -r line || [[ -n "$line" ]]; do
      if (( in_hunk )); then
        case "$line" in
          '+'*)
            printf '%s\n' "${line:1}" >&3
            printf '%s %s\n' "$fc" "$ln" >&4
            ln=$((ln + 1))
            continue ;;
          ' '*) ln=$((ln + 1)); continue ;;
          '-'*|'\'*) continue ;;
          '@@ '*) ;;
          *) in_hunk=0 ;;
        esac
      fi
      case "$line" in
        $'\x01'*) sha=${line:1}; in_hunk=0 ;;
        'diff --git '*)
          hist_path "${line#diff --git }"
          fc=$((fc + 1))
          FC_SHA[fc]=$sha
          FC_PATH[fc]=$REPLY
          in_hunk=0 ;;
        'Binary files '*' differ') HB_FC+=("$fc") ;;
        '@@ '*)
          h=${line#@@ -* +}
          h=${h%% @@*}
          ln=${h%%,*}
          [[ "$ln" =~ ^[0-9]+$ ]] || die "scan error: unexpected hunk header: $line"
          in_hunk=1 ;;
      esac
    done < "$TMPD/hlog"
    exec 3>&- 4>&-
  }

  run_git "log (history)" "$TMPD/hlog" g "${HLOG[@]}" -m --no-renames -p -U0 \
    --inter-hunk-context=0 --no-color --no-ext-diff --no-textconv \
    --src-prefix=a/ --dst-prefix=b/ --format=%x01%H -- . "${skip_excludes[@]}"
  hist_parse
  mapfile -t HMETA < "$TMPD/hmeta"

  declare -A HIST_SEEN=()
  hist_hit() { # kind pattern file line text commit — once per (kind, pattern, file, text)
    local key="$1${#2}:$2${#3}:$3:$5"
    [[ -z "${HIST_SEEN[$key]+x}" ]] || return 0
    HIST_SEEN[$key]=1
    add_hit "$2" "$3" "$4" "$5" history "$6"
  }

  for p in "${PATTERNS[@]}"; do
    re_args "$p"
    run_git "pattern '$p' (history)" "$TMPD/hhits" \
      git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- h
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      m="${HMETA[l - 1]-}"
      [[ -n "$m" ]] || die "internal error: history pass returned line $l"
      fc=${m%% *}
      if [[ -n "$CONFIG_REL" && "${FC_PATH[fc]}" == "$CONFIG_REL" && -n "${CUR_CFG["l$t"]+x}" ]]; then
        CFG_EXEMPT["l$t"]=1
        continue
      fi
      hist_hit c "$p" "${FC_PATH[fc]}" "${m#* }" "$t" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done

  # Names: every path that ever appeared in a diff header, at its first commit.
  HN_FC=()
  HN_OF_LINE=()
  declare -A HN_SEEN=()
  n=0
  exec 5>"$TMPD/subj/hn"
  for fc in "${!FC_PATH[@]}"; do
    path=${FC_PATH[fc]}
    [[ -z "${HN_SEEN["p$path"]+x}" ]] || continue
    HN_SEEN["p$path"]=1
    e=${#HN_FC[@]}
    HN_FC+=("$fc")
    printf '%s\n' "$path" >&5
    nl="${path//[!$'\n']/}"
    for (( k = 0; k <= ${#nl}; k++ )); do
      n=$((n + 1))
      HN_OF_LINE[n]=$e
    done
  done
  exec 5>&-
  for p in "${PATTERNS[@]}"; do
    re_args "$p"
    run_git "pattern '$p' (history names)" "$TMPD/hhits" \
      git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hn
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      e="${HN_OF_LINE[l]-}"
      [[ -n "$e" ]] || die "internal error: history names pass returned line $l"
      fc=${HN_FC[e]}
      hist_hit n "$p" "${FC_PATH[fc]}" 0 "${FC_PATH[fc]}" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done

  # Binary files in history: skipped and counted, once per path.
  declare -A HB_SEEN=()
  for fc in "${HB_FC[@]}"; do
    path=${FC_PATH[fc]}
    [[ -z "${HB_SEEN["p$path"]+x}" ]] || continue
    HB_SEEN["p$path"]=1
    HIST_BINARY=$((HIST_BINARY + 1))
    if [[ "$STRICT" -eq 1 ]]; then
      add_hit "unscanned:binary" "$path" 0 "(binary file; content not scanned)" history "${FC_SHA[fc]}"
    fi
  done

  # What `skip` kept out of the history scan, in distinct paths.
  if [[ ${#SKIPS[@]} -gt 0 ]]; then
    sp=("${SKIPS[@]}")
    run_git "log (skipped)" "$TMPD/hskip" g "${HLOG[@]}" -m --no-renames \
      --format= --name-only -z -- "${sp[@]}"
    mapfile -d '' -t HSK < "$TMPD/hskip"
    declare -A HSK_SEEN=()
    for path in "${HSK[@]}"; do HSK_SEEN["p$path"]=1; done
    HIST_SKIPPED=${#HSK_SEEN[@]}
  fi

  # Author, committer and message — published by every push. Each distinct
  # (field, text) is scanned once, at its first commit: one leaked email in
  # five hundred commits is one hit.
  run_git "log (metadata)" "$TMPD/hmlog" g "${HLOG[@]}" -z \
    --format='%H%x00%an <%ae>%x00%cn <%ce>%x00%B'
  mapfile -d '' -t HM < "$TMPD/hmlog"
  (( ${#HM[@]} % 4 == 0 )) || die "scan error: unexpected commit metadata from git log"
  M_SHA=()
  M_FIELD=()
  M_LINE=()
  M_TEXT=()
  declare -A M_SEEN=()
  hm_add() { # commit field line text
    local key="${#2}:$2:$4"
    [[ -n "$4" && -z "${M_SEEN[$key]+x}" ]] || return 0
    M_SEEN[$key]=1
    M_SHA+=("$1"); M_FIELD+=("$2"); M_LINE+=("$3"); M_TEXT+=("$4")
    printf '%s\n' "$4" >&5
  }
  exec 5>"$TMPD/subj/hm"
  for (( i = 0; i < ${#HM[@]}; i += 4 )); do
    sha=${HM[i]}
    hm_add "$sha" "(author)" 0 "${HM[i + 1]}"
    hm_add "$sha" "(committer)" 0 "${HM[i + 2]}"
    rest=${HM[i + 3]}
    k=0
    while [[ -n "$rest" ]]; do
      k=$((k + 1))
      ml=${rest%%$'\n'*}
      if [[ "$rest" == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
      hm_add "$sha" "(message)" "$k" "$ml"
    done
  done

  # Ref names and annotated tags. A push of --all, --tags or --follow-tags
  # publishes them, and neither is part of any commit: a branch named
  # feature/MYHOST-fix and a tag message "built on MYHOST" were both clean
  # through v0.7.0 (measured). Every ref is scanned by name, `(ref)`; every
  # annotated tag object a ref reaches, nested ones included, by name, tagger
  # and message, `(tag)`, `(tagger)`, `(tag message)`. With --history-range,
  # only the refs and tags that point into the range — those its push
  # carries. A ref that ends at a tree or a blob, not a commit, publishes
  # content no diff shows: counted, and reported under --strict.
  if [[ -n "$HIST_RANGE" ]]; then
    run_git "rev-list" "$TMPD/hrange" g rev-list "${HREVS[@]}" --
    declare -A IN_RANGE=()
    while IFS= read -r c; do IN_RANGE["c$c"]=1; done < "$TMPD/hrange"
  fi
  # Ref names hold no space or control character (git check-ref-format).
  run_git "for-each-ref" "$TMPD/hrefs" g for-each-ref --format='%(objectname) %(objecttype) %(refname)'
  REF_OBJ=(); REF_TYPE=(); REF_NAME=()
  while read -r o t n; do REF_OBJ+=("$o"); REF_TYPE+=("$t"); REF_NAME+=("$n"); done < "$TMPD/hrefs"

  declare -A TAG_OBJ=() TAG_OTYPE=() TAG_NAME=() TAG_TAGGER=() TAG_MSG=()
  # parse_tags <cat-file --batch output>: each tag's headers and message.
  # Sizes are bytes. Bash cannot hold a NUL, and `read -N` drops one and
  # reads a byte further, which misframes every object after it (measured),
  # so NULs reach here as \x01: same size, nothing dropped. A read that still
  # comes up short is a scan error, never a silently shorter tag.
  parse_tags() {
    local LC_ALL=C hdr sha size body nl head line obj ot name tagger
    while IFS= read -r hdr; do
      [[ "$hdr" =~ ^([0-9a-f]+)\ tag\ ([0-9]+)$ ]] ||
        die "scan error: unexpected tag object from git cat-file: $hdr"
      sha=${BASH_REMATCH[1]}; size=${BASH_REMATCH[2]}
      body=""
      if (( size > 0 )); then IFS= read -r -N "$size" body || true; fi
      (( ${#body} == size )) || die "scan error: tag object $sha could not be read whole"
      IFS= read -r nl || true
      [[ -z "$nl" ]] || die "scan error: unexpected tag object framing from git cat-file"
      head=${body%%$'\n\n'*}
      TAG_MSG[$sha]=""
      if [[ "$body" == *$'\n\n'* ]]; then TAG_MSG[$sha]=${body#*$'\n\n'}; fi
      obj=""; ot=""; name=""; tagger=""
      while [[ -n "$head" ]]; do
        line=${head%%$'\n'*}
        if [[ "$head" == *$'\n'* ]]; then head=${head#*$'\n'}; else head=""; fi
        case "$line" in
          "object "*) obj=${line#object } ;;
          "type "*)   ot=${line#type } ;;
          "tag "*)    name=${line#tag } ;;
          "tagger "*) tagger=${line#tagger } ;;
        esac
      done
      [[ -n "$obj" && -n "$ot" ]] || die "scan error: tag object $sha names no object"
      # The ident without its timestamp, as (author) shows a commit's.
      if [[ "$tagger" =~ ^(.*)\ [0-9]+\ [-+][0-9]{4}$ ]]; then tagger=${BASH_REMATCH[1]}; fi
      TAG_OBJ[$sha]=$obj; TAG_OTYPE[$sha]=$ot; TAG_NAME[$sha]=$name; TAG_TAGGER[$sha]=$tagger
    done < "$1"
  }
  queue=()
  declare -A QUEUED=()
  for k in "${!REF_OBJ[@]}"; do
    if [[ "${REF_TYPE[k]}" == tag && -z "${QUEUED[${REF_OBJ[k]}]+x}" ]]; then
      QUEUED[${REF_OBJ[k]}]=1; queue+=("${REF_OBJ[k]}")
    fi
  done
  while [[ ${#queue[@]} -gt 0 ]]; do
    printf '%s\n' "${queue[@]}" > "$TMPD/tagq"
    run_git "cat-file (tags)" "$TMPD/tags0" g cat-file --batch < "$TMPD/tagq"
    LC_ALL=C tr '\000' '\001' < "$TMPD/tags0" > "$TMPD/tags"
    parse_tags "$TMPD/tags"
    next=()
    for t in "${queue[@]}"; do
      o=${TAG_OBJ[$t]}
      if [[ "${TAG_OTYPE[$t]}" == tag && -z "${QUEUED[$o]+x}" ]]; then QUEUED[$o]=1; next+=("$o"); fi
    done
    queue=("${next[@]}")
  done

  HIST_REFS=0
  HIST_TAGS=0
  HIST_TAGGED=0
  declare -A TAG_DONE=()
  for k in "${!REF_OBJ[@]}"; do
    # Peel through any chain of tags to the object the ref ends at.
    o=${REF_OBJ[k]}; t=${REF_TYPE[k]}; chain=()
    while [[ "$t" == tag ]]; do chain+=("$o"); t=${TAG_OTYPE[$o]}; o=${TAG_OBJ[$o]}; done
    if [[ -n "$HIST_RANGE" ]]; then
      [[ "$t" == commit && -n "${IN_RANGE["c$o"]+x}" ]] || continue
    fi
    HIST_REFS=$((HIST_REFS + 1))
    hm_add "${REF_OBJ[k]}" "(ref)" 0 "${REF_NAME[k]}"
    if [[ "$t" != commit ]]; then
      HIST_TAGGED=$((HIST_TAGGED + 1))
      if [[ "$STRICT" -eq 1 ]]; then
        add_hit "unscanned:tagged-$t" "(ref)" 0 "${REF_NAME[k]} (points at a $t; its content is not scanned)" history "$o"
      fi
    fi
    for tg in "${chain[@]}"; do
      [[ -z "${TAG_DONE[$tg]+x}" ]] || continue
      TAG_DONE[$tg]=1
      HIST_TAGS=$((HIST_TAGS + 1))
      hm_add "$tg" "(tag)" 0 "${TAG_NAME[$tg]}"
      hm_add "$tg" "(tagger)" 0 "${TAG_TAGGER[$tg]}"
      rest=${TAG_MSG[$tg]}
      kk=0
      while [[ -n "$rest" ]]; do
        kk=$((kk + 1))
        ml=${rest%%$'\n'*}
        if [[ "$rest" == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
        hm_add "$tg" "(tag message)" "$kk" "$ml"
      done
    done
  done
  exec 5>&-
  for p in "${PATTERNS[@]}"; do
    re_args "$p"
    run_git "pattern '$p' (history metadata)" "$TMPD/hhits" \
      git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hm
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      i=$((l - 1))
      [[ -n "${M_SHA[i]-}" ]] || die "internal error: history metadata pass returned line $l"
      add_hit "$p" "${M_FIELD[i]}" "${M_LINE[i]}" "${M_TEXT[i]}" history "${M_SHA[i]}"
    done < "$TMPD/hhits"
  done

  # A .leakcheckrc.local committed at ANY point published its tells, even if
  # it is gone today: the same rule as for the tree, and for the same reason.
  run_git "log (.leakcheckrc.local)" "$TMPD/hlocal" g "${HLOG[@]}" --format=%H \
    -- ':(literal).leakcheckrc.local'
  if [[ -s "$TMPD/hlocal" ]]; then
    IFS= read -r sha < "$TMPD/hlocal"
    add_hit "config:local-in-history" ".leakcheckrc.local" 0 \
      "(a .leakcheckrc.local committed in history publishes the tells it held; remove it from history)" history "$sha"
  fi
fi

# A committed .leakcheckrc.local publishes the inventory of tells it exists
# to keep out of git. Reported as a finding of its own, in every mode and
# whatever --config says: its patterns need not match their own source text
# (`pattern ^SECRET-[0-9]+$` does not), so "its lines will report it" is not
# a guarantee.
if [[ -n "${SEEN_PATH["p.leakcheckrc.local"]+x}" ]]; then
  add_hit "config:local-tracked" ".leakcheckrc.local" 0 \
    "(a committed .leakcheckrc.local publishes the tells it holds; gitignore it)" "index"
fi

# Under --strict, what could not be scanned is itself a finding.
if [[ "$STRICT" -eq 1 ]]; then
  for path in "${BINARY_PATHS[@]}"; do
    add_hit "unscanned:binary" "$path" 0 "(binary file; content not scanned)" "${BINARY["p$path"]}"
  done
  for path in "${GITLINKS[@]}"; do
    add_hit "unscanned:submodule" "$path" 0 "(submodule; contents not scanned)" "index"
  done
fi

# ─── allowlist ────────────────────────────────────────────────────────
# A rule allows a hit in one of two ways, each tested by the same engine as
# the patterns:
#   whole line  it matches all of `path:line:text`, so it names this exact
#               line (`^f\.txt:1:/home/alice/x$`): matching is POSIX
#               leftmost-longest, so such a rule's first -o match is the
#               whole line, and git grep has no -x
#   per match   it matches `path:line:M` for a match M of the hit's own
#               pattern, and every such M on the line is excused by some
#               rule (`/home/USERNAME/`, `\.example\.com`) — a location
#               rule (`^fixtures/`) matches every M there
# A rule that merely matches somewhere on the line allows nothing: matching
# the whole line once let the placeholder in `allow /home/USERNAME/` hide a
# MYHOST hit, and a real /home/alice/, that shared its line (measured,
# v0.6.0) — and a minified file is one line.
# Matches come from `git grep -o`, whose match TEXTS are right but whose
# --column is right only for a line's first match (git 2.53 adds the
# previous match's end instead: measured), so nothing here uses positions.
# Rules are compiled even when there is nothing to allow, so a broken one
# fails on a clean repo too. The lowest-numbered rule that took part takes
# the credit, and every rule's count is reported: an over-broad allow must
# not look identical to a clean repo.
ALLOWED=()
ALLOW_COUNTS=()
for i in "${!H_FILE[@]}"; do ALLOWED[$i]=0; done
for r in "${!ALLOWLIST[@]}"; do ALLOW_COUNTS[$r]=0; done
if [[ ${#ALLOWLIST[@]} -gt 0 ]]; then
  # lines_of <string>: how many lines a record takes in a subject file (a
  # path or text may hold a newline).
  lines_of() { local nl=${1//[!$'\n']/}; REPLY=$(( ${#nl} + 1 )); }

  # Every match of each hit's own pattern, as text. A text the pattern finds
  # no non-empty match in as displayed (an anchored pattern on a
  # `-> target` symlink hit), or that no pattern produced (unscanned:binary
  # and the other pseudo-patterns), counts as one match: the whole text.
  declare -A IS_PAT=() BY_PAT=()
  for p in "${PATTERNS[@]}"; do IS_PAT["l$p"]=1; done
  MT_HIT=(); MT_TXT=(); MT_OF=()
  for i in "${!H_FILE[@]}"; do
    MT_OF[$i]=""
    BY_PAT["l${H_PAT[$i]}"]+="$i "
  done
  for key in "${!BY_PAT[@]}"; do
    [[ -n "${IS_PAT[$key]+x}" ]] || continue
    p=${key#l}
    T_HIT=(); n=0
    exec 6>"$TMPD/subj/t"
    for i in ${BY_PAT[$key]}; do
      printf '%s\n' "${H_TEXT[$i]}" >&6
      lines_of "${H_TEXT[$i]}"
      for (( k = 0; k < REPLY; k++ )); do n=$((n + 1)); T_HIT[n]=$i; done
    done
    exec 6>&-
    re_args "$p"
    run_git "pattern '$p' (allow)" "$TMPD/tmatch" \
      git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column "${RE_ARGS[@]}" -- t
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
      i=${T_HIT[l]:-}
      [[ -n "$i" ]] || die "internal error: allow match pass returned line $l"
      MT_OF[$i]+="${#MT_HIT[@]} "
      MT_HIT+=("$i"); MT_TXT+=("$m")
    done < "$TMPD/tmatch"
  done
  for i in "${!H_FILE[@]}"; do
    if [[ -z "${MT_OF[$i]}" ]]; then
      MT_OF[$i]="${#MT_HIT[@]} "
      MT_HIT+=("$i"); MT_TXT+=("${H_TEXT[$i]}")
    fi
  done

  # Subjects: a holds each hit's whole line, m one line per match; each
  # subject line maps back to its hit (or match).
  A_OF=(); A_TXT=(); A_LINES=(); M_OF=()
  na=0; nm=0
  exec 7>"$TMPD/subj/a" 8>"$TMPD/subj/m"
  for i in "${!H_FILE[@]}"; do
    rec="${H_FILE[$i]}:${H_LINE[$i]}:${H_TEXT[$i]}"
    printf '%s\n' "$rec" >&7
    lines_of "$rec"; A_LINES[$i]=$REPLY
    for (( k = 0; k < REPLY; k++ )); do
      na=$((na + 1)); A_OF[na]=$i
      A_TXT[na]=${rec%%$'\n'*}
      rec=${rec#*$'\n'}
    done
  done
  for j in "${!MT_HIT[@]}"; do
    i=${MT_HIT[j]}
    printf '%s\n' "${H_FILE[$i]}:${H_LINE[$i]}:${MT_TXT[j]}" >&8
    lines_of "${H_FILE[$i]}:${H_LINE[$i]}:${MT_TXT[j]}"
    for (( k = 0; k < REPLY; k++ )); do nm=$((nm + 1)); M_OF[nm]=$j; done
  done
  exec 7>&- 8>&-

  WHOLE=(); EXC=()
  for i in "${!H_FILE[@]}"; do WHOLE[$i]=""; done
  for j in "${!MT_HIT[@]}"; do EXC[$j]=""; done
  for r in "${!ALLOWLIST[@]}"; do
    rule=${ALLOWLIST[$r]}
    re_args "$rule"
    # Whole line: every line of the record matched entirely.
    run_git "allow '$rule'" "$TMPD/awhole" \
      git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column "${RE_ARGS[@]}" -- a
    declare -A WCOUNT=() WSEEN=()
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      i=${A_OF[l]:-}
      [[ -n "$i" ]] || die "internal error: allow pass returned line $l"
      [[ "$t" == "${A_TXT[l]}" && -z "${WSEEN[$l]+x}" ]] || continue
      WSEEN[$l]=1
      WCOUNT[$i]=$(( ${WCOUNT[$i]:-0} + 1 ))
    done < "$TMPD/awhole"
    for i in "${!WCOUNT[@]}"; do
      if [[ ${WCOUNT[$i]} -eq ${A_LINES[$i]} && -z "${WHOLE[$i]}" ]]; then WHOLE[$i]=$r; fi
    done
    unset WCOUNT WSEEN
    run_git "allow '$rule'" "$TMPD/amatch" \
      git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- m
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      j=${M_OF[l]:-}
      [[ -n "$j" ]] || die "internal error: allow pass returned line $l"
      [[ -n "${EXC[$j]}" ]] || EXC[$j]=$r
    done < "$TMPD/amatch"
  done

  for i in "${!H_FILE[@]}"; do
    credit=none
    for j in ${MT_OF[$i]}; do
      if [[ -z "${EXC[$j]}" ]]; then credit=""; break; fi
      if [[ "$credit" == none || ${EXC[$j]} -lt $credit ]]; then credit=${EXC[$j]}; fi
    done
    [[ "$credit" != none ]] || credit=""
    r=${WHOLE[$i]}
    if [[ -n "$r" ]] && [[ -z "$credit" || $r -lt $credit ]]; then credit=$r; fi
    if [[ -n "$credit" ]]; then
      ALLOWED[$i]=1
      ALLOW_COUNTS[$credit]=$(( ALLOW_COUNTS[credit] + 1 ))
    fi
  done
fi

KEEP=()
ALLOWED_TOTAL=0
for i in "${!H_FILE[@]}"; do
  if [[ "${ALLOWED[$i]}" -eq 1 ]]; then
    ALLOWED_TOTAL=$((ALLOWED_TOTAL + 1))
  else
    KEEP+=("$i")
  fi
done
HIT_COUNT=${#KEEP[@]}

if [[ "$HISTORY" -eq 1 ]]; then
  HRANGE=""
  if [[ -n "$HIST_RANGE" ]]; then HRANGE=" in range $HIST_RANGE only"; fi
  HSCOPE="history scanned: $HIST_COMMITS commits$HRANGE, $HIST_BINARY binary files skipped, $HIST_SKIPPED skipped by config, ${#CFG_EXEMPT[@]} current-config lines exempt, $HIST_REFS refs, $HIST_TAGS annotated tags, $HIST_TAGGED tagged trees or blobs not scanned"
else
  HSCOPE="history not scanned"
fi
SCOPE="index + worktree; $BINARY_COUNT binary skipped, ${#GITLINKS[@]} submodules not scanned, $SKIPPED_COUNT skipped by config, $ALLOWED_TOTAL allowed; $HSCOPE"

# ─── output ───────────────────────────────────────────────────────────
if [[ "$OUTPUT_MODE" == "json" ]]; then
  # One well-formed UTF-8 sequence, as bytes (matched under LC_ALL=C).
  UTF8_SEQ=$'([\x01-\x7f]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])'
  # JSON must be UTF-8, and neither a path nor a line has to be (a legacy
  # filename, a Latin-1 file): one such byte made the whole envelope
  # unparseable. Well-formed input passes through on one regex test; in
  # anything else each stray byte becomes U+FFFD.
  utf8_clean() {
    local LC_ALL=C s="$1" out=""
    if [[ "$s" =~ ^${UTF8_SEQ}*$ ]]; then
      printf '%s' "$s"
      return 0
    fi
    while [[ -n "$s" ]]; do
      if [[ "$s" =~ ^$UTF8_SEQ ]]; then
        out+="${BASH_REMATCH[0]}"
        s="${s:${#BASH_REMATCH[0]}}"
      else
        out+='�'
        s="${s:1}"
      fi
    done
    printf '%s' "$out"
  }
  # Pure-bash escaping for portability.
  json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    # Strip remaining control chars (<0x20) — rare in tracked source.
    s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037')
    utf8_clean "$s"
  }
  # version, clean, count and hits stay first and unchanged; new fields
  # only ever append.
  printf '{"version":"%s","clean":%s,"count":%d,"hits":[' \
    "$VERSION" \
    "$([[ "$HIT_COUNT" -eq 0 ]] && echo true || echo false)" \
    "$HIT_COUNT"
  first=1
  for i in "${KEEP[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '{"file":"%s","line":%s,"pattern":"%s","text":"%s","source":"%s"' \
      "$(json_escape "${H_FILE[$i]}")" "${H_LINE[$i]}" "$(json_escape "${H_PAT[$i]}")" \
      "$(json_escape "${H_TEXT[$i]}")" "${H_SRC[$i]}"
    # Only history hits carry a commit; every other hit keeps its v0.3.0 shape.
    if [[ -n "${H_COMMIT[$i]}" ]]; then printf ',"commit":"%s"' "${H_COMMIT[$i]}"; fi
    printf '}'
  done
  printf '],"target":"index+worktree","tracked":%d,"skipped":{"binary":%d,"submodule":%d,"config":%d},"symlinks":%d,"allowed":[' \
    "$TRACKED_COUNT" "$BINARY_COUNT" "${#GITLINKS[@]}" "$SKIPPED_COUNT" "${#LINK_PATHS[@]}"
  first=1
  for r in "${!ALLOWLIST[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '{"rule":"%s","count":%d}' "$(json_escape "${ALLOWLIST[$r]}")" "${ALLOW_COUNTS[$r]}"
  done
  if [[ "$HISTORY" -eq 1 ]]; then
    hr=null
    if [[ -n "$HIST_RANGE" ]]; then hr="\"$(json_escape "$HIST_RANGE")\""; fi
    printf '],"history_scanned":true,"history":{"commits":%d,"binary":%d,"skipped":%d,"config_lines_exempt":%d,"range":%s,"refs":%d,"tags":%d,"tagged_unscanned":%d}}\n' \
      "$HIST_COMMITS" "$HIST_BINARY" "$HIST_SKIPPED" "${#CFG_EXEMPT[@]}" "$hr" "$HIST_REFS" "$HIST_TAGS" "$HIST_TAGGED"
  else
    printf '],"history_scanned":false}\n'
  fi
else
  # One hit, one line. A field holding a newline — only a path name or a
  # symlink target can — is C-quoted the way git quotes such paths; every
  # other field prints byte-for-byte, so the common case is unchanged.
  line_safe() {
    local s="$1"
    case "$s" in
      *$'\n'*)
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/\\r}"
        s="${s//$'\t'/\\t}"
        printf '"%s"' "$s"
        ;;
      *) printf '%s' "$s" ;;
    esac
  }
  if [[ "$HIT_COUNT" -eq 0 ]]; then
    echo "leakcheck: clean — 0 matches across $TRACKED_COUNT tracked files ($SCOPE)"
  else
    for i in "${KEEP[@]}"; do
      # A history hit leads with its commit: <sha>:path:line: [pattern] text.
      if [[ -n "${H_COMMIT[$i]}" ]]; then printf '%s:' "${H_COMMIT[$i]}"; fi
      printf '%s:%s: [%s] %s\n' "$(line_safe "${H_FILE[$i]}")" "${H_LINE[$i]}" \
        "${H_PAT[$i]}" "$(line_safe "${H_TEXT[$i]}")"
    done
    echo "leakcheck: $HIT_COUNT match(es)" >&2
    echo "leakcheck: scanned $TRACKED_COUNT tracked files ($SCOPE)" >&2
  fi
fi

if [[ "$HIT_COUNT" -gt 0 ]]; then
  EXIT_HITS=1
  exit 1
fi
exit 0
