#!/usr/bin/env bash
# leakcheck — scan a repo's tracked files for workspace-internal references
# (host paths, internal names) and credentials before the repo goes public.
#
# Scans the whole repo from its top level, wherever it is run: the index
# (what the next commit publishes) AND the worktree copy of every tracked
# file, plus every tracked path name and symlink target. Reads default
# patterns + the optional .leakcheckrc and .leakcheckrc.local at the repo
# top level (keep the .local one gitignored); --config replaces both.
# Built-in credential rules find keys and tokens in formats their issuers
# fixed (cloud, AI and git-host keys, webhooks, private key headers), key
# files by their names (PKCS #12), and keys with no prefix of their own by
# a keyword and the value's randomness (a password, an AWS secret key,
# `token = ...`, an HTTP Authorization header, curl's -u user:password); a
# credential hit is labelled credential:<id>, and any key it prints is
# masked.
#
# Usage:
#   leakcheck                    # scan with defaults + .leakcheckrc(.local)
#   leakcheck --strict           # also report every file whose content was
#                                # not scanned (binary, submodule) as a match
#   leakcheck --history          # also scan every commit reachable from any
#                                # ref: added lines, path names, author,
#                                # committer and message; every ref name and
#                                # annotated tag (needs full history)
#   leakcheck --history-range RANGE
#                                # --history over the commits in one git
#                                # revision range only (origin/main..HEAD)
#   leakcheck --json             # machine-readable output
#   leakcheck --format FMT       # text, json (as --json), sarif, csv or junit
#   leakcheck --write-baseline FILE  # write each finding's fingerprint to FILE
#   leakcheck --baseline FILE    # report only findings FILE does not hold
#   leakcheck --dir DIR          # scan every file under DIR, no repository
#                                # needed, ignored files included
#   leakcheck --stdin            # scan standard input, as a file named stdin
#   leakcheck --decode           # also read base64, hex and percent-encoded
#                                # values decoded, where they decode to text
#   leakcheck --archives         # also read what zip, tar and gzip files hold
#   leakcheck --redact           # print no hit's text, and no tell in a path
#   leakcheck --rule ID          # run only this rule (repeatable): a
#                                # credential:<id> or a config label
#   leakcheck --list-patterns    # print the effective pattern set
#   leakcheck --list-rules       # print each credential rule's label, on/off
#   leakcheck -c, --config FILE  # config path, relative to the cwd (after --root)
#   leakcheck -C, --root DIR     # run as if started in DIR
#   leakcheck -V, --version
#   leakcheck -h, --help
#
# Config file (.leakcheckrc) is line-oriented:
#   pattern <regex>          # add an ERE to the scan set; a leading (?i)
#                            # makes it (or an allow rule) ignore case
#   label   <name> <regex>   # the same, its hits and --list-patterns line
#                            # printing the name, never the regex
#   allow   <regex>          # allowlist hits: an ERE matching all of
#                            # path:line:text, or path:line:<match> for
#                            # every match of the hit's own pattern there;
#                            # never excuses a credential hit
#   allow credential:<id> <regex>
#                            # the same, for that credential rule's hits
#                            # only (credential:* for every credential rule)
#   skip    <glob>           # skip paths matching glob (git pathspec, top-relative)
#   disable credential:<id>  # turn one built-in credential rule off (counted)
#   no-defaults              # disable the built-in home-path patterns
#   no-credentials           # disable the built-in credential rules
#
# Blank lines and lines starting with '#' are ignored. Name and symlink hits
# report line 0.
#
# Environment: LEAKCHECK_CONFIG names a config as --config does (--config
# wins); LEAKCHECK_RC holds config lines, read after every config file — a
# CI secret, so the tells stay out of the repo.
#
# Git history and commit metadata are scanned only with --history or
# --history-range. Never scanned: submodule contents, encoded or compressed
# content. Binary files are skipped and counted.
#
# Exit codes (treat ANY non-zero as "do not publish"):
#   0  clean
#   1  one or more matches
#   2  usage, config or scan error

# SPDX-FileCopyrightText: 2026 KeMeK Network
# SPDX-License-Identifier: MIT
# Credential rules derived from gitleaks: notice after the CREDENTIALS table.

# Older bash dies at its first empty-array expansion under `set -u` with exit
# 1, "matches found", having printed nothing (measured on bash 3.2, macOS's
# /bin/bash). Refuse it before anything else runs.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "leakcheck: needs bash 4.4 or newer (this is bash ${BASH_VERSION:-unknown})" >&2
  exit 2
fi

# The caller's shell settings never reach the scan (measured, /cxr 00b04d9):
# a compatibility level of 4.2 or lower (BASH_COMPAT, or compat31 from
# BASHOPTS or BASH_ENV) reads a quoted `=~` needle as a regex, so a key's
# `.` matched a near-copy of an allowed key and a real secret yielded to it,
# exit 0, and breaks the JSON escaping; `nocasematch` from BASH_ENV dropped the
# same secret. Unsetting BASH_COMPAT resets the level and its compat options.
unset BASH_COMPAT
shopt -u nocasematch

set -eEuo pipefail
# An unexpected failure must never surface as exit 1, which means "matches
# found" — map every abort onto the error code.
trap 'echo "leakcheck: internal error at line $LINENO; nothing was reported" >&2; exit 2' ERR
# The ERR trap does not see a `set -u` abort (an unbound variable): bash exits
# 1 without running it (measured, bash 5.3). So the one deliberate exit 1 sets
# EXIT_HITS first, and every other exit 1 is mapped onto 2 here.
EXIT_HITS=""
TMPD=""
on_exit() {
  local rc=$?
  if [[ -n "$TMPD" ]]; then rm -rf -- "$TMPD"; fi
  if [[ $rc -eq 1 && -z "$EXIT_HITS" ]]; then
    echo "leakcheck: internal error (aborted); nothing was reported" >&2
    rc=2
  fi
  exit "$rc"
}
trap on_exit EXIT

VERSION="0.29.5"

OUTPUT_MODE="text"
STRICT=0
HISTORY=0
HIST_RANGE=""
LIST_ONLY=0
CONFIG_FILE=""
ROOT=""
ARG_ERR=""
REDACT=0
RULE_ONLY=()
FORMAT_ARG=""
JSON_FLAG=0
BASELINE_IN=""
BASELINE_OUT=""
DIR_ARG=""
STDIN_MODE=0
DECODE=0
ARCHIVES=0

# Every error leaves through fail, masked by every built-in rule once the
# temp dir exists (mask_texts): an error quotes what it is about — a config
# line, git's own message about a pattern, a path — and a key written there
# printed whole (v0.11.6 §4). One exit, so a message added later is masked
# without anyone remembering to. Nothing the caller wrote is checked before
# the masking exists — an argument, a path, a config — so a message before it
# quotes none of it: a CI log shows an expanded `--config "$X"`, a key
# included, where the runner's echo of the command does not (Codex, /qaa of
# v0.11.8). A failure while masking prints nothing of the message.
ERR_BUSY=0
FAIL_USAGE=0 # the usage follows the message: a command-line error
fail() { # line... -> stderr, exit 2
  if [[ $ERR_BUSY -eq 1 ]]; then
    echo "leakcheck: error while checking an error message for credentials; it is not printed" >&2
    exit 2
  fi
  ERR_BUSY=1
  local fail_msg
  local -a fail_lines=()
  printf -v fail_msg '%s\n' "$@"
  mapfile -t fail_lines <<< "${fail_msg%$'\n'}"
  if [[ -n "$TMPD" ]]; then mask_texts fail_lines "error message"; fi
  printf '%s\n' "${fail_lines[@]}" >&2
  if [[ $FAIL_USAGE -eq 1 ]]; then usage 2 >&2; fi
  exit 2
}
die() { fail "leakcheck: $*"; }

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//; s/^#$//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)            OUTPUT_MODE="json"; JSON_FLAG=1; shift ;;
    --format)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      # One format, never last-wins; checked once an error is masked.
      [[ -z "$FORMAT_ARG" ]] || ARG_ERR="--format given twice; pass one"
      FORMAT_ARG=$2; shift 2 ;;
    --strict)          STRICT=1; shift ;;
    --history)         HISTORY=1; shift ;;
    --history-range)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      # One range, never last-wins: a second value silently replacing the
      # first changes what was scanned without saying so.
      [[ -z "$HIST_RANGE" ]] || die "--history-range given twice; pass one revision range"
      HIST_RANGE="$2"; HISTORY=1; shift 2 ;;
    --list-patterns)   LIST_ONLY=1; shift ;;
    --dir)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      DIR_ARG=$2; shift 2 ;;
    --stdin)           STDIN_MODE=1; shift ;;
    --decode)          DECODE=1; shift ;;
    --archives)        ARCHIVES=1; shift ;;
    --baseline|--write-baseline)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      if [[ "$1" == --baseline ]]; then BASELINE_IN=$2; else BASELINE_OUT=$2; fi
      shift 2 ;;
    --redact)          REDACT=1; shift ;;
    --rule)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      RULE_ONLY+=("$2"); shift 2 ;;
    --list-rules)      LIST_ONLY=2; shift ;;
    -c|--config|-C|--root)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "leakcheck: $1 needs a value" >&2; usage 2 >&2
      fi
      case "$1" in
        -c|--config) CONFIG_FILE="$2" ;;
        *)           ROOT="$2" ;;
      esac
      shift 2 ;;
    -V|--version)      echo "leakcheck $VERSION"; exit 0 ;;
    -h|--help)         usage 0 ;;
    --)                shift; break ;;
    # Both repeat the argument, so they wait for the masking (fail).
    -*)                ARG_ERR="unknown flag: $1"; break ;;
    *)                 ARG_ERR="unexpected arg: $1"; break ;;
  esac
done

# Default patterns. Only the universally-bad shapes — absolute home paths
# with a username, on each major OS. Tilde-prefixed paths (`~/...`,
# `$HOME/...`) are intentionally NOT in the defaults: they're shape-only,
# not leaks — Claude Code docs and tooling reference them as generic
# locations. Per-repo `.leakcheckrc` adds workspace tells (hostnames,
# internal project names, custom tilde paths if a project considers them
# leaky).
#
# The first three are the canonical forms; the rest catch the same paths as
# serialized or spelled differently. Every default is DISJOINT from every
# other by construction: git grep reports one hit per (line, pattern), so an
# overlapping default would double-count every hit the canonical ones find.
# Each later default was measured against a corpus of private repos before
# promotion, with no false positives. A username needs an ASCII letter,
# digit or underscore somewhere, so the elided `/home/.../` and `/home/…/`
# placeholders stay clean, in every locale. NOT a default, by measurement:
# `/home/<user>` with no trailing slash — `src/home/` trees and route
# literals like "/home/feed" are false positives; the README offers it as an
# opt-in recipe.
DEFAULTS=(
  '/home/[A-Za-z0-9_][A-Za-z0-9_.-]*/'
  '/Users/[A-Za-z0-9_][A-Za-z0-9_.-]*/'
  'C:\\Users\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\'
  # JSON-escaped slashes: {"path":"\/home\/<user>\/x"}; the only default for
  # them, so its username takes the non-ASCII form too
  '\\/(home|Users)\\/([A-Za-z0-9_]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*\\/'
  # JSON-escaped backslashes, any drive, any case: "C:\\Users\\<user>\\"
  '[A-Za-z]:\\\\[Uu][Ss][Ee][Rr][Ss]\\\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\\\'
  # Single backslashes, any spelling except the canonical C:\Users\ above
  '([A-BD-Za-z]:\\[Uu][Ss][Ee][Rr][Ss]|C:\\(u[Ss][Ee][Rr][Ss]|U(S[Ee][Rr][Ss]|s(E[Rr][Ss]|e(R[Ss]|rS)))))\\[A-Za-z0-9_][A-Za-z0-9_.-]*\\'
  # Usernames holding a non-ASCII character (zoë, José); [^ -~] is "not
  # printable ASCII", and the defaults run in the C locale (pat_args), where
  # it meets every byte of any encoding
  '/(home|Users)/([A-Za-z0-9_][A-Za-z0-9_.-]*[^ -~]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*/'
  '[A-Za-z]:(\\\\|\\)[Uu][Ss][Ee][Rr][Ss](\\\\|\\)([A-Za-z0-9_][A-Za-z0-9_.-]*[^ -~]|[^ -~]+[A-Za-z0-9_])([A-Za-z0-9_.-]|[^ -~])*(\\\\|\\)'
)

# SPDX-SnippetBegin
# SPDX-SnippetCopyrightText: 2019 Zachary Rice
# SPDX-SnippetCopyrightText: 2026 KeMeK Network
# SPDX-License-Identifier: MIT
# A row ending `# gitleaks: <id>` was first derived from that rule (or rules)
# in gitleaks' default configuration (config/gitleaks.toml, v8.30.1;
# https://github.com/gitleaks/gitleaks): its prefix and shape, re-spelled as
# POSIX ERE. A row with no such note has no gitleaks counterpart. gitleaks'
# license notice follows the table.
# Every row is sourced from its issuer (v0.12.0): the `# source:` line above
# it names the issuer's own documentation, or failing that the issuer's own
# code (an SDK, a CLI, its scanner), that states the format; `none` means the
# issuer publishes nothing and the shape is what real keys show. Where the
# issuer leaves a length or an alphabet open, the rule leaves it open too, so
# a longer key masks whole.
# Credential rules, on by default (`no-credentials` turns them off): each
# names one format by a prefix or shape the issuer fixed, so a match is a
# credential, or a stand-in written to look like one. Formats with no such
# anchor (an AWS secret key, a password, `token = <anything>`) are not here:
# telling them from ordinary text needs a keyword, the value and its entropy,
# which KV_CREDENTIALS weighs (below). A hit is labelled `credential:<id>`
# and printed masked; allow rules and the placeholder check see the real
# text. No `\b`: git's ERE is the system regex, and one that reads `\b` as a
# plain `b` would make a rule match nothing, silently. Every `/` a rule
# matches may be written `\/`, as JSON serializers such as PHP's escape it:
# a webhook URL or a base64 key in such JSON was missed (measured, v0.11.1).
# A rule may match inside a longer run (a key pasted into a larger blob is
# still a key), except where a measured false positive needs a left edge:
# such a rule is listed in CRED_KEYSTART with the literal its key begins
# with, and every match of it is cut to start there, so the edge character
# is never masked, judged or printed as part of the key.
# A token whose body is a JWT behind a prefix — GitHub's stateless `ghs_`
# installation tokens (2026), GitLab's `glcbt-`, `glsat-` and `gliamat-` — is
# found by `jwt`, which needs no prefix.
# The first two name a header, not the secret, and print it alone. A PEM
# header counts only where a key can follow it: at the end of its line, or
# before a body (64 base64 characters, or an armor header such as
# Proc-Type:) on the same line, after nothing, spaces or an escaped newline,
# or before a closing quote, as in a key built from one string per line.
# All five headers a measurement over real repositories' histories found
# were stand-ins: a string constant holding the header alone, or a test
# fixture with a body of `xx` or `not a key`.
CRED_MARKERS=(private-key putty-private-key)
CREDENTIALS=(
  # source: RFC 7468; RFC 9580 §6.2.1; OpenSSH sshkey.c; GnuPG armor.c (PGP SECRET KEY BLOCK); PuTTY import.c (the SSH2 header)
  private-key                 $'(-----BEGIN[ A-Z0-9_-]{0,100}(PRIVATE|SECRET) KEY( BLOCK)?-----|---- BEGIN SSH2 ENCRYPTED PRIVATE KEY ----)([[:space:]]*$|[[:space:]]*[A-Za-z0-9+/=\\\\]{64}|(\\\\+r)?\\\\+n(["\'`]|[A-Za-z-]+: ))'  # gitleaks: private-key
  # source: the.earth.li/~sgtatham/putty/latest/htmldoc/AppendixC.html
  putty-private-key           'PuTTY-User-Key-File-[0-9]+:'
  # source: docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html (AKIA, ASIA, ABIA, ACCA; A3T is not AWS's)
  aws-access-key-id           '(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}'  # gitleaks: aws-access-token
  # source: github.blog/engineering/platform-security/behind-githubs-new-authentication-token-formats/ (a CRC32 checksum in the last six; checksum_fails); github.blog/changelog/2021-03-04-authentication-token-format-updates/ (up to 255 characters)
  github-token                'gh[pousr]_[A-Za-z0-9]{36,}'  # gitleaks: github-pat, github-oauth, github-app-token, github-refresh-token
  # source: docs.github.com/en/organizations/managing-programmatic-access-to-your-organization/github-credential-types
  github-fine-grained-token   'github_pat_[A-Za-z0-9_]{22,}'  # gitleaks: github-fine-grained-pat
  # source: docs.gitlab.com/security/tokens/; lengths and glrct-, gliamrt-, gliamac- from GitLab's own gitlab-org/security-products/secret-detection/secret-detection-rules
  # and the session cookie, "the old 32 random characters and digits" (gitlab-org/gitlab merge request 145178)
  gitlab-token                'gl(pat|ptt|rtr?|rct|dt|soat|cbt|ft|ffct|imt|agent|oas|wt|iamrt|iamac)-[A-Za-z0-9_-]{20,}|GR1348941[A-Za-z0-9_-]{20}|_gitlab_session=[A-Za-z0-9]{32}'  # gitleaks: gitlab-pat and the other gitlab-* token rules
  # source: docs.slack.dev/authentication/tokens
  slack-token                 'xox[abeoprs]-[A-Za-z0-9-]{10,}|xapp-[0-9]-[A-Za-z0-9-]{10,}|xwfp-[A-Za-z0-9-]{10,}'  # gitleaks: slack-bot-token, slack-user-token, slack-app-token
  # Webhook URLs match their issuer's segments and stop: a body running
  # across `/` took in what followed the secret, and `<url>/XXXXXXXX` was set
  # aside as a stand-in (v0.11.3 §7). Each segment's class excludes `/`.
  # source: docs.slack.dev/messaging/sending-messages-using-incoming-webhooks; docs.slack.dev/tools/slack-github-action/sending-data-webhook-slack-workflow
  slack-webhook               'hooks\.slack(-gov)?\.com\\?/(services(\\?/[A-Za-z0-9]{8,}){2}|workflows(\\?/[A-Za-z0-9]{8,}){3}|triggers(\\?/[A-Za-z0-9]{8,}){2})\\?/[A-Za-z0-9]{20,}'  # gitleaks: slack-webhook-url
  # source: docs.discord.com/developers/resources/webhook; docs.discord.com/developers/reference (versioned base)
  discord-webhook             'discord(app)?\.com\\?/api(\\?/v[0-9]+)?\\?/webhooks\\?/[0-9]{17,20}\\?/[A-Za-z0-9_-]{60,}'
  # source: none for the layout (Microsoft documents only the retirement, learn.microsoft.com add-incoming-webhook)
  teams-webhook               '(\.webhook\.office\.com\\?/webhookb2|outlook\.office(365)?\.com\\?/webhook)\\?/[A-Za-z0-9-]{20,}@[A-Za-z0-9-]{20,}\\?/[A-Za-z0-9]+\\?/[A-Za-z0-9]{20,}\\?/[A-Za-z0-9-]{20,}(\\?/V2[A-Za-z0-9_-]{20,})?'  # gitleaks: microsoft-teams-webhook
  # source: docs.stripe.com/keys; docs.stripe.com/keys/organization-api-keys (sk_org)
  stripe-key                  '[rs]k_(live|test|prod)_[A-Za-z0-9]{24,}|sk_org_[A-Za-z0-9_]{24,}'  # gitleaks: stripe-access-token
  # source: docs.stripe.com/webhooks/signature; the Standard Webhooks spec (github.com/standard-webhooks: whsec_, and whsk_ for an ed25519 secret key)
  webhook-signing-secret      'wh(sec|sk)_([A-Za-z0-9+=]|\\?/){24,}'
  # source: docs.cloud.google.com/docs/authentication/api-keys (AIza and 35, in its examples); AQ. keys from Google's own scanner (google/osv-scalibr, gcpexpressmode)
  google-api-key              'AIza[A-Za-z0-9_-]{35}|AQ\.Ab[A-Za-z0-9_-]{48}'  # gitleaks: gcp-api-key
  # source: none (Google: no documented format); the shape Google's own scanner uses (google/osv-scalibr, gcpoauth2client)
  google-oauth-client-secret  'GOCSPX-[A-Za-z0-9_-]{28}'
  # source: platform.claude.com/docs/en/manage-claude/admin-api-keys; .../wif-reference; .../authentication
  anthropic-key               'sk-ant-[A-Za-z0-9_-]{20,}'  # gitleaks: anthropic-api-key
  # source: developers.openai.com admin API keys (sk-admin-); proj- and svcacct- as real keys show them
  openai-key                  'sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{40,}'  # gitleaks: openai-api-key
  # source: openrouter.ai/docs/guides/features/guardrails/secret-formats
  openrouter-key              'sk-or-v1-[a-f0-9]{64}'
  # source: none (api-docs.deepseek.com states no format; Alibaba's legacy DashScope keys, sk- and about 32, match too).
  # A left edge: `desk-`, `task-`, `flask-` + 32 hex are names (the corpus
  # harness's look-alikes), so `sk-` may not follow a lowercase letter, but
  # may follow an escape such as `\n` in a JSON string, or an `=` or `/` a
  # writer escaped (`\u` and four hex digits, `\x3d`, `%3d`, `%2f`), each
  # of which ends in a lowercase letter and was refused, exit 0 (v0.11.11
  # to v0.16.0).
  deepseek-key                '(^|[^a-z]|\\[a-z]|\\u[0-9A-Fa-f]{4}|\\x[0-9A-Fa-f]{2}|%[0-9A-Fa-f]{2})sk-[a-f0-9]{32}'
  # source: none
  groq-key                    'gsk_[A-Za-z0-9]{52,}'
  # source: docs.perplexity.ai/docs/admin/api-key-management (pplx-, by example)
  perplexity-key              'pplx-[A-Za-z0-9]{48,}'  # gitleaks: perplexity-api-key
  # source: none
  xai-key                     'xai-[A-Za-z0-9]{80,}'
  # source: huggingface.co/docs/hub/security-tokens (hf_; api_org_ is deprecated)
  # A left edge for hf_ (v0.19.0): inside random base64url, `hf_` and 34
  # alphanumerics turn up about once in 3,000 lines of 300 characters (the
  # corpus harness's look-alikes, once reseeded). No letter or digit before
  # it, so the 2 in 64 base64url places after `-` or `_` remain, and a key
  # in a file name after `-` is still found.
  huggingface-token           '(^|[^A-Za-z0-9])hf_[A-Za-z0-9]{34}|api_org_[A-Za-z0-9]{34}'  # gitleaks: huggingface-access-token, huggingface-organization-api-token
  # source: github.blog/security/announcing-npms-new-access-token-format/
  npm-token                   'npm_[A-Za-z0-9]{36,}'  # gitleaks: npm-access-token
  # source: docs.pypi.org/api/secrets/ (its own regex: pypi- and 85 or more, any Warehouse); the
  # pypi.org and test.pypi.org macaroon headers keep their shorter floor, so a
  # cut-off token there is still found
  pypi-token                  'pypi-AgE(IcHlwaS5vcmc|NdGVzdC5weXBpLm9yZw)[A-Za-z0-9_-]{50,}|pypi-[A-Za-z0-9_=-]{85,}'  # gitleaks: pypi-upload-token
  # source: rubygems/rubygems.org, app/controllers/concerns/api_keyable.rb
  rubygems-token              'rubygems_[a-f0-9]{48}'  # gitleaks: rubygems-api-token
  # source: clojars/clojars-web, src/clojars/models/deploy_token.clj
