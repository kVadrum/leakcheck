  # source: devcenter.heroku.com/articles/oauth (HRKU- and 65 characters); devcenter.heroku.com/changelog-items/2842 (HRKU- and a UUID, 2024)
  heroku-key                  'HRKU-[A-Za-z0-9_-]{36,}'  # gitleaks: heroku-api-key-v2
  # source: supabase/cli, src/auth/access-token.ts; supabase.com/docs/guides/api/api-keys (sb_secret_)
  supabase-key                'sbp_(oauth_|v0_)?[a-f0-9]{40}|sb_secret_[A-Za-z0-9_-]{20,}'
  # source: learn.microsoft.com/en-us/purview/sit-defn-azure-storage-account-access-key; microsoft/security-utilities (identifiable keys, +ASt)
  azure-storage-key           '([Aa][Cc][Cc][Oo][Uu][Nn][Tt]|[Ss][Tt][Oo][Rr][Aa][Gg][Ee])[Kk][Ee][Yy][[:space:]]*=[[:space:]]*([A-Za-z0-9+]|\\?/){86}==|([A-Za-z0-9+]|\\?/){76}\+ASt([A-Za-z0-9+]|\\?/){5}[AQgw]=='
  # source: microsoft/security-utilities, SEC101_156_AzureClientAppIdentifiableCredentials.cs (7Q~ or 8Q~)
  azure-ad-client-secret      '[A-Za-z0-9_~.-]{3}[0-9]Q~[A-Za-z0-9_~.-]{31,34}'  # gitleaks: azure-ad-client-secret
  # source: newrelic/newrelic-cli, internal/utils/utils.go (license keys end NRAL); newrelic/rusty-hog, default_rules.json
  new-relic-key               'NRA[AK]-[A-Za-z0-9]{27}|NRI[IQ]-[A-Za-z0-9_-]{32}|NRRA-[A-Fa-f0-9]{21,}|NRSP-[A-Za-z]{2}[A-Fa-f0-9]{33}|([a-z]{2}[0-9]{2}xx[A-Fa-f0-9]{30}|[A-Fa-f0-9]{36})NRAL'  # gitleaks: new-relic-user-api-key, new-relic-insert-key
