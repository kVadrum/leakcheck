  # source: planetscale/cli, internal/config/config.go (pscale_tkn_), internal/cmd/password (pscale_pw_)
  planetscale-token           'pscale_(tkn|oauth|pw)_[A-Za-z0-9=._-]{32,64}'  # gitleaks: planetscale-api-token, planetscale-oauth-token, planetscale-password
  # source: docs.fly.io/security/tokens; superfly/macaroon, format.go (fm1r, fm1a, fm2, fo1)
  flyio-token                 'fo1_[A-Za-z0-9_-]{43}|fm[12][ar]?_([A-Za-z0-9+]|\\?/){100,}={0,3}'  # gitleaks: flyio-access-token
  # source: docs.dynatrace.com/docs/manage/identity-access-management/access-tokens-and-oauth-clients/access-tokens-legacy
