# ─── keyword + value rules (stage C) ──────────────────────────────────
# A secret with no prefix of its own (an AWS secret key, a password, a key a
# service hands out bare) is told from ordinary text by three things at
# once: a keyword naming it, an assignment, and a value random enough to be
# a secret. One ERE per rule finds the keyword, the assignment and the
# value's shape; at the hit, kv_value cuts the value from the match and
# kv_weak judges it, and a weak value is a stand-in, counted with the
# placeholders. A row: id; the keyword, an ERE in lower case matched in any
# case (with KV_RAW, the whole ERE before the value instead); the value's
# ERE, its first bound the most kv_weak reads (128 characters at most); a
# literal the match ends with after the value; the least entropy the value
# needs, in millibits per character. The match itself runs to the value's
# end (KV_VAL, the ERE with that bound dropped): bounded, a longer value's
# tail lay outside the match, printed in a name, an allow rule or an error,
# and a URL's password over 128 characters matched nothing (Codex, the /qaa
# of main..dev).
# A hit prints its keyword (a raw rule: the URL's scheme) and the value's
# length, never a byte of the value. The rows are ours, not gitleaks'.
# kv_ci <ERE> -> REPLY: each lower-case letter as a bracket of both cases.
kv_ci() {
  local LC_ALL=C s=$1 i c
  REPLY=""
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    if [[ "$c" == [a-z] ]]; then REPLY+="[${c^^}$c]"; else REPLY+=$c; fi
  done
}
# The words a secret's name holds, shared by the generic rule and the XML
# setting rule.
KV_SECRET_WORDS='passw(or)?d|pass|pwd|secret|token|credential|api[_.-]?key|apikey|access[_.-]?key|auth[_.-]?key|private[_.-]?key'
# An HTTP Authorization header, as a request, a config or code writes it:
# `Authorization: X`, `"Authorization": "X"`, `'Authorization' => 'X'`,
# `Header.Set("Authorization", "X")`, nginx's `Authorization "X"`; the
# proxy's header (RFC 9110 §11.6.2, §11.7.2) by its tail, as nothing anchors
# the match's start.
kv_ci 'authorization'
KV_AUTHZ="$REPLY[\"'\`]?([[:space:]]*(:|=>?|,)[[:space:]]*|[[:space:]]+)[\"'\`]?"
kv_ci "$KV_SECRET_WORDS"
KV_SECRET_CI=$REPLY
# curl's user and password on its command line, `-u user:password`: a value
# opening with `$`, `<` or `{` is a template's (`-u "$USER:$PASS"`).
KV_CURL_U="[Cc][Uu][Rr][Ll][[:space:]]([^|;]{0,200}[[:space:]])?(-u[[:space:]]*|-U[[:space:]]*|--user[[:space:]=]+|--proxy-user[[:space:]=]+)[\"']?[^[:space:]:\"'\`\$<{]{1,64}:"
KV_CURL_PW="[^[:space:]\"'\`\$<{][^[:space:]\"'\`]{7,127}"
# A setting written as XML, `<add key="…Password" value="…"/>`: NuGet's
# packageSourceCredentials and .NET's appSettings, with the generic words.
KV_XML_ADD="<[Aa][Dd][Dd][[:space:]]+[Kk][Ee][Yy][[:space:]]*=[[:space:]]*[\"'][A-Za-z0-9_.:-]{0,40}($KV_SECRET_CI)[A-Za-z0-9_.:-]{0,40}[\"'][[:space:]]+[Vv][Aa][Ll][Uu][Ee][[:space:]]*=[[:space:]]*[\"']"
KV_XML_VAL="[^\"'<>[:space:]]{8,128}"
# A service's name, as a secret's name is often no more than that
# (`HEROKU=…`, `"datadog": "…"`): the providers GitHub's secret scanning
# lists, each a name no ordinary word holds (`linear`, `notion`'s neighbours
# `segment` and `temporal` are left out), behind a left edge (KV_EDGE).
KV_SERVICE_WORDS='adafruit|adobe|aiven|alibaba|aliyun|algolia|amplitude|anthropic|apify|asana|atlassian|auth0|authress|azure|baidu|beamer|bitbucket|bitrise|brevo|buildkite|cashfree|circleci|clickhouse|clojars|cloudflare|cloudinary|cloudsmith|cockroach|cohere|contentful|contribsys|coveo|databento|databricks|datadog|datastax|deepseek|devcycle|digitalocean|discord|dockerhub|doppler|dropbox|duffel|dynatrace|easypost|ebay|fastly|figma|finicity|firebase|flickr|flutterwave|frameio|fullstory|gemini|github|gitlab|gocardless|google|gcloud|grafana|groq|hashicorp|hcaptcha|heroku|highnote|hubspot|huggingface|infracost|intercom|jfrog|artifactory|langchain|langsmith|launchdarkly|lichess|linkedin|localstack|logicmonitor|mailchimp|mailersend|mailgun|mandrill|mapbox|maxmind|meraki|mergify|messagebird|microsoft|midtrans|mistral|mongodb|netlify|newrelic|notion|npm|nuget|octopus|okta|onesignal|onfido|openai|openrouter|openweather|pagerduty|palantir|pangea|perplexity|pinecone|pinterest|planetscale|plivo|posthog|postman|prefect|pulumi|pypi|rubygems|runpod|salesforce|samsara|scalingo|scalr|sendbird|sendgrid|sentry|shippo|shopify|slack|snowflake|sourcegraph|sslmate|stripe|supabase|tableau|tailscale|tavily|telegram|telnyx|tencent|terraform|twilio|twitch|twitter|typeform|unkey|vercel|wakatime|wandb|weatherstack|workato|workos|yandex|zendesk|zenhub|zuplo'
# Sidekiq Pro and Enterprise: `user:password` for the gem server, in its
# environment variable or bundle config (the URL form is url-password's).
kv_ci 'bundle_'; KV_SIDEKIQ="$REPLY"
kv_ci '(gems|enterprise)'; KV_SIDEKIQ+="$REPLY"
kv_ci '__contribsys__com'; KV_SIDEKIQ+="$REPLY[\"']?[[:space:]]*[=:][[:space:]]*[\"']?"
kv_ci '(gems|enterprise)\.contribsys\.com'
KV_SIDEKIQ="($KV_SIDEKIQ|$REPLY[\"']?[[:space:]]+[\"']?)[A-Za-z0-9._-]{1,64}:"
KV_CREDENTIALS=(
  # source: docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_access-keys.html (a secret access key, wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY: 40 characters); docs.aws.amazon.com/cli/latest/userguide/cli-configure-envvars.html (AWS_SECRET_ACCESS_KEY)
  aws-secret-access-key   'aws[_.-]?secret[_.-]?(access[_.-]?)?key'  '([A-Za-z0-9+]|\\?/){40}'  ''  4000
  # source: RFC 3986 §3.2.1 (userinfo: "user:password" is deprecated, and "applications should not render as clear text any data after the first colon")
  # RFC 3986's userinfo: unreserved, percent-encoded, every sub-delim
  # (`!$&'()*+,;=`) and, past the first, `:`; a password holding `$&'(),;`
  # or a `:` was no match (v0.16.0; the colon, Codex, the /qaa of v0.16.1).
  url-password            '[A-Za-z][A-Za-z0-9+.-]{1,30}:(\\?/){2}[A-Za-z0-9._~!$&'"'"'()*+,;=%-]{0,64}:'  '[A-Za-z0-9._~!$&'"'"'()*+,;=%:-]{8,128}'  '@'  3000
  # source: none (the generic rule every scanner carries, its grammar and stopwords ours)
  generic-secret          "$KV_SECRET_WORDS"  '[A-Za-z0-9_+/=~.!@#%^*-]{12,100}'  ''  3500
  # source: RFC 7617 §2 (Basic: the base64 of a user-id, a colon and a password); RFC 9110 §11.6.2 (Authorization)
  http-basic-auth         "${KV_AUTHZ}[Bb][Aa][Ss][Ii][Cc][[:space:]]+"  '[A-Za-z0-9+/]{8,126}={0,2}'  ''  3000
  # source: RFC 6750 §2.1 (Bearer and its b64token); docs.github.com/en/rest/authentication/authenticating-to-the-rest-api (the `token` scheme)
  http-bearer-token       "${KV_AUTHZ}([Bb][Ee][Aa][Rr][Ee][Rr]|[Tt][Oo][Kk][Ee][Nn])[[:space:]]+"  '[A-Za-z0-9._~+/-]{16,126}={0,2}'  ''  3000
  # source: curl.se/docs/manpage.html (-u, --user <user:password>; -U, --proxy-user <user:password>)
  curl-user-password      "$KV_CURL_U"  "$KV_CURL_PW"  ''  3000
  # source: learn.microsoft.com/en-us/nuget/reference/nuget-config-file (packageSourceCredentials, ClearTextPassword); learn.microsoft.com/en-us/dotnet/framework/configure-apps/file-schema/appsettings/add-element-for-appsettings
  xml-key-value           "$KV_XML_ADD"  "$KV_XML_VAL"  ''  3000
  # source: none (the generic rule's weaker names, as every scanner's generic rule carries them; its judgement ours)
  generic-key             'key|auth|access|creds|api'  '[A-Za-z0-9_+/=~.!@#%^*-]{12,100}'  ''  3500
  # source: github.com/sidekiq/sidekiq/wiki/Comm-Installation (Pro and Enterprise credentials "look like username:password", set as BUNDLE_GEMS__CONTRIBSYS__COM or with bundle config gems.contribsys.com)
  # One bit a character: eight random hex digits fall under two about one
  # time in eight (`aaabbb31`), and only a run like `aaaabbbb` is no secret.
  sidekiq-credentials     "$KV_SIDEKIQ"  '[A-Za-z0-9]{8,64}'  ''  1000
  # source: none (the names from GitHub's list of supported secret scanning providers, docs.github.com supported-secret-scanning-patterns, as the coverage inventory; the judgement ours)
  service-secret          "$KV_SERVICE_WORDS"  '[A-Za-z0-9_+/=~.!@#%^*-]{12,100}'  ''  3000
)
# KV_WORDY: rules whose values a person writes, judged for words too.
declare -A KV_RAW=([url-password]=1 [http-basic-auth]=1 [http-bearer-token]=1
  [curl-user-password]=1 [xml-key-value]=1 [sidekiq-credentials]=1)
declare -A KV_WORDY=([url-password]=1 [generic-secret]=1 [http-basic-auth]=1
  [http-bearer-token]=1 [curl-user-password]=1 [xml-key-value]=1 [generic-key]=1
  [sidekiq-credentials]=1 [service-secret]=1)
# KV_PARTS: rules whose names say less (`key`, `auth`), so a value made of
# words is no secret either: two or more parts split at `-_./:~@+`, each a
# word, words joined in camel case, a number, or a letter and a number —
# a slug, a path, a cache key, a file name (kv_wordparts).
declare -A KV_PARTS=([generic-key]=1 [service-secret]=1)
# KV_EDGE: rules whose keyword starts a name, after a line's start or any
# byte but a letter or digit — a service's name is short, and `lob` sits in
# `global`. The edge joins the match, so it is masked with it.
declare -A KV_EDGE=([service-secret]=1)
# KV_NAMESTOP: rules whose match says the value is an identifier's when the
# name holds one of these words (`HEROKU_APP_ID`, `GITHUB_SHA`,
# `stripePriceId`): the value a service hands out with the secret, or a
# setting. kv_namestop splits the name at `_`, `.`, `-` and camel case.
declare -A KV_NAMESTOP=([service-secret]=1)
KV_NAME_STOPS=" id ids sid uid guid uuid url urls uri host hostname domain region zone site user username
  login name email org organization project account env environment version endpoint port dsn path dir
  file bucket queue topic channel team workspace model plan tier mode level enabled timeout limit count
  sha hash commit digest checksum ref branch tag run build job image repo repository price product
  customer sku list audience number phone from sender template locale lang theme size format type kind
  status flag feature rate index table database schema collection cluster instance client app slug
  owner location release publishable public pub tenant subscription group resource scope issuer kid "
# What a raw rule's hit prints before the value's length: group 1 of this
# ERE over the text before the value (the URL rule prints its scheme).
declare -A KV_SHOW_RE=([http-basic-auth]='([A-Za-z]+)[[:space:]]+$'
  [http-bearer-token]='([A-Za-z]+)[[:space:]]+$'
  [curl-user-password]='(-u|-U|--user|--proxy-user)[[:space:]=]*["'"'"']?[^:]*:$'
  [xml-key-value]='[Kk][Ee][Yy][[:space:]]*=[[:space:]]*["'"'"']([^"'"'"']*)["'"'"'][[:space:]]+[Vv][Aa][Ll][Uu][Ee]'
  [sidekiq-credentials]='([Cc][Oo][Nn][Tt][Rr][Ii][Bb][Ss][Yy][Ss])')
# A value that is base64 of `user:password` (Basic): judged as its password,
# or as its user where the password is empty (an API key sent as the user).
declare -A KV_B64USER=([http-basic-auth]=1)
# The generic rules: generic-secret yields to every rule but generic-key,
# and generic-key to every rule (kv_yields).
KV_GENERIC=generic-secret
KV_GENERIC2=generic-key
# service-secret yields to every rule, generic-key included: a value a rule
# with a stronger name holds is that rule's.
KV_SERVICE=service-secret
# The grammar after a keyword: up to 12 more name characters (`_key`,
# `word`, `_v2`; 20 let `id_token_signed_response_alg=` in), then an
# assignment — `=`, `:=` or `=>` after an optional closing quote and blanks,
# or `:` after a closing quote or before a blank, as JSON and YAML write it,
# so `credential:github-token` in this tool's own config is no assignment —
# then blanks and an opening quote. KV_KW keeps the keyword's ERE, for what
# a hit prints.
declare -A KV_PRE=() KV_VAL=() KV_JVAL=() KV_POST=() KV_MINH=() KV_KW=()
for (( k = 0; k < ${#KV_CREDENTIALS[@]}; k += 5 )); do
  id=${KV_CREDENTIALS[k]}
  if [[ -n "${KV_RAW[$id]+x}" ]]; then
    KV_PRE[$id]=${KV_CREDENTIALS[k + 1]}
  else
    kv_ci "${KV_CREDENTIALS[k + 1]}"
    KV_KW[$id]="($REPLY)"
    KV_PRE[$id]="($REPLY)[A-Za-z0-9_.-]{0,12}([\"']?[[:space:]]*(:=|=>|=)|[\"']?[[:space:]]*:[[:space:]]|[\"']:)[[:space:]]*[\"'\`]?"
    if [[ -n "${KV_EDGE[$id]+x}" ]]; then KV_PRE[$id]="(^|[^A-Za-z0-9])${KV_PRE[$id]}"; fi
  fi
  KV_JVAL[$id]=${KV_CREDENTIALS[k + 2]}
  KV_VAL[$id]=${KV_JVAL[$id]}
  # The first `{m,n}`, as no `}` comes before it in any row: `{m,}`.
  if [[ "${KV_JVAL[$id]}" =~ ^([^}]*\{[0-9]+),[0-9]+\}(.*)$ ]]; then
    KV_VAL[$id]="${BASH_REMATCH[1]},}${BASH_REMATCH[2]}"
  fi
  KV_POST[$id]=${KV_CREDENTIALS[k + 3]}
  KV_MINH[$id]=${KV_CREDENTIALS[k + 4]}
  CREDENTIALS+=("$id" "${KV_PRE[$id]}${KV_VAL[$id]}${KV_POST[$id]}")
done
# Fixed-format rules added after the keyword rules (v0.19.0), sourced from
# their issuers as every row is, and none from gitleaks; listed last so the
# suite's seeded stand-ins keep their order. Where an issuer states a prefix
# and no length, the body takes 16 characters at least: no issued token
# holds fewer than about 95 bits, and a shorter run after a prefix is a
# name or a stand-in (`shippo_test_key`).
CREDENTIALS+=(
  # source: docs.jfrog.com/user-management/docs/identity-tokens (API keys AKCp and 69 alphanumerics; reference tokens cmVmd and 59, 64 characters in all)
  jfrog-token                 'AKCp[A-Za-z0-9]{69}|cmVmd[A-Za-z0-9]{59}'
  # source: authress.io/knowledge-base/docs/authorization/service-clients/secrets-scanning (the issuer's own expression for its service client keys)
  authress-key                '(sc|ext|scauth|authress)_[A-Za-z0-9]{5,30}\.[A-Za-z0-9]{4,6}\.acc[_-][a-z0-9-]{10,32}\.([A-Za-z0-9+_=-]|\\?/){30,120}'
  # source: dev.maxmind.com/geoip/release-notes/2023-03-16-changes-to-maxmind-license-keys/ (40 characters of [a-zA-Z0-9_] ending in _mmk; "the length ... may increase")
  # Bounded, unlike the issuer: with no literal before it, an open run is
  # tried from every byte to the line's end, and a 400 KB line took past 60
  # s against 0.15 s at 100 (measured, git 2.53).
  maxmind-license-key         '[A-Za-z0-9_]{36,100}_mmk'
  # source: github.com/openshift/oauth-server pkg/server/crypto (SHA256Prefix "sha256~"; 256 random bits in unpadded URL-safe base64, 43 characters)
  openshift-token             'sha256~[A-Za-z0-9_-]{43}'
  # source: github.com/settlemint/sdk sdk/utils/src/logging/mask-tokens.ts (sm_pat_, sm_aat_ and sm_sat_, then alphanumerics)
  settlemint-token            'sm_(pat|aat|sat)_[A-Za-z0-9]{16,}'
  # source: docs.goshippo.com/docs/guides_general/authentication ("Live keys begin with shippo_live_", "Test keys begin with shippo_test_")
  shippo-token                'shippo_(live|test)_[A-Za-z0-9]{16,}'
  # source: developers.scalingo.com/tokens (tk-us- in its example)
  scalingo-token              'tk-us-[A-Za-z0-9_-]{16,}'
  # source: duffel.com/docs/api/overview/test-mode (test tokens "start with duffel_test_"; a live token, the page's other kind, as duffel_live_)
  duffel-token                'duffel_(test|live)_[A-Za-z0-9_-]{16,}'
  # source: github.com/Flutterwave SDK READMEs (FLWSECK-, FLWPUBK- and their _TEST forms, ending -X); developer.flutterwave.com ("Test keys will always have _TEST as prefix")
  flutterwave-key             'FLW(SEC|PUB)K(_TEST)?-[A-Za-z0-9]{16,}-X'
  # source: github.com/harness/harness-cli cmd/auth/login.go ("Token format: pat.AccountID.Random.Random")
  harness-token               'pat\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9]{16,}\.[A-Za-z0-9]{16,}'
  # source: experienceleague.adobe.com (App Builder server-to-server authentication: a sample OAUTHS2S_CLIENT_SECRET, p8e- and 32 more)
  adobe-client-secret         'p8e-[A-Za-z0-9_-]{32,}'
  # source: github.com/aws/aws-bedrock-token-generator-python (AUTH_PREFIX "bedrock-api-key-", then the base64 of a SigV4-presigned URL)
  aws-bedrock-key             'bedrock-api-key-([A-Za-z0-9+=]|\\?/){100,}'
  # source: github.com/infracost/ci pull 33 (v0.1 API keys ico-, CLI v2 tokens ics_v1_); "36 chars for new users" (an Infracost member, infracost/infracost issue 1975)
  infracost-token             'ico-[A-Za-z0-9]{32,}|ics_v1_[A-Za-z0-9_-]{16,}'
  # source: github.com/PrefectHQ/terraform-prefect-ecs-worker README (prefect_api_key = "pnu_…")
  prefect-token               'pnu_[A-Za-z0-9]{16,}'
  # source: alibabacloud.com/help/en/ram/developer-reference/api-ims-2019-08-15-listaccesskeys (AccessKey IDs in its examples begin LTAI, the rest masked)
  # A left edge, as deepseek-key's: `LTAI` inside base64 image data in two
  # SVGs read as keys (the v0.19.0 sweep), so it may not follow a base64
  # character, but may follow an escape.
  alibaba-access-key-id       '(^|[^A-Za-z0-9+/]|\\[a-z]|\\u[0-9A-Fa-f]{4}|\\x[0-9A-Fa-f]{2}|%[0-9A-Fa-f]{2})LTAI[A-Za-z0-9]{12,}'
  # v0.29.0, the formats v0.19.0 left untaken. Three from their issuers:
  # source: docs.readme.com/main/docs/readmes-mcp-server (README_API_KEY, "format: rdme_xxx..."): the prefix, no length, so 16 or more
  readme-key                  'rdme_[A-Za-z0-9]{16,}'
  # source: clickhouse.com/docs/resources/support-center/knowledge-base/integrations/terraform-example (a token_secret: 4b1d and 35 more, by example)
  # A left edge, as alibaba-access-key-id's: a hex run holds 4b1d.
  clickhouse-secret           '(^|[^A-Za-z0-9+/]|\\[a-z]|\\u[0-9A-Fa-f]{4}|\\x[0-9A-Fa-f]{2}|%[0-9A-Fa-f]{2})4b1d[A-Za-z0-9]{35,}'
# SPDX-SnippetBegin
# SPDX-SnippetCopyrightText: 2019 Zachary Rice
# SPDX-SnippetCopyrightText: 2026 KeMeK Network
# SPDX-License-Identifier: MIT
  # Six whose issuers state no format: gitleaks' shapes (v8.30.1), credited
  # in THIRD_PARTY_NOTICES.md, a fixed length taken as a least.
  # source: none (Octopus Deploy's docs print API-XXXX…); gitleaks: octopus-deploy-api-key
  octopus-key                 '(^|[^A-Za-z0-9+/]|\\[a-z]|\\u[0-9A-Fa-f]{4}|\\x[0-9A-Fa-f]{2}|%[0-9A-Fa-f]{2})API-[A-Z0-9]{26,}'
  # source: none (EasyPost's docs and SDKs state no format); gitleaks: easypost-api-token, easypost-test-api-token
  easypost-key                'EZ[AT]K[A-Za-z0-9]{54,}'
  # source: none (Frame.io's developer docs state no format); gitleaks: frameio-api-token
  frameio-token               'fio-u-[A-Za-z0-9_=-]{64,}'
  # source: none (42's API guide states no format); gitleaks: intra42-client-secret
  intra42-secret              's-s4t2(ud|af)-[0-9A-Fa-f]{64,}'
  # source: none (AWS prints no long-term Bedrock API key); gitleaks: aws-amazon-bedrock-api-key-long-lived
  # A left edge, as alibaba-access-key-id's: base64 holds ABSK. Its `/` as
  # JSON may write it, `\/`, as aws-bedrock-key's: one of 64 characters, so
  # four keys in five hold one in their first 109.
  aws-bedrock-long-term-key   '(^|[^A-Za-z0-9+/]|\\[a-z]|\\u[0-9A-Fa-f]{4}|\\x[0-9A-Fa-f]{2}|%[0-9A-Fa-f]{2})ABSK([A-Za-z0-9+]|\\?/){109,}'
  # source: none (Airtable: "do not rely on tokens having a particular length or format"); gitleaks: airtable-personnal-access-token
  airtable-token              'pat[A-Za-z0-9]{14}\.[a-f0-9]{64}'
# SPDX-SnippetEnd
)
ALL_CREDENTIALS=("${CREDENTIALS[@]}" "${PATH_CREDENTIALS[@]}")


# round(1000·log2 k) for k = 0..128: Shannon entropy in integer bash.
KV_LOG2=(0 0 1000 1585 2000 2322 2585 2807 3000 3170 3322 3459 3585 3700 3807
  3907 4000 4087 4170 4248 4322 4392 4459 4524 4585 4644 4700 4755 4807 4858
  4907 4954 5000 5044 5087 5129 5170 5209 5248 5285 5322 5358 5392 5426 5459
  5492 5524 5555 5585 5615 5644 5672 5700 5728 5755 5781 5807 5833 5858 5883
  5907 5931 5954 5977 6000 6022 6044 6066 6087 6109 6129 6150 6170 6190 6209
  6229 6248 6267 6285 6304 6322 6340 6358 6375 6392 6409 6426 6443 6459 6476
  6492 6508 6524 6539 6555 6570 6585 6600 6615 6629 6644 6658 6672 6687 6700
  6714 6728 6741 6755 6768 6781 6794 6807 6820 6833 6845 6858 6870 6883 6895
  6907 6919 6931 6943 6954 6966 6977 6989 7000)
# kv_entropy <value> -> REPLY: its entropy over bytes, in millibits per
# character: log2 n - Σ c·log2 c / n, for n bytes and each byte's count c.
kv_entropy() {
  local LC_ALL=C v=$1 n=${#1} i o s=0
  local -a cnt=()
  for (( i = 0; i < n; i++ )); do
    printf -v o '%d' "'${v:i:1}"
    cnt[o]=$(( ${cnt[o]:-0} + 1 ))
  done
  for o in "${cnt[@]}"; do s=$(( s + o * KV_LOG2[o] )); done
  REPLY=$(( KV_LOG2[n] - s / n ))
}
# kv_value <id> <match> -> REPLY: the value cut from a keyword rule's match,
# by the rule's own ERE in bash's regex (the system's, as git grep's is);
# status 1 if it does not split, and the match is then judged and printed
# as a whole.
kv_value() {
  local LC_ALL=C re="^(${KV_PRE[$1]})(${KV_VAL[$1]})${KV_POST[$1]}\$"
  REPLY=""
  [[ "$2" =~ $re ]] || return 1
  REPLY=${2:${#BASH_REMATCH[1]}}
  REPLY=${REPLY:0:${#REPLY}-${#KV_POST[$1]}}
}
# Words a person writes into a stand-in, never found in a random secret.
KV_STOPWORDS=(example sample dummy fake test mock demo placeholder changeme change_me your
  redacted insert replace secret password passwd token xxxx '****' todo foobar lorem)
# b64_text <base64> -> REPLY: the text it encodes, in bash; status 1 if a
# character is no base64 or a byte decodes to no printable ASCII.
B64_ALPHA=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/
ASCII_PRINT=' !"#$%&'"'"'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~'
b64_text() {
  local LC_ALL=C s=${1%%=*} i c p v=0 bits=0 o
  REPLY=""
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    p=${B64_ALPHA%%"$c"*}
    (( ${#p} < 64 )) || return 1
    v=$(( (v << 6) | ${#p} )); bits=$(( bits + 6 ))
    if (( bits >= 8 )); then
      bits=$(( bits - 8 )); o=$(( (v >> bits) & 255 )); v=$(( v & ((1 << bits) - 1) ))
      (( o >= 32 && o < 127 )) || return 1
      REPLY+=${ASCII_PRINT:o-32:1}
    fi
  done
}
# kv_weak <id> <value>: no secret. A placeholder's shape or too little
# entropy; in a rule a person writes values for (KV_WORDY), also no digit or
# no letter, a stopword, a dotted name (settings.SECRET_KEY) or an
# environment variable's name (MY_API_TOKEN). Judged at the hit only, as
# GitHub's checksum is: masking hides every match whatever this says. The
# substring tests (a placeholder's shape, a stopword) read a CRED_SLASH
# rule's value up to its first `/`, as is_placeholder does, which can only
# report more; entropy and the digit test read it whole, since a short
# prefix would look weak and hide a key.
kv_weak() { # id value [text before it] [raw: no Basic decoding]
  local LC_ALL=C v=$2 lv w min=${KV_MINH[$1]} user pw
  # The value's start its row reads, the value a bounded match held: a
  # judgement as before, and no bash loop over a megabyte.
  if [[ -z "${4-}" && "$v" =~ ^(${KV_JVAL[$1]}) ]]; then v=${BASH_REMATCH[1]}; fi
  if [[ -n "${KV_NAMESTOP[$1]+x}" && -n "${3-}" ]] && kv_namestop "$3"; then return 0; fi
  # Basic auth's user:password, a key's place either: Freshdesk, BambooHR
  # and Teamwork take the API key as the user and `X` as the password, and
  # the pair judged by its password alone was set aside (/qaa). Weak when
  # both are.
  if [[ -z "${4-}" && -n "${KV_B64USER[$1]+x}" ]] && b64_text "$v" && [[ "$REPLY" == *:* ]]; then
    user=${REPLY%%:*}; pw=${REPLY#*:}
    if [[ -n "$pw" ]] && ! kv_weak "$1" "$pw" "" raw; then return 1; fi
    [[ -n "$user" ]] || return 0
    if kv_weak "$1" "$user" "" raw; then return 0; fi
    return 1
  fi
  if is_placeholder "$v" "$1"; then return 0; fi
  kv_entropy "$v"
  if (( REPLY < min )); then return 0; fi
  [[ -n "${KV_WORDY[$1]+x}" ]] || return 1
  if [[ "$v" != *[0-9]* || "$v" != *[A-Za-z]* ]]; then return 0; fi
  lv=${v,,}
  if [[ -n "${CRED_SLASH[$1]+x}" ]]; then lv=${lv%%/*}; fi
  for w in "${KV_STOPWORDS[@]}"; do
    if [[ "$lv" == *"$w"* ]]; then return 0; fi
  done
  # A dotted name's parts are words: a part of 16 or more mixing upper case,
  # lower case and digits that does not split into camel-case words, runs of
  # capitals and short numbers (`base64EncodedString` does) is a token's,
  # as in a Vault `s.` token or a Discord bot token, which read as names and
  # were set aside (v0.16.0); a random part of 24 splits about 2% of times.
  if [[ "$v" =~ ^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+$ ]]; then
    local -a parts=()
    local p rnd=0
    IFS=. read -r -a parts <<< "$v"
    for p in "${parts[@]}"; do
      if (( ${#p} >= 16 )) && [[ "$p" == *[A-Z]* && "$p" == *[a-z]* && "$p" == *[0-9]* ]] &&
         ! [[ "$p" =~ ^[a-z]?([A-Z]?[a-z]{2,}|[A-Z]{2,}|[0-9]{1,4}|_)+$ ]]; then
        rnd=1
      fi
      # 32 or more hex digits with a letter and a digit: an Airtable token's
      # secret after `pat<id>.` (v0.19.0), a hash; never a word.
      if (( ${#p} >= 32 )) && [[ "$p" =~ ^[0-9a-f]+$ || "$p" =~ ^[0-9A-F]+$ ]] &&
         [[ "$p" == *[0-9]* && "$p" == *[A-Fa-f]* ]]; then
        rnd=1
      fi
    done
    if [[ "$rnd" -eq 0 ]]; then return 0; fi
  fi
  if [[ "$v" =~ ^[A-Z0-9_]+$ && "$v" == *_* ]]; then return 0; fi
  if [[ -n "${KV_PARTS[$1]+x}" ]] && kv_wordparts "$v"; then return 0; fi
  return 1
}
# kv_namestop <text before the value>: its name holds a KV_NAME_STOPS word.
kv_namestop() {
  local LC_ALL=C n=$1 w
  n=${n#[!A-Za-z0-9]}
  [[ "$n" =~ ^[A-Za-z0-9_.-]+ ]] || return 1
  n=${BASH_REMATCH[0]}
  while [[ "$n" =~ ^(.*[a-z0-9])([A-Z].*)$ ]]; do n="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"; done
  n=${n,,}
  for w in ${n//[_.-]/ }; do
    if [[ "$KV_NAME_STOPS" == *" $w "* ]]; then return 0; fi
  done
  return 1
}
# kv_wordparts <value>: two or more parts at `-_./:~@+`, every one a word's
# (KV_PARTS). A random part all but never is: across 20,000 draws each, two
# or more random alphanumeric parts split so under 0.4% of the time, and
# lower case with digits 1.6% for two parts of 8, 3.8% for four of 4 — the
# rule's names are weak, and its stand-ins are words (measured, v0.18.0).
KV_WORD_RE='^([A-Za-z]|[0-9]{1,6}|[A-Za-z][0-9]{1,6}|([A-Z]?[a-z]{2,}|[A-Z]{2,})+([0-9]{1,6}([A-Z]?[a-z]{2,}|[A-Z]{2,})+)*[0-9]{0,6})$'
# One camel-case name in whole words: lower case, capitalised words and
# numbers, a capitalised word last but for a number or an acronym after it.
KV_CAMEL_RE='^[a-z]{2,}([A-Z][a-z]{2,}|[0-9]{1,4})*[A-Z][a-z]{2,}([0-9]{1,4}|[A-Z]{2,5}|[A-Z][0-9]{1,2})?$'
# kv_call <id> <hit> <match> <text before the value>: in a rule that reads
# word parts (KV_PARTS), the value is a function's name — the match runs
# into `(` on its line, as in `applicationServerKey:
# urlBase64ToUint8Array(vapidKey)` — so code, not a literal (v0.25.2). The
# line is searched for the match and `(`: the same match elsewhere on the
# line, unquoted and called, is all it could mistake. A value after an
# opening quote is a literal whatever follows it: `key = "<key>(x)"` read
# as a call, set aside, exit 0 (Codex, the /qaa of main..dev); the quote is
# in the match, so the search finds it quoted too.
kv_call() {
  [[ -n "${KV_PARTS[$1]+x}" && "$4" != *[\"\'\`] && "${H_TEXT[$2]}" == *"$3("* ]]
}
kv_wordparts() {
  local LC_ALL=C p n=0 v=$1 one=""
  local -a parts=()
  # A TypeScript non-null read (`signer!.privatePkcs8`) is a property
  # access: its parts are the names it reads (v0.25.1). `?.` needs no such
  # reading: `?` ends a value.
  v=${v//\!./.}
  IFS='-_./:~@+' read -r -a parts <<< "$v"
  for p in "${parts[@]}"; do
    [[ -n "$p" ]] || continue
    [[ "$p" =~ $KV_WORD_RE ]] || return 1
    one=$p
    n=$(( n + 1 ))
  done
  # Two parts, or one camel-case name (`createPrivateKey`, `privatePkcs8`):
  # code (v0.25.1, from four such names the fleet sweep reported as keys in
  # a test file). One name is held to whole words (KV_CAMEL_RE): any word
  # part with a hump set aside 1.9% of random runs of 16, keys among them
  # (`VqmCplppjs46Lmue`); whole words take 0.06% (/qaa).
  (( n >= 2 )) || [[ "$one" =~ $KV_CAMEL_RE ]]
}
# kv_overlaps <id> <match> <keys, one per line> [text] [cache id]: the
# match's value and one of the keys hold one another, so it is that key's
# rule's (kv_yields). Given the text the match came from, a partial overlap
# counts too: a value capped at 100 that starts before a key and ends inside
# it (`ghs_<n>_<JWT>`) holds neither whole, and was reported beside the key
# (corpus harness, v0.16.1). That one is judged by position, never by text:
# every place the match sits in the text must have its value touch the key
# there — v0.16.1 compared their first 16 bytes, and a client secret that
# opened like an allowed JWT on its line was dropped, exit 0 (Codex, the
# /qaa of v0.16.1). Holding one another stays a text test: a key held in a
# value lies in the value's own bytes. The masking passes no text, so a
# value's bytes outside a key never print for a partial overlap.
# A line's key places are found once (kv_spans, by the cache id: the line
# and its key set) and searched by position, each key once: v0.16.2 searched
# the line for every candidate key at every match, and a line holding
# `SECRET=ab12_<JWT>` a hundred times ran past two minutes (Codex, /cxr
# 148aa93). Offsets are bytes (the C locale), in the index as in the match.
declare -A KV_YIELDS=() KV_LINE_ID=() KV_KEYS=()
KV_LINE_N=0
# kv_lines <text>: KV_ARR = its non-empty lines, split in memory. A `read`
# loop over a here-string reads a pipe one byte at a time, and kv_overlaps
# and kv_yields ran one per match over every key on the line.
kv_lines() {
  local -
  local IFS=$'\n'
  set -f
  KV_ARR=($1)
}
# kv_spans <cache id> <text>: every place each key in KV_ARR sits in the
# text, sorted by start: KV_SS starts, KV_SE ends, KV_SK the key, KV_SM the
# largest end so far. One line's index is kept: kv_yields judges a hit's
# matches one after another, all on its line.
KV_SPAN_ID=""
kv_spans() {
  local LC_ALL=C k n mx=0 txt=$2
  local -a at=() ak=() we=() wk=()
  if [[ -n "$1" && "$1" == "$KV_SPAN_ID" ]]; then return 0; fi
  KV_SS=(); KV_SE=(); KV_SK=(); KV_SM=()
  for n in "${!KV_ARR[@]}"; do
    kv_places "$txt" "${KV_ARR[n]}"
    for k in $REPLY; do at[k]+="$(( k + ${#KV_ARR[n]} )) "; ak[k]+="$n "; done
  done
  for k in "${!at[@]}"; do
    we=(${at[k]}); wk=(${ak[k]})
    for n in "${!we[@]}"; do
      if (( we[n] > mx )); then mx=${we[n]}; fi
      KV_SS+=("$k"); KV_SE+=("${we[n]}"); KV_SK+=("${KV_ARR[wk[n]]}"); KV_SM+=("$mx")
    done
  done
  KV_SPAN_ID=$1
}
# kv_places <text> <needle> -> REPLY: every offset the needle starts at,
# overlapping places included. bash's regex finds the leftmost place, the
# quoted needle read literally; `${rest%%"$2"*}` tries a match at every
# offset and was ten times slower on a long line (measured).
kv_places() {
  local LC_ALL=C rest=$1 p k=0
  REPLY=""
  while [[ $rest =~ "$2"(.*)$ ]]; do
    p=$(( ${#rest} - ${#BASH_REMATCH[1]} - ${#2} ))
    k=$(( k + p )); REPLY+="$k "
    rest=${rest:p+1}; k=$(( k + 1 ))
  done
}
# A key holds the value: one search of the key list, whose newlines no value
# holds. A partial overlap's key is judged at the place the index names.
kv_overlaps() {
  local LC_ALL=C v t vs=0 m=$2 txt=${4-} o s e i lo hi mid hit=0 places
  if kv_value "$1" "$2"; then v=$REPLY; vs=${#BASH_REMATCH[1]}; else v=$2; fi
  # Since the match runs to the value's end (v0.29.5) a value can hold a key
  # and far more. At the hit the value is the start a bounded match held, so
  # every yield is as it was; the masking, which passes no text, yields only
  # to a key holding the whole value, so no byte of the value outside a key
  # prints: v0.29.4 yielded to a key the value held, and printed the rest
  # (`SECRET=ab12_<key>`, the tail of a long value).
  if [[ -z "${4+x}" ]]; then [[ "$3" == *"$v"* ]]; return; fi
  if [[ -n "${KV_JVAL[$1]+x}" && "$v" =~ ^(${KV_JVAL[$1]}) ]]; then v=${BASH_REMATCH[1]}; fi
  kv_lines "$3"
  [[ ${#KV_ARR[@]} -gt 0 ]] || return 1
  if [[ "$3" == *"$v"* ]]; then return 0; fi
  for t in "${KV_ARR[@]}"; do
    if (( ${#t} <= ${#v} )) && [[ "$v" == *"$t"* ]]; then return 0; fi
  done
  [[ -n "${4+x}" ]] || return 1
  if [[ "$3" != *"${v:0:16}"* ]]; then
    for t in "${KV_ARR[@]}"; do
      if [[ "$v" == *"${t:0:16}"* ]]; then hit=1; break; fi
    done
    [[ "$hit" -eq 1 ]] || return 1
  fi
  kv_places "$txt" "$m"
  # Kept apart: kv_spans' own kv_places replace REPLY, and the first match
  # judged on a line read the last key's places (fuzzed against v0.16.2).
  places=$REPLY
  [[ -n "$places" ]] || return 1
  kv_spans "${5-}" "$txt"
  for o in $places; do
    s=$(( o + vs )); e=$(( s + ${#v} )); hit=0
    lo=0; hi=${#KV_SS[@]}
    while (( lo < hi )); do
      mid=$(( (lo + hi) / 2 ))
      if (( KV_SS[mid] < e )); then lo=$(( mid + 1 )); else hi=$mid; fi
    done
    i=$(( lo - 1 ))
    while (( i >= 0 )) && (( KV_SM[i] > s )); do
      t=${KV_SK[i]}
      if (( KV_SE[i] > s )) && [[ "$v" == *"${t:0:16}"* || "$t" == *"${v:0:16}"* ]]; then hit=1; break; fi
      i=$(( i - 1 ))
    done
    [[ "$hit" -eq 1 ]] || return 1
  done
}
# kv_show <id> <match> -> REPLY: what a keyword rule's hit prints.
kv_show() {
  local LC_ALL=C kw="" n=${#2} pre=$2
  if kv_value "$1" "$2"; then n=${#REPLY}; pre=${BASH_REMATCH[1]}; fi
  if [[ -n "${KV_SHOW_RE[$1]+x}" ]]; then
    if [[ "$pre" =~ ${KV_SHOW_RE[$1]} ]]; then kw=${BASH_REMATCH[1]}; fi
  elif [[ -n "${KV_RAW[$1]+x}" ]]; then
    kw="${2%%:*}://"
  elif [[ "$2" =~ ${KV_KW[$1]} ]]; then
    kw=${BASH_REMATCH[0]}
  fi
  REPLY="$kw[redacted, $n chars]"
}

# Rules with a left edge, and the literal each one's key begins with.
declare -A CRED_KEYSTART=([deepseek-key]='sk-' [alibaba-access-key-id]='LTAI' [huggingface-token]='hf_'
  [square-token]='EAAA' [facebook-token]='EAA' [clickhouse-secret]='4b1d' [octopus-key]='API-' [aws-bedrock-long-term-key]='ABSK')
# cred_key <id> <match>: the match cut to start at its key -> REPLY.
cred_key() {
  REPLY=$2
  local ks=${CRED_KEYSTART[$1]:-} pre
  # Only past a left edge, 6 bytes at most (`\u0022`): a rule's other
  # branch can hold the literal in its secret (facebook-token's
  # `<app id>|<secret>`, EAA in the secret), and a cut there printed the
  # secret's head unmasked in a name (/qaa).
  if [[ -n "$ks" && "$REPLY" != "$ks"* && "$REPLY" == *"$ks"* ]]; then
    pre=${REPLY%%"$ks"*}
    if (( ${#pre} <= 6 )); then REPLY=${REPLY:${#pre}}; fi
  fi
}

# ─── temp dir and error masking ───────────────────────────────────────
# Absolute: the cds to --root and the top level come after it.
tmp_base=${TMPDIR:-/tmp}
[[ "$tmp_base" == /* ]] || tmp_base="$PWD/$tmp_base"
TMPD="$(mktemp -d "$tmp_base/leakcheck.XXXXXX")" || die "cannot create a temp dir"
# Scan the objects a push publishes, in every git call from here on: replace
# refs and a local info/grafts file both rewrite what git shows, and a graft
# that makes HEAD a root hid a leak from --history, exit 0 (found by /cxr,
# reproduced). A graft file that does not exist turns grafts off with no
# output; GIT_GRAFT_FILE=/dev/null also does, but prints the deprecation hint
# in every repo, which run_git rightly reads as a scan error (both measured).
export GIT_NO_REPLACE_OBJECTS=1
export GIT_GRAFT_FILE="$TMPD/no-grafts"
# Pathspec magic is the script's to choose: GIT_LITERAL_PATHSPECS=1 made
# `:(literal).leakcheckrc.local` a filename matching nothing, and a committed
# .leakcheckrc.local in history then read clean, exit 0 (measured).
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
mkdir "$TMPD/subj"

in_c() { LC_ALL=C "$@"; } # pat_args says why the C locale

# lines_of <string>: how many lines a record takes in a subject file (a path
# or text may hold a newline) -> REPLY. By length difference, in C: bash's
# `${1//[!$'\n']/}` grows with the square of the length, and a hit on a
# 200 KB line took 19 s, a 1.8 MB one minutes; deleting a literal is linear.
lines_of() {
  local LC_ALL=C
  local nl=${1//$'\n'/}
  REPLY=$(( ${#1} - ${#nl} + 1 ))
}

# mask_git <git args...>: git over the masking's own files in $TMPD/subj,
# with no GIT_* variable and no global or system config of the caller's. A
# setting that makes every git call write to stderr (GIT_TRACE, a trace2
# target, a deprecated key) failed the masking too, and the error being
# masked was withheld for a fixed line (/qaa, v0.11.8).
mask_git() {
  ( unset "${!GIT_@}"
    export HOME="$TMPD" XDG_CONFIG_HOME="$TMPD" GIT_CONFIG_NOSYSTEM=1
    in_c git -C "$TMPD/subj" "$@" )
}

# run_git <label> <out-file> <command...>: stdout to <out-file>. Exit 0 or
# 1 is a result; any other status, or ANY stderr, is a scan error. git grep
# reports an unreadable worktree file on stderr and still exits 1, which
# would otherwise read as "no match" (measured, git 2.53).
run_git() {
  local label=$1 out=$2 rc=0
  shift 2
  "$@" > "$out" 2> "$TMPD/err" || rc=$?
  if [[ $rc -gt 1 || -s "$TMPD/err" ]]; then
    fail_err "leakcheck: scan error: $label (git exited $rc)"
  fi
  return 0
}
# fail_err <line>: fail with it, then the stderr in $TMPD/err, indented.
fail_err() {
  local -a fe=()
  mapfile -t fe < "$TMPD/err"
  fail "$1" "${fe[@]/#/  }"
}

# is_placeholder <match>: a stand-in, not a key. Each test is something a
# random secret all but never does — 8 equal characters in a row, or 8
# letters or digits counting up, is under one in a million even for a
# 64-character hex key — and that docs and fixtures do all the time: an
# X-filled key, an alphabet run, AWS's documented key ending in EXAMPLE.
# A run of `A` does not count: it is base64 for zero bytes, and a format
# holding zero-filled fields has one in every real key — OpenSSH's
# unencrypted private key (measured: nine As in its first 64 characters),
# and by its msgpack layout Fly.io's macaroon token. Except in a rule listed
# in CRED_ARUN, whose keys are no base64 of binary: there `A` counts in a
# run, and a match at least 1/N `A` (N per rule) is zero bytes too. Base64
# of mostly-zero binary (a font, a protobuf) read as an AWS key id or a
# Facebook token, its `A`s often broken into runs of fewer than eight
# (corpus harness, v0.12.0). N is the largest share a random key all but
# never reaches: half of an AWS id (1e-8), an eighth of a Facebook token
# (7e-7 at its shortest, 104 characters; less for longer ones).
# A private-key header is never a placeholder: the body after it is base64
# of a structured format, and the rule's key-after-the-header requirement is
# what tells a fixture from a key.
# A classic GitHub token whose checksum fails is a stand-in too
# (checksum_fails, at the hit), though never left unmasked for it.
# checksum_fails <match>: a classic GitHub token, `gh[pousr]_` and exactly
# 36 more, whose last six are not the CRC-32 (IEEE, zlib's) of the 30 before
# them in base62 (0-9A-Za-z), zero-padded — GitHub's checksum, "in the last
# 6 digits of each token" (GitHub engineering blog, 2021). The byte-level
# scheme (body alone, that alphabet order) is third-party, and was confirmed
# on a real gho_ token, pass/fail only, with the operator's consent
# (v0.13.0): of four candidate schemes exactly this one passed. A longer run
# is no classic token whose checksum is known (GitHub plans for 255
# characters; the stateless ghs_ carry a JWT), so it never fails here; nor
# does an npm_ token, whose scheme npm states but nothing here confirmed.
# It judges hits only: masking still hides a token whose checksum fails, so
# a scheme confirmed on one token type can cost a report, never a print.
CRC_T=()
checksum_fails() { # match
  local LC_ALL=C m=$1 i k c o crc=4294967295 sum=""
  [[ ${#m} -eq 40 ]] || return 1
  if [[ ${#CRC_T[@]} -eq 0 ]]; then
    for (( i = 0; i < 256; i++ )); do
      c=$i
      for (( k = 0; k < 8; k++ )); do
        if (( c & 1 )); then c=$(( 0xEDB88320 ^ (c >> 1) )); else c=$(( c >> 1 )); fi
      done
      CRC_T[i]=$c
    done
  fi
  for (( i = 4; i < 34; i++ )); do
    printf -v o '%d' "'${m:i:1}"
    crc=$(( CRC_T[(crc ^ o) & 255] ^ (crc >> 8) ))
  done
  crc=$(( crc ^ 4294967295 ))
  for (( k = 0; k < 6; k++ )); do
    sum=${B62:crc % 62:1}$sum; crc=$(( crc / 62 ))
  done
  [[ "$sum" != "${m:34:6}" ]]
}
B62=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
declare -A CRED_ARUN=([aws-access-key-id]=2 [facebook-token]=8)
# CRED_SLASH: the rules whose body takes `/` (or `\/`) as a body character,
# so text after a key joins its match: a real key followed by `/XXXXXXXX`
# read as a stand-in and was set aside, exit 0. In these the test judges
# the match up to its first `/` alone: a prefix holds a stand-in's shape
# only if the whole match does, so this sets nothing more aside. A rule
# whose body is widened to take `/` belongs here; the webhook rules never
# do: their `/` ends a segment, and their stand-in is the secret segment.
# The long-term Bedrock key (v0.29.0) and the Authorization header's two
# rules took `/` and were left out: `ABSK<key>/XXXXXXXX` was a stand-in
# (Codex, the /qaa of main..dev).
declare -A CRED_SLASH=([webhook-signing-secret]=1 [grafana-token]=1 [sentry-token]=1
  [1password-token]=1 [flyio-token]=1 [jwt]=1 [generic-secret]=1 [generic-key]=1
  [authress-key]=1 [aws-bedrock-key]=1 [service-secret]=1
  [aws-bedrock-long-term-key]=1 [http-basic-auth]=1 [http-bearer-token]=1)
# is_placeholder <match> [rule id]: a stand-in's shape (ph_shape), and for
# a rule in CRED_OPENED, in the shortest start of the match the rule still
# matches too. v0.12.0 opened these eight fixed lengths at their end
# (`{36}` to `{36,}`), so letters and digits glued after a key joined the
# match: a real key followed by `12345678` read as a stand-in, set aside,
# exit 0, and printed whole in an error (to v0.16.0; the shortest start is
# the key's length the old rule judged, or less). Both, never the start
# instead: a start holds a stand-in's shape only if the whole match does,
# so this sets nothing more aside. A rule open on main stays judged whole:
# there a stand-in's shape past the shortest key (`sk_test_<20>example`, a
# run of `A` far into a Facebook match of zero-byte base64) is a measured
# stand-in, not a tail. Every later rule whose length its source fixes,
# by statement or by example, and which takes it as a least is one of these
# too; v0.19.0's three and v0.29.0's five were left out, and an Octopus key
# followed by `12345678` was a stand-in (Codex, the /qaa of main..dev).
declare -A CRED_OPENED=([github-token]=1 [npm-token]=1 [groq-key]=1 [perplexity-key]=1
  [xai-key]=1 [atlassian-token]=1 [heroku-key]=1 [terraform-cloud-token]=1
  [adobe-client-secret]=1 [infracost-token]=1 [clickhouse-secret]=1 [octopus-key]=1
  [easypost-key]=1 [frameio-token]=1 [intra42-secret]=1 [aws-bedrock-long-term-key]=1)
is_placeholder() { # match [rule id]
  ph_shape "$@" || return 1
  [[ -n "${2:-}" && -n "${CRED_OPENED[$2]+x}" ]] || return 0
  cred_shortest "$2" "$1" || return 0
  ph_shape "$REPLY" "$2"
}
# cred_shortest <id> <match> -> REPLY: the shortest start of the match the
# rule matches whole, by bash's =~ (the system's regex, as kv_value's);
# status 1 if none is shorter, or none within 512 bytes — every rule's
# shortest key is far shorter, and a cap keeps a long match from costing
# one regex run per byte.
cred_shortest() {
  local LC_ALL=C k re="" n
  for (( k = 0; k < ${#CREDENTIALS[@]}; k += 2 )); do
    if [[ "${CREDENTIALS[k]}" == "$1" ]]; then re="^(${CREDENTIALS[k + 1]})\$"; break; fi
  done
  [[ -n "$re" ]] || return 1
  for (( n = 1; n < ${#2} && n <= 512; n++ )); do
    if [[ "${2:0:n}" =~ $re ]]; then REPLY=${2:0:n}; return 0; fi
  done
  return 1
}
# The walk goes by 256-byte chunks: `${m:i:1}` measures all of m each time,
# so one character at a time grew with the square of the match's length (a
# 200 KB match took 20 s); `pc` carries the previous character across.
ph_shape() { # match [rule id]
  local LC_ALL=C m=$1 i c o prev=-2 same=0 up=0 arun=0 zs share off ch pc=""
  if [[ -n "${2:-}" && -n "${CRED_SLASH[$2]+x}" ]]; then m=${m%%/*}; fi
  if [[ "$m" == *EXAMPLE* || "$m" == *example* ]]; then return 0; fi
  if [[ -n "${2:-}" && -n "${CRED_ARUN[$2]+x}" ]]; then
    arun=1; share=${CRED_ARUN[$2]}; zs=${m//A/}
    if (( (${#m} - ${#zs}) * share >= ${#m} )); then return 0; fi
  fi
  for (( off = 0; off < ${#m}; off += 256 )); do
    ch=${m:off:256}
    for (( i = 0; i < ${#ch}; i++ )); do
      c=${ch:i:1}
      printf -v o '%d' "'$c"
      if (( o == prev )) && [[ "$c" != A || $arun -eq 1 ]]; then same=$((same + 1)); else same=1; fi
      if (( o == prev + 1 )) && [[ "$c" == [A-Za-z0-9] && "$pc" == [A-Za-z0-9] ]]; then
        up=$((up + 1))
      else
        up=1
      fi
      if (( same >= 8 || up >= 8 )); then return 0; fi
      prev=$o; pc=$c
    done
  done
  return 1
}

# Every built-in rule over FILEs in $TMPD/subj, whatever this config runs:
# `disable` and `no-credentials` choose which hits to look for, never which
# keys may print. One rule per -o grep, since git resumes after a match and
# with every rule in one grep a key swallowed the start of the key after it
# (/qaa, v0.11.5); one grep with them all first says whether any is needed.
# OUT gets <id>\0<file>\0<line>\0<match>\n per match.
cred_matches_all() { # out label file...
  local out=$1 label=$2 k f l m
  shift 2
  local -a cre=()
  for (( k = 1; k < ${#CREDENTIALS[@]}; k += 2 )); do cre+=(-e "${CREDENTIALS[k]}"); done
  : > "$out"
  run_git "credential rules ($label)" "$TMPD/cmatch" \
    mask_git grep --no-index -a -l -E "${cre[@]}" -- "$@"
  [[ -s "$TMPD/cmatch" ]] || return 0
  for (( k = 0; k < ${#CREDENTIALS[@]}; k += 2 )); do
    run_git "credential rule ${CREDENTIALS[k]} ($label)" "$TMPD/cmatch" \
      mask_git grep --no-index -a -z -n -o --no-color --no-column -E -e "${CREDENTIALS[k + 1]}" -- "$@"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
      cred_key "${CREDENTIALS[k]}" "$m"
      printf '%s\0%s\0%s\0%s\n' "${CREDENTIALS[k]}" "$f" "$l" "$REPLY"
    done < "$TMPD/cmatch" >> "$out"
  done
}

# TEXT with each run of hidden bytes shown as its first four and its length,
# a hit's mask; HIDE names an associative array keyed PREFIX<byte offset>.
render_masked() { # text hide-array prefix [shown] -> REPLY
  local LC_ALL=C t=$1 pre=$3 shown=${4:-4} k run=-1
  local -n rm_hide=$2
  REPLY=""
  for (( k = 0; k <= ${#t}; k++ )); do
    if [[ $k -lt ${#t} && -n "${rm_hide[$pre$k]+x}" ]]; then
      if [[ $run -lt 0 ]]; then run=$k; fi
      continue
    fi
    if [[ $run -ge 0 ]]; then
      REPLY+="${t:run:shown}[redacted, $(( k - run )) chars]"; run=-1
    fi
    if [[ $k -lt ${#t} ]]; then REPLY+=${t:k:1}; fi
  done
}

# The literal form of a rule, for the key scan only, never printed: a `\`
# before punctuation dropped, a one-character bracket such as `[.]`
# unwrapped, and parentheses dropped, so `SG\.(<body>)\.(<body>)` reads as
# the key it matches (/cxr, v0.11.4). `(?i)` is dropped whole: its `i` left
# before a key would fail a rule's left edge (`(?i)sk\-<hex>`). LIT_MAP[i] is the offset in the rule
# of the literal form's i-th byte. An alternation, a quantifier or a wider
# bracket has no literal form; the README says so.
literal_form() {
  local LC_ALL=C s=$1 i=0 c d
  LIT=""; LIT_MAP=()
  while (( i < ${#s} )); do
    c=${s:i:1}; d=${s:i+1:1}
    if [[ "${s:i:4}" == '(?i)' ]]; then
      i=$(( i + 4 ))
    elif [[ "$c" == '\' && -n "$d" && "$d" != [A-Za-z0-9] ]]; then
      LIT+=$d; LIT_MAP+=("$(( i + 1 ))"); i=$(( i + 2 ))
    elif [[ "$c" == '[' && -n "$d" && "${s:i+2:1}" == ']' && "$d" != ']' && "$d" != '^' && "$d" != '\' && "$d" != '[' ]]; then
      LIT+=$d; LIT_MAP+=("$(( i + 1 ))"); i=$(( i + 3 ))
    elif [[ "$c" == '(' || "$c" == ')' ]]; then
      i=$(( i + 1 ))
    else
      LIT+=$c; LIT_MAP+=("$i"); i=$(( i + 1 ))
    fi
  done
}

# mask_texts <array> <label>: each element masked in place by every built-in
# rule, whatever this config runs: `disable` and `no-credentials` say which
# hits to look for, not which keys may be printed, and an allow rule naming a
# disabled rule's key printed it raw (/qaa, v0.11.2). An element may be a
# regex — an allow rule, or an error message quoting a pattern — so a careful
# writer's escaped punctuation (`SG\.<body>\.<body>`) matches no rule as
# written: the rules also run over its literal form, and what they find there
# masks the element's own bytes (literal_form's map). The as-written scan
# stays for what the literal form loses — a backslash a rule's class accepts —
# and both scans mark bytes of the one text, so neither can unmask the
# other's key: v0.11.4 showed the literal form instead, and a key only the
# as-written scan found was no longer there to mask (/cxr, v0.11.4).
# Elements hold no newline.
mask_texts() { # array label
  local -n mt_text=$1
  local LC_ALL=C r f l m t o s e k n cid marker
  local -a lit=() maps=() map=()
  local -A hide=() touched=()
  [[ ${#mt_text[@]} -gt 0 ]] || return 0
  for r in "${!mt_text[@]}"; do
    literal_form "${mt_text[r]}"
    lit+=("$LIT"); maps+=("${LIT_MAP[*]}")
  done
  printf '%s\n' "${mt_text[@]}" > "$TMPD/subj/as-written"
  printf '%s\n' "${lit[@]}" > "$TMPD/subj/literal"
  cred_matches_all "$TMPD/rmatch" "$2" as-written literal
  # A keyword rule's match yields to a fixed-format rule's key that holds its
  # value: that rule's mask prints it (kv_overlaps).
  local -A fixed=()
  while IFS= read -r -d '' cid && IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
    if [[ -z "${KV_VAL[$cid]+x}" ]]; then fixed["$f:$l"]+="$m"$'\n'; fi
  done < "$TMPD/rmatch"
  while IFS= read -r -d '' cid && IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
    [[ "$l" =~ ^[0-9]+$ && -n "${mt_text[l - 1]+x}" ]] || die "internal error: $2 mask returned line $l"
    if [[ -n "${KV_VAL[$cid]+x}" && -n "${fixed["$f:$l"]+x}" ]] &&
       kv_overlaps "$cid" "$m" "${fixed["$f:$l"]}"; then
      continue
    fi
    # A private-key header is never a placeholder, as for a hit, and the key
    # after it runs to the end of the element, not the 64 characters the rule
    # reads: a one-line key printed whole after its header (/qaa, v0.11.5).
    marker=0
    for k in "${CRED_MARKERS[@]}"; do
      if [[ "$k" == "$cid" ]]; then marker=1; fi
    done
    # A keyword rule's match is masked whatever its value: its value is
    # judged at the hit only (kv_weak), and judged here as a whole match a
    # name holding `example` printed the value (`--password_example=…`,
    # /qaa, v0.16.1).
    if [[ $marker -eq 0 && -z "${KV_VAL[$cid]+x}" ]] && is_placeholder "$m" "$cid"; then continue; fi
    r=$(( l - 1 ))
    case "$f" in
      as-written) t=${mt_text[r]}; map=() ;;
      literal) t=${lit[r]}; read -r -a map <<< "${maps[r]}" ;;
      *) die "internal error: $2 mask returned file $f" ;;
    esac
    # Every occurrence, overlapping ones included; a key the scan found and
    # this cannot place must not print, so that is a scan error.
    o=0; n=0
    while [[ "${t:o}" == *"$m"* ]]; do
      s=${t:o}; s=${s%%"$m"*}; o=$(( o + ${#s} )); e=$(( o + ${#m} - 1 ))
      if [[ "$f" == literal ]]; then s=${map[o]}; e=${map[e]}; else s=$o; fi
      if [[ $marker -eq 1 ]]; then e=$(( ${#mt_text[r]} - 1 )); fi
      for (( k = s; k <= e; k++ )); do hide[$r:$k]=1; done
      touched[$r]=1; o=$(( o + 1 )); n=$(( n + 1 ))
    done
    (( n > 0 )) || die "internal error: $2 mask could not place a match in line $l"
  done < "$TMPD/rmatch"
  # Runs from two scans that touch are one run.
  for r in "${!touched[@]}"; do
    render_masked "${mt_text[r]}" hide "$r:"
    mt_text[r]=$REPLY
  done
}

# ─── command line, repo and config paths ─────────────────────────────
# Checked only now that an error is masked: each check below repeats what
# the caller wrote (fail). First the argument the loop stopped at; usage
# reads "$0", so before any cd.
if [[ -n "$ARG_ERR" ]]; then FAIL_USAGE=1; die "$ARG_ERR"; fi

# The range reaches git as a revision argument, so an option-shaped value
# (`--all`, `--since=…`, `--first-parent`) would change what the walk means
# instead of naming commits.
case "$HIST_RANGE" in
  -*) die "--history-range takes a revision range, not an option: $HIST_RANGE" ;;
esac
if [[ -n "$FORMAT_ARG" ]]; then
  case "$FORMAT_ARG" in
    text|json|sarif|csv|junit) ;;
    *) FAIL_USAGE=1; die "unknown format: $FORMAT_ARG (text, json, sarif, csv or junit)" ;;
  esac
  # --json is --format json; with any other format it is a contradiction.
  if [[ "$JSON_FLAG" -eq 1 && "$FORMAT_ARG" != json ]]; then
    die "--json and --format $FORMAT_ARG disagree; pass one"
  fi
  OUTPUT_MODE=$FORMAT_ARG
fi

if [[ -n "$ROOT" ]]; then
  cd -- "$ROOT" 2>/dev/null || die "cannot cd to $ROOT"
fi

# An explicit --config resolves against the cwd as it stands now: after
# --root ("run as if started in DIR", as `git -C` means it) and before the
# move to the top level below, so a relative path typed in a subdirectory
# still means what it says. A named config that is missing is an error —
# proceeding on defaults alone is a confident clean pass over a repo that
# nothing the caller asked for actually checked.
CONFIG_ABS=""
if [[ -z "$CONFIG_FILE" && -n "${LEAKCHECK_CONFIG-}" ]]; then CONFIG_FILE=$LEAKCHECK_CONFIG; fi
if [[ -n "$CONFIG_FILE" ]]; then
  [[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE"
  [[ -r "$CONFIG_FILE" ]] || die "config not readable: $CONFIG_FILE"
  cfg_dir="$(cd -- "$(dirname -- "$CONFIG_FILE")" && pwd -P)" \
    || die "cannot resolve config path: $CONFIG_FILE"
  CONFIG_ABS="$cfg_dir/$(basename -- "$CONFIG_FILE")"
fi

# A baseline resolves as --config does. One named and missing is an error:
# reading none would report every finding a baseline was meant to hold.
abs_path() { # path -> REPLY, its directory resolved
  local d
  d="$(cd -- "$(dirname -- "$1")" 2>/dev/null && pwd -P)" || die "cannot resolve path: $1"
  REPLY="$d/$(basename -- "$1")"
}
if [[ -n "$BASELINE_IN" ]]; then
  [[ -f "$BASELINE_IN" ]] || die "baseline not found: $BASELINE_IN"
  [[ -r "$BASELINE_IN" ]] || die "baseline not readable: $BASELINE_IN"
  abs_path "$BASELINE_IN"; BASELINE_IN_ABS=$REPLY
fi
if [[ -n "$BASELINE_OUT" ]]; then
  abs_path "$BASELINE_OUT"; BASELINE_OUT_ABS=$REPLY
fi

# --dir and --stdin: files that are no repository's, scanned as if every one
# were tracked. A private repository indexes the tree with `add -N` — paths
# alone, so nothing is hashed and no filter runs; the worktree pass reads
# each file as it is — and every pass below runs on it unchanged. --stdin is
# a tree of one file, `stdin`; its config comes from --config or the
# environment, as no tree holds one. Paths above resolved first, against the
# caller's directory.
SCAN_TARGET="index+worktree"
SCOPE_HEAD="index + worktree"
FILES_WORD="tracked files"
CONTENT_WORD="tracked content"
DOTGIT=()
if [[ -n "$DIR_ARG" || "$STDIN_MODE" -eq 1 ]]; then
  [[ -z "$DIR_ARG" || "$STDIN_MODE" -eq 0 ]] || die "--dir and --stdin: pass one"
  [[ "$HISTORY" -eq 0 ]] || die "--history needs a git repository; --dir and --stdin scan files"
  if [[ "$STDIN_MODE" -eq 1 ]]; then
    mkdir "$TMPD/stdin" || die "cannot create a temporary directory"
    # tr x x copies every byte, NULs included.
    LC_ALL=C tr x x > "$TMPD/stdin/stdin" || die "cannot read standard input"
    DIR_ABS="$TMPD/stdin"
    SCAN_TARGET="stdin"; SCOPE_HEAD="standard input"; CONTENT_WORD="standard input"
  else
    [[ -d "$DIR_ARG" ]] || die "not a directory: $DIR_ARG"
    DIR_ABS="$(cd -- "$DIR_ARG" 2>/dev/null && pwd -P)" || die "cannot resolve directory: $DIR_ARG"
    SCAN_TARGET="dir"; SCOPE_HEAD="every file under the directory, ignored ones included"
    CONTENT_WORD="the directory's files"
  fi
  FILES_WORD="files"
  # A caller's index or object store would be this scan's: a hook runs with
  # GIT_INDEX_FILE set.
  unset GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE
  export GIT_DIR="$TMPD/dir.git" GIT_WORK_TREE="$DIR_ABS"
  run_git "init (--dir)" "$TMPD/dinit" git -c init.defaultBranch=main init -q --template=
  cd -- "$DIR_ABS" || die "cannot cd to $DIR_ABS"
  # git warns of each repository inside the tree, which it indexes as a
  # gitlink — counted with the submodules, not scanned. Any other message is
  # a scan error.
  rc=0
  LC_ALL=C git -c advice.addEmbeddedRepo=false add -A -f -N -- . > "$TMPD/dadd" 2> "$TMPD/err" || rc=$?
  mapfile -t dw < "$TMPD/err"
  dk=()
  for l in "${dw[@]}"; do
    [[ "$l" == "warning: adding embedded git repository: "* ]] || dk+=("$l")
  done
  if [[ $rc -ne 0 || ${#dk[@]} -gt 0 ]]; then
    if [[ ${#dk[@]} -gt 0 ]]; then printf '%s\n' "${dk[@]}" > "$TMPD/err"; else : > "$TMPD/err"; fi
    fail_err "leakcheck: scan error: indexing the files (git exited $rc)"
  fi
  # git indexes no path named .git, at any depth — a repository's own, a
  # backup's, a file — and dropped each silently under a summary saying
  # "every file" (/qaa): each is counted (GIT_DIRS, below), not scanned.
  if [[ "$STDIN_MODE" -eq 0 ]]; then
    shopt -s globstar dotglob nullglob
    for f in **/.git; do
      if [[ "/$f" != */.git/* ]]; then DOTGIT+=("$f"); fi
    done
    shopt -u globstar dotglob nullglob
  fi
fi

# Always scan from the top level. `git ls-files` and `git grep` are
# cwd-relative, so a run from a subdirectory used to scan that subtree,
# miss the root .leakcheckrc, and report clean with a plausible count.
top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git work tree"
[[ -n "$top" ]] || die "not inside a git work tree"
cd -- "$top" || die "cannot cd to $top"
top="$(pwd -P)"

# Config files, read in order. An explicit --config is the whole config.
# Without one: .leakcheckrc, then .leakcheckrc.local — the gitignored home
# for the tells you would rather not commit, since a committed config is an
# inventory of exactly what you are hiding. Either may be absent; one that
# exists but is not a readable regular file (a dangling symlink, a
# directory) is a config that cannot be read, not "no config".
CONFIG_FILES=()
CONFIG_NAMES=()
if [[ -n "$CONFIG_ABS" ]]; then
  CONFIG_FILES=("$CONFIG_ABS")
  CONFIG_NAMES=("$CONFIG_FILE")
else
  for name in .leakcheckrc .leakcheckrc.local; do
    if [[ -f "$top/$name" ]]; then
      [[ -r "$top/$name" ]] || die "config not readable: $top/$name"
      CONFIG_FILES+=("$top/$name")
      CONFIG_NAMES+=("$name")
    elif [[ -e "$top/$name" || -L "$top/$name" ]]; then
      die "config is not a regular file: $top/$name"
    fi
  done
  # Only the committable .leakcheckrc has its content exempt from the scan.
  # A TRACKED .leakcheckrc.local is the inventory published: its own
  # pattern lines are left to report it.
  if [[ -f "$top/.leakcheckrc" ]]; then CONFIG_ABS="$top/.leakcheckrc"; fi
fi

PATTERNS=()
declare -A LABEL_RE=()   # a config label -> its regex
declare -A PLAIN_PAT=()  # a config pattern's text, for the label check
ALLOWLIST=()
ALLOW_SCOPE=()   # per allow rule: "" (no credential hit), a credential id, or *
ALLOW_TEXT=()    # per allow rule: as written, scope included
ALLOW_AT=()      # per allow rule: file:line, for messages
DISABLES=()      # credential id, file:line pairs
RULE_CHECK=()
SKIPS=()
USE_DEFAULTS=1
USE_CREDENTIALS=1

# POSIX ERE has no \d, \t or \x: git's regex reads `\` before an ordinary
# letter as that letter, so `SECRET-\d+` and a single-backslash
# `C:\Users\<user>` silently match nothing real, and inside brackets a
# backslash is literal, so `[\w.-]` misses every letter (all measured, git
# 2.53). Only \w \W \s \S \b \B mean something; refuse every other `\` +
# letter, and `\0`. The bracket walk follows POSIX: `]` right after `[` or
# `[^` is literal, and [:class:] / [=x=] / [.x.] nest.
check_escapes() { # regex where
  local re=$1 where=$2 n=${#1} i=0 c x in_br=0 open=0 d rest tail
  local letters='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
  while (( i < n )); do
    c=${re:i:1}
    if (( in_br )); then
      if [[ $c == '[' ]] && (( i + 1 < n )); then
        d=${re:i+1:1}
        if [[ $d == ':' || $d == '=' || $d == '.' ]]; then
          rest=${re:i+2}
          tail=${rest#*"$d]"}
          if [[ $tail == "$rest" ]]; then return 0; fi # unterminated: git rejects it
          i=$(( n - ${#tail} ))
          continue
        fi
      fi
      if [[ $c == ']' ]] && (( i > open )); then
        in_br=0
      elif [[ $c == '\' ]] && (( i + 1 < n )); then
        x=${re:i+1:1}
        if [[ $letters == *"$x"* ]]; then
          die "$where: inside [...] a backslash is literal, so '\\$x' means a backslash or a '$x', not a class; write [0-9] for a digit, [[:alnum:]_] for a word character"
        fi
      fi
      i=$(( i + 1 ))
      continue
    fi
    if [[ $c == '\' ]]; then
      x=${re:i+1:1}
      if [[ -n $x && ( $letters == *"$x"* || $x == 0 ) && $x != [bBsSwW] ]]; then
        die "$where: '\\$x' is a plain '$x' in POSIX ERE, not an escape, so this can never match what it looks like; write '\\\\' for a literal backslash, [0-9] for a digit"
      fi
      i=$(( i + 2 ))
      continue
    fi
    if [[ $c == '[' ]]; then
      in_br=1
      i=$(( i + 1 ))
      if [[ ${re:i:1} == '^' ]]; then i=$(( i + 1 )); fi
      open=$i
      continue
    fi
    i=$(( i + 1 ))
  done
}

# Read each config in order. Absence is fine — defaults still apply.
# The blanks a copy from a rendered page brings, as UTF-8 bytes, which
# [[:space:]] does not see (measured, in a UTF-8 and a C locale): no-break,
# U+1680, U+180E, U+2000 through the zero-width space, the line and
# paragraph separators, narrow no-break, medium mathematical, word joiner,
# ideographic, and the BOM.
UNICODE_BLANKS=($'\xc2\xa0' $'\xe1\x9a\x80' $'\xe1\xa0\x8e' $'\xe2\x80\xa8' $'\xe2\x80\xa9'
                $'\xe2\x80\xaf' $'\xe2\x81\x9f' $'\xe2\x81\xa0' $'\xe3\x80\x80' $'\xef\xbb\xbf')
for b in 80 81 82 83 84 85 86 87 88 89 8a 8b; do
  printf -v c "\\xe2\\x80\\x$b"
  UNICODE_BLANKS+=("$c")
done
unicode_blank_edge() { # text: does it begin or end in one of them?
  local LC_ALL=C b
  for b in "${UNICODE_BLANKS[@]}"; do
    [[ "$1" != "$b"* && "$1" != *"$b" ]] || return 0
  done
  return 1
}

# A config error repeats the text after `credential:` only when it is a rule
# id: a key typed where the id goes is what it would print (/qaa, v0.11.5).
is_cred_id() {
  local k
  for (( k = 0; k < ${#ALL_CREDENTIALS[@]}; k += 2 )); do
    if [[ "${ALL_CREDENTIALS[k]}" == "$1" ]]; then return 0; fi
  done
  return 1
}
NOT_AN_ID="names no built-in credential rule (the text after credential: is not repeated, in case it is a key; leakcheck --list-rules prints the ids)"

parse_config() { # path name-for-messages
  local file=$1 name=$2 lineno=0 line keyword rest
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    # A CRLF config would otherwise end every regex in a CR that no line
    # can match — a pattern that silently finds nothing.
    line="${line%$'\r'}"
    # Strip leading whitespace, drop blank + comment lines.
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    keyword="${line%%[[:space:]]*}"
    rest="${line#"$keyword"}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
    case "$keyword" in
      pattern|allow|skip)
        # An empty `allow` matches every hit and an empty `pattern` every
        # line: both are typos, and one of them turns a dirty repo clean.
        [[ -n "$rest" ]] || die "$name:$lineno: empty $keyword directive"
        # `allow credential:<id> <regex>` scopes a rule to one credential
        # rule's hits (`*`: every credential rule's); an unscoped rule never
        # excuses a credential hit. The scope is peeled before the checks,
        # which then judge the regex alone.
        local text=$rest scope=""
        if [[ $keyword == allow && "$rest" == credential:* ]]; then
          scope=${rest%%[[:space:]]*}
          rest=${rest#"$scope"}
          rest="${rest#"${rest%%[![:space:]]*}"}"
          scope=${scope#credential:}
          [[ -n "$scope" ]] || die "$name:$lineno: allow credential: names no rule; write allow credential:<id> <regex>, or credential:* for every credential rule"
          if [[ -z "$rest" ]]; then
            [[ "$scope" != '*' ]] || die "$name:$lineno: allow credential:* needs a regex after the rule; to turn every credential rule off, write: no-credentials"
            is_cred_id "$scope" || die "$name:$lineno: allow $NOT_AN_ID"
            die "$name:$lineno: allow credential:$scope needs a regex after the rule; to turn the rule off, write: disable credential:$scope"
          fi
        fi
        if [[ $keyword != skip && "$rest" == '(?i)' ]]; then
          die "$name:$lineno: empty $keyword directive after (?i)"
        fi
        if [[ $keyword != skip ]]; then
          check_escapes "$rest" "$name:$lineno: $keyword '$rest'"
          # Trailing blanks are part of the regex, invisible in an editor,
          # and turn `pattern MYHOST ` into a pattern that misses `MYHOST.`.
          [[ "$rest" != *[[:space:]] ]] ||
            die "$name:$lineno: $keyword '$rest' ends in whitespace, which git would match literally; delete it, or write [ ] for a space you mean"
          ! unicode_blank_edge "$rest" ||
            die "$name:$lineno: $keyword '$rest' begins or ends in an invisible Unicode space (no-break, zero-width, ideographic or a BOM), which git would match literally; delete it"
          RULE_CHECK+=("$keyword" "$name:$lineno" "$rest")
        fi
        case "$keyword" in
          pattern) PATTERNS+=("$rest"); PLAIN_PAT["l$rest"]=1 ;;
          allow)   ALLOWLIST+=("$rest"); ALLOW_SCOPE+=("$scope"); ALLOW_TEXT+=("$text"); ALLOW_AT+=("$name:$lineno") ;;
          skip)    SKIPS+=("$rest") ;;
        esac
        ;;
      label)
        # A pattern that prints as its name: its regex is the inventory a
        # CI log should not carry. The name is a word, so no ERE is one.
        local lname=${rest%%[[:space:]]*} lre
        lre=${rest#"$lname"}
        lre="${lre#"${lre%%[![:space:]]*}"}"
        [[ -n "$lname" ]] || die "$name:$lineno: empty label directive"
        [[ "$lname" =~ ^[A-Za-z][A-Za-z0-9_.-]*$ ]] ||
          die "$name:$lineno: label names a pattern by a word (a letter, then letters, digits, _ . -)"
        [[ -n "$lre" ]] || die "$name:$lineno: label $lname needs a regex after its name"
        [[ "$lre" != '(?i)' ]] || die "$name:$lineno: empty label directive after (?i)"
        [[ -z "${LABEL_RE["l$lname"]+x}" ]] || die "$name:$lineno: label $lname is named twice"
        check_escapes "$lre" "$name:$lineno: label $lname"
        [[ "$lre" != *[[:space:]] ]] ||
          die "$name:$lineno: label $lname ends in whitespace, which git would match literally; delete it, or write [ ] for a space you mean"
        ! unicode_blank_edge "$lre" ||
          die "$name:$lineno: label $lname begins or ends in an invisible Unicode space (no-break, zero-width, ideographic or a BOM), which git would match literally; delete it"
        RULE_CHECK+=(pattern "$name:$lineno" "$lre")
        LABEL_RE["l$lname"]=$lre
        PATTERNS+=("$lname")
        ;;
      disable)
        # One credential rule off, by the label its hits carry. Read as words
        # with no glob, so `credential:*` reaches the check below as written.
        local -a words=()
        read -r -a words <<< "$rest"
        [[ ${#words[@]} -gt 0 ]] || die "$name:$lineno: empty disable directive"
        local w
        for w in "${words[@]}"; do
          [[ "$w" == credential:?* ]] || die "$name:$lineno: disable takes credential rule labels (credential:<id>) and nothing else"
          [[ "$w" != 'credential:*' ]] || die "$name:$lineno: disable credential:* — write no-credentials to turn every credential rule off"
          DISABLES+=("${w#credential:}" "$name:$lineno")
        done
        ;;
      no-defaults)   USE_DEFAULTS=0 ;;
      no-credentials) USE_CREDENTIALS=0 ;;
      *)             die "$name: unknown directive: $keyword" ;;
    esac
  done < "$file"
}
for i in "${!CONFIG_FILES[@]}"; do
  parse_config "${CONFIG_FILES[$i]}" "${CONFIG_NAMES[$i]}"
done
# The environment's config lines, after the files: CI's secret store holds
# the tells a public repo cannot commit.
if [[ -n "${LEAKCHECK_RC-}" ]]; then
  printf '%s\n' "$LEAKCHECK_RC" > "$TMPD/env.rc"
  parse_config "$TMPD/env.rc" LEAKCHECK_RC
fi
# A label is a pattern's name, so it may be no other pattern's text: pat_args
# would read that pattern as the label's regex.
for k in "${!LABEL_RE[@]}"; do
  [[ -z "${PLAIN_PAT[$k]+x}" ]] || die "label ${k#l} is also a pattern's text; rename the label"
done

# A credential rule's label is `credential:<id>`; every other pattern is its
# own label. CRED_RE maps a label to its ERE, so a config pattern spelled
# like a label would be read as that rule's regex: refused.
declare -A CRED_RE=() CRED_MARKER=() CRED_OFF=() CRED_PATHRULE=()
CRED_LABELS=()
CRED_PATH_LABELS=()
for (( i = 0; i < ${#ALL_CREDENTIALS[@]}; i += 2 )); do
  CRED_RE["lcredential:${ALL_CREDENTIALS[i]}"]=${ALL_CREDENTIALS[i + 1]}
  if [[ $i -ge ${#CREDENTIALS[@]} ]]; then CRED_PATHRULE["lcredential:${ALL_CREDENTIALS[i]}"]=1; fi
done
# A rule id that names no rule is refused, never ignored: a typo in `disable`
# would leave on a rule meant off (harmless), but one in an allow scope would
# leave hits meant excused reported with nothing saying why — and a rule
# renamed by a later version should fail loudly, not quietly change scope.
for (( i = 0; i < ${#DISABLES[@]}; i += 2 )); do
  [[ -n "${CRED_RE["lcredential:${DISABLES[i]}"]+x}" ]] ||
    die "${DISABLES[i + 1]}: disable $NOT_AN_ID"
  CRED_OFF["${DISABLES[i]}"]=1
done
for r in "${!ALLOWLIST[@]}"; do
  asc=${ALLOW_SCOPE[r]}
  [[ -z "$asc" || "$asc" == '*' || -n "${CRED_RE["lcredential:$asc"]+x}" ]] ||
    die "${ALLOW_AT[r]}: allow $NOT_AN_ID"
done
CRED_DISABLED=()
for (( i = 0; i < ${#ALL_CREDENTIALS[@]}; i += 2 )); do
  if [[ -n "${CRED_OFF["${ALL_CREDENTIALS[i]}"]+x}" ]]; then
    CRED_DISABLED+=("credential:${ALL_CREDENTIALS[i]}")
  elif [[ $i -lt ${#CREDENTIALS[@]} ]]; then
    CRED_LABELS+=("credential:${ALL_CREDENTIALS[i]}")
  else
    CRED_PATH_LABELS+=("credential:${ALL_CREDENTIALS[i]}")
  fi
done
for id in "${CRED_MARKERS[@]}"; do CRED_MARKER["lcredential:$id"]=1; done
for p in "${PATTERNS[@]}"; do
  [[ -z "${CRED_RE["l$p"]+x}" ]] || die "pattern '$p' is the name of a built-in credential rule; write the ERE you mean"
done
# CRED_RULES counts the content rules, the tail of PATTERNS; PATH_PATS the
# path rules, which are no pattern; CRED_COUNT both, as reported.
CRED_RULES=0
PATH_PATS=()
if [[ "$USE_DEFAULTS" -eq 1 ]]; then
  PATTERNS=("${DEFAULTS[@]}" "${PATTERNS[@]}")
fi
# After the config's patterns, so --list-patterns and the hit order only
# ever gain lines at the end.
if [[ "$USE_CREDENTIALS" -eq 1 ]]; then
  PATTERNS+=("${CRED_LABELS[@]}")
  CRED_RULES=${#CRED_LABELS[@]}
  PATH_PATS=("${CRED_PATH_LABELS[@]}")
fi
CRED_COUNT=$(( CRED_RULES + ${#PATH_PATS[@]} ))
# --rule: only the named rules run, each a credential rule this config runs
# or a config label; the defaults and every other pattern are off, and the
# scope says how many ran. A name that is neither is refused, never ignored.
if [[ ${#RULE_ONLY[@]} -gt 0 ]]; then
  declare -A RULE_WANT=() RULE_HAVE=()
  for p in "${PATTERNS[@]}" "${PATH_PATS[@]}"; do RULE_HAVE["l$p"]=1; done
  for r in "${RULE_ONLY[@]}"; do
    if [[ -z "${RULE_HAVE["l$r"]+x}" || ( -z "${CRED_RE["l$r"]+x}" && -z "${LABEL_RE["l$r"]+x}" ) ]]; then
      die "--rule $r names no credential rule this config runs and no label"
    fi
    RULE_WANT["l$r"]=1
  done
  kept=()
  CRED_RULES=0
  for p in "${PATTERNS[@]}"; do
    [[ -n "${RULE_WANT["l$p"]+x}" ]] || continue
    kept+=("$p")
    if [[ -n "${CRED_RE["l$p"]+x}" ]]; then CRED_RULES=$(( CRED_RULES + 1 )); fi
  done
  PATTERNS=("${kept[@]}")
  kept=()
  for p in "${PATH_PATS[@]}"; do
    if [[ -n "${RULE_WANT["l$p"]+x}" ]]; then kept+=("$p"); fi
  done
  PATH_PATS=("${kept[@]}")
  CRED_COUNT=$(( CRED_RULES + ${#PATH_PATS[@]} ))
fi

# pat_args <label>: re_args for the ERE behind a pattern label, and in
# RE_LOC how to run it. A credential rule runs in the C locale: it is ASCII
# throughout, so it matches the same bytes there, and git's regex runs over
# ten times faster than under UTF-8 (18 s against 1.4 s, 59 rules over 24 MB
# of history: measured). The defaults run there too, so their [^ -~] meets
# every byte: under UTF-8 a Latin-1 ë is no character at all, and a Latin-1
# file's home path for user zoë read clean (measured). A config pattern
# keeps the caller's locale.
declare -A DEFAULT_RE=()
for p in "${DEFAULTS[@]}"; do DEFAULT_RE["l$p"]=1; done
pat_args() {
  if [[ -n "${CRED_RE["l$1"]+x}" ]]; then
    re_args "${CRED_RE["l$1"]}"; RE_LOC=(in_c)
  elif [[ -n "${DEFAULT_RE["l$1"]+x}" ]]; then
    re_args "$1"; RE_LOC=(in_c)
  elif [[ -n "${LABEL_RE["l$1"]+x}" ]]; then
    re_args "${LABEL_RE["l$1"]}"; RE_LOC=()
  else
    re_args "$1"; RE_LOC=()
  fi
}

# The labels `disable` and `allow credential:` name, so they are never
# typed from memory: each built-in rule, tab, whether this config runs it.
if [[ "$LIST_ONLY" -eq 2 ]]; then
  for (( i = 0; i < ${#ALL_CREDENTIALS[@]}; i += 2 )); do
    st=on
    if [[ "$USE_CREDENTIALS" -eq 0 || -n "${CRED_OFF["${ALL_CREDENTIALS[i]}"]+x}" ]]; then st=off; fi
    if [[ ${#RULE_ONLY[@]} -gt 0 && -z "${RULE_WANT["lcredential:${ALL_CREDENTIALS[i]}"]+x}" ]]; then st=off; fi
    printf 'credential:%s\t%s\n' "${ALL_CREDENTIALS[i]}" "$st"
  done
  exit 0
fi
if [[ "$LIST_ONLY" -eq 1 ]]; then
  for p in "${PATTERNS[@]}" "${PATH_PATS[@]}"; do
    printf '%s\n' "${CRED_RE["l$p"]:-$p}"
  done
  exit 0
fi

if [[ "${#PATTERNS[@]}" -eq 0 ]]; then
  die "no patterns to scan (defaults disabled and config empty)"
fi

# Pathspecs. `skip` removes a path from the scan entirely: content, name and
# symlink target. The config file is narrower: only its CONTENT is skipped
# (its `pattern` lines would otherwise read as leaks), and only when it lives
# inside the repo — an exclude naming a path outside the repo is fatal to
# git. Its name and stored symlink target are published like any other path,
# so they are scanned: a tracked `.leakcheckrc -> /home/<user>/…` is a leak.
skip_excludes=()
for skip in "${SKIPS[@]}"; do
  skip_excludes+=(":!:$skip")
done
excludes=("${skip_excludes[@]}")
CONFIG_REL=""
case "$CONFIG_ABS" in
  "$top"/*)
    CONFIG_REL="${CONFIG_ABS#"$top"/}"
    excludes+=(":(exclude,literal)$CONFIG_REL")
    ;;
esac


# Binary detection must depend on content alone. git grep -I otherwise
# honours .gitattributes, and `*.svg binary` (a common line) would
# silently drop text files — an Inkscape SVG carrying its author's home
# path — that the published clone still contains. GIT_ATTR_SOURCE (git
# >= 2.40; older git ignores it, and the skip is still counted) points
# in-tree attributes at the empty tree; the other two lines cover the
# global and system attribute files. $GIT_DIR/info/attributes cannot be
# switched off and is counted like any other skip.
run_git "empty tree id" "$TMPD/empty-tree" git hash-object -t tree /dev/null
EMPTY_TREE=$(< "$TMPD/empty-tree")
[[ -n "$EMPTY_TREE" ]] || die "cannot compute the empty tree id"
g() {
  GIT_ATTR_SOURCE="$EMPTY_TREE" GIT_ATTR_NOSYSTEM=1 \
    git -c core.attributesFile=/dev/null "$@"
}


GREP_FLAGS=(-z --no-color --no-column --no-textconv --no-recurse-submodules)

# re_args <pattern or allow rule>: its git grep arguments, in RE_ARGS. A
# leading (?i) makes it case-insensitive — git's ERE refuses `(?i)` (exit
# 128, measured), so the prefix had no meaning before — and the text as
# written stays its label. Every site that hands a pattern or rule to git
# goes through here.
re_args() {
  if [[ "$1" == '(?i)'* ]]; then RE_ARGS=(-i -E -e "${1:4}"); else RE_ARGS=(-E -e "$1"); fi
}

# A config rule that matches the empty string matches everything: a pattern
# would flag every line, and an allow rule, which needs to match only
# somewhere in a hit's `path:line:match`, would excuse every hit. A stray
# `|` after the last alternative or an `x*` is a typo, like an empty
# directive, and one of them turns a dirty repo clean.
# A rule can also match the empty string only beside a character, which no
# empty line shows: `\b`, `\<`, `\b(docs|)\b`, `a|\b` (each excused every
# hit through v0.10.2, measured). Each edge probe puts one context (line
# edge, word character, other character) on each side of a gap, around each
# top-level alternative A of the rule: ^LAT$|^LBT$… can match no line but
# its own, and that only with the rule matching empty. No group is added,
# so a backreference keeps its number (`\b(docs|)\1\b`; a first draft
# wrapped the rule in one and skipped every rule holding a backreference,
# found by /cxr). An alternative never begins with a quantifier that the
# context would then bind: git refuses one anywhere (measured), and the
# empty-line run has already stopped on it.
split_alts() { # ERE -> its top-level alternatives, in ALTS; brackets as in check_escapes
  local re=$1 n=${#1} i=0 c d rest tail cur="" depth=0 in_br=0 open=0
  ALTS=()
  while (( i < n )); do
    c=${re:i:1}
    if (( in_br )); then
      if [[ $c == '[' ]] && (( i + 1 < n )); then
        d=${re:i+1:1}
        if [[ $d == ':' || $d == '=' || $d == '.' ]]; then
          rest=${re:i+2}
          tail=${rest#*"$d]"}
          if [[ $tail == "$rest" ]]; then cur+=${re:i}; break; fi
          cur+=${re:i:n-${#tail}-i}
          i=$(( n - ${#tail} ))
          continue
        fi
      fi
      if [[ $c == ']' ]] && (( i > open )); then in_br=0; fi
      cur+=$c; i=$(( i + 1 ))
      continue
    fi
    case "$c" in
      '\') cur+=${re:i:2}; i=$(( i + 2 )); continue ;;
      '[')
        in_br=1; cur+=$c; i=$(( i + 1 ))
        if [[ ${re:i:1} == '^' ]]; then cur+='^'; i=$(( i + 1 )); fi
        open=$i
        continue ;;
      '(') depth=$(( depth + 1 )) ;;
      ')') if (( depth > 0 )); then depth=$(( depth - 1 )); fi ;;
      '|') if (( depth == 0 )); then ALTS+=("$cur"); cur=""; i=$(( i + 1 )); continue; fi ;;
    esac
    cur+=$c; i=$(( i + 1 ))
  done
  ALTS+=("$cur")
}
printf '\n' > "$TMPD/empty-line"
printf '%s\n' a - b @ cd e, %f '=~' > "$TMPD/edge-lines"
EDGE_PROBES=('' a '' - b '' @ '' c d e , % f = '~')
for (( i = 0; i < ${#RULE_CHECK[@]}; i += 3 )); do
  re_args "${RULE_CHECK[i + 2]}"
  run_git "${RULE_CHECK[i]} '${RULE_CHECK[i + 2]}'" "$TMPD/e" \
    git -C "$TMPD" grep --no-index -l --no-color "${RE_ARGS[@]}" -- empty-line
  if [[ ! -s "$TMPD/e" ]]; then
    split_alts "${RE_ARGS[-1]}"
    edge=("${RE_ARGS[@]:0:${#RE_ARGS[@]}-2}")
    for (( k = 0; k < ${#EDGE_PROBES[@]}; k += 2 )); do
      e=""
      for a in "${ALTS[@]}"; do e+="${e:+|}^${EDGE_PROBES[k]}$a${EDGE_PROBES[k + 1]}\$"; done
      edge+=(-e "$e")
    done
    run_git "${RULE_CHECK[i]} '${RULE_CHECK[i + 2]}'" "$TMPD/e" \
      git -C "$TMPD" grep --no-index -l --no-color "${edge[@]}" -- edge-lines
  fi
  if [[ -s "$TMPD/e" ]]; then
    if [[ "${RULE_CHECK[i]}" == pattern ]]; then what="flag every line"; else what="excuse every hit"; fi
    die "${RULE_CHECK[i + 1]}: ${RULE_CHECK[i]} '${RULE_CHECK[i + 2]}' matches the empty string, so it would $what"
  fi
done

# Credential rules go to git once per pass first, all of them as one -l
# grep: most subjects hold no credential, and one process beats one per rule
# (59 of them took a scan of a small repo from 0.1 s to 1.2 s). Same engine,
# flags and subject as each rule's own run, so where this finds nothing no
# rule could. pass_patterns <label> <git grep command with "${CRED_E[@]}">
# sets PASS_PATS: every pattern, less the credential rules on a miss. The
# keyword rules go as a group of their own: their grammar matches weak
# values in most repositories, and one such match made every other rule run
# on its own too (a repository with one weak value: 0.9 s to 3.4 s).
CRED_E=(); CRED_E_FIXED=(); CRED_E_KV=(); FIXED_PATS=(); KV_PATS=()
for p in "${PATTERNS[@]}"; do
  if [[ -n "${CRED_RE["l$p"]+x}" ]]; then
    CRED_E+=(-e "${CRED_RE["l$p"]}")
    if [[ -n "${KV_VAL[${p#credential:}]+x}" ]]; then
      CRED_E_KV+=(-e "${CRED_RE["l$p"]}"); KV_PATS+=("$p")
    else
      CRED_E_FIXED+=(-e "${CRED_RE["l$p"]}"); FIXED_PATS+=("$p")
    fi
  fi
done
OTHER_PATS=("${PATTERNS[@]:0:${#PATTERNS[@]}-CRED_RULES}")
pass_patterns() {
  local label=$1 i n=${#CRED_E[@]}
  shift
  PASS_PATS=("${PATTERNS[@]}")
  if [[ "$CRED_RULES" -eq 0 ]]; then return 0; fi
  local -a cmd=("$@")
  # Where the caller put "${CRED_E[@]}": each group goes there in turn.
  for (( i = 0; i + n <= ${#cmd[@]}; i++ )); do
    if [[ "${cmd[i]}" == -e && "${cmd[i + 1]}" == "${CRED_E[1]}" ]]; then break; fi
  done
  (( i + n <= ${#cmd[@]} )) || die "internal error: no credential rules in the $label prefilter"
  PASS_PATS=("${OTHER_PATS[@]}")
  if [[ ${#CRED_E_FIXED[@]} -gt 0 ]]; then
    run_git "credential rules ($label)" "$TMPD/cpre" in_c "${cmd[@]:0:i}" "${CRED_E_FIXED[@]}" "${cmd[@]:i+n}"
    if [[ -s "$TMPD/cpre" ]]; then PASS_PATS+=("${FIXED_PATS[@]}"); fi
  fi
  if [[ ${#CRED_E_KV[@]} -gt 0 ]]; then
    run_git "credential rules ($label)" "$TMPD/cpre" in_c "${cmd[@]:0:i}" "${CRED_E_KV[@]}" "${cmd[@]:i+n}"
    if [[ -s "$TMPD/cpre" ]]; then PASS_PATS+=("${KV_PATS[@]}"); fi
  fi
  return 0
}

# ─── what is tracked ──────────────────────────────────────────────────
# Mode decides the kind: 100644/100755 regular, 120000 symlink (its blob is
# the target string), 160000 a submodule gitlink. Unmerged paths appear once
# per stage; the first row wins. Listed with `skip` excludes only — the
# config's own entry stays, for its name and symlink target.
run_git "ls-files" "$TMPD/ls" g ls-files -s -z -- . "${skip_excludes[@]}"
mapfile -d '' -t LS_ROWS < "$TMPD/ls"
declare -A SEEN_PATH=()
declare -A MODE_OF=()
PATHS=()
LINK_PATHS=()
LINK_OIDS=()
GITLINKS=()
for row in "${LS_ROWS[@]}"; do
  meta="${row%%$'\t'*}"
  path="${row#*$'\t'}"
  mode="${meta%% *}"
  oid="${meta#* }"
  oid="${oid%% *}"
  [[ -n "${SEEN_PATH["p$path"]+x}" ]] && continue
  SEEN_PATH["p$path"]=1
  MODE_OF["p$path"]=$mode
  PATHS+=("$path")
  case "$mode" in
    120000) LINK_PATHS+=("$path"); LINK_OIDS+=("$oid") ;;
    160000) GITLINKS+=("$path") ;;
  esac
done
# --dir: a .git inside a repository indexed as a gitlink is that one's,
# counted with the submodules.
GIT_DIRS=()
for f in "${DOTGIT[@]}"; do
  d=""
  if [[ "$f" == */.git ]]; then d=${f%/.git}; fi
  in=0
  for g in "${GITLINKS[@]}"; do
    if [[ -n "$d" && ( "$d" == "$g" || "$d" == "$g/"* ) ]]; then in=1; break; fi
  done
  if [[ $in -eq 0 ]]; then GIT_DIRS+=("$f"); fi
done
# The denominator counts files whose content is in scope; the config's own
# content is not, and is reported under "skipped by config".
TRACKED_COUNT=${#PATHS[@]}
if [[ -n "$CONFIG_REL" && -n "${SEEN_PATH["p$CONFIG_REL"]+x}" ]]; then
  TRACKED_COUNT=$((TRACKED_COUNT - 1))
fi

run_git "ls-files" "$TMPD/lsall" g ls-files -z -- .
mapfile -d '' -t ALL_ROWS < "$TMPD/lsall"
declare -A SEEN_ALL=()
for path in "${ALL_ROWS[@]}"; do SEEN_ALL["p$path"]=1; done
SKIPPED_COUNT=$(( ${#SEEN_ALL[@]} - TRACKED_COUNT ))
[[ $SKIPPED_COUNT -ge 0 ]] || SKIPPED_COUNT=0

# ─── binary detection ─────────────────────────────────────────────────
# A path is binary exactly when this scan's -I skips it: listed by
# `-l -e ''` (any content at all) and not by `-I -l -e ''`. Measuring with
# the scan's own flags is what makes the count follow the scan — git sniffs
# the first 8000 bytes, which is not GNU grep's rule.
declare -A BINARY=()
BINARY_PATHS=()
mark_binary() { # path source
  if [[ -z "${BINARY["p$1"]+x}" ]]; then
    BINARY["p$1"]="$2"
    BINARY_PATHS+=("$1")
  elif [[ "${BINARY["p$1"]}" != "$2" ]]; then
    BINARY["p$1"]="both"
  fi
}
# Fills BINARY_ROWS with the names the last two sniffs ($TMPD/all, $TMPD/text)
# disagree on: content present, but skipped by -I.
binary_rows() {
  local path
  local -A text=()
  BINARY_ROWS=()
  mapfile -d '' -t _rows < "$TMPD/text"
  for path in "${_rows[@]}"; do text["p$path"]=1; done
  mapfile -d '' -t _rows < "$TMPD/all"
  for path in "${_rows[@]}"; do
    [[ -n "${text["p$path"]+x}" ]] || BINARY_ROWS+=("$path")
  done
  return 0
}
binary_pass() { # source [git grep args...]
  local src=$1 path
  shift
  run_git "binary sniff ($src)" "$TMPD/all" g grep "$@" "${GREP_FLAGS[@]}" -l -e '' -- . "${excludes[@]}"
  run_git "binary sniff ($src)" "$TMPD/text" g grep "$@" "${GREP_FLAGS[@]}" -I -l -e '' -- . "${excludes[@]}"
  binary_rows
  for path in "${BINARY_ROWS[@]}"; do mark_binary "$path" "$src"; done
  return 0
}
binary_pass index --cached
binary_pass worktree

# ─── hits ─────────────────────────────────────────────────────────────
# Parallel arrays, never a delimited temp file: a path may hold a tab, a
# colon or a newline, and each of those broke one earlier shape. Hits found
# in both the index and the worktree are reported once, as "both".
H_PAT=()
H_FILE=()
H_LINE=()
H_TEXT=()
H_SRC=()
# A hit on a name that is no path of the tree (an archive member's): a name
# hit as a path's is, though its file and text differ.
declare -A H_NAME=()
# The path of the content an unscanned hit stands for, whose identity its
# baseline fingerprint takes.
declare -A H_CPATH=()
H_COMMIT=()
declare -A HIT_AT=()
add_hit() { # pattern file line text source [commit]
  # Length-prefixed fields make the key injective whatever the fields hold.
  # The commit is part of the key, so a history hit never merges into the
  # same line found in the tree today: they need different remedies.
  local c="${6-}"
  local key="h${#1}:$1${#2}:$2${#3}:$3${#c}:$c:$4" i
  if [[ -n "${HIT_AT[$key]+x}" ]]; then
    i=${HIT_AT[$key]}
    if [[ "${H_SRC[$i]}" != "$5" ]]; then H_SRC[$i]="both"; fi
    return 0
  fi
  HIT_AT[$key]=${#H_FILE[@]}
  H_PAT+=("$1"); H_FILE+=("$2"); H_LINE+=("$3"); H_TEXT+=("$4"); H_SRC+=("$5")
  H_COMMIT+=("$c")
}

# Content: git grep, one run per pattern so each hit knows its pattern.
# -z gives `path\0line\0text\n`, so the filename never has to be split off
# the match text — the reason the old per-file grep loop existed. Every
# pattern is compiled by git: an invalid ERE exits 128 here, where GNU grep
# behind `2>/dev/null || true` once made it match nothing, forever.
# --no-column is load-bearing: grep.column=true in a user's gitconfig adds a
# field and shifts the parse. A credential rule reads the config's content
# too: the exemption exists because pattern lines match themselves, which no
# credential rule's does, and a key pasted into a committed .leakcheckrc is
# published like any other.
content_pass() { # source [git grep args...]
  local src=$1 p f l t
  local -a ex
  shift
  pass_patterns "$src" g grep "$@" "${GREP_FLAGS[@]}" -l -I -E "${CRED_E[@]}" -- . "${skip_excludes[@]}"
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    ex=("${excludes[@]}")
    if [[ -n "${CRED_RE["l$p"]+x}" ]]; then ex=("${skip_excludes[@]}"); fi
    run_git "pattern '$p' ($src)" "$TMPD/hits" \
      "${RE_LOC[@]}" g grep "$@" "${GREP_FLAGS[@]}" -n -I -H --full-name "${RE_ARGS[@]}" -- . "${ex[@]}"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      add_hit "$p" "$f" "$l" "$t" "$src"
    done < "$TMPD/hits"
  done
  return 0
}
# The index is what the next commit publishes; the worktree is what
# `git commit -a` publishes, and holds the only copy of an intent-to-add
# file. Each pass alone misses a case the other catches.
content_pass index --cached
content_pass worktree

# Type changes the worktree pass cannot see: an index symlink or gitlink
# replaced by a regular file. git grep follows the INDEX mode and skips the
# path, but `git commit -a` stages the new file — and v0.2.2's per-file grep,
# which read whatever was on disk, did scan it. Each one is copied under a
# numbered name and scanned there, with the same flags and the same binary
# rule, then mapped back to its real path. The config is among them when it
# changed type: the credential rules read its content, as in the tree.
TC_PATHS=()
TC_CFG=()
for path in "${PATHS[@]}"; do
  case "${MODE_OF["p$path"]}" in
    120000|160000) ;;
    *) continue ;;
  esac
  if [[ -f "$path" && ! -L "$path" ]]; then
    if [[ "$path" == "$CONFIG_REL" ]]; then TC_CFG=(":(exclude,literal)${#TC_PATHS[@]}"); fi
    TC_PATHS+=("$path")
  fi
done
if [[ ${#TC_PATHS[@]} -gt 0 ]]; then
  mkdir "$TMPD/tc"
  for k in "${!TC_PATHS[@]}"; do
    if ! cp -- "${TC_PATHS[$k]}" "$TMPD/tc/$k" 2>"$TMPD/err"; then
      fail_err "leakcheck: scan error: cannot read ${TC_PATHS[$k]}"
    fi
  done
  gni() { GIT_ATTR_NOSYSTEM=1 git -c core.attributesFile=/dev/null -C "$TMPD/tc" grep --no-index "$@"; }
  run_git "binary sniff (type changes)" "$TMPD/all" gni -z -l -e '' -- .
  run_git "binary sniff (type changes)" "$TMPD/text" gni -z -I -l -e '' -- .
  binary_rows
  for k in "${BINARY_ROWS[@]}"; do mark_binary "${TC_PATHS[$k]}" worktree; done
  pass_patterns "type changes" gni -z -l -I -E "${CRED_E[@]}" -- .
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    ex=("${TC_CFG[@]}")
    if [[ -n "${CRED_RE["l$p"]+x}" ]]; then ex=(); fi
    run_git "pattern '$p' (type changes)" "$TMPD/hits" \
      "${RE_LOC[@]}" gni -z -n -I --no-color --no-column "${RE_ARGS[@]}" -- . "${ex[@]}"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      # An indexed subscript is arithmetic: a non-numeric name would quietly
      # map to entry 0, so check the shape before the lookup.
      [[ "$f" =~ ^[0-9]+$ && -n "${TC_PATHS[$f]+x}" ]] || die "internal error: type-change pass returned $f"
      add_hit "$p" "${TC_PATHS[$f]}" "$l" "$t" worktree
    done < "$TMPD/hits"
  done
fi
# --archives: a zip (a jar, war, apk, whl, nupkg…), a tar, or a gzip (a
# .tar.gz too) publishes every file it holds, and git sees one binary file.
# Each binary file whose first bytes are an archive's is read with bash and
# git alone — no unzip, tar or gzip (CLAUDE.md's dependency list):
#   - two views of the file, NUL as `Z` in one and `Y` in the other, have no
#     NUL, so read -N takes them in exact byte counts; a NUL is where they
#     differ, so any range can be written back byte for byte (ar_copy);
#   - git inflates a deflated member: its bytes behind a zlib header and a
#     stored block holding `blob <size>\0` make a loose object, which
#     cat-file streams. No Adler-32 follows (it is over bytes not yet known),
#     so git fails at the end, after writing every full buffer: the stored
#     block pads the size to a multiple of 64 KiB with line breaks, sed takes
#     them off, and a member whose output is not its stated size is not read.
# Members are scanned as tracked content is, as `archive!member`, and their
# names as paths; one level, so an archive inside one is a binary member. A
# member encrypted, compressed otherwise, or not read whole is counted and
# reported under --strict; an archive not read stays a binary file.
AR_PATH=()
AR_SRC=()
AR_NPATH=()
AR_NSUBJ=()
AR_NTEXT=()
AR_NSRC=()
AR_NNAME=()
AR_UPATH=()
AR_ULABEL=()
AR_UWHY=()
AR_USRC=()
AR_K=0
AR_READ=0
AR_FAILED=0
if [[ "$ARCHIVES" -eq 1 ]]; then
  AR_MAX=$(( 1 << 28 ))
  AR_OID=0000000000000000000000000000000000000001
  printf -v AR_NL4K '%4096s' ''; AR_NL4K=${AR_NL4K// /$'\n'}
  printf -v AR_ZB1 '%512s' ''; AR_ZB2=${AR_ZB1// /Y}; AR_ZB1=${AR_ZB1// /Z}
  ar_views() { # file label -> $TMPD/av1, $TMPD/av2, AR_SIZE
    local LC_ALL=C c n=0
    tr '\0' Z < "$1" > "$TMPD/av1" 2> "$TMPD/err" || fail_err "leakcheck: scan error: cannot read $2"
    tr '\0' Y < "$1" > "$TMPD/av2" 2> "$TMPD/err" || fail_err "leakcheck: scan error: cannot read $2"
    exec 7< "$TMPD/av1"
    while IFS= read -r -d '' -N 65536 c <&7; do n=$(( n + ${#c} )); done
    exec 7<&-
    AR_SIZE=$(( n + ${#c} )); AR_POS=-1
  }
  ar_goto() { # offset: fds 7 and 8 there, reopened to go back
    local LC_ALL=C n k c
    if (( $1 < AR_POS || AR_POS < 0 )); then
      exec 7< "$TMPD/av1" 8< "$TMPD/av2"
      AR_POS=0
    fi
    n=$(( $1 - AR_POS ))
    while (( n > 0 )); do
      k=$(( n > 65536 ? 65536 : n ))
      IFS= read -r -d '' -N "$k" c <&7 || :
      IFS= read -r -d '' -N "$k" c <&8 || :
      n=$(( n - k ))
    done
    AR_POS=$1
  }
  ar_read() { # n -> R1, R2: the views of the next n bytes; 1 if fewer
    local LC_ALL=C
    R1=""; R2=""
    if (( $1 > 0 )); then
      IFS= read -r -d '' -N "$1" R1 <&7 || :
      IFS= read -r -d '' -N "$1" R2 <&8 || :
    fi
    AR_POS=$(( AR_POS + $1 ))
    (( ${#R1} == $1 && ${#R2} == $1 ))
  }
  ar_byte() { # i -> REPLY: the byte at i of B1/B2
    local LC_ALL=C c=${B1:$1:1}
    if [[ "$c" == Z && "${B2:$1:1}" == Y ]]; then REPLY=0; else printf -v REPLY '%d' "'$c"; fi
  }
  ar_le() { # i n -> REPLY: the n bytes at i of B1/B2, little-endian
    local v=0 k
    for (( k = $2 - 1; k >= 0; k-- )); do ar_byte $(( $1 + k )); v=$(( v * 256 + REPLY )); done
    REPLY=$v
  }
  ar_cstr() { # i n -> REPLY: the n bytes at i of B1/B2, up to a NUL
    local LC_ALL=C s1=${B1:$1:$2} s2=${B2:$1:$2} out="" pre j=0
    while [[ "$s1" == *Z* ]]; do
      pre=${s1%%Z*}; j=$(( j + ${#pre} ))
      if [[ "${s2:j:1}" == Y ]]; then REPLY=$out$pre; return 0; fi
      out+="${pre}Z"; j=$(( j + 1 )); s1=${s1#*Z}
    done
    REPLY=$out$s1
  }
  ar_zstr() { # -> REPLY: the bytes up to the next NUL, which is passed
    local LC_ALL=C s=""
    while ar_read 1; do
      if [[ "$R1" == Z && "$R2" == Y ]]; then REPLY=$s; return 0; fi
      s+=$R1
    done
    return 1
  }
  # A write that fails (a full disk) is a scan error: these functions run
  # where errexit is off (`ar_one … || rc=$?`), and a member written short
  # would be scanned short.
  ar_wfail() { die "scan error: cannot write a member of $AR_LABEL"; }
  ar_put() { # view1 view2: a piece's bytes to fd 6
    local LC_ALL=C s1=$1 s2=$2 f pre i=0 j bs='\\' pc='%%' nul='\000'
    # A NUL is Z in view 1 and Y in view 2. Without one, view 1 is the
    # bytes; when every Z (or every Y) is one, a format prints them, as
    # \000: printf reads three octal digits at most, so a digit after it is
    # its own, where \0000 printed a 0 after each NUL. Else smaller pieces: a
    # loop per NUL over a piece of 4096 cost 18 s a MiB of zeros (/qaa).
    if [[ "$s1" != *Z* || "$s2" != *Y* ]]; then printf '%s' "$s1" >&6 || ar_wfail; return 0; fi
    if [[ "$s2" != *Z* ]]; then
      f=${s1//\\/"$bs"}; f=${f//%/"$pc"}; printf -- "${f//Z/"$nul"}" >&6 || ar_wfail; return 0
    fi
    if [[ "$s1" != *Y* ]]; then
      f=${s2//\\/"$bs"}; f=${f//%/"$pc"}; printf -- "${f//Y/"$nul"}" >&6 || ar_wfail; return 0
    fi
    if (( ${#s1} > 64 )); then
      for (( j = 0; j < ${#s1}; j += 64 )); do ar_put "${s1:j:64}" "${s2:j:64}"; done
      return 0
    fi
    while [[ "$s1" == *Z* ]]; do
      pre=${s1%%Z*}; i=$(( i + ${#pre} ))
      printf '%s' "$pre" >&6 || ar_wfail
      if [[ "${s2:i:1}" == Y ]]; then printf '\0' >&6 || ar_wfail; else printf Z >&6 || ar_wfail; fi
      i=$(( i + 1 )); s1=${s1#*Z}
    done
    printf '%s' "$s1" >&6 || ar_wfail
  }
  ar_copy() { # n: the next n bytes, exactly, to fd 6
    local LC_ALL=C n=$1 k c1 c2
    while (( n > 0 )); do
      k=$(( n > 4096 ? 4096 : n ))
      IFS= read -r -d '' -N "$k" c1 <&7 || :
      IFS= read -r -d '' -N "$k" c2 <&8 || :
      (( ${#c1} == k && ${#c2} == k )) || return 1
      ar_put "$c1" "$c2"
      n=$(( n - k )); AR_POS=$(( AR_POS + k ))
    done
  }
  ar_fsize() { # file -> REPLY: its size
    local LC_ALL=C c n=0
    tr '\0' Z < "$1" > "$TMPD/fsz" 2> "$TMPD/err" || fail_err "leakcheck: scan error: cannot read a member of $AR_LABEL"
    exec 9< "$TMPD/fsz"
    while IFS= read -r -d '' -N 65536 c <&9; do n=$(( n + ${#c} )); done
    exec 9<&-
    REPLY=$(( n + ${#c} ))
  }
  ar_store() { # n: the next n bytes, as member $AR_K
    exec 6> "$TMPD/ar/$AR_K" || ar_wfail
    if ! ar_copy "$1"; then exec 6>&-; return 1; fi
    exec 6>&-
  }
  ar_block() { # n: a stored block's header, not the last, to fd 6
    local hx
    printf -v hx '\\x00\\x%02x\\x%02x\\x%02x\\x%02x' $(( $1 & 255 )) $(( $1 >> 8 )) \
      $(( ~$1 & 255 )) $(( (~$1 >> 8) & 255 ))
    printf "$hx" >&6 || ar_wfail
  }
  ar_lines() { # n: n line breaks to fd 6
    local n=$1
    while (( n > 4096 )); do printf '%s' "$AR_NL4K" >&6 || ar_wfail; n=$(( n - 4096 )); done
    printf '%s' "${AR_NL4K:0:n}" >&6 || ar_wfail
  }
  ar_inflated() { # csize usize p: the next csize bytes inflated by git after
    # p line breaks; REPLY the size of what git printed, in $TMPD/arout
    local p=$3 hdr left blk rc=0
    hdr="blob $(( p + $2 ))"
    exec 6> "$AR_OBJ" || ar_wfail
    printf '\x78\x01' >&6 || ar_wfail
    left=$(( ${#hdr} + 1 + p ))
    blk=$(( left > 65535 ? 65535 : left ))
    ar_block "$blk"
    printf '%s\0' "$hdr" >&6 || ar_wfail
    ar_lines $(( blk - ${#hdr} - 1 ))
    left=$(( left - blk ))
    while (( left > 0 )); do
      blk=$(( left > 65535 ? 65535 : left ))
      ar_block "$blk"; ar_lines "$blk"
      left=$(( left - blk ))
    done
    if ! ar_copy "$1"; then exec 6>&-; return 1; fi
    exec 6>&-
    ( unset "${!GIT_@}"
      export HOME="$TMPD" XDG_CONFIG_HOME="$TMPD" GIT_CONFIG_NOSYSTEM=1 LC_ALL=C LANGUAGE=
      exec git --git-dir="$TMPD/arobj" cat-file blob "$AR_OID" ) > "$TMPD/arout" 2> "$TMPD/err" || rc=$?
    # The one failure expected: the checksum, after the last full buffer.
    if (( rc != 0 )); then
      [[ $rc -eq 128 && "$(< "$TMPD/err")" == "fatal: unable to stream $AR_OID to stdout" ]] || return 1
    fi
    ar_fsize "$TMPD/arout"
  }
  ar_inflate() { # csize usize out: the next csize bytes (raw deflate) inflated to out
    local start=$AR_POS p=$(( 65536 - $2 % 65536 ))
    # git prints whole buffers of 16 KiB, and the last one, cut short by the
    # missing checksum, never: padded to a whole number of them, the member
    # prints whole. That alone passed a member holding up to 16 KiB more
    # than its stated size, cut there (/qaa). So a first pass pads one byte
    # short of a buffer: one byte more fills it, and git prints it.
    ar_inflated "$1" "$2" $(( p + 16383 )) || return 1
    (( REPLY == p + $2 )) || return 1
    ar_goto "$start"
    ar_inflated "$1" "$2" "$p" || return 1
    (( REPLY == p + $2 )) || return 1
    LC_ALL=C sed "1,${p}d" "$TMPD/arout" > "$3" 2> "$TMPD/err" ||
      fail_err "leakcheck: scan error: cannot write a member of $AR_LABEL"
  }
  ar_add() { # name: member $AR_K is label!name
    AR_PATH[AR_K]="$AR_LABEL!$1"; AR_SRC[AR_K]=$AR_CSRC
    AR_K=$(( AR_K + 1 ))
  }
  ar_name() { # name [target]: a name, or a link's target, for the name pass
    AR_NPATH+=("$AR_LABEL!$1"); AR_NSRC+=("$AR_CSRC")
    if [[ $# -gt 1 ]]; then
      AR_NSUBJ+=("$2"); AR_NTEXT+=("-> $2"); AR_NNAME+=(0)
    else
      AR_NSUBJ+=("$1"); AR_NTEXT+=("$1"); AR_NNAME+=(1)
    fi
  }
  # Metadata an archive publishes beside its members — comments, a tar
  # entry's owner, pax records — for the name pass, as `(kind) text`: a
  # member's when one is named, else the archive's (/qaa: none was read).
  ar_meta() { # member kind text
    [[ -n "$3" ]] || return 0
    if [[ -n "$1" ]]; then AR_NPATH+=("$AR_LABEL!$1"); else AR_NPATH+=("$AR_LABEL"); fi
    AR_NSRC+=("$AR_CSRC"); AR_NSUBJ+=("$3"); AR_NTEXT+=("($2) $3"); AR_NNAME+=(0)
  }
  ar_unread() { # name why
    AR_UPATH+=("$AR_LABEL!$1"); AR_UWHY+=("$2"); AR_USRC+=("$AR_CSRC"); AR_ULABEL+=("$AR_LABEL")
  }
  ar_zip() { # 1 if the archive is not read
    local LC_ALL=C tl e n cds cdo i k nl xl cl name
    local -a zn=() zf=() zm=() zc=() zu=() zo=() zk=()
    (( AR_SIZE >= 22 )) || return 1
    tl=$(( AR_SIZE < 65557 ? AR_SIZE : 65557 ))
    ar_goto $(( AR_SIZE - tl ))
    ar_read "$tl" || return 1
    # The end record is the last `PK\5\6`, as unzip finds it.
    e=${R1%PK$'\5\6'*}
    [[ "$e" != "$R1" ]] || return 1
    e=${#e}
    B1=${R1:e:22}; B2=${R2:e:22}
    (( ${#B1} == 22 )) || return 1
    ar_le 10 2; n=$REPLY
    ar_le 12 4; cds=$REPLY
    ar_le 16 4; cdo=$REPLY
    ar_le 20 2
    ar_meta "" comment "${R1:e+22:REPLY}"
    # Zip64 (a count or an offset saturated) is not read.
    (( n < 65535 && cds < 4294967295 && cdo < 4294967295 && cdo + cds <= AR_SIZE )) || return 1
    ar_goto "$cdo"
    ar_read "$cds" || return 1
    # The directory is walked to its end, not to the count: a count written
    # modulo 65536, or one entry short, hid every entry past it (/qaa).
    i=0
    while (( i < cds )); do
      (( i + 46 <= cds )) || return 1
      B1=${R1:i:46}; B2=${R2:i:46}
      [[ "${B1:0:4}" == PK$'\1\2' ]] || return 1
      ar_le 8 2; zf+=("$REPLY")
      ar_le 10 2; zm+=("$REPLY")
      ar_le 20 4; zc+=("$REPLY")
      ar_le 24 4; zu+=("$REPLY")
      ar_le 28 2; nl=$REPLY
      ar_le 30 2; xl=$REPLY
      ar_le 32 2; cl=$REPLY
      ar_le 42 4; zo+=("$REPLY")
      (( i + 46 + nl + xl + cl <= cds )) || return 1
      zn+=("${R1:i+46:nl}")
      zk+=("${R1:i+46+nl+xl:cl}")
      i=$(( i + 46 + nl + xl + cl ))
    done
    for k in "${!zn[@]}"; do
      name=${zn[k]}
      ar_name "$name"
      ar_meta "$name" comment "${zk[k]}"
      [[ "$name" != */ ]] || continue
      if (( zf[k] & 1 )); then ar_unread "$name" "encrypted"; continue; fi
      if (( zm[k] != 0 && zm[k] != 8 )); then ar_unread "$name" "compression method ${zm[k]}"; continue; fi
      if (( zu[k] > AR_MAX || zc[k] > AR_SIZE )); then ar_unread "$name" "too large"; continue; fi
      ar_goto "${zo[k]}"
      if ! ar_read 30 || [[ "${R1:0:4}" != PK$'\3\4' ]]; then ar_unread "$name" "not read whole"; continue; fi
      B1=$R1; B2=$R2
      ar_le 26 2; nl=$REPLY
      ar_le 28 2; xl=$REPLY
      ar_goto $(( zo[k] + 30 + nl + xl ))
      if (( zm[k] == 0 )); then
        if (( zc[k] != zu[k] )) || ! ar_store "${zc[k]}"; then ar_unread "$name" "not read whole"; continue; fi
      elif ! ar_inflate "${zc[k]}" "${zu[k]}" "$TMPD/ar/$AR_K"; then
        ar_unread "$name" "not read whole"; continue
      fi
      ar_add "$name"
    done
  }
  ar_tar() { # 1 if the archive is not read
    local LC_ALL=C pos=0 size typ name long="" llink="" rec kv len own grp
    local -a pmeta=()
    while (( pos + 512 <= AR_SIZE )); do
      ar_goto "$pos"
      ar_read 512 || return 1
      B1=$R1; B2=$R2
      if [[ "$B1" == "$AR_ZB1" && "$B2" == "$AR_ZB2" ]]; then return 0; fi
      [[ "${B1:257:5}" == ustar ]] || return 1
      ar_cstr 124 12; size=${REPLY// /}
      # A base-256 size (over 8 GiB) is not read.
      [[ "$size" =~ ^[0-7]+$ ]] || return 1
      size=$(( 8#$size ))
      typ=${B1:156:1}
      if [[ "$typ" == Z && "${B2:156:1}" == Y ]]; then typ=0; fi
      ar_cstr 0 100; name=$REPLY
      ar_cstr 345 155
      if [[ -n "$REPLY" ]]; then name="$REPLY/$name"; fi
      if [[ -n "$long" ]]; then name=$long; long=""; fi
      pos=$(( pos + 512 + (size + 511) / 512 * 512 ))
      case "$typ" in
        x|g) # pax: a path or a link's target for the next entry (x), and
          # every other record, metadata for that entry or the archive
          ar_read "$size" || return 1
          rec=$R1
          while [[ "$rec" =~ ^([0-9]+)\  ]]; do
            len=${BASH_REMATCH[1]}
            (( len > ${#BASH_REMATCH[0]} && len <= ${#rec} )) || return 1
            kv=${rec:${#BASH_REMATCH[0]}:len - ${#BASH_REMATCH[0]} - 1}
            rec=${rec:len}
            if [[ "$typ" == g ]]; then ar_meta "" pax "$kv"; continue; fi
            case "$kv" in
              path=*) long=${kv#path=} ;;
              linkpath=*) llink=${kv#linkpath=} ;;
              *) pmeta+=("$kv") ;;
            esac
          done ;;
        L|K) # GNU: a long name, or a long link target, for the next entry
          ar_read "$size" || return 1
          B1=$R1; B2=$R2
          ar_cstr 0 "$size"
          if [[ "$typ" == L ]]; then long=$REPLY; else llink=$REPLY; fi ;;
        *)
          if [[ "$typ" == [12] ]]; then
            ar_cstr 157 100
            ar_name "$name"
            ar_name "$name" "${llink:-$REPLY}"
            llink=""
          else
            ar_name "$name"
          fi
          ar_cstr 265 32; own=$REPLY
          ar_cstr 297 32; grp=$REPLY
          if [[ -n "$own$grp" ]]; then ar_meta "$name" owner "$own:$grp"; fi
          for kv in "${pmeta[@]}"; do ar_meta "$name" pax "$kv"; done
          pmeta=()
          # A file's data, and any other type's that has some: GNU tar
          # extracts an unknown type as a file, and data skipped under one
          # was a member neither read nor counted (/qaa).
          if [[ "$typ" == [07] ]] || (( size > 0 )); then
            if (( size > AR_MAX )); then ar_unread "$name" "too large"
            elif ar_store "$size"; then ar_add "$name"
            else return 1; fi
          fi ;;
      esac
    done
  }
  ar_gzip() { # 1 if the archive is not read
    local LC_ALL=C flg off isize name=""
    (( AR_SIZE >= 18 )) || return 1
    ar_goto 0
    ar_read 10 || return 1
    B1=$R1; B2=$R2
    ar_byte 2; (( REPLY == 8 )) || return 1
    ar_byte 3; flg=$REPLY
    if (( flg & 4 )); then
      ar_read 2 || return 1
      B1=$R1; B2=$R2; ar_le 0 2
      ar_goto $(( AR_POS + REPLY ))
    fi
    if (( flg & 8 )); then ar_zstr || return 1; name=$REPLY; fi
    if (( flg & 16 )); then ar_zstr || return 1; ar_meta "" comment "$REPLY"; fi
    if (( flg & 2 )); then ar_goto $(( AR_POS + 2 )); fi
    off=$AR_POS
    (( off + 8 <= AR_SIZE )) || return 1
    ar_goto $(( AR_SIZE - 4 ))
    ar_read 4 || return 1
    B1=$R1; B2=$R2; ar_le 0 4; isize=$REPLY
    (( isize <= AR_MAX )) || return 1
    ar_goto "$off"
    ar_inflate $(( AR_SIZE - 8 - off )) "$isize" "$TMPD/argz" || return 1
    ar_sniff "$TMPD/argz"
    if [[ "${AR_HEAD:257:5}" == ustar ]]; then
      # The name it was compressed under names no member here.
      ar_meta "" name "$name"
      ar_views "$TMPD/argz" "$AR_LABEL"
      ar_tar
      return
    fi
    # One file: the name it was compressed under, else the archive's own less .gz.
    if [[ -z "$name" ]]; then
      name=${AR_LABEL##*/}; name=${name%.[Gg][Zz]}
    fi
    ar_name "$name"
    cp -- "$TMPD/argz" "$TMPD/ar/$AR_K" 2> "$TMPD/err" || fail_err "leakcheck: scan error: cannot copy a member of $AR_LABEL"
    ar_add "$name"
  }
  # The first bytes, as view 1, in a file: a process substitution would
  # inherit the ERR trap, and tr's SIGPIPE there printed it.
  ar_sniff() { # file -> AR_HEAD
    local LC_ALL=C
    AR_HEAD=""
    tr '\0' Z < "$1" > "$TMPD/sniff" 2> "$TMPD/err" || fail_err "leakcheck: scan error: cannot read $1"
    IFS= read -r -d '' -N 512 AR_HEAD < "$TMPD/sniff" || :
  }
  ar_one() { # file label source -> 0 read, 1 an archive not read, 2 no archive
    local LC_ALL=C rc=0
    ar_sniff "$1"
    AR_LABEL=$2; AR_CSRC=$3
    if [[ "${AR_HEAD:0:4}" == PK$'\3\4' || "${AR_HEAD:0:4}" == PK$'\5\6' ]]; then
      ar_views "$1" "$2"; ar_zip || rc=$?
    elif [[ "${AR_HEAD:0:2}" == $'\x1f\x8b' ]]; then
      ar_views "$1" "$2"; ar_gzip || rc=$?
    elif [[ "${AR_HEAD:257:5}" == ustar ]]; then
      ar_views "$1" "$2"; ar_tar || rc=$?
    else
      return 2
    fi
    exec 7<&- 8<&-
    return $(( rc == 0 ? 0 : 1 ))
  }
  mkdir "$TMPD/ar"
  ( unset "${!GIT_@}"
    export HOME="$TMPD" XDG_CONFIG_HOME="$TMPD" GIT_CONFIG_NOSYSTEM=1 GIT_DEFAULT_HASH=sha1
    exec git init -q --bare --template= "$TMPD/arobj" ) > /dev/null 2> "$TMPD/err" \
    || fail_err "leakcheck: scan error: cannot create a scratch repository"
  mkdir "$TMPD/arobj/objects/00"
  AR_OBJ="$TMPD/arobj/objects/00/${AR_OID:2}"
  declare -A AR_DONE=()
  for path in "${BINARY_PATHS[@]}"; do
    src=${BINARY["p$path"]}
    wsrc=""; isrc=""; ard=0; arf=0
    if [[ "$src" != index && -f "$path" && ! -L "$path" ]]; then wsrc=worktree; fi
    if [[ "$src" != worktree ]]; then
      isrc=index
      run_git "ls-files (archives)" "$TMPD/arls" g ls-files -s -z -- ":(literal)$path"
      IFS= read -r -d '' ent < "$TMPD/arls" || :
      aroid=${ent#* }; aroid=${aroid%% *}
      # Raw bytes, as the worktree copy is read: with its filters a clean
      # filter (`.git/info/attributes`) made a worktree archive hash to the
      # index's blob, and the index's own members were never read (Codex,
      # the /qaa of main..dev).
      if [[ -n "$wsrc" ]]; then
        run_git "hash-object (archives)" "$TMPD/arh" g hash-object --no-filters -- "$path"
        if [[ "$(< "$TMPD/arh")" == "$aroid" ]]; then wsrc=both; isrc=""; fi
      fi
    fi
    if [[ -n "$wsrc" ]]; then
      rc=0; ar_one "$path" "$path" "$wsrc" || rc=$?
      if (( rc == 0 )); then ard=1; elif (( rc == 1 )); then arf=1; fi
    fi
    if [[ -n "$isrc" ]]; then
      run_git "cat-file (archives)" "$TMPD/arblob" g cat-file blob "$aroid"
      rc=0; ar_one "$TMPD/arblob" "$path" index || rc=$?
      if (( rc == 0 )); then ard=1; elif (( rc == 1 )); then arf=1; fi
    fi
    if (( arf )); then AR_FAILED=$(( AR_FAILED + 1 ))
    elif (( ard )); then AR_DONE["p$path"]=1; AR_READ=$(( AR_READ + 1 )); fi
  done
  # An archive read is no longer a binary file not scanned.
  kept=()
  for path in "${BINARY_PATHS[@]}"; do
    [[ -n "${AR_DONE["p$path"]+x}" ]] || kept+=("$path")
  done
  BINARY_PATHS=("${kept[@]}")
  if (( AR_K > 0 )); then
    gna() { GIT_ATTR_NOSYSTEM=1 git -c core.attributesFile=/dev/null -C "$TMPD/ar" grep --no-index "$@"; }
    run_git "binary sniff (archives)" "$TMPD/all" gna -z -l -e '' -- .
    run_git "binary sniff (archives)" "$TMPD/text" gna -z -I -l -e '' -- .
    binary_rows
    for k in "${BINARY_ROWS[@]}"; do mark_binary "${AR_PATH[$k]}" "${AR_SRC[$k]}"; done
    pass_patterns "archives" gna -z -l -I -E "${CRED_E[@]}" -- .
    for p in "${PASS_PATS[@]}"; do
      pat_args "$p"
      run_git "pattern '$p' (archives)" "$TMPD/hits" \
        "${RE_LOC[@]}" gna -z -n -I --no-color --no-column "${RE_ARGS[@]}" -- .
      while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
        [[ "$f" =~ ^[0-9]+$ && -n "${AR_PATH[$f]+x}" ]] || die "internal error: archive pass returned $f"
        add_hit "$p" "${AR_PATH[$f]}" "$l" "$t" "${AR_SRC[$f]}"
      done < "$TMPD/hits"
    done
  fi
fi
BINARY_COUNT=${#BINARY_PATHS[@]}

# --decode: a value written encoded hides from every pattern — base64 (the
# URL-safe alphabet too), hex, percent-encoding. Each line of tracked content
# holding a candidate is read again with the candidate decoded in place, when
# it decodes to text (printable ASCII, a tab, a line break): the line keeps
# its context, so `password: <base64>` reads as `password: <value>`. A first
# byte of anything else stops the decoding, so an image's base64 costs a few
# bytes; a run of 20 that is no encoding decodes to text about one time in
# three million. One level, and the tree alone: a value encoded twice, and
# --history's lines, are not decoded. Every pattern runs over the lines made,
# and a hit's source names the encoding. The config's lines are read too, and
# only the credential rules report there, as in the tree passes.
dec_text_byte() { # byte -> appended to REPLY, or return 1
  if (( $1 >= 32 && $1 < 127 )); then REPLY+=${ASCII_PRINT:$1-32:1}
  elif (( $1 == 9 )); then REPLY+=$'\t'
  elif (( $1 == 10 )); then REPLY+=$'\n'
  elif (( $1 == 13 )); then REPLY+=$'\r'
  else return 1; fi
}
dec_b64() { # value -> REPLY, its text
  local LC_ALL=C s=${1%%=*} i c p v=0 bits=0 o
  s=${s//-/+}; s=${s//_//}
  (( ${#s} % 4 != 1 )) || return 1
  REPLY=""
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    p=${B64_ALPHA%%"$c"*}
    (( ${#p} < 64 )) || return 1
    v=$(( (v << 6) | ${#p} )); bits=$(( bits + 6 ))
    if (( bits >= 8 )); then
      bits=$(( bits - 8 )); o=$(( (v >> bits) & 255 )); v=$(( v & ((1 << bits) - 1) ))
      dec_text_byte "$o" || return 1
    fi
  done
  [[ -n "$REPLY" ]]
}
dec_hex() { # value -> REPLY, its text
  local LC_ALL=C s=$1 i
  (( ${#s} % 2 == 0 )) || return 1
  REPLY=""
  for (( i = 0; i < ${#s}; i += 2 )); do
    dec_text_byte "$(( 16#${s:i:2} ))" || return 1
  done
}
dec_pct() { # line -> REPLY, every %XX that is text decoded
  # An escape that is not text stays as written: one (`Zo%C3%AB`) stopped
  # the line's every other, `%2Fhome%2F…` among them (/qaa). Split at `%`,
  # the line is read once; a search per escape was quadratic.
  local LC_ALL=C s=$1 n=0 q
  local -a parts=()
  IFS=% read -r -a parts <<< "$s"
  REPLY=${parts[0]-}
  for q in "${parts[@]:1}"; do
    if [[ "$q" =~ ^[0-9A-Fa-f]{2} ]] && dec_text_byte "$(( 16#${q:0:2} ))"; then
      REPLY+=${q:2}; n=$((n + 1))
    else
      REPLY+="%$q"
    fi
  done
  if [[ "$s" == *% ]]; then REPLY+=%; fi
  (( n > 0 ))
}
# dec_value <run> -> REPLY its text, DEC_KIND its encoding, DEC_OFF where
# the value starts in the run: the run whole, else less a prefix that is no
# part of the value — 0x before hex, a path before base64 (`/static/<value>`)
# — which v0.27.0 read as one value that decoded to nothing (/qaa).
# Every `/` starts a try, the earliest first: v0.29.2 tried eight, a URL's
# `//host` took three, and a value after six path parts was never read
# (Codex, the /qaa of main..dev). No try copies the run: its parts are split
# once, and a try's first character, then its first twelve, built from the
# parts, must decode to text before the remainder is cut and read — exact,
# as a remainder decodes to text only if its start does. A megabyte of
# base64 image data holds some 16,000 slashes.
dec_value() {
  local LC_ALL=C v=$1 h k j n vn off=0
  local -a segs=()
  DEC_OFF=0
  if [[ "$v" =~ ^[0-9A-Fa-f]{32,}$ ]] && dec_hex "$v"; then DEC_KIND=hex; return 0; fi
  if [[ "$v" == 0[xX]* && "${v:2}" =~ ^[0-9A-Fa-f]{32,}$ ]] && dec_hex "${v:2}"; then
    DEC_OFF=2; DEC_KIND=hex; return 0
  fi
  if (( ${#v} >= 20 )) && dec_b64 "$v"; then DEC_KIND=base64; return 0; fi
  [[ "$v" == */* ]] || return 1
  # Split by the shell, not by `read`, which reads a here-string's pipe a
  # byte at a time; the run is [A-Za-z0-9+/_-] and `=`, no glob character.
  local IFS=/
  segs=($v)
  IFS=$' \t\n'
  n=${#segs[@]}; vn=${#v}
  for (( k = 1; k < n; k++ )); do
    off=$(( off + ${#segs[k - 1]} + 1 ))
    (( vn - off >= 20 )) || return 1
    if (( k == n - 1 )); then
      # The last part: no `/` left, so hex and 0x can be the value too.
      h=${v:off}
      if [[ "$h" =~ ^[0-9A-Fa-f]{32,}$ ]] && dec_hex "$h"; then DEC_OFF=$off; DEC_KIND=hex; return 0; fi
      if [[ "$h" == 0[xX]* && "${h:2}" =~ ^[0-9A-Fa-f]{32,}$ ]] && dec_hex "${h:2}"; then
        DEC_OFF=$(( off + 2 )); DEC_KIND=hex; return 0
      fi
      if dec_b64 "$h"; then DEC_OFF=$off; DEC_KIND=base64; return 0; fi
      return 1
    fi
    # A text byte's first sextet: C or D (tab, newline, return), I to f.
    [[ "${segs[k]:0:1}" == [CDI-Za-f] ]] || continue
    h=${segs[k]}; j=$k
    while (( ${#h} < 12 && j + 1 < n )); do j=$(( j + 1 )); h+="/${segs[j]}"; done
    dec_b64 "${h:0:12}" || continue
    if dec_b64 "${v:off}"; then DEC_OFF=$off; DEC_KIND=base64; return 0; fi
  done
  return 1
}
D_FILE=()
D_LINE=()
D_KIND=()
DEC_COUNT=0
dec_emit() { # file line kind text — each line of text, one subject line
  local -a parts=()
  mapfile -t parts <<< "$4"
  local q
  for q in "${parts[@]}"; do
    printf '%s\n' "$q" >&5
    D_FILE+=("$1"); D_LINE+=("$2"); D_KIND+=("$3")
  done
  DEC_COUNT=$((DEC_COUNT + 1))
}
dec_line() { # file line text
  local LC_ALL=C t=$3 w="" seg pre pos at base=0 k=0
  local -a W=()
  # The line cut into windows of 4096 once, and w the line from offset base
  # on, two windows long but for a longer run: a slice of the whole line per
  # run copies the whole line (bash), 15 s on a minified line of 480 KB
  # (/qaa). With no run in w, its last 21 bytes stay: a run they open is
  # whole in the next; a run reaching w's end is read on.
  for (( k = 0; k < ${#t}; k += 4096 )); do W+=("${t:k:4096}"); done
  k=0
  while :; do
    while (( ${#w} < 8192 && k < ${#W[@]} )); do w+=${W[k]}; k=$((k + 1)); done
    if ! [[ "$w" =~ [A-Za-z0-9+/_-]{20,}={0,2} ]]; then
      (( k < ${#W[@]} )) || break
      base=$(( base + ${#w} - 21 )); w=${w:${#w}-21}
      continue
    fi
    seg=${BASH_REMATCH[0]}
    pre=${w%%"$seg"*}
    while (( ${#pre} + ${#seg} + 2 >= ${#w} && k < ${#W[@]} )); do
      w+=${W[k]}; k=$((k + 1))
      if [[ "${w:${#pre}}" =~ ^[A-Za-z0-9+/_-]+={0,2} ]]; then seg=${BASH_REMATCH[0]}; fi
    done
    pos=$(( base + ${#pre} ))
    at=$(( pos + ${#seg} ))
    base=$at; w=${w:${#pre}+${#seg}}
    if dec_value "$seg"; then
      dec_emit "$1" "$2" "$DEC_KIND" "${t:0:pos+DEC_OFF}$REPLY${t:at}"
    fi
  done
  if [[ "$t" == *%[0-9A-Fa-f][0-9A-Fa-f]* ]] && dec_pct "$t"; then
    dec_emit "$1" "$2" percent "$REPLY"
  fi
}
if [[ "$DECODE" -eq 1 ]]; then
  declare -A DEC_SEEN=()
  exec 5>"$TMPD/subj/d"
  for dsrc in index worktree; do
    da=()
    if [[ "$dsrc" == index ]]; then da=(--cached); fi
    run_git "decode candidates ($dsrc)" "$TMPD/dcand" g grep "${da[@]}" "${GREP_FLAGS[@]}" -n -I -H --full-name \
      -E '[A-Za-z0-9+/_-]{20,}|%[0-9A-Fa-f]{2}' -- . "${skip_excludes[@]}"
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      [[ -z "${DEC_SEEN["$f:$l:$t"]+x}" ]] || continue
      DEC_SEEN["$f:$l:$t"]=1
      dec_line "$f" "$l" "$t"
    done < "$TMPD/dcand"
  done
  # The type-change copies, and under --archives the members: the passes
  # above read them from copies, and v0.27.0 decoded neither (/qaa).
  for dsrc in tc ar; do
    if [[ "$dsrc" == tc ]]; then
      [[ ${#TC_PATHS[@]} -gt 0 ]] || continue
      run_git "decode candidates (type changes)" "$TMPD/dcand" gni -z -n -I --no-color --no-column \
        -E '[A-Za-z0-9+/_-]{20,}|%[0-9A-Fa-f]{2}' -- .
    else
      (( AR_K > 0 )) || continue
      run_git "decode candidates (archives)" "$TMPD/dcand" gna -z -n -I --no-color --no-column \
        -E '[A-Za-z0-9+/_-]{20,}|%[0-9A-Fa-f]{2}' -- .
    fi
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      if [[ "$dsrc" == tc ]]; then
        [[ "$f" =~ ^[0-9]+$ && -n "${TC_PATHS[$f]+x}" ]] || die "internal error: type-change decode returned $f"
        f=${TC_PATHS[$f]}
      else
        [[ "$f" =~ ^[0-9]+$ && -n "${AR_PATH[$f]+x}" ]] || die "internal error: archive decode returned $f"
        f=${AR_PATH[$f]}
      fi
      [[ -z "${DEC_SEEN["$f:$l:$t"]+x}" ]] || continue
      DEC_SEEN["$f:$l:$t"]=1
      dec_line "$f" "$l" "$t"
    done < "$TMPD/dcand"
  done
  exec 5>&-
  if [[ ${#D_FILE[@]} -gt 0 ]]; then
    pass_patterns "decoded" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- d
    for p in "${PASS_PATS[@]}"; do
      pat_args "$p"
      run_git "pattern '$p' (decoded)" "$TMPD/dhits" \
        "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- d
      while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
        k=$(( l - 1 ))
        [[ -n "${D_FILE[k]+x}" ]] || die "internal error: decode pass returned line $l"
        if [[ -n "$CONFIG_REL" && "${D_FILE[k]}" == "$CONFIG_REL" && -z "${CRED_RE["l$p"]+x}" ]]; then continue; fi
        add_hit "$p" "${D_FILE[k]}" "${D_LINE[k]}" "$t" "decoded-${D_KIND[k]}"
      done < "$TMPD/dhits"
    done
  fi
fi

# Names and symlink targets: content too. A clone publishes every path name
# and every stored link target, and git grep reads neither. Each subject is
# one line of a scratch file (a name holding newlines spans several lines,
# all mapped back to it), matched by the same git grep engine as content.
S_PATH=()
S_SUBJ=()
S_TEXT=()
S_SRC=()
S_NAME=()   # 1: a name, which the path rules read and a hit on is a name hit
for path in "${PATHS[@]}"; do
  S_PATH+=("$path"); S_SUBJ+=("$path"); S_TEXT+=("$path"); S_SRC+=("index"); S_NAME+=(1)
done
for i in "${!LINK_PATHS[@]}"; do
  if ! tgt="$(git cat-file blob "${LINK_OIDS[$i]}" 2>"$TMPD/err")"; then
    fail_err "leakcheck: scan error: cannot read symlink ${LINK_PATHS[$i]}"
  fi
  S_PATH+=("${LINK_PATHS[$i]}"); S_SUBJ+=("$tgt"); S_TEXT+=("-> $tgt"); S_SRC+=("index"); S_NAME+=(0)
done
for path in "${PATHS[@]}"; do
  [[ -L "$path" ]] || continue
  tgt="$(readlink -- "$path")" || die "scan error: cannot read symlink $path"
  S_PATH+=("$path"); S_SUBJ+=("$tgt"); S_TEXT+=("-> $tgt"); S_SRC+=("worktree"); S_NAME+=(0)
done
# --archives: every member's name, a link member's target, and metadata.
for i in "${!AR_NPATH[@]}"; do
  S_PATH+=("${AR_NPATH[$i]}"); S_SUBJ+=("${AR_NSUBJ[$i]}"); S_TEXT+=("${AR_NTEXT[$i]}"); S_SRC+=("${AR_NSRC[$i]}")
  S_NAME+=("${AR_NNAME[$i]}")
done

SUBJ_OF_LINE=()
n=0
for i in "${!S_SUBJ[@]}"; do
  lines_of "${S_SUBJ[$i]}"
  for (( k = 0; k < REPLY; k++ )); do
    n=$((n + 1))
    SUBJ_OF_LINE[$n]=$i
  done
done
if [[ ${#S_SUBJ[@]} -gt 0 ]]; then
  printf '%s\n' "${S_SUBJ[@]}" > "$TMPD/subj/s"
else
  : > "$TMPD/subj/s"
fi

pass_patterns "names" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- s
for p in "${PASS_PATS[@]}"; do
  pat_args "$p"
  run_git "pattern '$p' (names)" "$TMPD/shits" \
    "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- s
  while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
    i="${SUBJ_OF_LINE[$l]:-}"
    [[ -n "$i" ]] || die "internal error: names pass returned line $l"
    n0=${#H_FILE[@]}
    add_hit "$p" "${S_PATH[$i]}" 0 "${S_TEXT[$i]}" "${S_SRC[$i]}"
    if (( ${#H_FILE[@]} > n0 )) && [[ "${S_NAME[$i]}" == 1 ]]; then H_NAME[$n0]=1; fi
  done < "$TMPD/shits"
done
# The path rules, over the names alone: a path's or an archive member's
# (which the cut at the tree's paths left out, /qaa). A symlink's target
# names a file the link does not publish.
for p in "${PATH_PATS[@]}"; do
  pat_args "$p"
  run_git "pattern '$p' (names)" "$TMPD/shits" \
    "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- s
  while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
    i="${SUBJ_OF_LINE[$l]:-}"
    [[ -n "$i" ]] || die "internal error: names pass returned line $l"
    [[ "${S_NAME[$i]}" == 1 ]] || continue
    [[ "${SUBJ_OF_LINE[$((l + 1))]:-}" != "$i" ]] || continue
    n0=${#H_FILE[@]}
    add_hit "$p" "${S_PATH[$i]}" 0 "${S_TEXT[$i]}" "${S_SRC[$i]}"
    if (( ${#H_FILE[@]} > n0 )); then H_NAME[$n0]=1; fi
  done < "$TMPD/shits"
done

# ─── history (--history) ──────────────────────────────────────────────
# Every commit reachable from any ref (--all: branches, tags, remote-tracking
# refs, stash, notes), scanned for: every ADDED line of every diff, at its
# line number in that commit's version of the file; every path that ever
# appeared in a diff; and author, committer and message. Each finding is
# reported once, at its earliest commit — a line that sat unchanged through
# fifty edits is one hit, and a leak still in the tree today is reported
# twice, once here and once as it is now, because each needs its own fix.
# --history-range RANGE puts one revision range in place of --all in every
# pass below; the summary and JSON name the range, so a partial scan never
# reads as a full one.
# Load-bearing flags:
#   --full-history  a pathspec otherwise simplifies history, and an `-s ours`
#                   merge then hides its whole side branch (measured). -m
#                   happens to stop that in the content pass; the
#                   .leakcheckrc.local pass has no -m and depends on this
#   --diff-merges=remerge, --max-parents=2
#                   lines a merge itself introduces appear in neither
#                   parent's diff; remerge diffs each merge against git's own
#                   re-merge of its parents, so it shows exactly those lines
#                   (every other line came from a parent, and is scanned at
#                   the commit that added it). -m, a diff against each
#                   parent, shows them too, with each side's whole churn: in
#                   git.git's history it passed 31 GB unfinished, where
#                   remerge's stream is 415 MB. git 2.36 and later; before
#                   it, -m (HMERGE)
#   -m (octopus)    remerge skips a merge of three or more parents, printing
#                   a warning in place of its diff, so those merges are
#                   diffed against each parent in a pass of their own
#   --no-renames    a rename is a delete plus an add, so every `diff --git`
#                   header names one path twice — the parser relies on that
#   log.showRoot    `false` in a user's config hides the root commit's diff
#   replace refs, grafts   ignored for every git call (exported above), so
#                   the objects scanned are the objects a push publishes
HIST_COMMITS=0
HIST_MERGE_MODE=""   # how merges were diffed: remerge, or separate (-m)
HIST_BINARY=0
HIST_SKIPPED=0
HIST_REFS=0
HIST_TAGS=0
HIST_TAGGED=0
declare -A CFG_EXEMPT=()
HREVS=(--all)
if [[ -n "$HIST_RANGE" ]]; then HREVS=("$HIST_RANGE"); fi
if [[ "$HISTORY" -eq 1 ]]; then
  run_git "rev-parse" "$TMPD/shallow" g rev-parse --is-shallow-repository
  if [[ "$(<"$TMPD/shallow")" != "false" ]]; then
    [[ -n "$HIST_RANGE" ]] ||
      die "shallow clone: its history is incomplete, so --history cannot vouch for it (git fetch --unshallow; in GitHub Actions, fetch-depth: 0)"
    # A range can still be complete in a shallow clone: what goes missing is
    # the parents of the boundary commits git lists in $GIT_DIR/shallow, so
    # the walk is exact unless one of those commits is IN the range — then
    # whatever lay behind it is silently absent (measured, git 2.53).
    run_git "rev-parse" "$TMPD/shpath" g rev-parse --git-path shallow
    run_git "rev-list" "$TMPD/hrevs" g rev-list "${HREVS[@]}" --
    declare -A SHALLOW=()
    while IFS= read -r c; do SHALLOW["c$c"]=1; done < "$(<"$TMPD/shpath")"
    while IFS= read -r c; do
      [[ -z "${SHALLOW["c$c"]+x}" ]] ||
        die "shallow clone: $HIST_RANGE reaches commit $c, whose parents this clone does not have, so the range cannot be scanned in full (fetch deeper, or git fetch --unshallow)"
    done < "$TMPD/hrevs"
  fi
  run_git "rev-list" "$TMPD/hcount" g rev-list "${HREVS[@]}" --count --
  HIST_COMMITS=$(<"$TMPD/hcount")
  [[ "$HIST_COMMITS" =~ ^[0-9]+$ ]] || die "scan error: unexpected commit count: $HIST_COMMITS"
fi

if [[ "$HISTORY" -eq 1 ]]; then
  # log.diffMerges: since git 2.32 `-m` means the user's default, and
  # `combined` prints a merge as `diff --cc` with `@@@` hunks — a merge's own
  # lines then went unscanned, exit 0 (measured). Older git ignores the key,
  # and its `-m` is already `separate`. core.bigFileThreshold: `log -p`
  # prints a file above it as binary, and at `1m` a removed 1 MB source
  # map's home path went to "binary files skipped", exit 0 (measured);
  # pinned to git's default, so a larger file is still skipped and counted.
  # i18n.logOutputEncoding: UTF-16 output split the metadata pass's NUL
  # framing, and a Latin-1 message hid a home path for user zoë (measured).
  # merge.default: the re-merge (--diff-merges=remerge) runs a user's
  # default merge driver, which can write a line in neither parent into the
  # re-merge as into the merge, and so hide it (measured); pinned to git's.
  HLOG=(-c log.showRoot=true -c core.quotePath=false -c log.diffMerges=separate
        -c core.bigFileThreshold=512m -c i18n.logOutputEncoding=UTF-8 -c merge.default=text
        log "${HREVS[@]}" --full-history --date-order --reverse --no-show-signature)

  # Commit metadata, ref names and tags share one subject file, each distinct
  # (field, text) once, at the first commit or ref that carries it.
  M_SHA=()
  M_FIELD=()
  M_LINE=()
  M_TEXT=()
  declare -A M_SEEN=()
  hm_add() { # commit field line text
    local key="${#2}:$2:$4"
    [[ -n "$4" && -z "${M_SEEN[$key]+x}" ]] || return 0
    M_SEEN[$key]=1
    M_SHA+=("$1"); M_FIELD+=("$2"); M_LINE+=("$3"); M_TEXT+=("$4")
    printf '%s\n' "$4" >&9
  }
  exec 9>"$TMPD/subj/hm"
fi

# The commit passes. With no commits there is nothing for them to read, but
# the ref pass after them still runs: a ref can end at a blob or a tree, and
# a repo whose only ref was a tag named deploy-MYHOST on a blob reported
# "0 refs", exit 0, through v0.10.1 (measured).
if [[ "$HISTORY" -eq 1 && "$HIST_COMMITS" -gt 0 ]]; then
  # Old versions of the config ARE scanned: a hostname that sat in
  # .leakcheckrc before .leakcheckrc.local existed is still in every commit
  # that held it, and excluding the config's history (the first draft) hid
  # exactly that. Only a line identical to one in today's TRACKED config —
  # published on purpose, and exempt in the tree for the same reason — is
  # not reported, and each such line is counted.
  declare -A CUR_CFG=()
  if [[ -n "$CONFIG_REL" && -n "${SEEN_PATH["p$CONFIG_REL"]+x}" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do CUR_CFG["l$line"]=1; done < "$CONFIG_ABS"
  fi

  # remerge where git knows it (2.36 and later), -m before: the same lines,
  # at a cost (above). A failed probe falls back to the slower, complete
  # pass, never to none, and the JSON names the mode that ran.
  # A merge driver can write lines in neither parent, and would write them
  # again in the re-merge, hiding them: merge.default is pinned to git's own
  # (HLOG), and a repository whose info/attributes holds anything — where a
  # driver is named per path, and nothing here can blank it — gets -m.
  # So is one in git's config that the re-merge would still run: one named
  # `text`, the name merge.default=text looks up among the user's drivers
  # before git's own, or, before git 2.40, where GIT_ATTR_SOURCE is unknown,
  # any, as an in-tree .gitattributes can name it (/qaa).
  HMERGE=(-m)
  HIST_MERGE_MODE=separate
  run_git "rev-parse (info/attributes)" "$TMPD/iattr" g rev-parse --git-path info/attributes
  iattr=$(<"$TMPD/iattr")
  run_git "version" "$TMPD/gver" git version
  gv=$(<"$TMPD/gver")
  old_attr=1
  if [[ "$gv" =~ ^git\ version\ ([0-9]+)\.([0-9]+) ]] &&
     (( BASH_REMATCH[1] > 2 || (BASH_REMATCH[1] == 2 && BASH_REMATCH[2] >= 40) )); then old_attr=0; fi
  run_git "config (merge drivers)" "$TMPD/mdrv" g config -z --name-only --get-regexp '^merge\..*\.driver$'
  mdrv=0
  while IFS= read -r -d '' k; do
    if [[ "$k" == merge.text.driver || $old_attr -eq 1 ]]; then mdrv=1; fi
  done < "$TMPD/mdrv"
  if [[ $mdrv -eq 0 && ! -L "$iattr" && ! -s "$iattr" ]] && g log -0 --all --diff-merges=remerge >/dev/null 2>&1; then
    HMERGE=(--max-parents=2 --diff-merges=remerge)
    HIST_MERGE_MODE=remerge
  fi

  # git C-quotes a path holding ", \ or a control character even with
  # core.quotePath=false: \" \\ \a \b \t \n \v \f \r and \NNN octal. Never
  # eval it: a filename is attacker-controlled input.
  c_unquote() { # quoted-body -> REPLY
    local s=$1 out="" c o
    while [[ -n "$s" ]]; do
      c=${s:0:1}
      if [[ "$c" != '\' ]]; then out+=$c; s=${s:1}; continue; fi
      c=${s:1:1}
      case "$c" in
        '"'|'\') out+=$c ;;
        a) out+=$'\a' ;;
        b) out+=$'\b' ;;
        t) out+=$'\t' ;;
        n) out+=$'\n' ;;
        v) out+=$'\v' ;;
        f) out+=$'\f' ;;
        r) out+=$'\r' ;;
        [0-7])
          o=${s:1:3}
          [[ "$o" =~ ^[0-7]{3}$ ]] || die "scan error: cannot unquote history path: $1"
          printf -v c "\\$o"
          out+=$c
          s=${s:4}
          continue ;;
        *) die "scan error: cannot unquote history path: $1" ;;
      esac
      s=${s:2}
    done
    REPLY=$out
  }

  # With --no-renames both halves of "a/P b/P" name the same P, so the
  # header splits at its exact middle — the only split that survives a path
  # holding " b/". Anything else is a header this parser does not know.
  hist_path() { # header-remainder -> REPLY
    local rest=$1 n h a b
    n=${#rest}
    (( n % 2 == 1 )) || die "scan error: unexpected diff header: diff --git $rest"
    h=$(( (n - 1) / 2 ))
    a=${rest:0:h}
    b=${rest:h+1}
    [[ "${rest:h:1}" == " " ]] || die "scan error: unexpected diff header: diff --git $rest"
    if [[ "$a" == '"a/'*'"' && "$b" == '"b/'*'"' ]]; then
      a=${a:3:${#a}-4}
      b=${b:3:${#b}-4}
      [[ "$a" == "$b" ]] || die "scan error: unexpected diff header: diff --git $rest"
      c_unquote "$b"
    elif [[ "$a" == a/* && "$b" == b/* && "${a:2}" == "${b:2}" ]]; then
      REPLY=${b:2}
    else
      die "scan error: unexpected diff header: diff --git $rest"
    fi
  }

  # Content: every added line, written to one subject file for git grep,
  # with "<file-change> <line>" in the same row of a parallel meta file.
  # Inside a hunk every line is prefixed (+, -, space, \), so a header-shaped
  # line there is content: an added "++ x" arrives as "+++ x".
  FC_SHA=()
  FC_PATH=()
  HB_FC=()
  hist_parse() { # stream...
    local LC_ALL=C line sha="" fc=-1 ln=0 in_hunk=0 h stream
    exec 3>"$TMPD/subj/h" 4>"$TMPD/hmeta"
    for stream in "$@"; do
    in_hunk=0
    while IFS= read -r line || [[ -n "$line" ]]; do
      if (( in_hunk )); then
        case "$line" in
          '+'*)
            printf '%s\n' "${line:1}" >&3
            printf '%s %s\n' "$fc" "$ln" >&4
            ln=$((ln + 1))
            continue ;;
          ' '*) ln=$((ln + 1)); continue ;;
          '-'*|'\'*) continue ;;
          '@@ '*) ;;
          *) in_hunk=0 ;;
        esac
      fi
      case "$line" in
        $'\x01'*) sha=${line:1}; in_hunk=0 ;;
        'diff --git '*)
          hist_path "${line#diff --git }"
          fc=$((fc + 1))
          FC_SHA[fc]=$sha
          FC_PATH[fc]=$REPLY
          in_hunk=0 ;;
        'Binary files '*' differ') HB_FC+=("$fc") ;;
        '@@ '*)
          h=${line#@@ -* +}
          h=${h%% @@*}
          ln=${h%%,*}
          [[ "$ln" =~ ^[0-9]+$ ]] || die "scan error: unexpected hunk header: $line"
          in_hunk=1 ;;
        # The extended header lines git prints with these flags. Anything
        # else — a `diff --cc` and its `@@@` hunks, a `Submodule` summary —
        # is output this parser does not understand, and skipping it would
        # skip whatever it carried.
        ''|'index '*|'--- '*|'+++ '*|'new file mode '*|'deleted file mode '*|'old mode '*|'new mode '*) ;;
        # remerge's note on a conflict the re-merge met, after `diff --git`
        # (`remerge CONFLICT (content): Merge conflict in a.txt`).
        'remerge '*) ;;
        *) die "scan error: unexpected line in the history diff: ${line:0:40}" ;;
      esac
    done < "$stream"
    done
    exec 3>&- 4>&-
  }

  HDIFF=(--no-renames -p -U0 --inter-hunk-context=0 --no-color --no-ext-diff
    --no-textconv --submodule=short --src-prefix=a/ --dst-prefix=b/ --format=%x01%H)
  run_git "log (history)" "$TMPD/hlog" g "${HLOG[@]}" "${HMERGE[@]}" "${HDIFF[@]}" \
    -- . "${skip_excludes[@]}"
  HSTREAMS=("$TMPD/hlog")
  # Octopus merges after every other commit: a line one of them alone holds
  # is found at it, unless a later commit adds the same line to the same
  # file, which then takes the finding.
  if [[ "$HIST_MERGE_MODE" == remerge ]]; then
    run_git "log (octopus merges)" "$TMPD/hlog2" g "${HLOG[@]}" --min-parents=3 -m "${HDIFF[@]}" \
      -- . "${skip_excludes[@]}"
    HSTREAMS+=("$TMPD/hlog2")
  fi
  hist_parse "${HSTREAMS[@]}"
  mapfile -t HMETA < "$TMPD/hmeta"

  declare -A HIST_SEEN=()
  hist_hit() { # kind pattern file line text commit — once per (kind, pattern, file, text)
    local key="$1${#2}:$2${#3}:$3:$5"
    [[ -z "${HIST_SEEN[$key]+x}" ]] || return 0
    HIST_SEEN[$key]=1
    add_hit "$2" "$3" "$4" "$5" history "$6"
  }

  pass_patterns "history" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- h
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- h
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      m="${HMETA[l - 1]-}"
      [[ -n "$m" ]] || die "internal error: history pass returned line $l"
      fc=${m%% *}
      if [[ -n "$CONFIG_REL" && "${FC_PATH[fc]}" == "$CONFIG_REL" && -n "${CUR_CFG["l$t"]+x}" &&
            -z "${CRED_RE["l$p"]+x}" ]]; then
        CFG_EXEMPT["l$t"]=1
        continue
      fi
      hist_hit c "$p" "${FC_PATH[fc]}" "${m#* }" "$t" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done

  # Names: every path that ever appeared in a diff header, at its first commit.
  HN_FC=()
  HN_OF_LINE=()
  declare -A HN_SEEN=()
  n=0
  exec 5>"$TMPD/subj/hn"
  for fc in "${!FC_PATH[@]}"; do
    path=${FC_PATH[fc]}
    [[ -z "${HN_SEEN["p$path"]+x}" ]] || continue
    HN_SEEN["p$path"]=1
    e=${#HN_FC[@]}
    HN_FC+=("$fc")
    printf '%s\n' "$path" >&5
    lines_of "$path"
    for (( k = 0; k < REPLY; k++ )); do
      n=$((n + 1))
      HN_OF_LINE[n]=$e
    done
  done
  exec 5>&-
  pass_patterns "history names" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- hn
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history names)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hn
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      e="${HN_OF_LINE[l]-}"
      [[ -n "$e" ]] || die "internal error: history names pass returned line $l"
      fc=${HN_FC[e]}
      hist_hit n "$p" "${FC_PATH[fc]}" 0 "${FC_PATH[fc]}" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done
  for p in "${PATH_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history names)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hn
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      e="${HN_OF_LINE[l]-}"
      [[ -n "$e" ]] || die "internal error: history names pass returned line $l"
      [[ "${HN_OF_LINE[l + 1]-}" != "$e" ]] || continue
      fc=${HN_FC[e]}
      hist_hit n "$p" "${FC_PATH[fc]}" 0 "${FC_PATH[fc]}" "${FC_SHA[fc]}"
    done < "$TMPD/hhits"
  done

  # Binary files in history: skipped and counted, once per path.
  declare -A HB_SEEN=()
  for fc in "${HB_FC[@]}"; do
    path=${FC_PATH[fc]}
    [[ -z "${HB_SEEN["p$path"]+x}" ]] || continue
    HB_SEEN["p$path"]=1
    HIST_BINARY=$((HIST_BINARY + 1))
    if [[ "$STRICT" -eq 1 ]]; then
      add_hit "unscanned:binary" "$path" 0 "(binary file; content not scanned)" history "${FC_SHA[fc]}"
    fi
  done

  # What `skip` kept out of the history scan, in distinct paths.
  if [[ ${#SKIPS[@]} -gt 0 ]]; then
    sp=("${SKIPS[@]}")
    run_git "log (skipped)" "$TMPD/hskip" g "${HLOG[@]}" -m --no-renames \
      --format= --name-only -z -- "${sp[@]}"
    mapfile -d '' -t HSK < "$TMPD/hskip"
    declare -A HSK_SEEN=()
    for path in "${HSK[@]}"; do HSK_SEEN["p$path"]=1; done
    HIST_SKIPPED=${#HSK_SEEN[@]}
  fi

  # Author, committer and message — published by every push. Each distinct
  # (field, text) is scanned once, at its first commit: one leaked email in
  # five hundred commits is one hit.
  run_git "log (metadata)" "$TMPD/hmlog" g "${HLOG[@]}" -z \
    --format='%H%x00%an <%ae>%x00%cn <%ce>%x00%B'
  mapfile -d '' -t HM < "$TMPD/hmlog"
  (( ${#HM[@]} % 4 == 0 )) || die "scan error: unexpected commit metadata from git log"
  for (( i = 0; i < ${#HM[@]}; i += 4 )); do
    sha=${HM[i]}
    hm_add "$sha" "(author)" 0 "${HM[i + 1]}"
    hm_add "$sha" "(committer)" 0 "${HM[i + 2]}"
    rest=${HM[i + 3]}
    k=0
    while [[ -n "$rest" ]]; do
      k=$((k + 1))
      ml=${rest%%$'\n'*}
      if [[ "$rest" == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
      hm_add "$sha" "(message)" "$k" "$ml"
    done
  done

  # A merge of a signed tag (`git pull <url> tag v1`) carries the whole tag
  # in its own header, `mergetag`, so pushing the merge publishes the tag's
  # name, tagger and message with no tag ref at all; the tagger never
  # reaches %B, and was clean through v0.10.2 (measured). Scanned as a
  # tag's fields are, at the merge commit, from the raw objects: header
  # lines, then continuation lines that each lead with one space.
  parse_mergetags() { # <cat-file --batch output, NULs as \x01>
    local LC_ALL=C hdr sha size body nl head line tag in_tag th name tagger msg ml kk
    local -a tags
    while IFS= read -r hdr; do
      [[ "$hdr" =~ ^([0-9a-f]+)\ commit\ ([0-9]+)$ ]] ||
        die "scan error: unexpected commit object from git cat-file: $hdr"
      sha=${BASH_REMATCH[1]}; size=${BASH_REMATCH[2]}
      body=""
      if (( size > 0 )); then IFS= read -r -N "$size" body || true; fi
      (( ${#body} == size )) || die "scan error: commit object $sha could not be read whole"
      IFS= read -r nl || true
      [[ -z "$nl" ]] || die "scan error: unexpected commit object framing from git cat-file"
      [[ "$body" == *$'\nmergetag '* ]] || continue
      head=${body%%$'\n\n'*}
      tags=(); in_tag=0
      while [[ -n "$head" ]]; do
        line=${head%%$'\n'*}
        if [[ "$head" == *$'\n'* ]]; then head=${head#*$'\n'}; else head=""; fi
        if [[ "$line" == 'mergetag '* ]]; then
          tags+=("${line#mergetag }"); in_tag=1
        elif (( in_tag )) && [[ "$line" == ' '* ]]; then
          tags[${#tags[@]} - 1]+=$'\n'"${line:1}"
        else
          in_tag=0
        fi
      done
      for tag in "${tags[@]}"; do
        th=${tag%%$'\n\n'*}
        msg=""
        if [[ "$tag" == *$'\n\n'* ]]; then msg=${tag#*$'\n\n'}; fi
        name=""; tagger=""
        while [[ -n "$th" ]]; do
          line=${th%%$'\n'*}
          if [[ "$th" == *$'\n'* ]]; then th=${th#*$'\n'}; else th=""; fi
          case "$line" in
            "tag "*)    name=${line#tag } ;;
            "tagger "*) tagger=${line#tagger } ;;
          esac
        done
        if [[ "$tagger" =~ ^(.*)\ [0-9]+\ [-+][0-9]{4}$ ]]; then tagger=${BASH_REMATCH[1]}; fi
        hm_add "$sha" "(tag)" 0 "$name"
        hm_add "$sha" "(tagger)" 0 "$tagger"
        kk=0
        while [[ -n "$msg" ]]; do
          kk=$((kk + 1))
          ml=${msg%%$'\n'*}
          if [[ "$msg" == *$'\n'* ]]; then msg=${msg#*$'\n'}; else msg=""; fi
          hm_add "$sha" "(tag message)" "$kk" "$ml"
        done
      done
    done < "$1"
  }
  run_git "rev-list (merges)" "$TMPD/hmerges" g rev-list "${HREVS[@]}" --merges --
  if [[ -s "$TMPD/hmerges" ]]; then
    run_git "cat-file (merges)" "$TMPD/hmt0" g cat-file --batch < "$TMPD/hmerges"
    LC_ALL=C tr '\000' '\001' < "$TMPD/hmt0" > "$TMPD/hmt"
    parse_mergetags "$TMPD/hmt"
  fi
fi

if [[ "$HISTORY" -eq 1 ]]; then
  # Ref names and annotated tags. A push of --all, --tags or --follow-tags
  # publishes them, and neither is part of any commit: a branch named
  # feature/MYHOST-fix and a tag message "built on MYHOST" were both clean
  # through v0.7.0 (measured). Every ref is scanned by name, `(ref)`; every
  # annotated tag object a ref reaches, nested ones included, by name, tagger
  # and message, `(tag)`, `(tagger)`, `(tag message)`. With --history-range,
  # only the refs and tags that point into the range — those its push
  # carries. A ref that ends at a tree or a blob, not a commit, publishes
  # content no diff shows: counted, and reported under --strict. This pass
  # runs with or without commits.
  if [[ -n "$HIST_RANGE" ]]; then
    run_git "rev-list" "$TMPD/hrange" g rev-list "${HREVS[@]}" --
    declare -A IN_RANGE=()
    while IFS= read -r c; do IN_RANGE["c$c"]=1; done < "$TMPD/hrange"
    # A tree or a blob is in no range a walk can list, but the README's
    # pre-push hook passes a pushed tag's own id as the range, and a tag on a
    # blob or a tree went out clean, `0 refs` (measured). Such a ref is in
    # the range when the range names it, its tag or its object as a tip.
    run_git "rev-parse" "$TMPD/htips" g rev-parse "${HREVS[@]}" --
    declare -A RANGE_TIP=()
    while IFS= read -r c; do
      [[ "$c" == '^'* || "$c" == -- ]] || RANGE_TIP["o$c"]=1
    done < "$TMPD/htips"
  fi
  # Ref names hold no space or control character (git check-ref-format).
  run_git "for-each-ref" "$TMPD/hrefs" g for-each-ref --format='%(objectname) %(objecttype) %(refname)'
  REF_OBJ=(); REF_TYPE=(); REF_NAME=()
  while read -r o t n; do REF_OBJ+=("$o"); REF_TYPE+=("$t"); REF_NAME+=("$n"); done < "$TMPD/hrefs"

  declare -A TAG_OBJ=() TAG_OTYPE=() TAG_NAME=() TAG_TAGGER=() TAG_MSG=()
  # parse_tags <cat-file --batch output>: each tag's headers and message.
  # Sizes are bytes. Bash cannot hold a NUL, and `read -N` drops one and
  # reads a byte further, which misframes every object after it (measured),
  # so NULs reach here as \x01: same size, nothing dropped. A read that still
  # comes up short is a scan error, never a silently shorter tag.
  parse_tags() {
    local LC_ALL=C hdr sha size body nl head line obj ot name tagger
    while IFS= read -r hdr; do
      [[ "$hdr" =~ ^([0-9a-f]+)\ tag\ ([0-9]+)$ ]] ||
        die "scan error: unexpected tag object from git cat-file: $hdr"
      sha=${BASH_REMATCH[1]}; size=${BASH_REMATCH[2]}
      body=""
      if (( size > 0 )); then IFS= read -r -N "$size" body || true; fi
      (( ${#body} == size )) || die "scan error: tag object $sha could not be read whole"
      IFS= read -r nl || true
      [[ -z "$nl" ]] || die "scan error: unexpected tag object framing from git cat-file"
      head=${body%%$'\n\n'*}
      TAG_MSG[$sha]=""
      if [[ "$body" == *$'\n\n'* ]]; then TAG_MSG[$sha]=${body#*$'\n\n'}; fi
      obj=""; ot=""; name=""; tagger=""
      while [[ -n "$head" ]]; do
        line=${head%%$'\n'*}
        if [[ "$head" == *$'\n'* ]]; then head=${head#*$'\n'}; else head=""; fi
        case "$line" in
          "object "*) obj=${line#object } ;;
          "type "*)   ot=${line#type } ;;
          "tag "*)    name=${line#tag } ;;
          "tagger "*) tagger=${line#tagger } ;;
        esac
      done
      [[ -n "$obj" && -n "$ot" ]] || die "scan error: tag object $sha names no object"
      # The ident without its timestamp, as (author) shows a commit's.
      if [[ "$tagger" =~ ^(.*)\ [0-9]+\ [-+][0-9]{4}$ ]]; then tagger=${BASH_REMATCH[1]}; fi
      TAG_OBJ[$sha]=$obj; TAG_OTYPE[$sha]=$ot; TAG_NAME[$sha]=$name; TAG_TAGGER[$sha]=$tagger
    done < "$1"
  }
  queue=()
  declare -A QUEUED=()
  for k in "${!REF_OBJ[@]}"; do
    if [[ "${REF_TYPE[k]}" == tag && -z "${QUEUED[${REF_OBJ[k]}]+x}" ]]; then
      QUEUED[${REF_OBJ[k]}]=1; queue+=("${REF_OBJ[k]}")
    fi
  done
  while [[ ${#queue[@]} -gt 0 ]]; do
    printf '%s\n' "${queue[@]}" > "$TMPD/tagq"
    run_git "cat-file (tags)" "$TMPD/tags0" g cat-file --batch < "$TMPD/tagq"
    LC_ALL=C tr '\000' '\001' < "$TMPD/tags0" > "$TMPD/tags"
    parse_tags "$TMPD/tags"
    next=()
    for t in "${queue[@]}"; do
      o=${TAG_OBJ[$t]}
      if [[ "${TAG_OTYPE[$t]}" == tag && -z "${QUEUED[$o]+x}" ]]; then QUEUED[$o]=1; next+=("$o"); fi
    done
    queue=("${next[@]}")
  done

  HIST_REFS=0
  HIST_TAGS=0
  HIST_TAGGED=0
  declare -A TAG_DONE=()
  for k in "${!REF_OBJ[@]}"; do
    # Peel through any chain of tags to the object the ref ends at.
    o=${REF_OBJ[k]}; t=${REF_TYPE[k]}; chain=()
    while [[ "$t" == tag ]]; do chain+=("$o"); t=${TAG_OTYPE[$o]}; o=${TAG_OBJ[$o]}; done
    if [[ -n "$HIST_RANGE" && "$t" == commit ]]; then
      [[ -n "${IN_RANGE["c$o"]+x}" ]] || continue
    elif [[ -n "$HIST_RANGE" ]]; then
      tip=0
      for x in "${REF_OBJ[k]}" "${chain[@]}" "$o"; do
        [[ -z "${RANGE_TIP["o$x"]+x}" ]] || tip=1
      done
      (( tip )) || continue
    fi
    HIST_REFS=$((HIST_REFS + 1))
    hm_add "${REF_OBJ[k]}" "(ref)" 0 "${REF_NAME[k]}"
    if [[ "$t" != commit ]]; then
      HIST_TAGGED=$((HIST_TAGGED + 1))
      if [[ "$STRICT" -eq 1 ]]; then
        add_hit "unscanned:tagged-$t" "(ref)" 0 "${REF_NAME[k]} (points at a $t; its content is not scanned)" history "$o"
      fi
    fi
    for tg in "${chain[@]}"; do
      [[ -z "${TAG_DONE[$tg]+x}" ]] || continue
      TAG_DONE[$tg]=1
      HIST_TAGS=$((HIST_TAGS + 1))
      hm_add "$tg" "(tag)" 0 "${TAG_NAME[$tg]}"
      hm_add "$tg" "(tagger)" 0 "${TAG_TAGGER[$tg]}"
      rest=${TAG_MSG[$tg]}
      kk=0
      while [[ -n "$rest" ]]; do
        kk=$((kk + 1))
        ml=${rest%%$'\n'*}
        if [[ "$rest" == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
        hm_add "$tg" "(tag message)" "$kk" "$ml"
      done
    done
  done
  exec 9>&-
  pass_patterns "history metadata" git -C "$TMPD/subj" grep --no-index -a -z -l -E "${CRED_E[@]}" -- hm
  for p in "${PASS_PATS[@]}"; do
    pat_args "$p"
    run_git "pattern '$p' (history metadata)" "$TMPD/hhits" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- hm
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      i=$((l - 1))
      [[ -n "${M_SHA[i]-}" ]] || die "internal error: history metadata pass returned line $l"
      add_hit "$p" "${M_FIELD[i]}" "${M_LINE[i]}" "${M_TEXT[i]}" history "${M_SHA[i]}"
    done < "$TMPD/hhits"
  done

  # A .leakcheckrc.local committed at ANY point published its tells, even if
  # it is gone today: the same rule as for the tree, and for the same reason.
  if [[ "$HIST_COMMITS" -gt 0 ]]; then
    run_git "log (.leakcheckrc.local)" "$TMPD/hlocal" g "${HLOG[@]}" --format=%H \
      -- ':(literal).leakcheckrc.local'
    if [[ -s "$TMPD/hlocal" ]]; then
      IFS= read -r sha < "$TMPD/hlocal"
      add_hit "config:local-in-history" ".leakcheckrc.local" 0 \
        "(a .leakcheckrc.local committed in history publishes the tells it held; remove it from history)" history "$sha"
    fi
  fi
fi

# A committed .leakcheckrc.local publishes the inventory of tells it exists
# to keep out of git. Reported as a finding of its own, in every mode and
# whatever --config says: its patterns need not match their own source text
# (`pattern ^SECRET-[0-9]+$` does not), so "its lines will report it" is not
# a guarantee. Looked up past `skip`, which listed it away: `skip
# .leakcheckrc*` turned this finding into a skipped path, exit 0 (measured).
run_git "ls-files (.leakcheckrc.local)" "$TMPD/lslocal" g ls-files -z -- ':(literal).leakcheckrc.local'
if [[ -s "$TMPD/lslocal" ]]; then
  add_hit "config:local-tracked" ".leakcheckrc.local" 0 \
    "(a committed .leakcheckrc.local publishes the tells it holds; gitignore it)" "index"
fi

# Under --strict, what could not be scanned is itself a finding.
if [[ "$STRICT" -eq 1 ]]; then
  for path in "${BINARY_PATHS[@]}"; do
    n0=${#H_FILE[@]}
    add_hit "unscanned:binary" "$path" 0 "(binary file; content not scanned)" "${BINARY["p$path"]}"
    if (( ${#H_FILE[@]} > n0 )); then H_CPATH[$n0]=$path; fi
  done
  for path in "${GITLINKS[@]}"; do
    n0=${#H_FILE[@]}
    add_hit "unscanned:submodule" "$path" 0 "(submodule; contents not scanned)" "index"
    if (( ${#H_FILE[@]} > n0 )); then H_CPATH[$n0]=$path; fi
  done
  for path in "${GIT_DIRS[@]}"; do
    add_hit "unscanned:git-dir" "$path" 0 "(named .git; contents not scanned)" "worktree"
  done
  for i in "${!AR_UPATH[@]}"; do
    n0=${#H_FILE[@]}
    add_hit "unscanned:archive" "${AR_UPATH[$i]}" 0 "(archive member not read: ${AR_UWHY[$i]})" "${AR_USRC[$i]}"
    if (( ${#H_FILE[@]} > n0 )); then H_CPATH[$n0]=${AR_ULABEL[$i]}; fi
  done
fi

# ─── allowlist ────────────────────────────────────────────────────────
# A rule allows a hit in one of two ways, each tested by the same engine as
# the patterns:
#   whole line  it matches all of `path:line:text`, so it names this exact
#               line (`^f\.txt:1:/home/alice/x$`): matching is POSIX
#               leftmost-longest, so such a rule's first -o match is the
#               whole line, and git grep has no -x
#   per match   it matches `path:line:M` for a match M of the hit's own
#               pattern, and every such M on the line is excused by some
#               rule (`/home/USERNAME/`, `\.example\.com`) — a location
#               rule (`^fixtures/`) matches every M there
# A rule that merely matches somewhere on the line allows nothing: matching
# the whole line once let the placeholder in `allow /home/USERNAME/` hide a
# MYHOST hit, and a real /home/alice/, that shared its line (measured,
# v0.6.0) — and a minified file is one line.
# Matches come from `git grep -o`, whose match TEXTS are right but whose
# --column is right only for a line's first match (git 2.53 adds the
# previous match's end instead: measured), so nothing here uses positions.
# Rules are compiled even when there is nothing to allow, so a broken one
# fails on a clean repo too. The lowest-numbered rule that took part takes
# the credit, and every rule's count is reported: an over-broad allow must
# not look identical to a clean repo.
ALLOWED=()
ALLOW_COUNTS=()
declare -A UNSCOPED_HINT=()
for i in "${!H_FILE[@]}"; do ALLOWED[$i]=0; done
for r in "${!ALLOWLIST[@]}"; do ALLOW_COUNTS[$r]=0; done
# The matches are needed by the allow rules, and by every credential hit,
# which prints them masked and is judged on them by the placeholder check.
NEED_MT=0
if [[ ${#ALLOWLIST[@]} -gt 0 || "$REDACT" -eq 1 ]]; then NEED_MT=1; fi
for i in "${!H_FILE[@]}"; do
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then NEED_MT=1; break; fi
done
MT_HIT=(); MT_TXT=(); MT_OF=()
if [[ "$NEED_MT" -eq 1 ]]; then
  # Every match of each hit's own pattern, as text. A text the pattern finds
  # no non-empty match in as displayed (an anchored pattern on a
  # `-> target` symlink hit), or that no pattern produced (unscanned:binary
  # and the other pseudo-patterns), counts as one match: the whole text.
  declare -A IS_PAT=() BY_PAT=()
  for p in "${PATTERNS[@]}"; do IS_PAT["l$p"]=1; done
  for i in "${!H_FILE[@]}"; do
    MT_OF[$i]=""
    BY_PAT["l${H_PAT[$i]}"]+="$i "
  done
  for key in "${!BY_PAT[@]}"; do
    [[ -n "${IS_PAT[$key]+x}" ]] || continue
    p=${key#l}
    T_HIT=(); n=0
    exec 6>"$TMPD/subj/t"
    for i in ${BY_PAT[$key]}; do
      printf '%s\n' "${H_TEXT[$i]}" >&6
      lines_of "${H_TEXT[$i]}"
      for (( k = 0; k < REPLY; k++ )); do n=$((n + 1)); T_HIT[n]=$i; done
    done
    exec 6>&-
    pat_args "$p"
    run_git "pattern '$p' (matches)" "$TMPD/tmatch" \
      "${RE_LOC[@]}" git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column "${RE_ARGS[@]}" -- t
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r m; do
      i=${T_HIT[l]:-}
      [[ -n "$i" ]] || die "internal error: match pass returned line $l"
      if [[ "$p" == credential:* ]]; then cred_key "${p#credential:}" "$m"; m=$REPLY; fi
      MT_OF[$i]+="${#MT_HIT[@]} "
      MT_HIT+=("$i"); MT_TXT+=("$m")
    done < "$TMPD/tmatch"
  done
  for i in "${!H_FILE[@]}"; do
    if [[ -z "${MT_OF[$i]}" ]]; then
      MT_OF[$i]="${#MT_HIT[@]} "
      MT_HIT+=("$i"); MT_TXT+=("${H_TEXT[$i]}")
    fi
  done
fi

if [[ ${#ALLOWLIST[@]} -gt 0 ]]; then
  # Subjects: a holds each hit's whole line, m one line per match; each
  # subject line maps back to its hit (or match).
  A_OF=(); A_TXT=(); A_LINES=(); M_OF=()
  na=0; nm=0
  exec 7>"$TMPD/subj/a" 8>"$TMPD/subj/m"
  for i in "${!H_FILE[@]}"; do
    rec="${H_FILE[$i]}:${H_LINE[$i]}:${H_TEXT[$i]}"
    printf '%s\n' "$rec" >&7
    # mapfile splits it in one pass: `${rec#*$'\n'}` per line grows with
    # the square of the record's length.
    mapfile -t REC_LINES <<< "$rec"
    A_LINES[$i]=${#REC_LINES[@]}
    for (( k = 0; k < A_LINES[$i]; k++ )); do
      na=$((na + 1)); A_OF[na]=$i
      A_TXT[na]=${REC_LINES[k]}
    done
  done
  for j in "${!MT_HIT[@]}"; do
    i=${MT_HIT[j]}
    printf '%s\n' "${H_FILE[$i]}:${H_LINE[$i]}:${MT_TXT[j]}" >&8
    lines_of "${H_FILE[$i]}:${H_LINE[$i]}:${MT_TXT[j]}"
    for (( k = 0; k < REPLY; k++ )); do nm=$((nm + 1)); M_OF[nm]=$j; done
  done
  exec 7>&- 8>&-

  # A rule excuses only the hits in its scope: an unscoped rule never a
  # credential hit, a scoped one only its own rule's (`*`: any credential
  # rule's). A location rule (`^fixtures/`) written for home paths would
  # otherwise hide a real key beside them, clean and exit 0 (measured,
  # v0.10.4). Where an unscoped rule matched a credential hit it may not
  # excuse, U_WHOLE / U_EXC record it, for one line saying how to scope it.
  allow_applies() { # rule hit
    local sc=${ALLOW_SCOPE[$1]} p=${H_PAT[$2]}
    if [[ -z "${CRED_RE["l$p"]+x}" ]]; then
      [[ -z "$sc" ]]
    else
      [[ "$sc" == '*' || "credential:$sc" == "$p" ]]
    fi
  }
  WHOLE=(); EXC=(); U_WHOLE=(); U_EXC=()
  for i in "${!H_FILE[@]}"; do WHOLE[$i]=""; U_WHOLE[$i]=""; done
  for j in "${!MT_HIT[@]}"; do EXC[$j]=""; U_EXC[$j]=""; done
  for r in "${!ALLOWLIST[@]}"; do
    rule=${ALLOWLIST[$r]}
    re_args "$rule"
    # Whole line: every line of the record matched entirely.
    run_git "allow '$rule'" "$TMPD/awhole" \
      git -C "$TMPD/subj" grep --no-index -a -z -n -o --no-color --no-column "${RE_ARGS[@]}" -- a
    declare -A WCOUNT=() WSEEN=()
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      i=${A_OF[l]:-}
      [[ -n "$i" ]] || die "internal error: allow pass returned line $l"
      [[ "$t" == "${A_TXT[l]}" && -z "${WSEEN[$l]+x}" ]] || continue
      WSEEN[$l]=1
      WCOUNT[$i]=$(( ${WCOUNT[$i]:-0} + 1 ))
    done < "$TMPD/awhole"
    for i in "${!WCOUNT[@]}"; do
      [[ ${WCOUNT[$i]} -eq ${A_LINES[$i]} ]] || continue
      if allow_applies "$r" "$i"; then
        [[ -n "${WHOLE[$i]}" ]] || WHOLE[$i]=$r
      elif [[ -z "${ALLOW_SCOPE[r]}" ]]; then
        U_WHOLE[$i]=1
      fi
    done
    unset WCOUNT WSEEN
    run_git "allow '$rule'" "$TMPD/amatch" \
      git -C "$TMPD/subj" grep --no-index -a -z -n --no-color --no-column "${RE_ARGS[@]}" -- m
    while IFS= read -r -d '' f && IFS= read -r -d '' l && IFS= read -r t; do
      j=${M_OF[l]:-}
      [[ -n "$j" ]] || die "internal error: allow pass returned line $l"
      if allow_applies "$r" "${MT_HIT[j]}"; then
        [[ -n "${EXC[$j]}" ]] || EXC[$j]=$r
      elif [[ -z "${ALLOW_SCOPE[r]}" ]]; then
        U_EXC[$j]=1
      fi
    done < "$TMPD/amatch"
  done

  for i in "${!H_FILE[@]}"; do
    credit=none
    for j in ${MT_OF[$i]}; do
      if [[ -z "${EXC[$j]}" ]]; then credit=""; break; fi
      if [[ "$credit" == none || ${EXC[$j]} -lt $credit ]]; then credit=${EXC[$j]}; fi
    done
    [[ "$credit" != none ]] || credit=""
    r=${WHOLE[$i]}
    if [[ -n "$r" ]] && [[ -z "$credit" || $r -lt $credit ]]; then credit=$r; fi
    if [[ -n "$credit" ]]; then
      ALLOWED[$i]=1
      ALLOW_COUNTS[$credit]=$(( ALLOW_COUNTS[credit] + 1 ))
    elif [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then
      # Would an unscoped rule have excused it, every match or the line?
      u=1
      for j in ${MT_OF[$i]}; do
        if [[ -z "${EXC[$j]}${U_EXC[$j]}" ]]; then u=0; break; fi
      done
      if [[ "$u" -eq 1 || -n "${U_WHOLE[$i]}" ]]; then UNSCOPED_HINT[$i]=1; fi
    fi
  done
fi

# ─── credentials ──────────────────────────────────────────────────────
# A credential hit prints its matches masked, never its line: the line may
# hold a second secret no rule knows. A credential the name passes found in a
# path, a ref name or a tag name is masked wherever that name is printed — in
# every hit's path, and in a hit whose text is the name — since it would
# otherwise ride along in the location of every hit in that file.
# A hit whose every match is a stand-in (is_placeholder, with the masking
# helpers) is not reported, and is counted.
# cred_show <label> <match>: a header as found; anything else as its first
# four characters and its length.
cred_show() {
  local h
  if [[ "$2" == -----BEGIN* ]]; then
    h=${2#-----}
    REPLY="-----${h%%-----*}-----"
  elif [[ "$2" == "---- BEGIN "* ]]; then
    h=${2#---- }
    REPLY="---- ${h%% ----*} ----"
  elif [[ -n "${CRED_MARKER["l$1"]+x}" ]]; then
    REPLY=$2
  elif [[ -n "${KV_VAL[${1#credential:}]+x}" ]]; then
    kv_show "${1#credential:}" "$2"
  else
    REPLY="${2:0:4}[redacted, ${#2} chars]"
  fi
}

# A name hit: its text is the name itself — a path (line 0, text = the
# path), a ref name or a tag name; an --strict hit on a ref leads with it.
is_name_hit() { # hit
  [[ "${H_LINE[$1]}" == 0 ]] || return 1
  [[ -n "${H_NAME[$1]+x}" || "${H_FILE[$1]}" == "${H_TEXT[$1]}" || "${H_FILE[$1]}" == "(ref)" || "${H_FILE[$1]}" == "(tag)" ]]
}

# Credentials in names, from the name hits; mask_names <string> -> REPLY.
NAME_TOKS=()
declare -A NAME_TOK_SEEN=()
for i in "${!H_FILE[@]}"; do
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" && -z "${CRED_PATHRULE["l${H_PAT[$i]}"]+x}" ]] &&
     is_name_hit "$i"; then
    for j in ${MT_OF[$i]}; do
      [[ -z "${NAME_TOK_SEEN["t${MT_TXT[j]}"]+x}" ]] || continue
      NAME_TOK_SEEN["t${MT_TXT[j]}"]=1
      NAME_TOKS+=("${MT_TXT[j]}")
    done
  fi
done
# And from every name that prints, by every built-in rule: a disabled rule's
# key printed whole in its file's path (/qaa, v0.11.5).
if [[ ${#H_FILE[@]} -gt 0 ]]; then
  NAMES=()
  for i in "${!H_FILE[@]}"; do
    NAMES+=("${H_FILE[$i]}")
    if is_name_hit "$i"; then NAMES+=("${H_TEXT[$i]}"); fi
  done
  printf '%s\n' "${NAMES[@]}" > "$TMPD/subj/names"
  cred_matches_all "$TMPD/nmatch" "names" names
  while IFS= read -r -d '' _ && IFS= read -r -d '' _ && IFS= read -r -d '' _ && IFS= read -r tok; do
    [[ -z "${NAME_TOK_SEEN["t$tok"]+x}" ]] || continue
    NAME_TOK_SEEN["t$tok"]=1
    NAME_TOKS+=("$tok")
  done < "$TMPD/nmatch"
fi
# Every occurrence of every token marks its bytes, and each run prints once:
# replacing tokens one after another let a shorter match over a longer one's
# bytes break it, and the longer one's tail printed (Codex, v0.11.6).
mask_names() {
  REPLY=$1
  [[ ${#NAME_TOKS[@]} -gt 0 ]] || return 0
  local LC_ALL=C s=$1 tok o p k
  local -A nhide=()
  for tok in "${NAME_TOKS[@]}"; do
    [[ -n "$tok" ]] || continue
    o=0
    while [[ "${s:o}" == *"$tok"* ]]; do
      p=${s:o}; p=${p%%"$tok"*}; o=$(( o + ${#p} ))
      for (( k = o; k < o + ${#tok}; k++ )); do nhide[$k]=1; done
      o=$(( o + 1 ))
    done
  done
  [[ ${#nhide[@]} -gt 0 ]] || return 0
  render_masked "$s" nhide ""
}

# A keyword rule yields to a fixed-format rule, generic-secret to every
# other but generic-key, and generic-key to every other: a key another rule
# matched, overlapping the value, is that rule's to report, set aside or
# excuse. CRED_ON_LINE holds, by line, each such key behind its rank (0 a
# fixed-format rule, 1 a keyword rule, 2 generic-secret's value).
declare -A CRED_ON_LINE=()
for i in "${!H_FILE[@]}"; do
  p=${H_PAT[$i]}; cid=${p#credential:}
  [[ -n "${CRED_RE["l$p"]+x}" && "$cid" != "$KV_SERVICE" && -z "${CRED_PATHRULE["l$p"]+x}" ]] || continue
  rank=0
  if [[ -n "${KV_VAL[$cid]+x}" ]]; then rank=1; fi
  if [[ "$cid" == "$KV_GENERIC" ]]; then rank=2; fi
  if [[ "$cid" == "$KV_GENERIC2" ]]; then rank=3; fi
  lk="${#H_FILE[$i]}:${H_FILE[$i]}${#H_LINE[$i]}:${H_LINE[$i]}${#H_COMMIT[$i]}:${H_COMMIT[$i]}:${H_TEXT[$i]}"
  for j in ${MT_OF[$i]}; do
    t=${MT_TXT[j]}
    if [[ "$rank" -ge 1 ]] && kv_value "$cid" "$t"; then
      t=$REPLY
      # The start a bounded match held, as kv_overlaps reads its own value.
      if [[ "$t" =~ ^(${KV_JVAL[$cid]}) ]]; then t=${BASH_REMATCH[1]}; fi
    fi
    CRED_ON_LINE[$lk]+="$rank$t"$'\n'
  done
done
# kv_yields <hit> <match>: a keyword rule's match whose value overlaps a key
# a rule above it matched on the same line. Judged once per rule, line and
# match text (KV_YIELDS): kv_overlaps reads every place the match sits, so a
# match repeated on its line gets the one answer. A line's keys are listed
# once per rank (KV_KEYS), each once.
kv_yields() {
  local cid=${H_PAT[$1]#credential:} top=0 t keys="" r=0 mk id
  local lk="${#H_FILE[$1]}:${H_FILE[$1]}${#H_LINE[$1]}:${H_LINE[$1]}${#H_COMMIT[$1]}:${H_COMMIT[$1]}:${H_TEXT[$1]}"
  [[ -n "${CRED_ON_LINE[$lk]+x}" ]] || return 1
  id=${KV_LINE_ID[$lk]-}
  if [[ -z "$id" ]]; then KV_LINE_N=$(( KV_LINE_N + 1 )); id=$KV_LINE_N; KV_LINE_ID[$lk]=$id; fi
  mk="$cid $id:$2"
  if [[ -n "${KV_YIELDS[$mk]+x}" ]]; then return "${KV_YIELDS[$mk]}"; fi
  if [[ "$cid" == "$KV_GENERIC" ]]; then top=1; fi
  if [[ "$cid" == "$KV_GENERIC2" ]]; then top=2; fi
  if [[ "$cid" == "$KV_SERVICE" ]]; then top=3; fi
  if [[ -n "${KV_KEYS["$top $id"]+x}" ]]; then
    keys=${KV_KEYS["$top $id"]}
  else
    local -A seen=()
    kv_lines "${CRED_ON_LINE[$lk]}"
    for t in "${KV_ARR[@]}"; do
      if [[ "${t:0:1}" -le "$top" && -z "${seen["k${t:1}"]+x}" ]]; then seen["k${t:1}"]=1; keys+="${t:1}"$'\n'; fi
    done
    KV_KEYS["$top $id"]=$keys
  fi
  kv_overlaps "$cid" "$2" "$keys" "${H_TEXT[$1]}" "$top $id" || r=1
  KV_YIELDS[$mk]=$r
  return "$r"
}

# --redact: a tell is the matches of a pattern's hit, in a name (a path, a
# ref, a tag) or a line; each is hidden whole wherever a path prints, and in
# a credential hit's text, which prints a keyword or a path rule's name:
# `MYHOST.Password[redacted, …]` and `MYHOST-client.p12` printed a tell the
# line's or name's own hit hid, when only a name's tells were gathered (/qaa).
REDACT_TOKS=()
if [[ "$REDACT" -eq 1 ]]; then
  declare -A REDACT_SEEN=()
  for i in "${!H_FILE[@]}"; do
    [[ -z "${CRED_RE["l${H_PAT[$i]}"]+x}" ]] || continue
    for j in ${MT_OF[$i]}; do
      [[ -n "${MT_TXT[j]}" && -z "${REDACT_SEEN["t${MT_TXT[j]}"]+x}" ]] || continue
      REDACT_SEEN["t${MT_TXT[j]}"]=1
      REDACT_TOKS+=("${MT_TXT[j]}")
    done
  done
fi
redact_names() {
  REPLY=$1
  [[ ${#REDACT_TOKS[@]} -gt 0 ]] || return 0
  local LC_ALL=C s=$1 tok o p k
  local -A rhide=()
  for tok in "${REDACT_TOKS[@]}"; do
    o=0
    while [[ "${s:o}" == *"$tok"* ]]; do
      p=${s:o}; p=${p%%"$tok"*}; o=$(( o + ${#p} ))
      for (( k = o; k < o + ${#tok}; k++ )); do rhide[$k]=1; done
      o=$(( o + 1 ))
    done
  done
  [[ ${#rhide[@]} -gt 0 ]] || return 0
  render_masked "$s" rhide "" 0
}

KEEP=()
SHOW=()
SHOW_FILE=()
SHOW_PAT=()
declare -A PAT_NUM=()
pn=0
for p in "${PATTERNS[@]}" "${PATH_PATS[@]}"; do pn=$(( pn + 1 )); PAT_NUM["l$p"]=$pn; done
ALLOWED_TOTAL=0
declare -A IS_CRED_HIT=()
CRED_FOUND=0
CRED_UNSCOPED=0
CRED_PLACEHOLDERS=0
CRED_WEAK=0
for i in "${!H_FILE[@]}"; do
  if [[ "${ALLOWED[$i]}" -eq 1 ]]; then
    ALLOWED_TOTAL=$((ALLOWED_TOTAL + 1))
    continue
  fi
  SHOW[$i]=${H_TEXT[$i]}
  mask_names "${H_FILE[$i]}"; SHOW_FILE[$i]=$REPLY
  if is_name_hit "$i"; then
    mask_names "${H_TEXT[$i]}"; SHOW[$i]=$REPLY
  fi
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then
    ph=1
    [[ -z "${CRED_MARKER["l${H_PAT[$i]}"]+x}" ]] || ph=0
    # A path rule's hit shows its name as every name hit does: it holds no
    # key of the rule's to mask, and is never a stand-in.
    if [[ -n "${CRED_PATHRULE["l${H_PAT[$i]}"]+x}" ]]; then ph=0; else
      SHOW[$i]=""
      cid=${H_PAT[$i]#credential:}
      live=0
      for j in ${MT_OF[$i]}; do
        if [[ -n "${KV_VAL[$cid]+x}" ]] && kv_yields "$i" "${MT_TXT[j]}"; then continue; fi
        live=1
        if [[ -n "${KV_VAL[$cid]+x}" ]]; then
          if ! { kv_value "$cid" "${MT_TXT[j]}" && { kv_call "$cid" "$i" "${MT_TXT[j]}" "${BASH_REMATCH[1]}" || kv_weak "$cid" "$REPLY" "${BASH_REMATCH[1]}"; }; }; then ph=0; fi
        elif ! is_placeholder "${MT_TXT[j]}" "$cid" &&
           ! { [[ "${H_PAT[$i]}" == credential:github-token ]] && checksum_fails "${MT_TXT[j]}"; }; then
          ph=0
        fi
        cred_show "${H_PAT[$i]}" "${MT_TXT[j]}"
        SHOW[$i]+="${SHOW[$i]:+ }$REPLY"
      done
      # Every match another rule's key: reported, set aside or excused there.
      if [[ "$live" -eq 0 ]]; then continue; fi
    fi
    # A keyword rule's weak value is counted apart: a placeholder is a
    # stand-in written to look like a key, a weak value text a keyword's
    # grammar caught (`tokenizer = AutoTokenizer…`).
    if [[ "$ph" -eq 1 && -n "${KV_VAL[${H_PAT[$i]#credential:}]+x}" ]]; then
      CRED_WEAK=$((CRED_WEAK + 1))
      continue
    fi
    if [[ "$ph" -eq 1 ]]; then
      CRED_PLACEHOLDERS=$((CRED_PLACEHOLDERS + 1))
      continue
    fi
    CRED_FOUND=$((CRED_FOUND + 1))
    if [[ -n "${UNSCOPED_HINT[$i]+x}" ]]; then CRED_UNSCOPED=$((CRED_UNSCOPED + 1)); fi
  fi
  KEEP+=("$i")
  SHOW_PAT[$i]=${H_PAT[$i]}
  if [[ -n "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then IS_CRED_HIT[$i]=1; fi
  if [[ "$REDACT" -eq 1 ]]; then
    redact_names "${SHOW_FILE[$i]}"; SHOW_FILE[$i]=$REPLY
    if [[ -z "${CRED_RE["l${H_PAT[$i]}"]+x}" ]]; then SHOW[$i]="[redacted, ${#H_TEXT[$i]} chars]"
    else redact_names "${SHOW[$i]}"; SHOW[$i]=$REPLY; fi
    # A config pattern with no label is its own label, and its regex is the
    # tell: it prints as its line in --list-patterns.
    if [[ -n "${PLAIN_PAT["l${H_PAT[$i]}"]+x}" && -n "${PAT_NUM["l${H_PAT[$i]}"]+x}" ]]; then
      SHOW_PAT[$i]="pattern:${PAT_NUM["l${H_PAT[$i]}"]}"
    fi
  fi
done

# --write-baseline and --baseline. A finding is a hash of its path, pattern
# and raw text — raw, so a new key where an old one sat, whose masked text
# is the same, is a new finding — and its ordinal among identical findings,
# so a copy is new too; a line that moves keeps both. Not its commit: history
# reports a finding once, at its earliest commit, and a rebase would make
# every one of them new. The file holds the hashes alone, so committing it
# publishes no path, text or key.
# The baseline is read before it is written, so one file can be both.
BASELINE_HEAD="# leakcheck baseline v1"
BASELINED=0
if [[ -n "$BASELINE_IN$BASELINE_OUT" ]]; then
  declare -A BASE=() FP=() FP_N=()
  if [[ -n "$BASELINE_IN" ]]; then
    bl=0
    while IFS= read -r line || [[ -n "$line" ]]; do
      bl=$((bl + 1))
      line=${line%$'\r'}
      if [[ $bl -eq 1 ]]; then
        [[ "$line" == "$BASELINE_HEAD" ]] ||
          die "baseline $BASELINE_IN: not a leakcheck baseline (its first line is not: $BASELINE_HEAD)"
        continue
      fi
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ "$line" =~ ^[0-9a-f]{40}([0-9a-f]{24})?:[1-9][0-9]*$ ]] ||
        die "baseline $BASELINE_IN: line $bl is not a finding's fingerprint"
      BASE[$line]=1
    done < "$BASELINE_IN_ABS"
    [[ $bl -gt 0 ]] || die "baseline $BASELINE_IN: empty, not a leakcheck baseline"
  fi
  mkdir "$TMPD/fp" || die "cannot create a temporary directory"
  # An unscanned hit's text is the same whatever its content holds, so the
  # content's identity, the index's and the worktree's, is in its print: a
  # binary file baselined stayed baselined whatever it came to hold (/qaa).
  declare -A FPX=() CP_I=() CP_W=()
  cps=()
  for i in "${KEEP[@]}"; do
    if [[ -n "${H_CPATH[$i]+x}" ]]; then cps+=("${H_CPATH[$i]}"); fi
  done
  if [[ ${#cps[@]} -gt 0 ]]; then
    run_git "ls-files (baseline)" "$TMPD/bls" g ls-files -s -z
    while IFS= read -r -d '' row; do
      m=${row%%$'\t'*}; o=${m#* }
      CP_I["p${row#*$'\t'}"]=${o%% *}
    done < "$TMPD/bls"
    for p in "${cps[@]}"; do
      [[ -z "${CP_W["p$p"]+x}" && -f "$p" && ! -L "$p" ]] || continue
      run_git "hash-object (baseline)" "$TMPD/bwh" git hash-object --no-filters -- "$p"
      CP_W["p$p"]=$(<"$TMPD/bwh")
    done
    for i in "${KEEP[@]}"; do
      [[ -n "${H_CPATH[$i]+x}" ]] || continue
      p=${H_CPATH[$i]}
      FPX[$i]="${CP_I["p$p"]:--} ${CP_W["p$p"]:--}"
    done
  fi
  for i in "${KEEP[@]}"; do
    if [[ -n "${FPX[$i]+x}" ]]; then
      printf '%s\0%s\0%s\0%s' "${H_FILE[$i]}" "${H_PAT[$i]}" "${H_TEXT[$i]}" "${FPX[$i]}" > "$TMPD/fp/$i"
    else
      printf '%s\0%s\0%s' "${H_FILE[$i]}" "${H_PAT[$i]}" "${H_TEXT[$i]}" > "$TMPD/fp/$i"
    fi
    printf '%s\n' "$TMPD/fp/$i"
  done > "$TMPD/fp.list"
  FP_HASH=()
  if [[ ${#KEEP[@]} -gt 0 ]]; then
    run_git "hash-object (baseline)" "$TMPD/fp.hash" git hash-object --no-filters --stdin-paths < "$TMPD/fp.list"
    mapfile -t FP_HASH < "$TMPD/fp.hash"
    [[ ${#FP_HASH[@]} -eq ${#KEEP[@]} ]] ||
      die "scan error: git hash-object returned ${#FP_HASH[@]} hashes for ${#KEEP[@]} findings"
  fi
  k=0
  for i in "${KEEP[@]}"; do
    h=${FP_HASH[k]}; k=$((k + 1))
    [[ "$h" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || die "scan error: unexpected hash from git hash-object"
    FP_N[$h]=$(( ${FP_N[$h]:-0} + 1 ))
    FP[$i]="$h:${FP_N[$h]}"
  done
  if [[ -n "$BASELINE_OUT" ]]; then
    {
      printf '%s\n' "$BASELINE_HEAD" \
        "# One accepted finding a line: a hash of its path, pattern and text, then its" \
        "# ordinal among identical findings. Rewrite it with --write-baseline."
      for i in "${KEEP[@]}"; do printf '%s\n' "${FP[$i]}"; done
    } > "$BASELINE_OUT_ABS" || die "cannot write baseline: $BASELINE_OUT"
  fi
  if [[ -n "$BASELINE_IN" ]]; then
    kept=()
    for i in "${KEEP[@]}"; do
      if [[ -n "${BASE[${FP[$i]}]+x}" ]]; then
        BASELINED=$((BASELINED + 1))
        if [[ -n "${IS_CRED_HIT[$i]+x}" ]]; then
          CRED_FOUND=$((CRED_FOUND - 1))
          if [[ -n "${UNSCOPED_HINT[$i]+x}" ]]; then CRED_UNSCOPED=$((CRED_UNSCOPED - 1)); fi
        fi
        continue
      fi
      kept+=("$i")
    done
    KEEP=("${kept[@]}")
  fi
fi
HIT_COUNT=${#KEEP[@]}

if [[ "$HISTORY" -eq 1 ]]; then
  HRANGE=""
  if [[ -n "$HIST_RANGE" ]]; then HRANGE=" in range $HIST_RANGE only"; fi
  HSCOPE="history scanned: $HIST_COMMITS commits$HRANGE, $HIST_BINARY binary files skipped, $HIST_SKIPPED skipped by config, ${#CFG_EXEMPT[@]} current-config lines exempt, $HIST_REFS refs, $HIST_TAGS annotated tags, $HIST_TAGGED tagged trees or blobs not scanned"
else
  HSCOPE="history not scanned"
fi
if [[ "$CRED_COUNT" -gt 0 ]]; then
  CSCOPE="credentials scanned, $CRED_PLACEHOLDERS placeholders not reported"
  # A disabled rule is a scope reduction, so it is counted where the scope is
  # printed; a config that disables none prints what it always did.
  if [[ ${#CRED_DISABLED[@]} -gt 0 ]]; then
    CSCOPE+=", ${#CRED_DISABLED[@]} credential rules disabled by config"
  fi
  # Printed when there are any, as the disabled rules are: a run with none
  # prints what it always did.
  if [[ "$CRED_WEAK" -gt 0 ]]; then
    CSCOPE+=", $CRED_WEAK weak keyword values not reported"
  fi
else
  CSCOPE="credentials not scanned"
  # Every rule turned off one by one is not `no-credentials`: the config said
  # which rules, so they are still counted (Codex, v0.11.3).
  if [[ "$USE_CREDENTIALS" -eq 1 && ${#CRED_DISABLED[@]} -gt 0 ]]; then
    CSCOPE+=", ${#CRED_DISABLED[@]} credential rules disabled by config"
  fi
fi
SCOPE="$SCOPE_HEAD; $BINARY_COUNT binary skipped, ${#GITLINKS[@]} submodules not scanned, $SKIPPED_COUNT skipped by config, $ALLOWED_TOTAL allowed; $HSCOPE; $CSCOPE"
if [[ "$SCAN_TARGET" == dir ]]; then SCOPE+="; ${#GIT_DIRS[@]} paths named .git not scanned"; fi
# --rule is a scope reduction, so it is counted where the scope is printed.
if [[ ${#RULE_ONLY[@]} -gt 0 ]]; then
  SCOPE+="; only ${#RULE_WANT[@]} rules run (--rule)"
fi
# What --archives read: members, and what it could not read.
if [[ "$ARCHIVES" -eq 1 ]]; then
  SCOPE+="; $AR_READ archives read ($AR_K members, ${#AR_UPATH[@]} not read), $AR_FAILED archives not read (one level)"
fi
# What --decode read, so a run that decoded nothing says so.
if [[ "$DECODE" -eq 1 ]]; then
  SCOPE+="; $DEC_COUNT encoded values decoded ($CONTENT_WORD, one level)"
fi
# A baseline is a scope reduction like an allow rule, so it is counted.
if [[ -n "$BASELINE_IN" ]]; then
  SCOPE+="; $BASELINED in baseline"
fi

# An allow rule may name a credential outright — the README's way to excuse
# a stand-in — and the JSON report prints every rule: each credential in one
# that is not a placeholder is masked there, like a hit's.
ALLOW_SHOW=("${ALLOW_TEXT[@]}")
if [[ "$OUTPUT_MODE" == "json" && ${#ALLOWLIST[@]} -gt 0 ]]; then
  mask_texts ALLOW_SHOW "allow rules"
  # An allow rule names what is excused, a tell often enough.
  if [[ "$REDACT" -eq 1 ]]; then
    for r in "${!ALLOW_SHOW[@]}"; do ALLOW_SHOW[r]="[redacted, ${#ALLOW_TEXT[r]} chars]"; done
  fi
fi

# ─── output ───────────────────────────────────────────────────────────
  # One well-formed UTF-8 sequence, as bytes (matched under LC_ALL=C).
  UTF8_SEQ=$'([\x01-\x7f]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])'
  # JSON must be UTF-8, and neither a path nor a line has to be (a legacy
  # filename, a Latin-1 file): one such byte made the whole envelope
  # unparseable. Well-formed input passes through on one regex test; in
  # anything else each stray byte becomes U+FFFD.
  utf8_clean() {
    local LC_ALL=C s="$1" out=""
    if [[ "$s" =~ ^${UTF8_SEQ}*$ ]]; then
      printf '%s' "$s"
      return 0
    fi
    while [[ -n "$s" ]]; do
      if [[ "$s" =~ ^$UTF8_SEQ ]]; then
        out+="${BASH_REMATCH[0]}"
        s="${s:${#BASH_REMATCH[0]}}"
      else
        out+='�'
        s="${s:1}"
      fi
    done
    printf '%s' "$out"
  }
  # Pure-bash escaping for portability.
  json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    # Strip remaining control chars (<0x20) — rare in tracked source.
    s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037')
    utf8_clean "$s"
  }
  # XML 1.0 text and attributes, for --format junit. Each replacement comes
  # from a quoted variable: since bash 5.2 an unquoted `&` in a ${s//x/y}
  # replacement is the matched text (`a<b` became `a<lt;b`, measured).
  xml_escape() {
    local s="$1" amp='&amp;' lt='&lt;' gt='&gt;' quot='&quot;' apos='&apos;' tab='&#9;' nl='&#10;' cr='&#13;'
    s=${s//&/"$amp"}
    s=${s//</"$lt"}
    s=${s//>/"$gt"}
    s=${s//\"/"$quot"}
    s=${s//\'/"$apos"}
    s=${s//$'\t'/"$tab"}
    s=${s//$'\n'/"$nl"}
    s=${s//$'\r'/"$cr"}
    # XML 1.0 allows no other C0 character, even as a reference, nor U+FFFE
    # and U+FFFF, well-formed UTF-8 a hit line can hold (/qaa: unparseable).
    s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037')
    s=${s//$'\xef\xbf\xbe'/}; s=${s//$'\xef\xbf\xbf'/}
    utf8_clean "$s"
  }
  # A relative URI reference for a path, for --format sarif: every byte but
  # an unreserved one or `/` percent-encoded.
  uri_path() { # path -> REPLY
    local LC_ALL=C s=$1 c v k out=""
    for (( k = 0; k < ${#s}; k++ )); do
      c=${s:k:1}
      case "$c" in
        [A-Za-z0-9._~/-]) out+=$c ;;
        *) printf -v v '%%%02X' "'$c"; out+=$v ;;
      esac
    done
    REPLY=$out
  }
  # A CSV field, RFC 4180 quoted. A field a spreadsheet would read as a
  # formula (=, +, -, @, a tab or a CR first) gets a leading ': the text of
  # a hit is the scanned repository's, and opening the report must not run
  # it.
  csv_field() { # value -> REPLY
    local s=$1 q='""'
    case "$s" in [=+@-]*|$'\t'*|$'\r'*) s="'$s" ;; esac
    REPLY="\"${s//\"/"$q"}\""
  }
  # The hit as the text output leads it, commit first in history.
  hit_where() { # hit -> REPLY
    REPLY="${SHOW_FILE[$1]}:${H_LINE[$1]}"
    if [[ -n "${H_COMMIT[$1]}" ]]; then REPLY="${H_COMMIT[$1]}:$REPLY"; fi
  }
  # The summary the text output prints to stderr after its hits; the
  # formats whose document is stdout print it too.
  summary_stderr() {
    if [[ "$HIT_COUNT" -eq 0 ]]; then
      echo "leakcheck: clean — 0 matches across $TRACKED_COUNT $FILES_WORD ($SCOPE)" >&2
      return 0
    fi
    echo "leakcheck: $HIT_COUNT match(es)" >&2
    echo "leakcheck: scanned $TRACKED_COUNT $FILES_WORD ($SCOPE)" >&2
    if [[ "$CRED_FOUND" -gt 0 ]]; then
      echo "leakcheck: $CRED_FOUND credential(s) among these: revoke and reissue any that has left this machine; deleting one from the files or the history does not revoke it" >&2
    fi
    if [[ "$CRED_UNSCOPED" -gt 0 ]]; then
      echo "leakcheck: $CRED_UNSCOPED of them matched an allow rule that names no credential rule, which never excuses a credential; to excuse one, write allow credential:<id> <regex>" >&2
    fi
  }
if [[ "$OUTPUT_MODE" == "json" ]]; then
  # version, clean, count and hits stay first and unchanged; new fields
  # only ever append.
  printf '{"version":"%s","clean":%s,"count":%d,"hits":[' \
    "$VERSION" \
    "$([[ "$HIT_COUNT" -eq 0 ]] && echo true || echo false)" \
    "$HIT_COUNT"
  first=1
  for i in "${KEEP[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '{"file":"%s","line":%s,"pattern":"%s","text":"%s","source":"%s"' \
      "$(json_escape "${SHOW_FILE[$i]}")" "${H_LINE[$i]}" "$(json_escape "${SHOW_PAT[$i]}")" \
      "$(json_escape "${SHOW[$i]}")" "${H_SRC[$i]}"
    # Only history hits carry a commit; every other hit keeps its v0.3.0 shape.
    if [[ -n "${H_COMMIT[$i]}" ]]; then printf ',"commit":"%s"' "${H_COMMIT[$i]}"; fi
    printf '}'
  done
  printf '],"target":"%s","tracked":%d,"skipped":{"binary":%d,"submodule":%d,"config":%d},"symlinks":%d,"allowed":[' \
    "$SCAN_TARGET" "$TRACKED_COUNT" "$BINARY_COUNT" "${#GITLINKS[@]}" "$SKIPPED_COUNT" "${#LINK_PATHS[@]}"
  first=1
  for r in "${!ALLOWLIST[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '{"rule":"%s","count":%d}' "$(json_escape "${ALLOW_SHOW[$r]}")" "${ALLOW_COUNTS[$r]}"
  done
  if [[ "$HISTORY" -eq 1 ]]; then
    hr=null
    if [[ -n "$HIST_RANGE" ]]; then hr="\"$(json_escape "$HIST_RANGE")\""; fi
    printf '],"history_scanned":true,"history":{"commits":%d,"binary":%d,"skipped":%d,"config_lines_exempt":%d,"range":%s,"refs":%d,"tags":%d,"tagged_unscanned":%d,"merge_diffs":"%s"}' \
      "$HIST_COMMITS" "$HIST_BINARY" "$HIST_SKIPPED" "${#CFG_EXEMPT[@]}" "$hr" "$HIST_REFS" "$HIST_TAGS" "$HIST_TAGGED" "$HIST_MERGE_MODE"
  else
    printf '],"history_scanned":false'
  fi
  if [[ "$CRED_COUNT" -gt 0 || ( "$USE_CREDENTIALS" -eq 1 && ${#CRED_DISABLED[@]} -gt 0 ) ]]; then
    if [[ "$CRED_COUNT" -gt 0 ]]; then printf ',"credentials_scanned":true'; else printf ',"credentials_scanned":false'; fi
    printf ',"credentials":{"rules":%d,"placeholders":%d' "$CRED_COUNT" "$CRED_PLACEHOLDERS"
    if [[ ${#CRED_DISABLED[@]} -gt 0 ]]; then
      printf ',"disabled":['
      for k in "${!CRED_DISABLED[@]}"; do
        [[ "$k" -eq 0 ]] || printf ','
        printf '"%s"' "${CRED_DISABLED[$k]}"
      done
      printf ']'
    fi
    if [[ "$CRED_WEAK" -gt 0 ]]; then printf ',"weak":%d' "$CRED_WEAK"; fi
    printf '}'
  else
    printf ',"credentials_scanned":false'
  fi
  # --rule: the rules that ran, after every older field (append-only).
  if [[ ${#RULE_ONLY[@]} -gt 0 ]]; then
    printf ',"rules_run":['
    first=1
    for p in "${PATTERNS[@]}" "${PATH_PATS[@]}"; do
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '"%s"' "$(json_escape "$p")"
    done
    printf ']'
  fi
  # --baseline: the findings it held, last (append-only).
  if [[ -n "$BASELINE_IN" ]]; then printf ',"baseline":%d' "$BASELINED"; fi
  # --archives: what it read, last (append-only).
  if [[ "$ARCHIVES" -eq 1 ]]; then
    printf ',"archives":{"read":%d,"members":%d,"members_not_read":%d,"not_read":%d}' \
      "$AR_READ" "$AR_K" "${#AR_UPATH[@]}" "$AR_FAILED"
  fi
  # --dir: the paths named .git, last (append-only).
  if [[ "$SCAN_TARGET" == dir ]]; then printf ',"git_dirs":%d' "${#GIT_DIRS[@]}"; fi
  printf '}\n'
elif [[ "$OUTPUT_MODE" == "sarif" ]]; then
  # SARIF 2.1.0, as GitHub code scanning reads it: one run, a rule for each
  # pattern that hit, a result for each hit. A name or symlink target (line
  # 0) has no region. A commit's metadata, a ref or a tag (`(author)`,
  # `(ref)`, … in history) has no file, so its location is logical, named as
  # the text output names it.
  declare -A RULE_IX=()
  RULE_IDS=()
  for i in "${KEEP[@]}"; do
    if [[ -z "${RULE_IX["l${SHOW_PAT[$i]}"]+x}" ]]; then
      RULE_IX["l${SHOW_PAT[$i]}"]=${#RULE_IDS[@]}
      RULE_IDS+=("${SHOW_PAT[$i]}")
    fi
  done
  printf '{"version":"2.1.0","$schema":"https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"leakcheck","version":"%s","informationUri":"https://github.com/kVadrum/leakcheck","rules":[' "$VERSION"
  for k in "${!RULE_IDS[@]}"; do
    [[ "$k" -eq 0 ]] || printf ','
    r=${RULE_IDS[k]}
    if [[ "$r" == credential:* ]]; then d="A credential, by the built-in rule ${r#credential:}"; else d="A match of the pattern $r"; fi
    printf '{"id":"%s","shortDescription":{"text":"%s"}}' "$(json_escape "$r")" "$(json_escape "$d")"
  done
  printf ']}},"results":['
  first=1
  for i in "${KEEP[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    hit_where "$i"
    printf '{"ruleId":"%s","ruleIndex":%d,"level":"error","message":{"text":"%s"},"locations":[' \
      "$(json_escape "${SHOW_PAT[$i]}")" "${RULE_IX["l${SHOW_PAT[$i]}"]}" \
      "$(json_escape "$REPLY: [${SHOW_PAT[$i]}] ${SHOW[$i]}")"
    case "${H_SRC[$i]}:${H_FILE[$i]}" in
      'history:(author)'|'history:(committer)'|'history:(message)'|'history:(ref)'|'history:(tag)'|'history:(tagger)'|'history:(tag message)')
        printf '{"logicalLocations":[{"fullyQualifiedName":"%s"}]}' "$(json_escape "${SHOW_FILE[$i]}")" ;;
      *)
        uri_path "${SHOW_FILE[$i]}"
        printf '{"physicalLocation":{"artifactLocation":{"uri":"%s"}' "$(json_escape "$REPLY")"
        if [[ "${H_LINE[$i]}" -gt 0 ]]; then printf ',"region":{"startLine":%d}' "${H_LINE[$i]}"; fi
        printf '}}' ;;
    esac
    printf '],"properties":{"source":"%s"' "${H_SRC[$i]}"
    if [[ -n "${H_COMMIT[$i]}" ]]; then printf ',"commit":"%s"' "${H_COMMIT[$i]}"; fi
    printf '}}'
  done
  printf ']}]}\n'
  summary_stderr
elif [[ "$OUTPUT_MODE" == "csv" ]]; then
  # One row per hit, under a header; a clean scan is the header alone.
  printf 'file,line,pattern,text,source,commit\n'
  for i in "${KEEP[@]}"; do
    csv_field "${SHOW_FILE[$i]}"; row="$REPLY,${H_LINE[$i]},"
    csv_field "${SHOW_PAT[$i]}"; row+="$REPLY,"
    csv_field "${SHOW[$i]}"; row+="$REPLY,${H_SRC[$i]},${H_COMMIT[$i]}"
    printf '%s\n' "$row"
  done
  summary_stderr
elif [[ "$OUTPUT_MODE" == "junit" ]]; then
  # A failed test case per hit. A clean scan is one passing case, `scan`:
  # a suite of no tests reads as one that never ran.
  n=$HIT_COUNT f=$HIT_COUNT
  if [[ "$HIT_COUNT" -eq 0 ]]; then n=1; fi
  printf '<?xml version="1.0" encoding="UTF-8"?>\n'
  printf '<testsuites name="leakcheck" tests="%d" failures="%d">\n' "$n" "$f"
  printf '<testsuite name="leakcheck" tests="%d" failures="%d">\n' "$n" "$f"
  if [[ "$HIT_COUNT" -eq 0 ]]; then
    printf '<testcase classname="leakcheck" name="scan"/>\n'
  fi
  for i in "${KEEP[@]}"; do
    hit_where "$i"
    printf '<testcase classname="leakcheck" name="%s"><failure type="%s" message="%s">%s</failure></testcase>\n' \
      "$(xml_escape "$REPLY")" "$(xml_escape "${SHOW_PAT[$i]}")" \
      "$(xml_escape "[${SHOW_PAT[$i]}] ${SHOW[$i]}")" "$(xml_escape "$REPLY: [${SHOW_PAT[$i]}] ${SHOW[$i]}")"
  done
  printf '</testsuite>\n</testsuites>\n'
  summary_stderr
else
  # One hit, one line. A field holding a newline — only a path name or a
  # symlink target can — is C-quoted the way git quotes such paths; every
  # other field prints byte-for-byte, so the common case is unchanged.
  line_safe() {
    local s="$1"
    case "$s" in
      *$'\n'*)
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/\\r}"
        s="${s//$'\t'/\\t}"
        printf '"%s"' "$s"
        ;;
      *) printf '%s' "$s" ;;
    esac
  }
  if [[ "$HIT_COUNT" -eq 0 ]]; then
    echo "leakcheck: clean — 0 matches across $TRACKED_COUNT $FILES_WORD ($SCOPE)"
  else
    for i in "${KEEP[@]}"; do
      # A history hit leads with its commit: <sha>:path:line: [pattern] text.
      if [[ -n "${H_COMMIT[$i]}" ]]; then printf '%s:' "${H_COMMIT[$i]}"; fi
      dsuf=""
      if [[ "${H_SRC[$i]}" == decoded-* ]]; then dsuf=" (${H_SRC[$i]/-/ })"; fi
      printf '%s:%s: [%s] %s%s\n' "$(line_safe "${SHOW_FILE[$i]}")" "${H_LINE[$i]}" \
        "${SHOW_PAT[$i]}" "$(line_safe "${SHOW[$i]}")" "$dsuf"
    done
    echo "leakcheck: $HIT_COUNT match(es)" >&2
    echo "leakcheck: scanned $TRACKED_COUNT $FILES_WORD ($SCOPE)" >&2
    if [[ "$CRED_FOUND" -gt 0 ]]; then
      echo "leakcheck: $CRED_FOUND credential(s) among these: revoke and reissue any that has left this machine; deleting one from the files or the history does not revoke it" >&2
    fi
    if [[ "$CRED_UNSCOPED" -gt 0 ]]; then
      echo "leakcheck: $CRED_UNSCOPED of them matched an allow rule that names no credential rule, which never excuses a credential; to excuse one, write allow credential:<id> <regex>" >&2
    fi
  fi
fi

if [[ "$HIT_COUNT" -gt 0 ]]; then
  EXIT_HITS=1
  exit 1
fi
exit 0
